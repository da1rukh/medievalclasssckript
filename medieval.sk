function perkIcon(pid: text) :: item:
    if {_pid} is "warrior_A":
        return iron sword
    if {_pid} is "warrior_B":
        return redstone
    if {_pid} is "warrior_C":
        return shield
    if {_pid} is "warrior_D":
        return totem of undying
    if {_pid} is "scout_A":
        return sugar
    if {_pid} is "scout_B":
        return iron sword
    if {_pid} is "scout_C":
        return phantom membrane
    if {_pid} is "scout_D":
        return ghast tear
    if {_pid} is "tank_A":
        return magma cream
    if {_pid} is "tank_B":
        return anvil
    if {_pid} is "tank_C":
        return netherite ingot
    if {_pid} is "tank_D":
        return golden apple
    if {_pid} is "archer_A":
        return spectral arrow
    if {_pid} is "archer_B":
        return packed ice
    if {_pid} is "archer_C":
        return bow
    if {_pid} is "archer_D":
        return ender pearl
    if {_pid} is "mage_A":
        return fire charge
    if {_pid} is "mage_B":
        return packed ice
    if {_pid} is "mage_C":
        return glistering melon slice
    if {_pid} is "mage_D":
        return amethyst shard
    if {_pid} is "necro_A":
        return soul lantern
    if {_pid} is "necro_B":
        return fermented spider eye
    if {_pid} is "necro_C":
        return fishing rod
    if {_pid} is "necro_D":
        return wither skeleton skull
    return paper

function perkDesc(pid: text) :: texts:
    delete {_o::*}
    if {_pid} is "warrior_A":
        add "&7Удар по цели с ❤≤4: &c+75%% урона" to {_o::*}
        add "&7+ &cStrength I &7на 3с" to {_o::*}
    else if {_pid} is "warrior_B":
        add "&7При ❤<6 — постоянно &cStr II + Speed I" to {_o::*}
        add "&7Но получаешь &c+15%% входящего урона" to {_o::*}
    else if {_pid} is "warrior_C":
        add "&7Парирование вернёт &cx1.5 урона" to {_o::*}
        add "&7+ Slowness II + Blindness 4с, КД -50%%" to {_o::*}
    else if {_pid} is "warrior_D":
        add "&7Раз в 3 минуты при смертельном ударе:" to {_o::*}
        add "&aспасение на 6❤ + Resist II + Regen II 6с" to {_o::*}
    else if {_pid} is "scout_A":
        add "&7Можно сделать &fдва рывка &7подряд" to {_o::*}
        add "&7(КД 1-го: 4с, 2-й сразу за 1-м)" to {_o::*}
    else if {_pid} is "scout_B":
        add "&7Удар в инвизе даёт &c+100%% урона" to {_o::*}
        add "&7+ инвиз не снимается ещё 2с" to {_o::*}
    else if {_pid} is "scout_C":
        add "&7Shift в воздухе при падении >5 блоков" to {_o::*}
        add "&7= &fSlow Falling 5с &7(КД 30с)" to {_o::*}
    else if {_pid} is "scout_D":
        add "&7Каждый 4-й удар лечит &c+½❤" to {_o::*}
        add "&7При ❤<6 — &fSpeed III &75с (КД 20с)" to {_o::*}
    else if {_pid} is "tank_A":
        add "&7Атакующий поджигается на 4с" to {_o::*}
        add "&7+ получает 2❤ огнём" to {_o::*}
    else if {_pid} is "tank_B":
        add "&7Каждый 4-й удар по тебе:" to {_o::*}
        add "&7толчок врагов в радиусе 4 + Slow II 3с" to {_o::*}
    else if {_pid} is "tank_C":
        add "&7При ≤40%% макс. ❤ — &cResistance III" to {_o::*}
        add "&7+ &c-30%% урона сверху" to {_o::*}
    else if {_pid} is "tank_D":
        add "&7Союзник дуо в радиусе 8 получает" to {_o::*}
        add "&aResistance II + Regen I пассивно" to {_o::*}
    else if {_pid} is "archer_A":
        add "&7Стрелы &c+50%% урона" to {_o::*}
        add "&7если цель дальше &f20 блоков" to {_o::*}
    else if {_pid} is "archer_B":
        add "&7Стрела даёт цели:" to {_o::*}
        add "&fSlow III + Mining Fatigue II + Weakness I 5с" to {_o::*}
    else if {_pid} is "archer_C":
        add "&7Shift+ПКМ луком — &fвыпустить 3 стрелы" to {_o::*}
        add "&7веером сразу (КД 12с)" to {_o::*}
    else if {_pid} is "archer_D":
        add "&7Стрела наносит &c75%% урона" to {_o::*}
        add "&7ближайшему врагу в радиусе 6" to {_o::*}
    else if {_pid} is "mage_A":
        add "&7Большой фаербол доступен с L1" to {_o::*}
        add "&7через Shift+ПКМ блейзом (КД 20с)" to {_o::*}
    else if {_pid} is "mage_B":
        add "&7Фаербол замораживает врагов:" to {_o::*}
        add "&fSlow III &76с в радиусе 4" to {_o::*}
    else if {_pid} is "mage_C":
        add "&7Союзники в радиусе 10 пассивно:" to {_o::*}
        add "&aRegeneration I" to {_o::*}
    else if {_pid} is "mage_D":
        add "&7При получении удара (КД 20с):" to {_o::*}
        add "&7враг получает &fSlow II + Weakness I 4с" to {_o::*}
        add "&7а маг — &fSpeed II 3с" to {_o::*}
    else if {_pid} is "necro_A":
        add "&7Призыв даёт &f+1 миньон" to {_o::*}
        add "&7Жизнь миньонов: &f75с" to {_o::*}
    else if {_pid} is "necro_B":
        add "&7Миньон при смерти взрывается:" to {_o::*}
        add "&fPoison II 8с + Wither II 5с в R4" to {_o::*}
    else if {_pid} is "necro_C":
        add "&7Shift+ПКМ костью — притянуть врага" to {_o::*}
        add "&7+ &fSlow III &74с (КД 20с)" to {_o::*}
    else if {_pid} is "necro_D":
        add "&7Миньоны: &fx2 ❤ + 30%% урона" to {_o::*}
        add "&7+ накладывают &fWither I &7при ударе" to {_o::*}
    else:
        add "&7Перк не выбран" to {_o::*}
    return {_o::*}

# ==========================================
# АРТЕФАКТЫ (АДМИН GUI, ВЫДАЧА СЕБЕ)
# ==========================================
function artifactFromSlot(s: number) :: item:
    set {_i} to air
    if {_s} is 0:
        set {_i} to netherite sword named "&6&lЛегендарный артефакт: Печать Пространственного Разреза"
        set lore of {_i} to "&7Только для &cWarrior" and "&7ЛКМ по воздуху — &cкрасный разрез &7вперёд ~22 блока" and "&7Удар мечом/буловой по существу — бонусный урон" and "&8ЛЕГЕНДАРНЫЙ"
    else if {_s} is 1:
        set {_i} to echo shard named "&6&lЛегендарный артефакт: Тень Фантома"
        set lore of {_i} to "&7Только для &bScout" and "&7Шанс полностью избежать удара и уйти в инвиз" and "&8ЛЕГЕНДАРНЫЙ"
    else if {_s} is 2:
        set {_i} to netherite chestplate named "&6&lЛегендарный артефакт: Якорь Мироздания"
        set lore of {_i} to "&7Только для &fTank" and "&7Давление вблизи + ударная волна при падении" and "&8ЛЕГЕНДАРНЫЙ"
    else if {_s} is 6:
        set {_i} to spectral arrow named "&6&lЛегендарный артефакт: Око Хищника"
        set lore of {_i} to "&7Только для &aArcher" and "&7Стрелы получают автонаводку по цели" and "&8ЛЕГЕНДАРНЫЙ"
    else if {_s} is 7:
        set {_i} to amethyst shard named "&6&lЛегендарный артефакт: Эфирный Разум"
        set lore of {_i} to "&7Только для &dMage" and "&7Инвертирует дебаффы в полезные баффы" and "&8ЛЕГЕНДАРНЫЙ"
    else if {_s} is 8:
        set {_i} to wither skeleton skull named "&6&lЛегендарный артефакт: Амулет Гнилого Родства"
        set lore of {_i} to "&7Только для &5Necromancer" and "&7Нежить нейтральна и следует зову хозяина" and "&8ЛЕГЕНДАРНЫЙ"
    else if {_s} is 10:
        set {_i} to leather boots named "&6&lАртефакт: Сапоги Гермеса"
        set lore of {_i} to "&7Пассивно дают &fSpeed II" and "&7Работают постоянно, пока включены" and "&8Эффект: &aАКТИВЕН"
    else if {_s} is 11:
        set {_i} to gold nugget named "&e&lАртефакт: Кольцо Ветра"
        set lore of {_i} to "&7Даёт скорость и &a+15%% урона" and "&7но быстрее тратит голод" and "&8Эффект: &aАКТИВЕН"
    else if {_s} is 12:
        set {_i} to ghast tear named "&c&lАртефакт: Амулет вампира"
        set lore of {_i} to "&7Часть нанесённого урона" and "&7возвращается тебе как лечение" and "&8Эффект: &aАКТИВЕН"
    else if {_s} is 13:
        set {_i} to ender pearl named "&d&lАртефакт: Эфирный рывок"
        set lore of {_i} to "&7Пассивно: при получении урона от сущности" and "&7мгновенно телепортирует с эндер-частицами" and "&7КД срабатывания: &e20с" and "&8Эффект: &aАКТИВЕН"
    else if {_s} is 14:
        set {_i} to iron sword named "&4&lАртефакт: Бритва Мерунеса"
        set lore of {_i} to "&7Шанс &c13.33%% &7мгновенно казнить цель" and "&8(не срабатывает на боссах и игроках)" and "&8Эффект: &aАКТИВЕН"
    else if {_s} is 15:
        set {_i} to diamond sword named "&f&lАртефакт: Звёздная ярость"
        set lore of {_i} to "&7Шанс кометы: визуальная молния" and "&7поджог + двойной урон по цели" and "&8Эффект: &aАКТИВЕН"
    else if {_s} is 16:
        set {_i} to packed ice named "&b&lАртефакт: Ледяной след"
        set lore of {_i} to "&7Постоянно создаёт временный лёд под тобой" and "&7Работает только когда артефакт включён" and "&8Эффект: &aАКТИВЕН"

    else if {_s} is 19:
        set {_i} to heart of the sea named "&b&lАртефакт: Сердце ледяного великана"
        set lore of {_i} to "&7Когда тебя бьют — атакующий" and "&7получает &fSlowness I &7на 3с" and "&8Эффект: &aАКТИВЕН"
    else if {_s} is 20:
        set {_i} to shield named "&f&lАртефакт: Щит Анх"
        set lore of {_i} to "&7Иммунитет: Poison / Slowness / Weakness" and "&7Пока артефакт в инвентаре" and "&8Эффект: &aАКТИВЕН"
    else if {_s} is 21:
        set {_i} to nether star named "&d&lАртефакт: Звезда Азуры"
        set lore of {_i} to "&7Убийства заряжают звезду" and "&7ПКМ: 25 зарядов -> опыт" and "&8Эффект: &aАКТИВЕН"
    else if {_s} is 22:
        set {_i} to poisonous potato named "&2&lАртефакт: Гнилое яблоко"
        set lore of {_i} to "&7Нейтральные животные получают" and "&cx2 урон &7от твоих ударов" and "&8Эффект: &aАКТИВЕН"
    else if {_s} is 23:
        set {_i} to compass named "&8&lАртефакт: Компас Пустоты"
        set lore of {_i} to "&7Авто-сохранение места смерти" and "&7Возврат после респавна (внутр. КД)" and "&8Эффект: &aАКТИВЕН"
    else if {_s} is 24:
        set {_i} to gold ingot named "&6&lАртефакт: Монета удачи"
        set lore of {_i} to "&7Шанс &a25%% &7на бонусный лут" and "&7за убийство существ" and "&8Эффект: &aАКТИВЕН"
    else if {_s} is 25:
        set {_i} to glass bottle named "&f&lАртефакт: Воздушный шарик"
        set lore of {_i} to "&7Двойной прыжок + анти-урон от падения" and "&7ПКМ в руке: поглотить в ядро" and "&8Эффект: &aАКТИВЕН"
    else if {_s} is 26:
        set {_i} to golden helmet named "&6&lАртефакт: Корона Высшего Разума"
        set lore of {_i} to "&7Пассивно: &aх3 опыт из всех источников" and "&7Твои зачарования считаются на +1 уровень" and "&8Эффект: &aАКТИВЕН"
    else if {_s} is 27:
        set {_i} to portableHeaterArtifactItem()
    else if {_s} is 28:
        set {_i} to dreamCatcherArtifactItem()
    else if {_s} is 29:
        set {_i} to desertHeartArtifactItem()
    else if {_s} is 30:
        set {_i} to quantumDuplicatorArtifactItem()
    else if {_s} is 31:
        set {_i} to facelessMaskArtifactItem()
    else if {_s} is 32:
        set {_i} to cursedKingGiftArtifactItem()
    else if {_s} is 33:
        set {_i} to lootMagnetItem()
    else if {_s} is 34:
        set {_i} to nightLensItem()
    return {_i}

