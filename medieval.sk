function evoAdminItemById(id: text) :: item:
    set {_id} to {_id} in lower case

    # Базовые altar/ключевые предметы
    if {_id} is "void_key" or {_id} is "key_void":
        set {_k} to tripwire hook named "&5&lКлюч Пустоты"
        set lore of {_k} to "&8Админ-выдача"
        return {_k}
    if {_id} is "return_key" or {_id} is "key_return":
        set {_k} to tripwire hook named "&b&lКлюч Возврата"
        set lore of {_k} to "&8Админ-выдача"
        return {_k}
    if {_id} is "altar_hopper" or {_id} is "awakening_hopper":
        return awakeningHopperTokenItem()

    # Кирки алтаря
    if {_id} is "ether_pick":
        return altarEtherPickaxeItem()
    if {_id} is "flame_pick":
        return altarFlamePickaxeItem()
    if {_id} is "vein_pick":
        return altarVeinPickaxeItem()
    if {_id} is "fortune_pick":
        return altarFortunePickaxeItem()
    if {_id} is "void_pick":
        return altarVoidPickaxeItem()
    if {_id} is "omni_pick":
        return altarOmniPickaxeItem()

    # Новые крафтабельные артефакты вне ядра
    if {_id} is "heater":
        return portableHeaterItem()
    if {_id} is "dreamcatcher":
        return dreamCatcherItem()
    if {_id} is "desertheart":
        return desertHeartItem()
    if {_id} is "quantdup":
        return quantumDuplicatorItem()
    if {_id} is "facelessmask":
        return facelessMaskItem()
    if {_id} is "cursedgift":
        return cursedKingGiftItem()

    # Древние свитки
    if {_id} is "scroll_heater":
        return ancientScrollItem("heater")
    if {_id} is "scroll_dreamcatcher":
        return ancientScrollItem("dreamcatcher")
    if {_id} is "scroll_desertheart":
        return ancientScrollItem("desertheart")
    if {_id} is "scroll_quantdup":
        return ancientScrollItem("quantdup")
    if {_id} is "scroll_facelessmask":
        return ancientScrollItem("facelessmask")
    if {_id} is "scroll_cursedgift":
        return ancientScrollItem("cursedgift")

    # Артефакты из основной системы по id
    set {_slot} to artifactSlotFromKey({_id})
    if {_slot} >= 0:
        return artifactFromSlot({_slot})

    return air

function isArtifactRecipeByFive(inv: inventory, i1: item, i2: item, i3: item, i4: item, i5: item) :: boolean:
    set {_a} to 0
    set {_b} to 0
    set {_c} to 0
    set {_d} to 0
    set {_e} to 0
    set {_total} to 0
    set {_bad} to false
    loop 5 times:
        set {_it} to slot (loop-number - 1) of {_inv}
        if {_it} is air:
            set {_bad} to true
        else:
            add 1 to {_total}
            if {_it} is {_i1}:
                add 1 to {_a}
            else if {_it} is {_i2}:
                add 1 to {_b}
            else if {_it} is {_i3}:
                add 1 to {_c}
            else if {_it} is {_i4}:
                add 1 to {_d}
            else if {_it} is {_i5}:
                add 1 to {_e}
            else:
                set {_bad} to true
    if {_bad} is true:
        return false
    if {_total} is not 5:
        return false
    if {_a} is not 1:
        return false
    if {_b} is not 1:
        return false
    if {_c} is not 1:
        return false
    if {_d} is not 1:
        return false
    if {_e} is not 1:
        return false
    return true

function isCursedGiftAltarRecipe(inv: inventory) :: boolean:
    return isArtifactRecipeByFive({_inv}, crownHigherMindArtifactItem(), artifactFromSlot(8), enchanted golden apple, player head, netherite ingot)

function giveArtifactScaledExperience(p: player, amount: number):
    set {_xp} to round({_amount})
    if {_xp} < 1:
        set {_xp} to 1
    if hasArtifact({_p}, "crownmind") is true:
        set {_xp} to {_xp} * 3
    loop {_xp} times:
        give 1 experience to {_p}

function debugEtherPickaxeRecipe(inv: inventory, p: player):
    if isEvoDebug({_p}) is false:
        stop
    set {_voidN} to 0
    set {_retN} to 0
    set {_pickN} to 0
    set {_blockN} to 0
    set {_amN} to 0
    set {_total} to 0
    set {_bad} to 0
    loop 5 times:
        set {_si} to loop-number - 1
        set {_it} to slot {_si} of {_inv}
        if {_it} is air:
            send "{@prefix} &8[debug] slot %{_si}%: &cпусто" to {_p}
        else:
            add 1 to {_total}
            set {_nm} to name of {_it}
            if {_nm} is not set:
                set {_nm} to "&7без имени"
            if altarAwakeningVoidKey({_it}) is true:
                add 1 to {_voidN}
                send "{@prefix} &8[debug] slot %{_si}%: &dключ пустоты &8(%{_nm}%)" to {_p}
            else if altarAwakeningReturnKey({_it}) is true:
                add 1 to {_retN}
                send "{@prefix} &8[debug] slot %{_si}%: &bключ возврата &8(%{_nm}%)" to {_p}
            else if {_it} is diamond pickaxe:
                add 1 to {_pickN}
                send "{@prefix} &8[debug] slot %{_si}%: &fалмазная кирка" to {_p}
            else if {_it} is diamond block:
                add 1 to {_blockN}
                send "{@prefix} &8[debug] slot %{_si}%: &bалмазный блок" to {_p}
            else if {_it} is amethyst shard:
                add 1 to {_amN}
                send "{@prefix} &8[debug] slot %{_si}%: &dаметистовый осколок" to {_p}
            else:
                add 1 to {_bad}
                send "{@prefix} &8[debug] slot %{_si}%: &cчужой предмет &8(%type of {_it}% | %{_nm}%)" to {_p}
    send "{@prefix} &8[debug] total=%{_total}% bad=%{_bad}% | void=%{_voidN}% ret=%{_retN}% pick=%{_pickN}% block=%{_blockN}% am=%{_amN}%" to {_p}

function isAwakeningCraftHopperReady(hb: block) :: boolean:
    if {_hb} is not hopper:
        return false
    set {_w} to world of {_hb}
    set {_x} to floor(x-coordinate of {_hb})
    set {_y} to floor(y-coordinate of {_hb})
    set {_z} to floor(z-coordinate of {_hb})
    set {_ped} to block at location at {_x}, {_y} - 1, {_z} in {_w}
    if {_ped} is not amethyst block:
        return false
    set {_top} to block at location at {_x}, {_y} + 1, {_z} in {_w}
    if {_top} is not crying obsidian:
        return false
    set {_btn} to block at location at {_x}, {_y} + 1, {_z} - 1 in {_w}
    if {_btn} is not stone button:
        return false
    return true

function tryCraftAwakeningAltarAt(hb: block, crafter: player) :: boolean:
    if {_hb} is not hopper:
        return false
    # Для крафта важна рабочая связка (кнопка/верх/воронка/пьедестал), а не идеальная оболочка.
    if isAwakeningCraftHopperReady({_hb}) is false:
        if {_crafter} is set:
            if isEvoDebug({_crafter}) is true:
                send "{@prefix} &8[debug] ready-check: FAIL (воронка/аметист/верх/кнопка)" to {_crafter}
        return false
    set {_inv} to inventory of {_hb}
    set {_outItem} to air
    if isEtherPickaxeAltarRecipeExact({_inv}) is true:
        set {_outItem} to altarEtherPickaxeItem()
    else if isPickaxeRecipeByCore({_inv}, gold block, blaze rod) is true:
        set {_outItem} to altarFlamePickaxeItem()
    else if isPickaxeRecipeByCore({_inv}, emerald block, slime ball) is true:
        set {_outItem} to altarVeinPickaxeItem()
    else if isPickaxeRecipeByCore({_inv}, gold block, lapis lazuli) is true:
        set {_outItem} to altarFortunePickaxeItem()
    else if isPickaxeRecipeByCore({_inv}, obsidian, ender pearl) is true:
        set {_outItem} to altarVoidPickaxeItem()
    else if isOmniPickaxeAltarRecipe({_inv}) is true:
        set {_outItem} to altarOmniPickaxeItem()
    else if isCrownHigherMindAltarRecipe({_inv}) is true:
        set {_outItem} to crownHigherMindArtifactItem()
    else if isArtifactRecipeByFive({_inv}, furnace, blaze powder, copper block, coal, iron ingot) is true:
        set {_outItem} to portableHeaterItem()
    else if isArtifactRecipeByFive({_inv}, string, cobweb, glowstone dust, feather, gold nugget) is true:
        set {_outItem} to dreamCatcherItem()
    else if isArtifactRecipeByFive({_inv}, cactus, soul sand, blaze powder, gold ingot, flint) is true:
        set {_outItem} to desertHeartItem()
    else if isArtifactRecipeByFive({_inv}, dispenser, amethyst shard, copper ingot, redstone block, glowstone dust) is true:
        set {_outItem} to quantumDuplicatorItem()
    else if isArtifactRecipeByFive({_inv}, leather, white wool, potion of invisibility, ink sac, gold ingot) is true:
        set {_outItem} to facelessMaskItem()
    else if isCursedGiftAltarRecipe({_inv}) is true:
        set {_outItem} to cursedKingGiftItem()
    else:
        if {_crafter} is set:
            if isEvoDebug({_crafter}) is true:
                send "{@prefix} &8[debug] recipe-check: FAIL" to {_crafter}
                debugEtherPickaxeRecipe({_inv}, {_crafter})
        return false
    clearAltarCraftSlots({_inv})
    set {_out} to location of {_hb}
    add 1 to y-coordinate of {_out}
    strike lightning effect at {_out}
    execute console command "execute positioned %x-coordinate of {_out}% %y-coordinate of {_out}% %z-coordinate of {_out}% run particle minecraft:witch ~ ~ ~ 0.35 0.35 0.35 0.01 30 force"
    execute console command "execute positioned %x-coordinate of {_out}% %y-coordinate of {_out}% %z-coordinate of {_out}% run particle minecraft:portal ~ ~0.4 ~ 0.45 0.35 0.45 0.01 40 force"
    if {_crafter} is set:
        giveOrDrop({_outItem}, {_crafter}, {_out})
    else:
        drop {_outItem} at {_out}
    play sound "block.enchantment_table.use" with volume 1 and pitch 0.8 at {_out} for all players
    if {_crafter} is set:
        send "{@prefix} &dКрафт подтверждён." to {_crafter}
    return true

function isAwakeningAltarStructurePart(loc: location) :: boolean:
    set {_lw} to world of {_loc}
    set {_lx} to floor(x-coordinate of {_loc})
    set {_ly} to floor(y-coordinate of {_loc})
    set {_lz} to floor(z-coordinate of {_loc})
    loop {awakening_altar_bases::*}:
        set {_base} to loop-value
        if world of {_base} is not {_lw}:
            continue
        set {_bx} to floor(x-coordinate of {_base})
        set {_by} to floor(y-coordinate of {_base})
        set {_bz} to floor(z-coordinate of {_base})
        if {_ly} < {_by}:
            continue
        if {_ly} > {_by} + 2:
            if {_ly} is not {_by} + 3:
                continue
        if {_lx} < {_bx} - 1:
            continue
        if {_lx} > {_bx} + 1:
            continue
        if {_lz} < {_bz} - 1:
            continue
        if {_lz} > {_bz} + 1:
            continue
        if {_ly} is {_by} + 3:
            if {_lx} is {_bx}:
                if {_lz} is {_bz}:
                    return true
            continue
        set {_rdx} to {_lx} - {_bx}
        set {_rdy} to {_ly} - {_by}
        set {_rdz} to {_lz} - {_bz}
        if {_rdy} is 1:
            if isAwakeningAltarFaceHoleMiddle({_rdx}, {_rdz}) is true:
                continue
        return true
    return false

on place of hopper:
    wait 1 tick
    set {_pit} to event-item
    tryCompleteAwakeningAltarHopper(player, event-block, {_pit})

# Алтарь из сундука: проверка при изменении инвентаря сундука.
on inventory click:
    set {_do} to false
    if event-inventory is set:
        set {_h1} to holder of event-inventory
        if {_h1} is chest:
            set {_do} to true
        else if {_h1} is trapped chest:
            set {_do} to true
    if clicked inventory is set:
        if clicked inventory is not event-inventory:
            set {_h2} to holder of clicked inventory
            if {_h2} is chest:
                set {_do} to true
            else if {_h2} is trapped chest:
                set {_do} to true
    if {_do} is false:
        stop
    wait 1 tick
    set {_pl} to player
    if event-inventory is set:
        tryBuildAwakeningAltarFromInventoryHolder(holder of event-inventory, {_pl})
    if clicked inventory is set:
        if clicked inventory is not event-inventory:
            tryBuildAwakeningAltarFromInventoryHolder(holder of clicked inventory, {_pl})

on inventory drag:
    if event-inventory is player's inventory:
        stop
    set {_hd} to holder of event-inventory
    if {_hd} is not chest:
        if {_hd} is not trapped chest:
            stop
    wait 1 tick
    tryBuildAwakeningAltarFromInventoryHolder({_hd}, player)

on inventory item move:
    set {_dest} to holder of event-inventory
    if {_dest} is not set:
        stop
    if {_dest} is not chest:
        if {_dest} is not trapped chest:
            stop
    if event-item is not disc fragment 5:
        if event-item is not crying obsidian:
            if event-item is not obsidian:
                if event-item is not amethyst shard:
                    stop
    wait 1 tick
    tryBuildAwakeningAltarAtChestBlock({_dest})

every 2 seconds:
    loop {awakening_altars::*}:
        set {_loc} to loop-value
        set {_b} to block at {_loc}
        if {_b} is not hopper:
            remove loop-value from {awakening_altars::*}
            continue
        # Автокрафт отключён: подтверждение теперь только кнопкой/ПКМ по алтарю.
        continue

on right click on stone button:
    set {_rb} to event-block
    if {_rb} is not set:
        stop
    set {_bw} to world of {_rb}
    set {_bx} to floor(x-coordinate of {_rb})
    set {_by} to floor(y-coordinate of {_rb})
    set {_bz} to floor(z-coordinate of {_rb})
    set {_top} to block at location at {_bx}, {_by}, {_bz} + 1 in {_bw}
    if {_top} is not crying obsidian:
        send "{@prefix} &7Крафт не подтверждён: это не кнопка алтаря." to player
        play sound "block.note_block.bass" with volume 0.8 and pitch 0.7 at player for player
        stop
    set {_hb} to block at location at {_bx}, {_by} - 1, {_bz} + 1 in {_bw}
    if {_hb} is not hopper:
        send "{@prefix} &cАлтарь не завершён: поставь воронку в центр." to player
        play sound "block.note_block.bass" with volume 0.8 and pitch 0.7 at player for player
        stop
    if tryCraftAwakeningAltarAt({_hb}, player) is false:
        send "{@prefix} &7Крафт не подтверждён: проверь 5 ингредиентов в слотах 0–4 воронки." to player
        if isEvoDebug(player) is true:
            if isAwakeningCraftHopperReady({_hb}) is false:
                send "{@prefix} &8[debug] не готово ядро: нужен аметист под воронкой, плачущий обсидиан сверху и кнопка на северной стороне." to player
            debugEtherPickaxeRecipe(inventory of {_hb}, player)
        play sound "block.note_block.bass" with volume 0.8 and pitch 0.7 at player for player
    else:
        cancel event

command /altar:
    permission: evo.admin
    permission message: {@prefix} &cУ вас нет прав!
    trigger:
        send "{@prefix} &7Алтарь: положи в сундук &fровно &7рецепт и больше ничего:"
        send "{@prefix} &f5× ключ пустоты&7, &f3× плачущий обсидиан&7, &f3× обсидиан&7, &f3× аметистовый осколок."
        send "{@prefix} &7Появится куб без воронки; именную воронку получишь в инвентарь — поставь её на центральный аметист."
        send "{@prefix} &7Крафт подтверждается нажатием &fодной каменной кнопки &7на плачущем обсидиане (сбоку)."
        send "{@prefix} &7Алтарная кирка: &fПКМ по воздуху &7— шёлковое касание (целые блоки руды/мусора); &fShift+ПКМ &7— эфирный режим (пыль с мусора)."
        send "{@prefix} &6Рецепты алтарных кирок (слоты 0–4, порядок любой):"
        send "{@prefix} &dЭфирная: &5Ключ пустоты + &bКлюч возврата + &fалмазная кирка + &bалмазный блок + &dаметистовый осколок"
        send "{@prefix} &cПламенная: &5Ключ пустоты + &bКлюч возврата + &fалмазная кирка + &bалмазный блок + &6blaze rod"
        send "{@prefix} &aЖильная: &5Ключ пустоты + &bКлюч возврата + &fалмазная кирка + &aизумрудный блок + &aslime ball"
        send "{@prefix} &eУдачи: &5Ключ пустоты + &bКлюч возврата + &fалмазная кирка + &eзолотой блок + &9лазурит"
        send "{@prefix} &5Пустоты: &5Ключ пустоты + &bКлюч возврата + &fалмазная кирка + &8обсидиан + &5эндер-жемчуг"
        send "{@prefix} &6Омни-слияние: &7положи в 0–4 все 5 алтарных кирок (Эфирная, Пламенная, Жильная, Удачи, Пустоты)."
        send "{@prefix} &6Корона Высшего Разума: &6Эфирный Разум + &dЗвезда Азуры + &eзолотой шлем + &fenchanted book + &aпузырёк опыта."
        send "{@prefix} &6Портативный Нагреватель: &7печка + blaze powder + медный блок + уголь + железный слиток"
        send "{@prefix} &6Ловец Снов: &7нить + паутина + светокаменная пыль + перо + золотой самородок"
        send "{@prefix} &6Сердце Пустыни: &7кактус + песок душ + blaze powder + золотой слиток + кремень"
        send "{@prefix} &6Квантовый Дубликатор: &7раздатчик + аметист + медный слиток + блок редстоуна + светопыль"
        send "{@prefix} &6Маска Безликого: &7кожа + белая шерсть + зелье невидимости + чернильный мешок + золотой слиток"
        send "{@prefix} &6Дар Проклятого Короля: &7посох некро-тирана + корона + зачар. золотое яблоко + голова + незерит"

function pullArtifactFromCore(p: player, key: text) :: boolean:
    set {_u} to uuid of {_p}
    if {art_found::%{_u}%::%{_key}%} is not true:
        return false
    set {_s} to artifactSlotFromKey({_key})
    if {_s} < 0:
        return false
    set {_it} to artifactFromSlot({_s})
    if {_it} is air:
        return false
    set {art_found::%{_u}%::%{_key}%} to false
    set {art_enabled::%{_u}%::%{_key}%} to false
    if {_key} is "cloudjump":
        resetBalloonState({_p})
    give {_it} to {_p}
    return true

function hasArtifact(p: player, key: text) :: boolean:
    set {_u} to uuid of {_p}
    if {ghost::%{_u}%} is true:
        return false
    if {art_found::%{_u}%::%{_key}%} is true:
        if {art_enabled::%{_u}%::%{_key}%} is true:
            return true
    return false

function artifactCoreCount(p: player) :: number:
    set {_u} to uuid of {_p}
    set {_n} to 0
    loop "hermes", "windring", "vampcharm", "etherdash", "mehrunes", "starfury", "icewalker", "frostheart", "ankhshield", "azura", "rottenapple", "voidcompass", "luckcoin", "cloudjump" and "crownmind":
        if {art_found::%{_u}%::%loop-value%} is true:
            add 1 to {_n}
    return {_n}

function artifactCoreKeyByIndex(p: player, idx: number) :: text:
    set {_u} to uuid of {_p}
    set {_n} to 0
    loop "hermes", "windring", "vampcharm", "etherdash", "mehrunes", "starfury", "icewalker", "frostheart", "ankhshield", "azura", "rottenapple", "voidcompass", "luckcoin", "cloudjump" and "crownmind":
        if {art_found::%{_u}%::%loop-value%} is true:
            add 1 to {_n}
            if {_n} is {_idx}:
                return loop-value
    return ""

function artifactCoreGuiIndexBySlot(s: number) :: number:
    if {_s} is 11:
        return 1
    else if {_s} is 12:
        return 2
    else if {_s} is 13:
        return 3
    else if {_s} is 14:
        return 4
    else if {_s} is 15:
        return 5
    return 0

function isLegendaryArtifact(k: text) :: boolean:
    if {_k} is "leg_warrior":
        return true
    else if {_k} is "leg_scout":
        return true
    else if {_k} is "leg_tank":
        return true
    else if {_k} is "leg_archer":
        return true
    else if {_k} is "leg_mage":
        return true
    else if {_k} is "leg_necro":
        return true
    return false

function legendaryClass(k: text) :: text:
    if {_k} is "leg_warrior":
        return "Warrior"
    else if {_k} is "leg_scout":
        return "Scout"
    else if {_k} is "leg_tank":
        return "Tank"
    else if {_k} is "leg_archer":
        return "Archer"
    else if {_k} is "leg_mage":
        return "Mage"
    else if {_k} is "leg_necro":
        return "Necromancer"
    return ""

function classLegendaryKey(p: player) :: text:
    set {_u} to uuid of {_p}
    set {_c} to {class::%{_u}%} ? "None"
    if {_c} is "Warrior":
        return "leg_warrior"
    else if {_c} is "Scout":
        return "leg_scout"
    else if {_c} is "Tank":
        return "leg_tank"
    else if {_c} is "Archer":
        return "leg_archer"
    else if {_c} is "Mage":
        return "leg_mage"
    else if {_c} is "Necromancer":
        return "leg_necro"
    return ""

function hasBalloonArtifact(p: player) :: boolean:
    if hasArtifact({_p}, "cloudjump") is true:
        return true
    # Миграция старого ключа luckyhorseshoe -> cloudjump
    set {_u} to uuid of {_p}
    if {art_found::%{_u}%::luckyhorseshoe} is true:
        set {art_found::%{_u}%::cloudjump} to true
        if {art_enabled::%{_u}%::luckyhorseshoe} is true:
            set {art_enabled::%{_u}%::cloudjump} to true
        delete {art_found::%{_u}%::luckyhorseshoe}
        delete {art_enabled::%{_u}%::luckyhorseshoe}
        return true
    return false

function resetBalloonState(p: player):
    set {_u} to uuid of {_p}
    delete {art_cloud_used::%{_u}%}
    delete {art_cloud_fallimmune::%{_u}%}
    delete {art_cloud_fallimmune_until::%{_u}%}
    if {ghost::%{_u}%} is not true:
        if gamemode of {_p} is not creative:
            if gamemode of {_p} is not spectator:
                set flight mode of {_p} to false

# ---- Артефакты: пассивки, тики ----
every 10 ticks:
    loop all players:
        set {_u} to uuid of loop-player
        set {_loc} to location of loop-player
        set {_prev} to {art_hermes_prev::%{_u}%}
        set {_moved} to 0
        set {_speed_from_artifact} to false
        if {_prev} is set:
            set {_moved} to distance between {_loc} and {_prev}
        set {art_hermes_prev::%{_u}%} to {_loc}

        # Сапоги Гермеса: постоянный Speed II
        if hasArtifact(loop-player, "hermes") is true:
            apply speed 2 without particles to loop-player for 10 ticks
            set {_speed_from_artifact} to true
        else:
            delete {art_hermes_prev::%{_u}%}

        # Кольцо Ветра: мобильность + цена в голоде
        if hasArtifact(loop-player, "windring") is true:
            if {_speed_from_artifact} is false:
                apply speed 1 without particles to loop-player for 10 ticks
            if {_moved} > 0.25:
                chance of 20%:
                    if food level of loop-player > 1:
                        remove 1 from food level of loop-player

        # Щит Анх: иммун к ключевым дебаффам
        if hasArtifact(loop-player, "ankhshield") is true:
            set {_allowAnkhClean} to true
            if {class::%{_u}%} is "Mage":
                if hasArtifact(loop-player, "leg_mage") is true:
                    set {_allowAnkhClean} to false
            if {_allowAnkhClean} is true:
                remove poison from loop-player
                remove slowness from loop-player
                remove weakness from loop-player

        # Легендарка Mage: Эфирный Разум (инверсия дебаффов)
        if {class::%{_u}%} is "Mage":
            if hasArtifact(loop-player, "leg_mage") is true:
                if loop-player has potion effect wither:
                    remove wither from loop-player
                    apply regeneration 2 without particles to loop-player for 6 seconds
                if loop-player has potion effect poison:
                    remove poison from loop-player
                    apply regeneration 1 without particles to loop-player for 6 seconds
                if loop-player has potion effect slowness:
                    remove slowness from loop-player
                    apply speed 2 without particles to loop-player for 5 seconds
                if loop-player has potion effect weakness:
                    remove weakness from loop-player
                    apply strength 1 without particles to loop-player for 5 seconds
                if loop-player has potion effect mining fatigue:
                    remove mining fatigue from loop-player
                    apply haste 2 without particles to loop-player for 5 seconds

        # Легендарка Tank: Якорь Мироздания (урон убран — только "стенка")
        if {class::%{_u}%} is "Tank":
            if hasArtifact(loop-player, "leg_tank") is true:
                # Пассивный урон отключён; эффект "не пройти сквозь танка" ниже в every 2 ticks

        # Легендарка Necromancer: Амулет Гнилого Родства
        if {class::%{_u}%} is "Necromancer":
            if hasArtifact(loop-player, "leg_necro") is true:
                # Усиленная регенерация возле "смерти": мицелий/душ (дроп рядом — опущен из-за парсера Skript)
                set {_regenBoost} to false
                set {_under} to block below loop-player
                if {_under} is mycelium:
                    set {_regenBoost} to true
                else if {_under} is soul sand:
                    set {_regenBoost} to true
                else if {_under} is soul soil:
                    set {_regenBoost} to true
                if {_regenBoost} is true:
                    apply regeneration 2 without particles to loop-player for 15 ticks

                # Нежить следует фокусу некроманта (uuid цели)
                set {_fuuid} to {art_leg_necro_focus::%{_u}%}
                delete {_focus}
                if {_fuuid} is set:
                    for each {_le} in all living entities in radius 24 around loop-player:
                        if {_focus} is not set:
                            if "%uuid of {_le}%" is {_fuuid}:
                                set {_focus} to {_le}
                if {_focus} is set:
                    for each {_mob} in all living entities in radius 16 around loop-player:
                        if isLegNecroPacifiedUndead({_mob}) is true:
                            set target of {_mob} to {_focus}

        # Воздушный шарик: перезарядка на земле
        if hasBalloonArtifact(loop-player) is true:
            if gamemode of loop-player is not creative:
                if gamemode of loop-player is not spectator:
                    set {_b} to block below loop-player
                    if loop-player is on ground:
                        if {_b} is not air:
                            delete {art_cloud_used::%{_u}%}
                            set flight mode of loop-player to true
                    else:
                        if {art_cloud_used::%{_u}%} is true:
                            set flight mode of loop-player to false
                        else:
                            set flight mode of loop-player to true
        else:
            resetBalloonState(loop-player)

on right click with nether star:
    if hasArtifact(player, "azura") is true:
        cancel event
        set {_u} to player's uuid
        set {_c} to {art_azura_charge::%{_u}%} ? 0
        if {_c} < 25:
            send action bar "&cНедостаточно заряда: &e%{_c}%&7/&e25" to player
            stop
        remove 25 from {art_azura_charge::%{_u}%}
        give 8 experience bottle to player
        play sound "block.enchantment_table.use" with volume 1 and pitch 1.2 at player for player
        send "{@prefix} &dЗвезда Азуры высвободила энергию. &7(-25 заряда, +8 пузырьков опыта)" to player

on right click with compass:
    if hasArtifact(player, "voidcompass") is true:
        cancel event
        set {_u} to player's uuid
        if {art_voidcompass_pending::%{_u}%} is set:
            delete {art_voidcompass_pending::%{_u}%}
            send action bar "&cВозврат Компаса Пустоты отменён." to player
        else:
            send action bar "&7Компас Пустоты срабатывает автоматически после респавна." to player

command /voidcancel:
    aliases: /vccancel
    trigger:
        set {_u} to player's uuid
        if {art_voidcompass_pending::%{_u}%} is set:
            delete {art_voidcompass_pending::%{_u}%}
            send "{@prefix} &cВозврат Компаса Пустоты отменён." to player

# Ручная активация артефакта: только ПКМ предметом в руке
on right click:
    if player's tool is set:
        set {_n} to name of player's tool
        if {_n} does not contain "Артефакт:":
            if {_n} does not contain "Легендарный артефакт:":
                stop
        set {_key} to artifactKeyFromItemName({_n})
        if {_key} is "":
            dbgEvo(player, "artifact use: unknown key from item name %{_n}%")
            stop
        cancel event
        set {_u} to player's uuid
        if {art_found::%{_u}%::%{_key}%} is true:
            dbgEvo(player, "artifact use: already in core key=%{_key}%")
            send action bar "&eЭтот артефакт уже есть в ядре." to player
            stop
        if isLegendaryArtifact({_key}) is not true:
            if artifactCoreCount(player) >= 5:
                send "{@prefix} &cВ ядре максимум 5 обычных артефактов." to player
                play sound "entity.villager.no" with volume 0.8 and pitch 1 at player for player
                stop
        remove 1 of player's tool from player
        set {art_found::%{_u}%::%{_key}%} to true
        set {art_enabled::%{_u}%::%{_key}%} to true
        dbgEvo(player, "artifact absorbed by use: key=%{_key}% found=true enabled=true")
        send "{@prefix} &aАртефакт поглощён ядром: &f%{_n}%" to player
        send "{@prefix} &7Теперь его можно включать/выключать в &e/artifacts" to player
        play sound "ui.toast.challenge_complete" with volume 1 and pitch 1 at player for player
        stop

# Воздушный шарик: второй прыжок в воздухе
on toggle flight:
    if {ghost::%player's uuid%} is true:
        set flight mode of player to true
        stop
    if hasBalloonArtifact(player) is true:
        cancel event
        if gamemode of player is creative:
            stop
        if gamemode of player is spectator:
            stop
        set {_until} to {art_cloud_cd::%player's uuid%}
        if {_until} is set:
            if {_until} > now:
                send action bar "&7Воздушный шарик перезаряжается..." to player
                stop
        if {art_cloud_used::%player's uuid%} is true:
            stop
        set {art_cloud_used::%player's uuid%} to true
        set {art_cloud_fallimmune::%player's uuid%} to true
        set {art_cloud_fallimmune_until::%player's uuid%} to now + 4 seconds
        set {art_cloud_cd::%player's uuid%} to now + 1 second
        set flight mode of player to false
        set {_wloc} to location of player
        subtract 1 from y-coordinate of {_wloc}
        # Ветровой взрыв под носителем (визуал + импульс)
        play sound "entity.wind_charge.wind_burst" with volume 0.8 and pitch 1.1 at {_wloc} for all players
        push player upwards at speed 0.72
        send action bar "&f&lВОЗДУШНЫЙ ШАРИК!" to player
        stop

# Ледяной след: временный лёд под игроком
every 2 ticks:
    loop all players:
        # Легендарка Tank: "живая стена" — через танка нельзя пройти, но бить можно
        if classOf(loop-player) is "Tank":
            if hasArtifact(loop-player, "leg_tank") is true:
                for each {_tankWallEnt} in all living entities in radius 1.25 around loop-player:
                    if uuid of {_tankWallEnt} is not uuid of loop-player:
                        if {_tankWallEnt} is not an armor stand:
                            set {_dxWall} to x-coordinate of {_tankWallEnt} - x-coordinate of loop-player
                            set {_dzWall} to z-coordinate of {_tankWallEnt} - z-coordinate of loop-player
                            set {_lenWall} to sqrt((({_dxWall} * {_dxWall}) + ({_dzWall} * {_dzWall})))
                            if {_lenWall} <= 0.05:
                                set {_dxWall} to 0.1
                                set {_dzWall} to 0.1
                                set {_lenWall} to 0.141
                            set {_nlocWall} to location of {_tankWallEnt}
                            add ({_dxWall} / {_lenWall}) * 0.48 to x-coordinate of {_nlocWall}
                            add ({_dzWall} / {_lenWall}) * 0.48 to z-coordinate of {_nlocWall}
                            set {_feetWall} to block at {_nlocWall}
                            set {_headWall} to block above {_feetWall}
                            # Не только воздух: любой проходимый блок (трава, цветок, факел, знак…)
                            if {_feetWall} is passable:
                                if {_headWall} is passable:
                                    teleport {_tankWallEnt} to {_nlocWall}
        if hasArtifact(loop-player, "icewalker") is true:
            if gamemode of loop-player is not creative:
                if gamemode of loop-player is not spectator:
                    set {_b} to block below loop-player
                    set {_ok} to false
                    if {_b} is air:
                        set {_ok} to true
                    else if {_b} is water:
                        set {_ok} to true
                    else if "%type of {_b}%" is "minecraft:lava":
                        set {_ok} to true
                    if {_ok} is true:
                        set {_loc} to location of {_b}
                        set {_world} to name of world of {_loc}
                        set {_x} to floor(x-coordinate of {_loc})
                        set {_y} to floor(y-coordinate of {_loc})
                        set {_z} to floor(z-coordinate of {_loc})
                        set {_k} to "%{_world}%:%{_x}%:%{_y}%:%{_z}%"
                        if {art_ice_active::%{_k}%} is not true:
                            if {_b} is water:
                                set {art_ice_prev::%{_k}%} to "water"
                            else if "%type of {_b}%" is "minecraft:lava":
                                set {art_ice_prev::%{_k}%} to "lava"
                            else:
                                set {art_ice_prev::%{_k}%} to "air"
                            set {art_ice_active::%{_k}%} to true
                            execute console command "execute as %loop-player% at %loop-player% run setblock ~ ~-1 ~ packed_ice replace"
                            set {_k2} to {_k}
                            set {_world2} to {_world}
                            set {_x2} to {_x}
                            set {_y2} to {_y}
                            set {_z2} to {_z}
                            set {_owner} to loop-player
                            wait 35 ticks
                            if {art_ice_active::%{_k2}%} is true:
                                # Анти-rubberband: не убираем блок, пока кто-то стоит рядом
                                set {_occupied} to false
                                for each {_occP} in all players:
                                    if "%world of {_occP}%" is {_world2}:
                                        set {_px} to floor(x-coordinate of {_occP})
                                        set {_py} to floor(y-coordinate of {_occP})
                                        set {_pz} to floor(z-coordinate of {_occP})
                                        if {_px} is between {_x2} - 1 and {_x2} + 1:
                                            if {_py} is between {_y2} and {_y2} + 2:
                                                if {_pz} is between {_z2} - 1 and {_z2} + 1:
                                                    set {_occupied} to true
                                if {_occupied} is true:
                                    wait 15 ticks
                                set {_old} to {art_ice_prev::%{_k2}%}
                                if {_old} is set:
                                    execute console command "execute as %{_owner}% at %{_owner}% run setblock %{_x2}% %{_y2}% %{_z2}% %{_old}% replace"
                                else:
                                    execute console command "execute as %{_owner}% at %{_owner}% run setblock %{_x2}% %{_y2}% %{_z2}% air replace"
                                delete {art_ice_prev::%{_k2}%}
                                delete {art_ice_active::%{_k2}%}

# ---- Артефакты: боевые эффекты ----
on damage:
    # Корона Высшего Разума: зачарования работают на +1 уровень (боевой эквивалент).
    if attacker is a player:
        if hasArtifact(attacker, "crownmind") is true:
            if attacker's tool is enchanted with sharpness:
                add 1 to damage
            if projectile is set:
                if attacker's tool is enchanted with power:
                    set damage to damage * 1.1

    if victim is a player:
        if hasArtifact(victim, "crownmind") is true:
            set {_protBoost} to 0
            loop helmet, chestplate, leggings and boots of victim:
                if loop-value is enchanted with protection:
                    add 0.04 to {_protBoost}
            if {_protBoost} > 0:
                set damage to damage * (1 - {_protBoost})

    # Временная неуязвимость легендарки Scout
    if victim is a player:
        set {_vuImm} to victim's uuid
        set {_immUntil} to {leg_scout_immortal_until::%{_vuImm}%} ? 0
        if {_immUntil} > unix timestamp of now:
            cancel event
            stop

    # Гнилое яблоко: x2 урон по нейтральным животным (раньше вложенных damage victim, иначе set damage ломается)
    if attacker is a player:
        if hasArtifact(attacker, "rottenapple") is true:
            if victim is a cow:
                set damage to damage * 2
            else if victim is a sheep:
                set damage to damage * 2
            else if victim is a pig:
                set damage to damage * 2
            else if victim is a chicken:
                set damage to damage * 2
            else if victim is a rabbit:
                set damage to damage * 2

    # Легендарка Warrior: Печать Пространственного Разреза
    # Тип оружия — как у бонуса L1 воина: isSword() (любой материал) + булава 1.21
    if attacker is a player:
        if classOf(attacker) is "Warrior":
            if hasArtifact(attacker, "leg_warrior") is true:
                if levelOf(attacker) < 20:
                    if isNetherite(attacker's tool) is true:
                        stop
                if victim is a living entity:
                    if victim is not attacker:
                        if warriorLegMeleeWeapon(attacker) is true:
                            set {_slash} to damage * 0.4
                            if {_slash} < 1:
                                set {_slash} to 1
                            damage victim by {_slash}
                            set {_vlocSlash} to location of victim
                            execute console command "particle minecraft:sweep_attack %x-coordinate of {_vlocSlash}% %y-coordinate of {_vlocSlash}% %z-coordinate of {_vlocSlash}% 0.25 0.25 0.25 0 4 force"
                            send action bar "&6&lПРОСТРАНСТВЕННЫЙ РАЗРЕЗ!" to attacker
                            loop all living entities in radius 10 around attacker:
                                if loop-entity is not attacker:
                                    if loop-entity is not victim:
                                        if distance between loop-entity and victim <= 2.5:
                                            damage loop-entity by {_slash}

    # Кольцо Ветра: +15% урона в бою
    if attacker is a player:
        set {_auCore} to attacker's uuid
        if {class::%{_auCore}%} is "Necromancer":
            if hasArtifact(attacker, "leg_necro") is true:
                if victim is a living entity:
                    set {art_leg_necro_focus::%{_auCore}%} to "%uuid of victim%"
        if hasArtifact(attacker, "windring") is true:
            set damage to damage * 1.15
        if hasArtifact(attacker, "vampcharm") is true:
            heal attacker by damage * 0.25

    # Бритва Мерунеса: шанс казни 2% (кроме боссов и игроков)
    if attacker is a player:
        if hasArtifact(attacker, "mehrunes") is true:
            if victim is a living entity:
                if victim is not a player:
                    if victim is not an ender dragon:
                        if victim is not a wither:
                            if victim is not a warden:
                                chance of 13.33%:
                                    set health of victim to 0
                                    send action bar "&4&lКАЗНЬ!" to attacker
                                    play sound "entity.evoker.cast_spell" with volume 1 and pitch 0.6 at attacker for attacker

    # Звёздная ярость: комета по области при ударах мечом
    if attacker is a player:
        if hasArtifact(attacker, "starfury") is true:
            chance of 35%:
                set {_vloc} to location of victim
                # Только визуальный эффект молнии (без реального удара)
                strike lightning effect at {_vloc}
                # Основная цель получает бонус, равный базовому урону (x2 суммарно)
                set {_bonus} to damage
                if {_bonus} < 1:
                    set {_bonus} to 1
                damage victim by {_bonus}
                ignite victim for 5 seconds
                play sound "entity.generic.explode" with volume 1 and pitch 1.15 at {_vloc} for all players
                loop all living entities in radius 4 around {_vloc}:
                    if loop-entity is not attacker:
                        if loop-entity is not victim:
                            damage loop-entity by 6
                            ignite loop-entity for 4 seconds
                send action bar "&f&lКОМЕТА!" to attacker
    # Сердце ледяного великана: замедляет атакующего
    if victim is a player:
        if hasArtifact(victim, "frostheart") is true:
            if attacker is a living entity:
                remove slowness from attacker
                remove mining fatigue from attacker
                apply slowness 2 without particles to attacker for 15 seconds
                apply mining fatigue 1 without particles to attacker for 15 seconds

    # Легендарка Scout: Тень Фантома
    if victim is a player:
        set {_vuScout} to victim's uuid
        if {class::%{_vuScout}%} is "Scout":
            if hasArtifact(victim, "leg_scout") is true:
                if attacker is a living entity:
                    set {_cdScout} to {art_leg_scout_cd::%{_vuScout}%} ? 0
                    set {_nowScout} to unix timestamp of now
                    if {_nowScout} >= {_cdScout}:
                        chance of 25%:
                            set {_fromScout} to location of victim
                            cancel event
                            set {_toScout} to {_fromScout}
                            set {_foundScout} to false
                            loop 8 times:
                                if {_foundScout} is false:
                                    set {_candScout} to location of victim
                                    set {_dxScout} to random integer between -5 and 5
                                    set {_dzScout} to random integer between -5 and 5
                                    if {_dxScout} is 0:
                                        if {_dzScout} is 0:
                                            set {_dxScout} to 1
                                    add {_dxScout} to x-coordinate of {_candScout}
                                    add {_dzScout} to z-coordinate of {_candScout}
                                    add 0.2 to y-coordinate of {_candScout}
                                    set {_feetScout} to block at {_candScout}
                                    set {_headScout} to block above {_feetScout}
                                    set {_groundScout} to block below {_candScout}
                                    if {_feetScout} is air:
                                        if {_headScout} is air:
                                            if {_groundScout} is not air:
                                                if "%type of {_groundScout}%" is not "minecraft:lava":
                                                    set {_toScout} to {_candScout}
                                                    set {_foundScout} to true
                            if {_foundScout} is true:
                                teleport victim to {_toScout}
                            set {leg_scout_saved_helm::%{_vuScout}%} to helmet of victim
                            set {leg_scout_saved_chest::%{_vuScout}%} to chestplate of victim
                            set {leg_scout_saved_legs::%{_vuScout}%} to leggings of victim
                            set {leg_scout_saved_boots::%{_vuScout}%} to boots of victim
                            set {_hadAnyArmor} to false
                            if {leg_scout_saved_helm::%{_vuScout}%} is not air:
                                set {_hadAnyArmor} to true
                            if {leg_scout_saved_chest::%{_vuScout}%} is not air:
                                set {_hadAnyArmor} to true
                            if {leg_scout_saved_legs::%{_vuScout}%} is not air:
                                set {_hadAnyArmor} to true
                            if {leg_scout_saved_boots::%{_vuScout}%} is not air:
                                set {_hadAnyArmor} to true
                            set helmet of victim to air
                            set chestplate of victim to air
                            set leggings of victim to air
                            set boots of victim to air
                            ignite victim for 0 seconds
                            set {leg_scout_immortal_until::%{_vuScout}%} to (unix timestamp of now) + 3
                            apply invisibility without particles to victim for 3 seconds
                            apply speed 3 without particles to victim for 3 seconds
                            if {_hadAnyArmor} is true:
                                spawnScoutPhantomDecoy(victim, {_fromScout}, false, {leg_scout_saved_helm::%{_vuScout}%}, {leg_scout_saved_chest::%{_vuScout}%}, {leg_scout_saved_legs::%{_vuScout}%}, {leg_scout_saved_boots::%{_vuScout}%})
                            else:
                                spawnScoutPhantomDecoy(victim, {_fromScout}, true, air, air, air, air)
                            set {art_leg_scout_cd::%{_vuScout}%} to {_nowScout} + 8
                            send action bar "&6&lТЕНЬ ФАНТОМА!" to victim
                            wait 3 seconds
                            if victim is online:
                                if uuid of victim is {_vuScout}:
                                    if {_hadAnyArmor} is true:
                                        set helmet of victim to {leg_scout_saved_helm::%{_vuScout}%}
                                        set chestplate of victim to {leg_scout_saved_chest::%{_vuScout}%}
                                        set leggings of victim to {leg_scout_saved_legs::%{_vuScout}%}
                                        set boots of victim to {leg_scout_saved_boots::%{_vuScout}%}
                            delete {leg_scout_saved_helm::%{_vuScout}%}
                            delete {leg_scout_saved_chest::%{_vuScout}%}
                            delete {leg_scout_saved_legs::%{_vuScout}%}
                            delete {leg_scout_saved_boots::%{_vuScout}%}
                            delete {leg_scout_immortal_until::%{_vuScout}%}
                            stop

    # Легендарка Tank: Якорь Мироздания (ударная волна при падении)
    if victim is a player:
        set {_vuTank} to victim's uuid
        if {class::%{_vuTank}%} is "Tank":
            if hasArtifact(victim, "leg_tank") is true:
                if damage cause is fall:
                    if victim's fall distance <= 8:
                        stop
                    delete {art_cloud_fallimmune::%{_vuTank}%}
                    delete {art_cloud_fallimmune_until::%{_vuTank}%}
                    set {_fd} to victim's fall distance
                    if {_fd} < 3:
                        set {_fd} to 3
                    # Нерф: меньше базовый множитель, урон снижается бронёй как обычный melee-hit
                    set {_shockDmg} to round({_fd} * 0.35)
                    if {_shockDmg} < 2:
                        set {_shockDmg} to 2
                    if {_shockDmg} > 8:
                        set {_shockDmg} to 8
                    set {_pushY} to 0.6 + ({_fd} * 0.03)
                    if {_pushY} > 1.4:
                        set {_pushY} to 1.4
                    cancel event
                    execute console command "execute as %victim% at %victim% run particle minecraft:explosion_emitter ~ ~1 ~ 0 0 0 0 1 force"
                    execute console command "execute as %victim% at %victim% run particle minecraft:cloud ~ ~0.2 ~ 0.7 0.2 0.7 0.02 35 force"
                    execute console command "execute as %victim% at %victim% run particle minecraft:poof ~ ~0.2 ~ 1.2 0.25 1.2 0.03 45 force"
                    loop all living entities in radius 10 around victim:
                        if loop-entity is not victim:
                            execute console command "execute as %victim% at %victim% run particle minecraft:cloud %x-coordinate of loop-entity% %y-coordinate of loop-entity% %z-coordinate of loop-entity% 0.25 0.1 0.25 0.01 8 force"
                            set {leg_tank_wave_killer::%uuid of loop-entity%} to uuid of victim
                            damage loop-entity by {_shockDmg} with fake damage cause entity attack
                            delete {leg_tank_wave_killer::%uuid of loop-entity%}
                            if victim is a player:
                                tagCombat(victim)
                            if loop-entity is a player:
                                tagCombat(loop-entity)
                            push loop-entity upwards at speed {_pushY}
                    loop blocks in radius 3 around victim:
                        if loop-block is glass:
                            set loop-block to air
                        if "%type of loop-block%" contains "leaves":
                            set loop-block to air
                    play sound "entity.generic.explode" with volume 0.9 and pitch 0.7 at victim for all players
                    send action bar "&6&lЯКОРЬ МИРОЗДАНИЯ!" to victim
                    stop

    # Легендарка Necromancer: нежить не атакует первой (утопленник, хаск, stray, bogged и др.)
    if victim is a player:
        set {_vuNec} to victim's uuid
        if {class::%{_vuNec}%} is "Necromancer":
            if hasArtifact(victim, "leg_necro") is true:
                if attacker is a living entity:
                    if isLegNecroPacifiedUndead(attacker) is true:
                        cancel event
                        stop

    # Эфирный телепорт: при входящем уроне от сущности телепортирует и отменяет урон
    if victim is a player:
        if hasArtifact(victim, "etherdash") is true:
            if attacker is not a living entity:
                stop
            set {_vu} to victim's uuid
            set {_now} to unix timestamp of now
            set {_cd} to {art_etherdash_cd::%{_vu}%} ? 0
            if {_now} < {_cd}:
                stop
            # Смертельный удар + тотем в руке — не отменять (иначе тотем не сработает)
            if damage >= victim's health:
                if playerHoldsTotemOfUndying(victim) is true:
                    stop
            # Снимаем урон от самого попадания
            cancel event
            # Короткий иммун к урону после телепорта
            set {art_etherdash_immune_until::%{_vu}%} to {_now} + 2
            set {art_etherdash_cd::%{_vu}%} to {_now} + 20
            set {_from} to location of victim
            set {_to} to {_from}
            set {_foundSafe} to false
            loop 8 times:
                if {_foundSafe} is false:
                    set {_cand} to location of victim
                    set {_dx} to random integer between -5 and 5
                    set {_dz} to random integer between -5 and 5
                    if {_dx} is 0:
                        if {_dz} is 0:
                            set {_dx} to 1
                    add {_dx} to x-coordinate of {_cand}
                    add {_dz} to z-coordinate of {_cand}
                    add 0.2 to y-coordinate of {_cand}
                    set {_feet} to block at {_cand}
                    set {_head} to block above {_feet}
                    set {_ground} to block below {_cand}
                    if {_feet} is air:
                        if {_head} is air:
                            if {_ground} is not air:
                                if "%type of {_ground}%" is not "minecraft:lava":
                                    set {_to} to {_cand}
                                    set {_foundSafe} to true
            if {_foundSafe} is true:
                teleport victim to {_to}
            execute console command "particle minecraft:portal %x-coordinate of {_from}% %y-coordinate of {_from}% %z-coordinate of {_from}% 0.35 0.5 0.35 0 45 force"
            if {_foundSafe} is true:
                execute console command "particle minecraft:portal %x-coordinate of {_to}% %y-coordinate of {_to}% %z-coordinate of {_to}% 0.35 0.5 0.35 0 45 force"
            play sound "entity.enderman.teleport" with volume 0.9 and pitch 1.35 at victim for all players
            if {_foundSafe} is true:
                send action bar "&d&lЭФИРНЫЙ ТЕЛЕПОРТ!" to victim
            else:
                send action bar "&d&lЭФИРНЫЙ ЩИТ!" to victim
            stop

    # Эфирный телепорт: короткий иммун после срабатывания
    if victim is a player:
        set {_ivu} to victim's uuid
        set {_iuntil} to {art_etherdash_immune_until::%{_ivu}%} ? 0
        if {_iuntil} > unix timestamp of now:
            cancel event
            stop

# ---- Артефакты: смерть/заряды/награды ----
on death of player:
    set {art_last_death::%victim's uuid%} to location of victim

on respawn:
    set {_u} to player's uuid
    if hasArtifact(player, "voidcompass") is true:
        set {_nowVc} to unix timestamp of now
        set {_cdVc} to {art_voidcompass_cd::%{_u}%} ? 0
        if {_nowVc} < {_cdVc}:
            stop
        set {_base} to {art_last_death::%{_u}%}
        if {_base} is set:
            add 1 to {art_voidcompass_nonce::%{_u}%}
            set {_nonce} to {art_voidcompass_nonce::%{_u}%}
            set {art_voidcompass_pending::%{_u}%} to {_nonce}
            send "{@prefix} &8Компас Пустоты: &7возврат к месту смерти через &f10с&7..." to player
            send action bar "&7ПКМ компасом или /voidcancel: &cотменить возврат" to player
            execute console command "execute as %player% run tellraw @s [{""text"":""[Evo] "",""color"":""aqua"",""bold"":true},{""text"":""Компас Пустоты: "",""color"":""dark_gray""},{""text"":""[ОТМЕНИТЬ ВОЗВРАТ]"",""color"":""red"",""underlined"":true,""clickEvent"":{""action"":""run_command"",""value"":""/voidcancel""}}]"
            wait 10 seconds
            if player is online:
                if {art_voidcompass_pending::%{_u}%} is not {_nonce}:
                    stop
                set {_safe} to location of player
                set {_found} to false
                # Ищем безопасную точку в радиусе 10
                loop blocks in radius 10 around {_base}:
                    if {_found} is false:
                        if loop-block is not air:
                            set {_above} to block above loop-block
                            set {_above2} to block above {_above}
                            if {_above} is air:
                                if {_above2} is air:
                                    set {_safe} to location of {_above}
                                    set {_found} to true
                teleport player to {_safe}
                delete {art_voidcompass_pending::%{_u}%}
                set {art_voidcompass_cd::%{_u}%} to (unix timestamp of now) + 300
                play sound "entity.enderman.teleport" with volume 1 and pitch 0.9 at player for all players
                send title "&8&lКОМПАС ПУСТОТЫ" with subtitle "&7Возврат к месту гибели" to player for 2 seconds

on death:
    if attacker is a player:
        set {_u} to attacker's uuid

        # Звезда Азуры: заряд от убийств
        if hasArtifact(attacker, "azura") is true:
            add 1 to {art_azura_charge::%{_u}%}
            if {art_azura_charge::%{_u}%} > 200:
                set {art_azura_charge::%{_u}%} to 200

        # Монета удачи: шанс бонусного ресурса
        if hasArtifact(attacker, "luckcoin") is true:
            chance of 25%:
                set {_roll} to random integer between 1 and 4
                if {_roll} is 1:
                    drop 2 emerald at location of victim
                else if {_roll} is 2:
                    drop 3 gold ingot at location of victim
                else if {_roll} is 3:
                    drop 1 diamond at location of victim
                else:
                    drop 4 iron ingot at location of victim
                send action bar "&6&lМОНЕТА УДАЧИ! &7Бонусный лут выпал" to attacker

on pickup:
    if event-item is set:
        set {_nm} to name of event-item
        if {_nm} does not contain "Артефакт:":
            if {_nm} does not contain "Легендарный артефакт:":
                stop
        set {_key} to artifactKeyFromItemName({_nm})
        dbgEvo(player, "artifact pickup: key=%{_key}% item=%{_nm}%")
        if {_key} is not "":
            send "{@prefix} &eНайден артефакт-предмет: &f%{_nm}%" to player
            send "{@prefix} &7Чтобы зачислить в ядро, возьми его в руку и нажми &fПКМ&7." to player

# ----- Главная функция: открыть chest GUI -----
function openStatsMenu(viewer: player, target: player):
    set {_u} to uuid of {_target}
    set {_c} to {class::%{_u}%} ? "None"
    set {_l} to {level::%{_u}%} ? 1
    set {_k} to {kills::%{_u}%} ? 0
    set {_tk} to {total_kills::%{_u}%} ? 0
    set {_role} to classRoleName({_c})
    set {_rc} to roleColor({_role})
    set {_clsDisp} to classDisplayName({_c})

    open chest inventory with 6 rows named "&8&l⚜ Stats: %{_target}%" to {_viewer}
    wait 2 ticks

    # ----- декоративный фон -----
    loop 54 times:
        set slot (loop-number - 1) of {_viewer}'s current inventory to gray stained glass pane named " "
    loop 9 times:
        set slot (loop-number - 1) of {_viewer}'s current inventory to black stained glass pane named " "
        set slot (loop-number + 44) of {_viewer}'s current inventory to black stained glass pane named " "

    # ===== Slot 4: голова игрока =====
    set {_head} to player head
    set name of {_head} to "&e&l%{_target}%"
    if {_c} is "None":
        set lore of {_head} to "&7Класс: &fНет", "&7Уровень: &e%{_l}%", "&7Killов всего: &b%{_tk}%"
    else:
        set lore of {_head} to "&7Класс: %{_clsDisp}%", "&7Роль: %{_rc}%%{_role}%", "&7Уровень: &e%{_l}%&7/&625", "&7Killов всего: &b%{_tk}%"
    set slot 4 of {_viewer}'s current inventory to {_head}

    # ===== Slot 11: Класс =====
    if {_c} is "None":
        set {_noClass} to barrier
        set name of {_noClass} to "&7Класс: &fНет"
        set lore of {_noClass} to "&8Используй &e/class &8чтобы выбрать"
        set slot 11 of {_viewer}'s current inventory to {_noClass}
    else:
        set {_ci} to classIcon({_c})
        set name of {_ci} to "&6&l☆ %{_clsDisp}%"
        set {_l10} to classL10Bonus({_c})
        delete {_clore::*}
        add "%{_rc}%Роль: &l%{_role}%" to {_clore::*}
        loop classPlaystyle({_c}):
            add loop-value to {_clore::*}
        add " " to {_clore::*}
        add {_l10} to {_clore::*}
        add " " to {_clore::*}
        add "&8/class — сменить класс" to {_clore::*}
        set lore of {_ci} to {_clore::*}
        set slot 11 of {_viewer}'s current inventory to {_ci}

    # ===== Slot 13: Уровень / XP =====
    set {_xpItem} to experience bottle
    if {_l} >= 25:
        set name of {_xpItem} to "&6&l✪ Уровень: &eMAX (25)"
        set lore of {_xpItem} to "&7Killов всего: &b%{_tk}%", "&aМаксимальный уровень достигнут!"
    else:
        set {_kForLvl} to floor({_k} / 2) * 2
        set {_kInLvl} to {_k} - {_kForLvl}
        set {_kNeed} to 2 - {_kInLvl}
        set name of {_xpItem} to "&e&l⬆ Уровень: &6%{_l}% &7/ &e25"
        set lore of {_xpItem} to "&7XP: &a%{_k}%&7/&f49 killов", "&7Killов всего: &b%{_tk}%", " ", "&7До след. уровня: &e%{_kNeed}% &7killов"
    set slot 13 of {_viewer}'s current inventory to {_xpItem}

    # ===== Slot 15: Роль =====
    if {_c} is "None":
        set {_noRole} to paper
        set name of {_noRole} to "&7Роль: &fНе выбрана"
        set slot 15 of {_viewer}'s current inventory to {_noRole}
    else:
        set {_ri} to roleIcon({_role})
        set name of {_ri} to "%{_rc}%&l%{_role}%"
        set lore of {_ri} to roleDescription({_role})
        set slot 15 of {_viewer}'s current inventory to {_ri}

    # ===== Slot 20: Primary ability =====
    if {_c} is "None":
        set {_pBar} to barrier
        set name of {_pBar} to "&cНет способности"
        set lore of {_pBar} to "&8Выбери класс"
        set slot 20 of {_viewer}'s current inventory to {_pBar}
    else:
        set {_pi} to blaze powder
        set name of {_pi} to "&6&l▶ Primary"
        set {_pAbil} to classAbilityName({_c}, "primary")
        set lore of {_pi} to "%{_pAbil}%", " ", "&7Главная способность класса", "&8Активируется автоматически или ПКМ"
        set slot 20 of {_viewer}'s current inventory to {_pi}

    # ===== Slot 22: Перк =====
    if {_l} < 15:
        set {_perkLocked} to red stained glass pane
        set name of {_perkLocked} to "&7Перк: &cЗаблокирован"
        set lore of {_perkLocked} to "&8Откроется на &615 уровне", "&7Сейчас: &eL%{_l}%"
        set slot 22 of {_viewer}'s current inventory to {_perkLocked}
    else:
        if {perk::%{_u}%} is set:
            set {_pid} to {perk::%{_u}%}
            set {_perkItem} to perkIcon({_pid})
            set {_perkN} to perkName({_pid})
            set name of {_perkItem} to "%{_perkN}%"
            delete {_perkLore::*}
            loop perkDesc({_pid}):
                add loop-value to {_perkLore::*}
            add " " to {_perkLore::*}
            add "&8/perk — сменить (откатит до L15)" to {_perkLore::*}
            set lore of {_perkItem} to {_perkLore::*}
            set slot 22 of {_viewer}'s current inventory to {_perkItem}
        else:
            set {_perkPick} to nether star
            set name of {_perkPick} to "&6&l⚡ Перк не выбран!"
            set lore of {_perkPick} to "&eИспользуй &6/perk &eчтобы выбрать", "&8Один из 4 на класс"
            set slot 22 of {_viewer}'s current inventory to {_perkPick}

    # ===== Slot 24: Secondary ability =====
    if {_c} is "None":
        set {_sBar} to barrier
        set name of {_sBar} to "&cНет способности"
        set lore of {_sBar} to "&8Выбери класс"
        set slot 24 of {_viewer}'s current inventory to {_sBar}
    else:
        set {_si} to nether star
        set name of {_si} to "&b&l◢ Secondary"
        set {_sAbil} to classAbilityName({_c}, "secondary")
        set lore of {_si} to "%{_sAbil}%", " ", "&7Вторая способность класса", "&8Раскрывается с уровнем"
        set slot 24 of {_viewer}'s current inventory to {_si}

    # ===== Slot 26: Legendary =====
    if {_c} is "None":
        set {_lg} to barrier
        set name of {_lg} to "&6Легендарный артефакт"
        set lore of {_lg} to "&7Недоступно без класса", "&8Сначала выбери класс"
    else:
        set {_lgKey} to classLegendaryKey({_target})
        if {_lgKey} is "":
            set {_lg} to barrier
            set name of {_lg} to "&6Легендарный артефакт"
            set lore of {_lg} to "&7Для этого класса легендарка не найдена"
        else:
            set {_lgSlot} to artifactSlotFromKey({_lgKey})
            set {_lg} to artifactFromSlot({_lgSlot})
            if {_lg} is air:
                set {_lg} to barrier
                set name of {_lg} to "&6Легендарный артефакт"
                set lore of {_lg} to "&7Ошибка отображения легендарки"
            else:
                set {_ownedLg} to {art_found::%{_u}%::%{_lgKey}%} ? false
                set {_onLg} to {art_enabled::%{_u}%::%{_lgKey}%} ? false
                if {_ownedLg} is true:
                    if {_onLg} is true:
                        set name of {_lg} to "&a[ON] %name of {_lg}%"
                    else:
                        set name of {_lg} to "&c[OFF] %name of {_lg}%"
                else:
                    set name of {_lg} to "&8[НЕ НАЙДЕН] %name of {_lg}%"
                set lore of {_lg} to artifactDesc({_lgKey})
                add " " to lore of {_lg}
                add "&eКлик: открыть /legendary" to lore of {_lg}
    set slot 26 of {_viewer}'s current inventory to {_lg}

    # ===== Row 4 (28..34): Оружие =====
    set {_swLvl} to {wlvl::%{_u}%::sword} ? 1
    set {_axLvl} to {wlvl::%{_u}%::axe} ? 1
    set {_bwLvl} to {wlvl::%{_u}%::bow} ? 1
    set {_mcLvl} to {wlvl::%{_u}%::mace} ? 1
    set {_swXp} to {wxp::%{_u}%::sword} ? 0
    set {_axXp} to {wxp::%{_u}%::axe} ? 0
    set {_bwXp} to {wxp::%{_u}%::bow} ? 0
    set {_mcXp} to {wxp::%{_u}%::mace} ? 0

    set {_swItem} to iron sword
    set name of {_swItem} to "&cМеч &8» &eLv %{_swLvl}%"
    set {_swNeed} to wXPNeeded({_swLvl})
    set {_swBonus} to ({_swLvl} - 1) * 6
    set lore of {_swItem} to "&7Бонус урона: &a+%{_swBonus}%%%", "&7XP: &b%{_swXp}%&7/&f%{_swNeed}%"
    set slot 28 of {_viewer}'s current inventory to {_swItem}

    set {_axItem} to iron axe
    set name of {_axItem} to "&6Топор &8» &eLv %{_axLvl}%"
    set {_axNeed} to wXPNeeded({_axLvl})
    set {_axBonus} to ({_axLvl} - 1) * 6
    set lore of {_axItem} to "&7Бонус урона: &a+%{_axBonus}%%%", "&7XP: &b%{_axXp}%&7/&f%{_axNeed}%"
    set slot 30 of {_viewer}'s current inventory to {_axItem}

    set {_bwItem} to bow
    set name of {_bwItem} to "&aЛук &8» &eLv %{_bwLvl}%"
    set {_bwNeed} to wXPNeeded({_bwLvl})
    set {_bwBonus} to ({_bwLvl} - 1) * 6
    set lore of {_bwItem} to "&7Бонус урона: &a+%{_bwBonus}%%%", "&7XP: &b%{_bwXp}%&7/&f%{_bwNeed}%"
    set slot 32 of {_viewer}'s current inventory to {_bwItem}

    set {_mcItem} to mace
    set name of {_mcItem} to "&5Булава &8» &eLv %{_mcLvl}%"
    set {_mcNeed} to wXPNeeded({_mcLvl})
    set {_mcBonus} to ({_mcLvl} - 1) * 6
    set lore of {_mcItem} to "&7Бонус урона: &a+%{_mcBonus}%%%", "&7XP: &b%{_mcXp}%&7/&f%{_mcNeed}%"
    set slot 34 of {_viewer}'s current inventory to {_mcItem}

    # ===== Row 5 (37..43): 7 milestones (L1, L5, L8, L10★, L15, L20, L25) =====
    if {_c} is not "None":
        set {_lvls::1} to 1
        set {_lvls::2} to 5
        set {_lvls::3} to 8
        set {_lvls::4} to 10
        set {_lvls::5} to 15
        set {_lvls::6} to 20
        set {_lvls::7} to 25
        set {_mslot::1} to 37
        set {_mslot::2} to 38
        set {_mslot::3} to 39
        set {_mslot::4} to 40
        set {_mslot::5} to 41
        set {_mslot::6} to 42
        set {_mslot::7} to 43
        loop 7 times:
            set {_idx} to loop-number
            set {_lreq} to {_lvls::%{_idx}%}
            set {_sl} to {_mslot::%{_idx}%}
            if {_lreq} is 10:
                set {_descRaw} to classL10Bonus({_c})
                set {_desc} to "%{_descRaw}%"
                replace "&aL10: " with "" in {_desc}
            else:
                set {_desc} to milestoneDesc({_c}, {_lreq})
            if {_l} >= {_lreq}:
                set {_pane} to lime stained glass pane
                set name of {_pane} to "&a✔ &fLv %{_lreq}%"
                set lore of {_pane} to "&f%{_desc}%", " ", "&aОТКРЫТО"
                set slot {_sl} of {_viewer}'s current inventory to {_pane}
            else:
                set {_pane} to red stained glass pane
                set name of {_pane} to "&c✘ &7Lv %{_lreq}%"
                set lore of {_pane} to "&7%{_desc}%", " ", "&cЗакрыто &8(%{_l}%/%{_lreq}%)"
                set slot {_sl} of {_viewer}'s current inventory to {_pane}
    set {_label} to nether star
    set name of {_label} to "&6&lПрокачка класса"
    set lore of {_label} to "&7Тиры: &fL1 L5 L8 &aL10★ &fL15 L20 L25", "&8Открываются по уровню"
    set slot 36 of {_viewer}'s current inventory to {_label}

    # ===== Slot 44: Дуо =====
    if inDuo({_target}) is true:
        set {_partner} to duoPartner({_target})
        set {_duoItem} to player head
        set name of {_duoItem} to "&aДуо: &f%{_partner}%"
        set lore of {_duoItem} to "&7Партнёр в дуо", "&8Многие способности усиливаются"
        set slot 44 of {_viewer}'s current inventory to {_duoItem}
    else:
        set {_noDuo} to compass
        set name of {_noDuo} to "&7Дуо: &cнет"
        set lore of {_noDuo} to "&8/duo <ник> — пригласить", "&8Многие классы получают бонусы в дуо"
        set slot 44 of {_viewer}'s current inventory to {_noDuo}

    # ===== Slot 49: Закрыть =====
    set {_closeBtn} to barrier
    set name of {_closeBtn} to "&c&lЗакрыть"
    set slot 49 of {_viewer}'s current inventory to {_closeBtn}


command /stats [<player>]:
    aliases: /stat, /info
    trigger:
        set {_t} to player
        if arg-1 is set:
            set {_t} to arg-1
        openStatsMenu(player, {_t})

# ----- Клик / drag в меню /stats -----
on inventory click:
    if name of event-inventory contains "Stats:":
        cancel event
        if clicked inventory is not player's current inventory:
            stop
        set {_s} to index of event-slot
        if {_s} is 49:
            close player's inventory
        else if {_s} is 11:
            close player's inventory
            wait 2 ticks
            make player execute command "/class"
        else if {_s} is 22:
            close player's inventory
            wait 2 ticks
            make player execute command "/perk"
        else if {_s} is 28 or 30 or 32 or 34:
            close player's inventory
            wait 2 ticks
            make player execute command "/wstats"
        else if {_s} is 26:
            close player's inventory
            wait 2 ticks
            make player execute command "/legendary"

on inventory drag:
    if name of event-inventory contains "Stats:":
        cancel event


# ==========================================
# ОГРАНИЧЕНИЕ ЭКИПИРОВКИ ПО УРОВНЮ
# ==========================================

# --- СНЯТИЕ БРОНИ ПРИ ПОПЫТКЕ НАДЕТЬ (on armor change) ---
on armor change:
    set {_u} to player's uuid
    set {_l} to {level::%{_u}%} ? 1

    # 1. ПРОВЕРКА ЭЛИТР (15 УРОВЕНЬ)
    if event-item is elytra:
        if {_l} < 15:
            wait 1 tick
            if player's chestplate is elytra:
                set player's chestplate to air
                if player has space for elytra:
                    give elytra to player
                    send action bar "&eЭлитры сняты (нужен 15 уровень)" to player
                else:
                    drop elytra at player
                    send action bar "&cМеста нет! Элитры упали рядом" to player

    # 2. ПРОВЕРКА НЕЗЕРИТА (20 УРОВЕНЬ)
    if isNetherite(event-item) is true:
        if {_l} < 20:
            wait 1 tick
            # Проходим по всем слотам брони, чтобы снять всё нелегальное
            loop helmet, chestplate, leggings and boots of player:
                if isNetherite(loop-value) is true:
                    set {_bad_item} to loop-value
                    if loop-value is player's helmet:
                        set player's helmet to air
                    else if loop-value is player's chestplate:
                        set player's chestplate to air
                    else if loop-value is player's leggings:
                        set player's leggings to air
                    else if loop-value is player's boots:
                        set player's boots to air
                    
                    if player has space for {_bad_item}:
                        give {_bad_item} to player
                        send action bar "&eНезерит снят (нужен 20 уровень)" to player
                    else:
                        drop {_bad_item} at player

# --- ЗАПРЕТ ИСПОЛЬЗОВАНИЯ ЭЛИТР В ВОЗДУХЕ ---
on flight toggle:
    if player is wearing elytra:
        if {level::%player's uuid%} < 15:
            cancel event
            set player's gliding state to false
            send action bar "&cВы еще не умеете летать!" to player

# --- SCOUT Перк C "Парашют" — Shift в воздухе при падении >5 → Slow Falling 5с (КД 30с) ---
on toggle sneak:
    if player is not sneaking:
        stop
    set {_u} to player's uuid
    if {class::%{_u}%} is "Scout":
        if {perk::%{_u}%} is "scout_C":
            if {scout_parachute_cd::%{_u}%} ? 0 > 0:
                stop
            if player's fall distance > 5:
                if block below player is air:
                    apply slow falling 1 without particles to player for 5 seconds
                    set {scout_parachute_cd::%{_u}%} to 30
                    play sound "entity.phantom.flap" with volume 1 and pitch 1.2 at player for player
                    send action bar "&f&lПАРАШЮТ!" to player

# --- MAGE Перк B "Ледяной взрыв" / ARCHER Перк D "Рикошет" — на попадание снаряда ---
on damage:
    projectile is set
    set {_proj} to projectile
    set {_shooter} to shooter
    if {_shooter} is a player:
        set {_su} to {_shooter}'s uuid
        # Mage_B: малый/большой фаербол → AoE Slowness III 6с в радиусе 4
        if {perk::%{_su}%} is "mage_B":
            if "%{_proj}%" contains "fireball":
                if victim is a living entity:
                    set {_hit} to location of victim
                    play sound "block.glass.break" with volume 1 and pitch 1.5 at {_hit} for all players
                    execute console command "particle minecraft:snowflake %x-coordinate of {_hit}% %y-coordinate of {_hit}% %z-coordinate of {_hit}% 0.35 0.35 0.35 0.05 30 force"
                    loop all living entities in radius 4 around {_hit}:
                        if loop-entity is not {_shooter}:
                            apply slowness 3 without particles to loop-entity for 6 seconds
                    send action bar "&b&lЛЕДЯНОЙ ВЗРЫВ!" to {_shooter}
        # Archer_D: стрела наносит 75% урона ближайшему другому врагу в радиусе 6
        if {perk::%{_su}%} is "archer_D":
            if {_proj} is an arrow:
                if victim is a living entity:
                    if {archer_ricochet_lock::%uuid of {_proj}%} is not set:
                        set {archer_ricochet_lock::%uuid of {_proj}%} to true
                        set {_orig_dmg} to damage
                        set {_hit2} to location of victim
                        set {_chain_dmg} to {_orig_dmg} * 0.75
                        loop all living entities in radius 6 around {_hit2}:
                            if loop-entity is not {_shooter}:
                                if loop-entity is not victim:
                                    if loop-entity is a player or a monster:
                                        damage loop-entity by {_chain_dmg} with fake damage cause entity attack
                                        play sound "entity.arrow.hit" with volume 1 and pitch 1.4 at loop-entity for all players
                                        send action bar "&d&lРИКОШЕТ!" to {_shooter}
                                        exit loop

# ==========================================
# СУПЕР ЗАПРЕТ НЕЗЕРИТОВЫХ ИНСТРУМЕНТОВ И ОРУЖИЯ (20 УРОВЕНЬ)
# ==========================================

# 1. Запрет атаковать мобов и игроков
on damage:
    if attacker is a player:
        set {_u} to attacker's uuid
        set {_l} to {level::%{_u}%} ? 1
        if {_l} < 20:
            if isNetherite(attacker's tool) is true:
                cancel event
                send action bar "&4&l✕ &cСлишком тяжелое оружие (нужен 20 лвл)!" to attacker

# 2. Запрет ломать любые блоки
on break:
    if isAwakeningAltarStructurePart(location of event-block) is true:
        cancel event
        send "{@prefix} &cАлтарь неразрушим." to player
        stop
    set {_altarPick} to false
    if isEtherPickaxe(player's tool) is true:
        set {_altarPick} to true
    else if isFlamePickaxe(player's tool) is true:
        set {_altarPick} to true
    else if isVeinPickaxe(player's tool) is true:
        set {_altarPick} to true
    else if isFortunePickaxe(player's tool) is true:
        set {_altarPick} to true
    else if isVoidPickaxe(player's tool) is true:
        set {_altarPick} to true
    else if isOmniPickaxe(player's tool) is true:
        set {_altarPick} to true
    if {_altarPick} is true:
        set {_b} to event-block
        # Реальная «неразрушимость» для серверов, где флаг unbreakable не применяется.
        set durability of player's tool to 99999
        set {_flameOn} to true
        set {_veinOn} to true
        set {_fortuneOn} to true
        set {_voidOn} to true
        if isEtherTrashBlock({_b}) is true:
            if {altar_pick_silk_mode::%uuid of player%} is true:
                cancel event
                set event-block to air
                giveAltarSilkBlockItem(player, {_b}, location of {_b})
                giveArtifactScaledExperience(player, 1)
                stop
            if {altar_ether_trash_mode::%uuid of player%} is not true:
                stop
            cancel event
            set event-block to air
            if isFlamePickaxe(player's tool) is true:
                if {_flameOn} is true:
                    set {_drop} to smooth stone
                    giveOrDrop({_drop}, player, location of {_b})
                if {_flameOn} is false:
                    set {_dust} to gunpowder
                    giveOrDrop({_dust}, player, location of {_b})
            if isFlamePickaxe(player's tool) is not true:
                if isVoidPickaxe(player's tool) is true:
                    if {_voidOn} is true:
                        set {_drop} to obsidian
                        giveOrDrop({_drop}, player, location of player)
                    if {_voidOn} is not true:
                        set {_dust} to gunpowder
                        giveOrDrop({_dust}, player, location of {_b})
                if isVoidPickaxe(player's tool) is not true:
                    set {_dust} to gunpowder
                    giveOrDrop({_dust}, player, location of {_b})
            giveArtifactScaledExperience(player, 1)
            stop
        if isEtherValuableOre({_b}) is true:
            cancel event
            set {_dropLoc} to location of {_b}
            set event-block to air
            if {altar_pick_silk_mode::%uuid of player%} is true:
                giveAltarSilkBlockItem(player, {_b}, {_dropLoc})
                giveAltarSilkOreXp(player, {_b})
                stop
            if {_b} is diamond ore:
                set {_cnt} to 1
                if {_fortuneOn} is true:
                    add 3 to {_cnt}
                if isOmniPickaxe(player's tool) is true:
                    add 3 to {_cnt}
                loop {_cnt} times:
                    set {_it} to diamond
                    giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 3)
            else if {_b} is deepslate diamond ore:
                set {_cnt} to 1
                if {_fortuneOn} is true:
                    add 3 to {_cnt}
                if isOmniPickaxe(player's tool) is true:
                    add 3 to {_cnt}
                loop {_cnt} times:
                    set {_it} to diamond
                    giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 3)
            else if {_b} is gold ore:
                set {_it} to raw gold
                if isFlamePickaxe(player's tool) is true:
                    if {_flameOn} is true:
                        set {_it} to gold ingot
                if isOmniPickaxe(player's tool) is true:
                    set {_it} to gold ingot
                giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 2)
            else if {_b} is deepslate gold ore:
                set {_it} to raw gold
                if isFlamePickaxe(player's tool) is true:
                    if {_flameOn} is true:
                        set {_it} to gold ingot
                if isOmniPickaxe(player's tool) is true:
                    set {_it} to gold ingot
                giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 2)
            else if {_b} is nether gold ore:
                set {_nug} to 2
                if {_fortuneOn} is true:
                    add 6 to {_nug}
                if isOmniPickaxe(player's tool) is true:
                    add 6 to {_nug}
                loop {_nug} times:
                    set {_it} to gold nugget
                    giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 2)
            else if {_b} is iron ore:
                set {_it} to raw iron
                if isFlamePickaxe(player's tool) is true:
                    if {_flameOn} is true:
                        set {_it} to iron ingot
                if isOmniPickaxe(player's tool) is true:
                    set {_it} to iron ingot
                giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 2)
            else if {_b} is deepslate iron ore:
                set {_it} to raw iron
                if isFlamePickaxe(player's tool) is true:
                    if {_flameOn} is true:
                        set {_it} to iron ingot
                if isOmniPickaxe(player's tool) is true:
                    set {_it} to iron ingot
                giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 2)
            else if {_b} is coal ore:
                set {_cnt} to 1
                if {_fortuneOn} is true:
                    add 3 to {_cnt}
                if isOmniPickaxe(player's tool) is true:
                    add 3 to {_cnt}
                loop {_cnt} times:
                    set {_it} to coal
                    giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 2)
            else if {_b} is deepslate coal ore:
                set {_cnt} to 1
                if {_fortuneOn} is true:
                    add 3 to {_cnt}
                if isOmniPickaxe(player's tool) is true:
                    add 3 to {_cnt}
                loop {_cnt} times:
                    set {_it} to coal
                    giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 2)
            else if {_b} is lapis ore:
                set {_cnt} to 4
                if {_fortuneOn} is true:
                    set {_cnt} to 16
                if isOmniPickaxe(player's tool) is true:
                    set {_cnt} to 16
                loop {_cnt} times:
                    set {_it} to lapis lazuli
                    giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 3)
            else if {_b} is deepslate lapis ore:
                set {_cnt} to 4
                if {_fortuneOn} is true:
                    set {_cnt} to 16
                if isOmniPickaxe(player's tool) is true:
                    set {_cnt} to 16
                loop {_cnt} times:
                    set {_it} to lapis lazuli
                    giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 3)
            else if {_b} is redstone ore:
                set {_cnt} to 3
                if {_fortuneOn} is true:
                    set {_cnt} to 12
                if isOmniPickaxe(player's tool) is true:
                    set {_cnt} to 12
                loop {_cnt} times:
                    set {_it} to redstone
                    giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 3)
            else if {_b} is deepslate redstone ore:
                set {_cnt} to 3
                if {_fortuneOn} is true:
                    set {_cnt} to 12
                if isOmniPickaxe(player's tool) is true:
                    set {_cnt} to 12
                loop {_cnt} times:
                    set {_it} to redstone
                    giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 3)
            else if {_b} is ancient debris:
                set {_it} to ancient debris
                giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 5)
            # Жильная/Омни: дополнительно срубает руду того же типа в радиусе 1.
            set {_veinMode} to false
            if isVeinPickaxe(player's tool) is true:
                if {_veinOn} is true:
                    set {_veinMode} to true
            if isOmniPickaxe(player's tool) is true:
                set {_veinMode} to true
            if {_veinMode} is true:
                set {_bt} to "%type of {_b}%"
                loop blocks in radius 1 around {_dropLoc}:
                    if "%type of loop-block%" is {_bt}:
                        set {_sid} to "%type of loop-block%"
                        set {_lb} to location of loop-block
                        set loop-block to air
                        if {altar_pick_silk_mode::%uuid of player%} is true:
                            giveAltarSilkBlockItemById(player, {_sid})
                            giveAltarSilkOreXp(player, {_b})
                        else if {_b} is diamond ore:
                            set {_it} to diamond
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 2)
                        else if {_b} is deepslate diamond ore:
                            set {_it} to diamond
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 2)
                        else if {_b} is gold ore:
                            set {_it} to raw gold
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 1)
                        else if {_b} is deepslate gold ore:
                            set {_it} to raw gold
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 1)
                        else if {_b} is nether gold ore:
                            set {_it} to gold nugget
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 1)
                        else if {_b} is iron ore:
                            set {_it} to raw iron
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 1)
                        else if {_b} is deepslate iron ore:
                            set {_it} to raw iron
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 1)
                        else if {_b} is coal ore:
                            set {_it} to coal
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 1)
                        else if {_b} is deepslate coal ore:
                            set {_it} to coal
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 1)
                        else if {_b} is lapis ore:
                            set {_it} to lapis lazuli
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 1)
                        else if {_b} is deepslate lapis ore:
                            set {_it} to lapis lazuli
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 1)
                        else if {_b} is redstone ore:
                            set {_it} to redstone
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 1)
                        else if {_b} is deepslate redstone ore:
                            set {_it} to redstone
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 1)
                        else if {_b} is ancient debris:
                            set {_it} to ancient debris
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 2)
            # Доп. бафы Омни.
            # Кирка Пустоты: короткий рывок к дропу после добычи руды.
            if isVoidPickaxe(player's tool) is true:
                if {_voidOn} is true:
                    if random integer between 1 and 100 <= 25:
                        apply speed 2 without particles to player for 2 seconds
            stop
    set {_u} to player's uuid
    set {_l} to {level::%{_u}%} ? 1
    if {_l} < 20:
        if isNetherite(player's tool) is true:
            cancel event
            send action bar "&4&l✕ &cВы не умеете копать этим (нужен 20 лвл)!" to player

# 3. Запрет любого взаимодействия (ПКМ/ЛКМ по воздуху, блокам, сундукам и т.д.)
on right click:
    # Shift+ПКМ с алтарной киркой: вкл/выкл эфирный режим (пыль с мусорных блоков; выкл = обычная добыча камня).
    if player is sneaking:
        set {_tk} to player's tool
        if isAltarPickaxeTool({_tk}) is true:
            cancel event
            set {_u} to uuid of player
            if {altar_ether_trash_mode::%{_u}%} is true:
                delete {altar_ether_trash_mode::%{_u}%}
                send action bar "&7Эфирный режим: &cВЫКЛ &8(камень как обычно)" to player
            else:
                set {altar_ether_trash_mode::%{_u}%} to true
                send action bar "&7Эфирный режим: &aВКЛ &8(мусор -> пыль)" to player
            play sound "ui.button.click" with volume 0.85 and pitch 1.2 at player for player
            stop
    # ПКМ без Shift, алтарная кирка, клик по воздуху: шёлковое касание (целые блоки).
    if player is not sneaking:
        set {_tk} to player's tool
        if isAltarPickaxeTool({_tk}) is true:
            if targeted block is not set:
                cancel event
                set {_u} to uuid of player
                if {altar_pick_silk_mode::%{_u}%} is true:
                    delete {altar_pick_silk_mode::%{_u}%}
                    send action bar "&7Шёлковое касание: &cВЫКЛ" to player
                else:
                    set {altar_pick_silk_mode::%{_u}%} to true
                    send action bar "&7Шёлковое касание: &aВКЛ &8(целые блоки)" to player
                play sound "ui.button.click" with volume 0.85 and pitch 1.15 at player for player
                stop
    set {_u} to player's uuid
    set {_l} to {level::%{_u}%} ? 1
    if {_l} < 20:
        if isNetherite(player's tool) is true:
            cancel event
            send action bar "&4&l✕ &cНезерит недоступен до 20 уровня!" to player

on left click:
    set {_u} to player's uuid
    set {_l} to {level::%{_u}%} ? 1
    if {_l} < 20:
        if isNetherite(player's tool) is true:
            cancel event
            send action bar "&4&l✕ &cНезерит недоступен до 20 уровня!" to player
            stop
    # Легендарка Warrior: красный разрез только при взмахе мечом
    if classOf(player) is "Warrior":
        if hasArtifact(player, "leg_warrior") is true:
            if {_l} < 20:
                if isNetherite(player's tool) is true:
                    stop
            if isSword(player's tool) is not true:
                stop
            if noCooldownMode(player) is false:
                if {leg_warrior_air_last::%{_u}%} is set:
                    if difference between {leg_warrior_air_last::%{_u}%} and now < 1.05 seconds:
                        stop
            set {leg_warrior_air_last::%{_u}%} to now
            warriorLegSpatialAirSlash(player)

# --- КУРАЦИЯ КЛАССОВЫХ ПРЕДМЕТОВ ---

every 1 second:
    loop all players:
        loop all items in loop-player's inventory:
            if isClassItem(loop-value-2) is true:
                set durability of loop-value-2 to 99999
        set {_pu} to loop-player's uuid
        if noCooldownMode(loop-player) is true:
            # Во время "cooldown off" кулдауны очищаются, поэтому нужно постоянно сохранять
            # текущие значения, чтобы при "cooldown on" они вернулись с последнего использования.
            set {admin_nocd_save_archer_eye_cd::%{_pu}%} to {archer_eye_cd::%{_pu}%} ? 0
            set {admin_nocd_save_warrior_secondwind_cd::%{_pu}%} to {warrior_secondwind_cd::%{_pu}%} ? 0
            set {admin_nocd_save_scout_bloodrush_cd::%{_pu}%} to {scout_bloodrush_cd::%{_pu}%} ? 0
            set {admin_nocd_save_scout_parachute_cd::%{_pu}%} to {scout_parachute_cd::%{_pu}%} ? 0
            set {admin_nocd_save_archer_triple_cd::%{_pu}%} to {archer_triple_cd::%{_pu}%} ? 0
            set {admin_nocd_save_mage_overload_cd::%{_pu}%} to {mage_overload_cd::%{_pu}%} ? 0
            set {admin_nocd_save_necro_grip_cd::%{_pu}%} to {necro_grip_cd::%{_pu}%} ? 0
            set {admin_nocd_save_tank_laststand_cd::%{_pu}%} to {tank_laststand_cd::%{_pu}%} ? 0
            set {admin_nocd_save_necro_lifesteal_until::%{_pu}%} to {necro_lifesteal_until::%{_pu}%} ? 0
            set {admin_nocd_save_scout_dash_window::%{_pu}%} to {scout_dash_window::%{_pu}%} ? 0

            if loop-player is online:
                set {admin_nocd_save_feather_cd::%{_pu}%} to cooldown of feather for loop-player
                set {admin_nocd_save_bone_cd::%{_pu}%} to cooldown of bone for loop-player
                set {admin_nocd_save_blaze_rod_cd::%{_pu}%} to cooldown of blaze rod for loop-player
                set {admin_nocd_save_splash_potion_cd::%{_pu}%} to cooldown of splash potion for loop-player
                set {admin_nocd_save_golden_apple_cd::%{_pu}%} to cooldown of golden apple for loop-player
                set {admin_nocd_save_mace_cd::%{_pu}%} to cooldown of mace for loop-player
                set {admin_nocd_save_netherite_sword_cd::%{_pu}%} to cooldown of netherite sword for loop-player
                set {admin_nocd_save_diamond_sword_cd::%{_pu}%} to cooldown of diamond sword for loop-player
                set {admin_nocd_save_iron_sword_cd::%{_pu}%} to cooldown of iron sword for loop-player
                set {admin_nocd_save_golden_sword_cd::%{_pu}%} to cooldown of golden sword for loop-player
                set {admin_nocd_save_stone_sword_cd::%{_pu}%} to cooldown of stone sword for loop-player
                set {admin_nocd_save_wooden_sword_cd::%{_pu}%} to cooldown of wooden sword for loop-player
            # Важно: не удаляем и не обнуляем cooldown'ы,
            # иначе при включении обратно они не восстанавливаются.
        else:
            # Орлиный взор — таймер КД и индикатор
            if {archer_eye_cd::%{_pu}%} ? 0 > 0:
                subtract 1 from {archer_eye_cd::%{_pu}%}
                if {archer_eye_cd::%{_pu}%} <= 0:
                    delete {archer_eye_cd::%{_pu}%}
                    if {class::%{_pu}%} is "Archer":
                        send action bar "&a&lОРЛИНЫЙ ВЗОР готов!" to loop-player
                else if loop-player's tool is bow:
                    send action bar "&6Орлиный взор: &e%{archer_eye_cd::%{_pu}%}%с" to loop-player
            # Декремент КД новых перков
            if {warrior_secondwind_cd::%{_pu}%} ? 0 > 0:
                subtract 1 from {warrior_secondwind_cd::%{_pu}%}
                if {warrior_secondwind_cd::%{_pu}%} <= 0:
                    delete {warrior_secondwind_cd::%{_pu}%}
            if {scout_bloodrush_cd::%{_pu}%} ? 0 > 0:
                subtract 1 from {scout_bloodrush_cd::%{_pu}%}
                if {scout_bloodrush_cd::%{_pu}%} <= 0:
                    delete {scout_bloodrush_cd::%{_pu}%}
            if {scout_parachute_cd::%{_pu}%} ? 0 > 0:
                subtract 1 from {scout_parachute_cd::%{_pu}%}
                if {scout_parachute_cd::%{_pu}%} <= 0:
                    delete {scout_parachute_cd::%{_pu}%}
            if {archer_triple_cd::%{_pu}%} ? 0 > 0:
                subtract 1 from {archer_triple_cd::%{_pu}%}
                if {archer_triple_cd::%{_pu}%} <= 0:
                    delete {archer_triple_cd::%{_pu}%}
            if {mage_overload_cd::%{_pu}%} ? 0 > 0:
                subtract 1 from {mage_overload_cd::%{_pu}%}
                if {mage_overload_cd::%{_pu}%} <= 0:
                    delete {mage_overload_cd::%{_pu}%}
            if {necro_grip_cd::%{_pu}%} ? 0 > 0:
                subtract 1 from {necro_grip_cd::%{_pu}%}
                if {necro_grip_cd::%{_pu}%} <= 0:
                    delete {necro_grip_cd::%{_pu}%}
            # Очистка просроченного окна второго рывка
            if {scout_dash_window::%{_pu}%} is set:
                if {scout_dash_window::%{_pu}%} < unix timestamp of now:
                    delete {scout_dash_window::%{_pu}%}

# ==========================================
# ПАССИВНЫЕ БАФФЫ КЛАССОВ
# ==========================================
every 4 ticks:
    loop all players:
        set {_u} to loop-player's uuid
        set {_dual} to false
        if {class::%{_u}%} is "Warrior":
            set {_m1} to swordMat(loop-player's tool)
            set {_m2} to swordMat(loop-player's off hand tool)
            if {_m1} is not "":
                if {_m1} is {_m2}:
                    set {_dual} to true
        if {_dual} is true:
            if {dualwield_active::%{_u}%} is not true:
                set {dualwield_active::%{_u}%} to true
                set attack speed attribute of loop-player to 8
        else:
            if {dualwield_active::%{_u}%} is true:
                delete {dualwield_active::%{_u}%}
                set attack speed attribute of loop-player to 4

every 5 seconds:
    loop all players:
        set {_u} to loop-player's uuid
        set {_c} to {class::%{_u}%} ? "None"
        set {_l} to {level::%{_u}%} ? 1
        # Страховка от "залипания" анти-кнокбека у не-танков
        if {_c} is not "Tank":
            set knockback resistance attribute of loop-player to 0
            # Не танк: стандарт max health = 10 (10 ❤); сброс после танка / чужих значений
            if {ghost::%{_u}%} is not true:
                if max health of loop-player is not 10:
                    remove health boost from loop-player
                    set max health of loop-player to 10
                    if health of loop-player > 10:
                        set health of loop-player to 10

        # ===== WARRIOR =====
        if {_c} is "Warrior":
            if loop-player's health < 6:
                # Перк B "Кровавая клятва": при ❤<6 → Strength II + Speed I
                if {perk::%{_u}%} is "warrior_B":
                    apply strength 2 without particles to loop-player for 100 ticks
                    apply speed 1 without particles to loop-player for 100 ticks
                else:
                    apply strength 1 without particles to loop-player for 100 ticks
            if {_l} >= 15:
                apply haste 1 without particles to loop-player for 100 ticks
            if {_l} >= 25:
                apply resistance 1 without particles to loop-player for 100 ticks

        # ===== SCOUT =====
        else if {_c} is "Scout":
            apply speed 1 without particles to loop-player for 100 ticks
            if {_l} >= 15:
                apply jump boost 1 without particles to loop-player for 100 ticks
            if {_l} >= 20:
                if loop-player has potion effect slowness:
                    remove slowness from loop-player
            # Перк D "Кровопийца": при ❤<6 → Speed III на 5с (КД 20с)
            if {perk::%{_u}%} is "scout_D":
                if loop-player's health < 6:
                    if {scout_bloodrush_cd::%{_u}%} ? 0 <= 0:
                        apply speed 3 without particles to loop-player for 100 ticks
                        set {scout_bloodrush_cd::%{_u}%} to 20
                        play sound "entity.vampire.ambient" with volume 0.5 and pitch 1.5 at loop-player for loop-player
                        send action bar "&c&lКРОВОПИЙЦА! &7Speed III 5с" to loop-player
            # L25 — флай для двойного прыжка (вкл. в каждом тике, не только при join)

        # ===== TANK =====
        else if {_c} is "Tank":
            # До L25: как у всех, 10 ❤; L25: 20 ❤ (см. шапку файла)
            if {ghost::%{_u}%} is not true:
                if {_l} >= 25:
                    remove health boost from loop-player
                    set max health of loop-player to 20
                    if health of loop-player > 20:
                        set health of loop-player to 20
                else:
                    remove health boost from loop-player
                    set max health of loop-player to 10
                    if health of loop-player > 10:
                        set health of loop-player to 10
            # L3 — Knockback Resistance 50%, L13 — 100%
            if {_l} >= 13:
                set knockback resistance attribute of loop-player to 1
            else if {_l} >= 3:
                set knockback resistance attribute of loop-player to 0.5
            else:
                set knockback resistance attribute of loop-player to 0
            # L17 — Fire Resistance пассивно
            if {_l} >= 17:
                apply fire resistance 1 without particles to loop-player for 100 ticks
            # L25 — снимать Slowness и Mining Fatigue
            if {_l} >= 25:
                if loop-player has potion effect slowness:
                    remove slowness from loop-player
                if loop-player has potion effect mining fatigue:
                    remove mining fatigue from loop-player
            if {_l} >= 5:
                # Перк C "Несокрушимый": при ≤40%% макс. ❤ (доля от max health) → Resistance III
                if {perk::%{_u}%} is "tank_C":
                    if tankHpBelowC(loop-player) is true:
                        apply resistance 3 without particles to loop-player for 101 ticks
                    else:
                        apply resistance 1 without particles to loop-player for 100 ticks
                else:
                    apply resistance 1 without particles to loop-player for 100 ticks
            # L15 — Аура защитника: только напарнику в радиусе 5 блоков
            if {_l} >= 15:
                if inDuo(loop-player) is true:
                    set {_partner} to duoPartner(loop-player)
                    if {_partner} is online:
                        if distance between loop-player and {_partner} <= 5:
                            apply resistance 1 without particles to {_partner} for 100 ticks
            # Перк D "Защитник дуо": усиленная аура — Resistance II + Regen I в радиусе 8
            if {perk::%{_u}%} is "tank_D":
                if inDuo(loop-player) is true:
                    set {_partner} to duoPartner(loop-player)
                    if {_partner} is online:
                        if distance between loop-player and {_partner} <= 8:
                            apply resistance 2 without particles to {_partner} for 100 ticks
                            apply regeneration 1 without particles to {_partner} for 100 ticks

        # ===== ARCHER =====
        else if {_c} is "Archer":
            apply speed 1 without particles to loop-player for 100 ticks
            # L7 — иммунитет к Slowness (снимаем если есть)
            if {_l} >= 7:
                if loop-player has potion effect slowness:
                    remove slowness from loop-player
            if {_l} >= 15:
                apply night vision 1 without particles to loop-player for 100 ticks

        # ===== MAGE =====
        else if {_c} is "Mage":
            # L7 — иммунитет к Wither и Poison
            if {_l} >= 7:
                if loop-player has potion effect wither:
                    remove wither from loop-player
                if loop-player has potion effect poison:
                    remove poison from loop-player
            if {_l} >= 20:
                apply resistance 1 without particles to loop-player for 100 ticks
            # L17 — Аура ослабления: враги (моббы и не-дуо игроки) в радиусе 5 → Weakness I
            if {_l} >= 17:
                for each {_ae} in all living entities in radius 5 around loop-player:
                    if uuid of {_ae} is not {_u}:
                        if {_ae} is a monster:
                            apply weakness 1 without particles to {_ae} for 100 ticks
                        else if {_ae} is a player:
                            if areDuo(loop-player, {_ae}) is not true:
                                apply weakness 1 without particles to {_ae} for 100 ticks
            # Перк C "Аура регена": союзникам в радиусе 10 — Regen I
            if {perk::%{_u}%} is "mage_C":
                set {_mageCaster} to loop-player
                for each {_ally} in all players in radius 10 around {_mageCaster}:
                    if uuid of {_ally} is not {_u}:
                        if areDuo({_mageCaster}, {_ally}) is true:
                            apply regeneration 1 without particles to {_ally} for 100 ticks

        # ===== NECROMANCER =====
        # Некромант — повелитель смерти, бьёт через миньонов и дебаффы.
        # РЕГЕНА БОЛЬШЕ НЕТ как пассивки — заменено на Восставшего чемпиона (см. on death of player).
        else if {_c} is "Necromancer":
            # L1 — Призрачный взор: Night Vision пассивно (перенесено с L15)
            apply night vision 1 without particles to loop-player for 100 ticks
            # L10 — Иммунитет к Wither (свой же эффект ауры на себя не действует)
            if {_l} >= 10:
                if loop-player has potion effect wither:
                    remove wither from loop-player
            # L20 — Аура смерти: враги-мобы в 4 блоках получают Wither I (2с)
            if {_l} >= 20:
                for each {_ae} in all living entities in radius 4 around loop-player:
                    if uuid of {_ae} is not {_u}:
                        if {_ae} is a monster:
                            set {_eid2} to uuid of {_ae}
                            # не баффать своих же миньонов
                            if {minion_owner::%{_eid2}%} is not set:
                                apply wither 1 without particles to {_ae} for 100 ticks


# ==========================================
# БОЕВАЯ ЛОГИКА
# ==========================================
on damage:
    # Активное парирование Воина (L20+) — окно открыто игроком через ПКМ с мечом
    if victim is a player:
        set {_uv} to victim's uuid
        if {parry_until::%{_uv}%} is set:
            if {parry_until::%{_uv}%} > unix timestamp of now:
                if attacker is a living entity:
                    cancel event
                    # Перк C "Идеальное парирование": x1.5 урон + Slowness II 4с
                    if {perk::%{_uv}%} is "warrior_C":
                        set {_dmg} to damage * 1.5
                        damage attacker by {_dmg} with fake damage cause entity attack
                        if attacker is a living entity:
                            apply slowness 2 without particles to attacker for 4 seconds
                            apply blindness 1 without particles to attacker for 4 seconds
                        send action bar "&e&lИДЕАЛЬНОЕ ПАРИРОВАНИЕ!" to victim
                    else:
                        set {_dmg} to damage * 1
                        damage attacker by {_dmg} with fake damage cause entity attack
                        if attacker is a living entity:
                            apply blindness 1 without particles to attacker for 4 seconds
                        send action bar "&e&lPARRY!" to victim
                    set {_maxhp} to victim's max health
                    # +5 в тех же ед., что health игрока (на сервере — целые ❤)
                    set victim's health to min({_maxhp}, victim's health + 5)
                    play sound "block.vault.open_shutter" with volume 1 and pitch 1 at victim for all players
                    delete {parry_until::%{_uv}%}
                    set {parry_used::%{_uv}%} to true
                    stop

on damage:
    attacker is a player
    set {_u} to attacker's uuid
    set {_c} to {class::%{_u}%} ? "None"
    set {_l} to {level::%{_u}%} ? 1

    # ----- Дуал-вилд (мечи в обеих руках) — только Воин -----
    # Скорость атаки повышается через атрибут на самом игроке (см. периодический лоуп ниже).
    # Здесь — пусто, эффект применяется автоматически при подходящем инвентаре.

    # ----- Кулдаун булавы (SkBee) -----
    if attacker's tool is a mace:
        if cooldown of mace for attacker > 0 seconds:
            if noCooldownMode(attacker) is false:
                cancel event
                stop
            set cooldown of mace for attacker to 0 seconds
        set cooldown of mace for attacker to 60 seconds

    # ===== БАФФ УРОНА ОТ УРОВНЯ ОРУЖИЯ =====
    set {_wt} to weaponType(attacker's tool)
    if {_wt} is "bow":
        if projectile is not an arrow:
            set {_wt} to "none"
    if {_wt} is not "none":
        set {_wlvl} to {wlvl::%attacker's uuid%::%{_wt}%} ? 1
        set damage to damage * wDamageMult({_wlvl})
        addWXP(attacker, {_wt}, 1)

    # ===== БАФФЫ УРОНА ПО КЛАССАМ =====
    if {_c} is "Warrior":
        # L1 — +10% урона мечом всегда
        if isSword(attacker's tool) is true:
            set damage to damage * 1.1
        # L3 — общий бонус
        if {_l} >= 3:
            set damage to damage * 1.15
        # Перк A "Палач": цель с ❤≤4 — +75% урона + Strength I 3с
        if {perk::%{_u}%} is "warrior_A":
            if victim is a living entity:
                if victim's health <= 4:
                    set damage to damage * 1.75
                    apply strength 1 without particles to attacker for 3 seconds
                    send action bar "&4&lПАЛАЧ!" to attacker
        # Воин — меч-онли: топоры не дают бонусов

    else if {_c} is "Scout":
        # L1 — удар в спину: атакующий должен находиться позади жертвы по позиции
        if victim is a living entity:
            set {_vyr} to yaw of victim * 0.017453292519943295
            set {_vx} to (0 - sin({_vyr}))
            set {_vz} to cos({_vyr})
            set {_dx} to x-coordinate of attacker - x-coordinate of victim
            set {_dz} to z-coordinate of attacker - z-coordinate of victim
            set {_dot} to ({_vx} * {_dx}) + ({_vz} * {_dz})
            if {_dot} < -0.35:
                set damage to damage * 1.4
                send action bar "&e&lУДАР В СПИНУ!" to attacker
        # L1 — крит при sneak (стандартный «sneak attack»)
        if attacker is sneaking:
            set damage to damage * 1.15
        # L13 — Кровавый след: +30% урона 3с после рывка
        if {_l} >= 13:
            if {scout_dash::%{_u}%} is set:
                if difference between {scout_dash::%{_u}%} and now < 3 seconds:
                    set damage to damage * 1.3
                    send action bar "&c&lКРОВАВЫЙ СЛЕД!" to attacker
        # Перк B "Невидимый клинок": удар в инвизе — +100% и продлевает инвиз на 2с
        # Суммарный лимит инвиза в одной цепочке — 30с (см. scoutApplyInvis)
        if {perk::%{_u}%} is "scout_B":
            if attacker has potion effect invisibility:
                set damage to damage * 2
                scoutApplyInvis(attacker, 2)
                send action bar "&5&lНЕВИДИМЫЙ КЛИНОК!" to attacker
        # Перк D "Кровопийца": каждый 4-й удар → heal 0.5 (½❤ в лоре)
        if {perk::%{_u}%} is "scout_D":
            add 1 to {scout_lifesteal_hits::%{_u}%}
            if {scout_lifesteal_hits::%{_u}%} >= 4:
                set {scout_lifesteal_hits::%{_u}%} to 0
                heal attacker by 0.5
                send action bar "&c&lКРОВОПИЙЦА! &7+½❤" to attacker

    else if {_c} is "Tank":
        # L10 — шипы при получении урона (см. блок ниже)
        # L1 — наносит меньше урона, но почти не получает (см. ниже в on damage of player)
        set damage to damage * 0.85

    else if {_c} is "Archer":
        if {_l} >= 10:
            if projectile is an arrow:
                set damage to damage * 1.4
        # L1 — лук бьёт чуть сильнее
        if projectile is an arrow:
            set damage to damage * 1.1
            # L3 — +1 флэт урона стрелой
            if {_l} >= 3:
                set damage to damage + 1
            # L13 — снайперский урон: +25% по целям дальше 15 блоков
            if {_l} >= 13:
                if victim is a living entity:
                    if distance between attacker and victim > 15:
                        set damage to damage * 1.25
            # L17 — Slowness I на 2с
            if {_l} >= 17:
                if victim is a living entity:
                    applyCappedDebuff(victim, "slowness", "slowness", 1, 2)
            # Перк A "Снайпер": +50% урона если цель дальше 20 блоков
            if {perk::%attacker's uuid%} is "archer_A":
                if victim is a living entity:
                    if distance between attacker and victim > 20:
                        set damage to damage * 1.5
                        send action bar "&e&lСНАЙПЕР!" to attacker
            # Перк B "Морозная стрела": Slowness III + Mining Fatigue II + Weakness I
            if {perk::%attacker's uuid%} is "archer_B":
                if victim is a living entity:
                    applyCappedDebuff(victim, "slowness", "slowness", 3, 5)
                    applyCappedDebuff(victim, "mining_fatigue", "mining_fatigue", 2, 5)
                    applyCappedDebuff(victim, "weakness", "weakness", 1, 4)
        # L5 — шанс крит-стрелы (x2 урон), L23 — 40% вместо 25%
        if {_l} >= 23:
            if projectile is an arrow:
                chance of 40%:
                    set damage to damage * 2
                    send action bar "&e&lКРИТ!" to attacker
        else if {_l} >= 5:
            if projectile is an arrow:
                chance of 25%:
                    set damage to damage * 2
                    send action bar "&e&lКРИТ!" to attacker
        # Легендарка Archer «Око Хищника»: самонаводка уже сильная — режем суммарный урон со стрел
        if projectile is an arrow:
            if hasArtifact(attacker, "leg_archer") is true:
                set damage to damage * 0.68

    else if {_c} is "Mage":
        # L1 — палочка (blaze rod) наносит магический урон
        if attacker's tool is a blaze rod:
            set damage to damage + 1
            if victim is a living entity:
                # L3 — огонь дольше: 4с вместо 2с
                if {_l} >= 3:
                    ignite victim for 4 seconds
                else:
                    ignite victim for 2 seconds
                # L13 — Цепь молний: бьёт ещё одного врага рядом на 50% урона
                if {_l} >= 13:
                    set {_chained} to false
                    loop all living entities in radius 5 around victim:
                        if {_chained} is false:
                            if loop-entity is not victim:
                                if loop-entity is not attacker:
                                    if areDuo(attacker, loop-entity) is not true:
                                        set {_chain_dmg2} to damage * 0.5
                                        damage loop-entity by {_chain_dmg2} with fake damage cause entity attack
                                        ignite loop-entity for 2 seconds
                                        play sound "entity.lightning_bolt.thunder" with volume 0.4 and pitch 1.8 at loop-entity for all players
                                        send action bar "&b&lЦЕПЬ МОЛНИЙ!" to attacker
                                        set {_chained} to true

    else if {_c} is "Necromancer":
        # Бьёт через миньонов и дебаффы — оружие слабое, но с механиками.
        if attacker's tool is a bone:
            if "%{attacker's tool}%" contains "Жезл Некроманта":
                if victim is a living entity:
                    if victim is not attacker:
                        set {_vidPending} to uuid of victim
                        if {necro_staff_bomb_pending::%{_vidPending}%} is set:
                            cancel event
                            stop
                        # Удар по чужой нежити: без урона от удара, ИИ выкл., взрыв через 3 с, +1½❤, AoE (всё после wait — без set damage: ивент уже прошёл)
                        set {_useNecStaffBomb} to false
                        if victim is not a player:
                            if victim is not an ender dragon:
                                if victim is not a wither:
                                    if victim is not a warden:
                                        if isLegNecroPacifiedUndead(victim) is true:
                                            set {_vid} to uuid of victim
                                            if {minion_owner::%{_vid}%} is not {_u}:
                                                if {necro_staff_bomb_pending::%{_vid}%} is not set:
                                                    set {_useNecStaffBomb} to true
                        if {_useNecStaffBomb} is true:
                            cancel event
                            set ai of victim to false
                            set {_necBombAnchor} to location of victim
                            set {necro_staff_bomb_pending::%{_vid}%} to true
                            set {necro_staff_bomb_caster::%{_vid}%} to {_u}
                            send action bar "&8&lФАНТОМНАЯ ЖЕРТВА &7— взрыв через &f3с" to attacker
                            play sound "entity.evoker.prepare_summon" with volume 1 and pitch 0.65 at victim for all players
                            wait 3 seconds
                            if {necro_staff_bomb_pending::%{_vid}%} is not set:
                                stop
                            delete {necro_staff_bomb_pending::%{_vid}%}
                            set {_casterSaved} to {necro_staff_bomb_caster::%{_vid}%}
                            delete {necro_staff_bomb_caster::%{_vid}%}
                            delete {_boomMob}
                            loop all living entities in radius 8 around {_necBombAnchor}:
                                if uuid of loop-entity is {_vid}:
                                    set {_boomMob} to loop-entity
                                    stop loop
                            set {_casterPl} to player from {_casterSaved}
                            if {_boomMob} is set:
                                if {_boomMob} is a living entity:
                                    if {_casterPl} is online:
                                        set {_bloc} to location of {_boomMob}
                                        necroStaffPhantomBurst({_bloc}, {_boomMob}, {_casterPl})
                                        kill {_boomMob}
                                        heal {_casterPl} by 1.5
                                        send action bar "&2&lПОГЛОЩЕНИЕ &7+1½❤" to {_casterPl}
                                    else:
                                        kill {_boomMob}
                            stop
                        else:
                            # L1 — Костяной молот: +1 урон, 30% слабость 1 на 2с
                            set damage to damage + 1
                            chance of 30%:
                                apply slowness 1 without particles to victim for 2 seconds
                            # L1 — Кража жизни: лечит 1❤ за удар (КД 2с)
                            set {_now} to unix timestamp of now
                            if noCooldownMode(attacker) is true:
                                heal attacker by 1
                            else if {necro_lifesteal_until::%{_u}%} is not set:
                                heal attacker by 1
                                set {necro_lifesteal_until::%{_u}%} to {_now} + 2
                            else if {necro_lifesteal_until::%{_u}%} < {_now}:
                                heal attacker by 1
                                set {necro_lifesteal_until::%{_u}%} to {_now} + 2
                            # L5 — Метка смерти: +20% урона по цели от тебя и миньонов 5с
                            if {_l} >= 5:
                                set {necro_mark::%uuid of victim%} to {_now} + 5
                                set {necro_mark_owner::%uuid of victim%} to {_u}
                            # L20 — Wither удар костью
                            if {_l} >= 20:
                                apply wither 1 without particles to victim for 4 seconds

# ----- Tank L1: получает -15% урона; L10: шипы -----
on damage:
    if victim is a player:
        set {_uv} to victim's uuid
        set {_cv} to {class::%{_uv}%} ? "None"
        set {_lv} to {level::%{_uv}%} ? 1

        if attacker is a living entity:
            if {_cv} is "Tank":
                # L20 — -25% урона, иначе L1 -15%
                if {_lv} >= 20:
                    set damage to damage * 0.75
                else:
                    set damage to damage * 0.85
                # Перк C "Несокрушимый": при ≤40%% макс. ❤ → -30%% дополнительно
                if {perk::%{_uv}%} is "tank_C":
                    if tankHpBelowC(victim) is true:
                        set damage to damage * 0.7
                # L7 — Якорь: атакующий получает Slowness I на 2с
                if {_lv} >= 7:
                    if attacker is a player:
                        if areDuo(victim, attacker) is not true:
                            apply slowness 1 without particles to attacker for 2 seconds
                    else:
                        apply slowness 1 without particles to attacker for 2 seconds
                # L8 — Последний рубеж: при ≤30%% макс. ❤ → Resistance II 5с (КД 30с)
                if {_lv} >= 8:
                    if tankHpBelowLastStand(victim) is true:
                        set {_now_ts} to unix timestamp of now
                        set {_cd} to {tank_laststand_cd::%{_uv}%} ? 0
                        set {_allowLaststand} to false
                        if {_cd} <= {_now_ts}:
                            set {_allowLaststand} to true
                        if noCooldownMode(victim) is true:
                            set {_allowLaststand} to true
                        if {_allowLaststand} is true:
                            apply resistance 2 without particles to victim for 5 seconds
                            set {tank_laststand_cd::%{_uv}%} to {_now_ts} + 30
                            set {_vloc} to location of victim
                            play sound "block.beacon.activate" with volume 0.8 and pitch 1.5 at {_vloc} for victim
                            send action bar "&4&l⛨ ПОСЛЕДНИЙ РУБЕЖ!" to victim
                if {_lv} >= 10:
                    if attacker is a player:
                        if areDuo(victim, attacker) is not true:
                            damage attacker by 1 with fake damage cause entity attack
                            send action bar "&7Шипы!" to attacker
                    else:
                        damage attacker by 1 with fake damage cause entity attack
                # Перк A "Магма-броня": атакующий поджигается + 2❤ огнём
                if {perk::%{_uv}%} is "tank_A":
                    if attacker is a player:
                        if areDuo(victim, attacker) is not true:
                            ignite attacker for 4 seconds
                            damage attacker by 2 with fake damage cause entity attack
                            send action bar "&c&lМАГМА-БРОНЯ!" to attacker
                    else:
                        ignite attacker for 4 seconds
                        damage attacker by 2 with fake damage cause entity attack
                # Перк B "Сейсмический удар" (пассивный, реактивный):
                # каждый 4-й удар по танку отталкивает всех врагов в радиусе 4
                if {perk::%{_uv}%} is "tank_B":
                    add 1 to {tank_seismic_hits::%{_uv}%}
                    if {tank_seismic_hits::%{_uv}%} >= 4:
                        set {tank_seismic_hits::%{_uv}%} to 0
                        set {_pl} to location of victim
                        play sound "entity.generic.explode" with volume 0.8 and pitch 0.6 at {_pl} for all players
                        execute console command "particle minecraft:large_smoke %x-coordinate of {_pl}% %y-coordinate of {_pl}% %z-coordinate of {_pl}% 0.4 0.4 0.4 0.1 30 force"
                        loop all living entities in radius 4 around victim:
                            if loop-entity is not victim:
                                if loop-entity is a player:
                                    if areDuo(victim, loop-entity) is not true:
                                        apply slowness 2 without particles to loop-entity for 3 seconds
                                        push loop-entity upwards at speed 0.4
                                        push loop-entity backwards at speed 0.7
                                else:
                                    apply slowness 2 without particles to loop-entity for 3 seconds
                                    push loop-entity upwards at speed 0.4
                                    push loop-entity backwards at speed 0.7
                        send action bar "&8&lСЕЙСМИЧЕСКИЙ УДАР!" to victim

    # Перк B "Кровавая клятва" (Warrior): +15% входящего урона
        if {_cv} is "Warrior":
            if {perk::%{_uv}%} is "warrior_B":
                set damage to damage * 1.15

    # Перк D "Защитник дуо" (Tank): партнёр получает урон, Tank принимает 50% на себя
        if {_cv} is not "Tank":
            if inDuo(victim) is true:
                set {_partner} to duoPartner(victim)
                if {_partner} is online:
                    if classOf({_partner}) is "Tank":
                        if {perk::%uuid of {_partner}%} is "tank_D":
                            if distance between victim and {_partner} <= 8:
                                if {_partner} is not attacker:
                                    set {_redirect} to damage * 0.5
                                    set damage to damage * 0.5
                                    damage {_partner} by {_redirect} with fake damage cause entity attack
                                    send action bar "&6&lТАНК ЗАЩИЩАЕТ" to victim
                                    send action bar "&6&lТЫ ПРИНЯЛ УДАР" to {_partner}

    # Перк D "Второй ветер" (Warrior): спасение от смертельного удара (КД 180с)
        if {_cv} is "Warrior":
            if {perk::%{_uv}%} is "warrior_D":
                if damage >= victim's health:
                    set {_swCd} to {warrior_secondwind_cd::%{_uv}%} ? 0
                    set {_allowSecondwind} to false
                    if {_swCd} <= 0:
                        set {_allowSecondwind} to true
                    if noCooldownMode(victim) is true:
                        set {_allowSecondwind} to true
                    if {_allowSecondwind} is true:
                        if playerHoldsTotemOfUndying(victim) is false:
                            cancel event
                            set victim's health to 6
                            apply resistance 2 without particles to victim for 6 seconds
                            apply regeneration 2 without particles to victim for 6 seconds
                            set {warrior_secondwind_cd::%{_uv}%} to 180
                            play sound "item.totem.use" with volume 1 and pitch 1 at victim for all players
                            send title "&a&lВТОРОЙ ВЕТЕР!" with subtitle "&7Спасение от смерти" to victim for 2 seconds

    # Перк D "Арканная перегрузка" (Mage): реактивный контр-импульс (КД 20с)
        if {_cv} is "Mage":
            if {perk::%{_uv}%} is "mage_D":
                set {_molCd} to {mage_overload_cd::%{_uv}%} ? 0
                set {_allowOverload} to false
                if {_molCd} <= 0:
                    set {_allowOverload} to true
                if noCooldownMode(victim) is true:
                    set {_allowOverload} to true
                if {_allowOverload} is true:
                    if attacker is a living entity:
                        if attacker is not victim:
                            apply slowness 2 without particles to attacker for 4 seconds
                            apply weakness 1 without particles to attacker for 4 seconds
                            send action bar "&d&lАРКАННЫЙ ИМПУЛЬС!" to victim
                            play sound "block.amethyst_block.resonate" with volume 1 and pitch 1.2 at victim for all players
                    apply speed 2 without particles to victim for 3 seconds
                    set {mage_overload_cd::%{_uv}%} to 20

# ==========================================
# НЕКРОМАНТ: Метка смерти — +20% урона по отмеченной цели
# Действует и для хозяина, и для его миньонов.
# ==========================================
on damage:
    if victim is a living entity:
        set {_vid} to uuid of victim
        if {necro_mark::%{_vid}%} is set:
            if {necro_mark::%{_vid}%} > unix timestamp of now:
                set {_owner} to {necro_mark_owner::%{_vid}%}
                set {_apply} to false
                if attacker is a player:
                    if uuid of attacker is {_owner}:
                        set {_apply} to true
                else if attacker is a living entity:
                    set {_aid} to uuid of attacker
                    if {minion_owner::%{_aid}%} is {_owner}:
                        set {_apply} to true
                if {_apply} is true:
                    set damage to damage * 1.2
            else:
                delete {necro_mark::%{_vid}%}
                delete {necro_mark_owner::%{_vid}%}

# ==========================================
# СПОСОБНОСТИ ПО ПКМ
# ==========================================

# ---- Кулдаун золотых яблок (для всех) ----
on right click with golden apple:
    if noCooldownMode(player) is true:
        stop
    if cooldown of golden apple for player > 0 seconds:
        cancel event
        send action bar "&cЗолотые яблоки на кулдауне!" to player

on consume of golden apple:
    if noCooldownMode(player) is true:
        set cooldown of golden apple for player to 0 seconds
        stop
    set cooldown of golden apple for player to 10 seconds

# ==========================================
# СПОСОБНОСТИ ПО ПКМ — единый обработчик
# ==========================================
# Один общий on right click с проверкой класса и предмета — надёжнее
# чем `on right click with X`, который иногда не фаерится.

on right click:
    set {_u} to player's uuid
    set {_c} to {class::%{_u}%} ? "None"
    set {_l} to {level::%{_u}%} ? 1
    set {_tool} to player's tool
    set {_nocd} to noCooldownMode(player)

    # ===== WARRIOR L20: Активное парирование (ПКМ с мечом, КД 15с) =====
    if {_c} is "Warrior":
        if {_l} >= 20:
            if isSword({_tool}) is true:
                if {_nocd} is false:
                    if cooldown of {_tool} for player > 0 seconds:
                        stop
                # Перк C "Идеальное парирование": КД -50% (30с → 15с)
                if {perk::%{_u}%} is "warrior_C":
                    set cooldown of {_tool} for player to 15 seconds
                else:
                    set cooldown of {_tool} for player to 30 seconds
                set {parry_until::%{_u}%} to (unix timestamp of now) + 1
                delete {parry_used::%{_u}%}
                play sound "item.trident.throw" with volume 1 and pitch 1 at player for all players
                send action bar "&e&lPARRY! &7(окно 1с)" to player
                wait 1.05 seconds
                if {parry_used::%{_u}%} is not set:
                    delete {parry_until::%{_u}%}
                    apply weakness 2 without particles to player for 5 seconds
                    apply slowness 2 without particles to player for 5 seconds
                    play sound "block.anvil.land" with volume 1 and pitch 0.7 at player for all players
                    send action bar "&c&lPARRY FAIL &cпромах!" to player
                delete {parry_used::%{_u}%}
                stop

    # ===== SCOUT: Рывок (L5) и Невидимость (L10) пером =====
    if {_c} is "Scout":
        if {_tool} is feather:
            # shift = инвиз (L10)
            if player is sneaking:
                if {_l} >= 10:
                    if {_nocd} is false:
                        if cooldown of feather for player > 0 seconds:
                            send action bar "&cНевидимость на КД!" to player
                            stop
                    scoutApplyInvis(player, 5)
                    send action bar "&7&lИсчезновение..." to player
                    play sound "entity.illusioner.mirror_move" at player for all players
                    set cooldown of feather for player to 60 seconds
                else:
                    send action bar "&cНевидимость с 10 уровня!" to player
                stop
            # без shift = рывок (L5)
            else:
                if {_l} >= 5:
                    # Перк A "Двойной рывок": два рывка в окне 5с с КД 4с между; затем общий КД 15с
                    if {perk::%{_u}%} is "scout_A":
                        # Если в окне второго рывка (один уже использован)
                        if {scout_dash_window::%{_u}%} is set:
                            if {scout_dash_window::%{_u}%} > unix timestamp of now:
                                push player forwards at speed 1.8
                                push player upwards at speed 0.5
                                play sound "entity.firework_rocket.launch" at player for all players
                                delete {scout_dash_window::%{_u}%}
                                set cooldown of feather for player to 15 seconds
                                set {scout_dash::%{_u}%} to now
                                set {scout_dash_fallimmune::%{_u}%} to true
                                send action bar "&b&lВТОРОЙ РЫВОК!" to player
                                stop
                        if {_nocd} is false:
                            if cooldown of feather for player > 0 seconds:
                                send action bar "&cРывок на КД!" to player
                                stop
                        # Первый рывок — открыть окно на 5с для второго, КД короткий 4с
                        push player forwards at speed 1.8
                        push player upwards at speed 0.5
                        play sound "entity.firework_rocket.launch" at player for all players
                        set cooldown of feather for player to 4 seconds
                        set {scout_dash_window::%{_u}%} to (unix timestamp of now) + 5
                        set {scout_dash::%{_u}%} to now
                        set {scout_dash_fallimmune::%{_u}%} to true
                        send action bar "&b&lРЫВОК!" to player
                        stop
                    if {_nocd} is false:
                        if cooldown of feather for player > 0 seconds:
                            send action bar "&cРывок на КД!" to player
                            stop
                    push player forwards at speed 1.8
                    push player upwards at speed 0.5
                    play sound "entity.firework_rocket.launch" at player for all players
                    set cooldown of feather for player to 15 seconds
                    set {scout_dash::%{_u}%} to now
                    set {scout_dash_fallimmune::%{_u}%} to true
                    send action bar "&b&lРЫВОК!" to player
                else:
                    send action bar "&cРывок с 5 уровня!" to player
                stop

    # (Tank L15 теперь имеет пассивную ауру — см. блок пассивных баффов)

    # ===== ARCHER: Shift+ПКМ луком =====
    if {_c} is "Archer":
        if {_tool} is bow:
            if player is sneaking:
                # Перк C "Тройной выстрел" — приоритет над Орлиным взором
                if {perk::%{_u}%} is "archer_C":
                    if {_nocd} is false:
                        if {archer_triple_cd::%{_u}%} ? 0 > 0:
                            send action bar "&cТройной выстрел: КД &e%{archer_triple_cd::%{_u}%}%с" to player
                            stop
                    cancel event
                    set {_arr} to amount of arrow in player's inventory
                    if {_arr} < 3:
                        send action bar "&cНужно 3 стрелы!" to player
                        stop
                    remove 3 of arrow from player
                    shoot an arrow from player at speed 2.5
                    set {_a1} to last shot projectile
                    shoot an arrow from player at speed 2.5
                    set {_a2} to last shot projectile
                    shoot an arrow from player at speed 2.5
                    set {_a3} to last shot projectile
                    if {_a2} is set:
                        push {_a2} to the right at speed 0.3
                    if {_a3} is set:
                        push {_a3} to the left at speed 0.3
                    play sound "entity.skeleton.shoot" with volume 1 and pitch 0.8 at player for all players
                    set {archer_triple_cd::%{_u}%} to 12
                    send action bar "&6&lТРОЙНОЙ ВЫСТРЕЛ!" to player
                    stop
                if {_l} >= 25:
                    if {_nocd} is false:
                        if {archer_eye_cd::%player's uuid%} ? 0 > 0:
                            send action bar "&cОрлиный взор: КД &e%{archer_eye_cd::%player's uuid%}%с" to player
                            stop
                    cancel event
                    set {_n} to 0
                    delete {archer_marked::%player's uuid%::*}
                    loop all living entities in radius 25 around player:
                        if loop-entity is not player:
                            apply glowing 1 without particles to loop-entity for 8 seconds
                            add uuid of loop-entity to {archer_marked::%player's uuid%::*}
                            add 1 to {_n}
                    set {archer_eye::%player's uuid%} to now
                    set {archer_eye_cd::%player's uuid%} to 45
                    apply speed 2 without particles to player for 8 seconds
                    apply night vision 1 without particles to player for 8 seconds
                    play sound "item.spyglass.use" with volume 1 and pitch 0.7 at player for all players
                    send action bar "&6&lОРЛИНЫЙ ВЗОР!" to player
                    stop

    # ===== TANK: активных способностей по щиту НЕТ — танк пассивный =====
    # (Перк B "Сейсмический удар" — реактивный, см. блок on damage of player)

    # ===== NECROMANCER: ПКМ костью — Призыв миньона =====
    if {_c} is "Necromancer":
        if {_tool} is bone:
            # Перк C "Мёртвая хватка": Shift+ПКМ костью — притянуть врага
            if player is sneaking:
                if {perk::%{_u}%} is "necro_C":
                    if {_nocd} is false:
                        if {necro_grip_cd::%{_u}%} ? 0 > 0:
                            send action bar "&cМёртвая хватка: КД &e%{necro_grip_cd::%{_u}%}%с" to player
                            stop
                    set {_target} to target entity of player
                    if {_target} is a living entity:
                        if {_target} is not player:
                            if distance between player and {_target} <= 20:
                                set {_pl} to location of player
                                teleport {_target} to {_pl}
                                apply slowness 3 without particles to {_target} for 4 seconds
                                play sound "entity.zombie.attack_iron_door" with volume 1 and pitch 0.6 at player for all players
                                set {necro_grip_cd::%{_u}%} to 20
                                send action bar "&8&lМЁРТВАЯ ХВАТКА!" to player
                            else:
                                send action bar "&cЦель слишком далеко" to player
                        else:
                            send action bar "&cНет цели" to player
                    else:
                        send action bar "&cНаведись на врага" to player
                    stop
            if {_nocd} is false:
                if cooldown of bone for player > 0 seconds:
                    send action bar "&cПризыв на КД!" to player
                    stop
            spawnNecroMinion(player, {_l})
            set cooldown of bone for player to 30 seconds
            send action bar "&2&lПРИЗЫВ!" to player
            stop

    # ===== MAGE: Фаербол / Эндер-перл блейз родом =====
    if {_c} is "Mage":
        if {_tool} is blaze rod:
            # shift = эндер-перл (L15)
            if player is sneaking:
                if {_l} >= 15:
                    if {_nocd} is false:
                        if cooldown of blaze rod for player > 0 seconds:
                            send action bar "&cТелепорт на КД!" to player
                            stop
                    shoot an ender pearl from player at speed 1.6
                    play sound "entity.ender_pearl.throw" with volume 1 and pitch 1 at player for all players
                    set cooldown of blaze rod for player to 25 seconds
                    send action bar "&d&lЭНДЕР-ПЁРЛ!" to player
                else:
                    send action bar "&cЭндер-перл с 15 уровня!" to player
                stop
            # без shift = фаербол (L1+ малый, L25+ большой)
            else:
                if {_nocd} is false:
                    if cooldown of blaze rod for player > 0 seconds:
                        send action bar "&cФаербол на КД!" to player
                        stop
                # Заряд маны (L5+) — пометить следующий фаербол
                set {_charged} to false
                if {mage_charge::%{_u}%} is set:
                    if {mage_charge::%{_u}%} > unix timestamp of now:
                        set {_charged} to true
                    delete {mage_charge::%{_u}%}
                # Перк A "Метеор": большой фаербол доступен с L1 (КД 20с)
                if {perk::%{_u}%} is "mage_A":
                    shoot a fireball from player at speed 2
                    set {fireball_shooter::%uuid of last spawned entity%} to {_u}
                    if {_charged} is true:
                        set {fireball_charged::%uuid of last spawned entity%} to true
                    set cooldown of blaze rod for player to 20 seconds
                    play sound "entity.ghast.shoot" with volume 1 and pitch 0.7 at player for all players
                    if {_charged} is true:
                        send action bar "&c&lМЕТЕОР!" to player
                    else:
                        send action bar "&c&lМЕТЕОР!" to player
                    stop
                if {_l} >= 25:
                    shoot a fireball from player at speed 2
                    set {fireball_shooter::%uuid of last spawned entity%} to {_u}
                    if {_charged} is true:
                        set {fireball_charged::%uuid of last spawned entity%} to true
                    set cooldown of blaze rod for player to 8 seconds
                    if {_charged} is true:
                        send action bar "&c&lБОЛЬШОЙ ФАЕРБОЛ!" to player
                    else:
                        send action bar "&c&lБОЛЬШОЙ ФАЕРБОЛ!" to player
                else:
                    shoot a small fireball from player at speed 2
                    set {fireball_shooter::%uuid of last spawned entity%} to {_u}
                    if {_charged} is true:
                        set {fireball_charged::%uuid of last spawned entity%} to true
                    set cooldown of blaze rod for player to 4 seconds
                    if {_charged} is true:
                        send action bar "&d&lЗАРЯЖЕННЫЙ ФАЕРБОЛ!" to player
                    else:
                        send action bar "&6&lФаербол!" to player
                stop

        # MAGE L10: Масс-хил зельем (радиус 6)
        if {_l} >= 10:
            if "%{_tool}%" contains "potion":
                if {_nocd} is false:
                    if cooldown of splash potion for player > 0 seconds:
                        send action bar "&cМасс-хил на КД!" to player
                        stop
                cancel event
                set {_n} to 0
                loop all players in radius 6 around player:
                    heal loop-player by 4
                    apply regeneration 2 without particles to loop-player for 4 seconds
                    add 1 to {_n}
                play sound "block.beacon.activate" at player for all players
                set cooldown of splash potion for player to 30 seconds
                send action bar "&a&lМАСС-ХИЛ!" to player
                stop

# ==========================================
# ARCHER L8/L20 — Многозарядность и Магический колчан
# ==========================================
on shoot:
    if shooter is a player:
        if projectile is an arrow:
            set {_su} to uuid of shooter
            if {class::%{_su}%} is "Archer":
                set {_lv} to {level::%{_su}%} ? 1
                # L8 — каждая 5-я стрела возвращается обратно в инвентарь
                if {_lv} >= 8:
                    add 1 to {archer_shots::%{_su}%}
                    if {archer_shots::%{_su}%} >= 5:
                        set {archer_shots::%{_su}%} to 0
                        give 1 arrow to shooter
                        send action bar "&e&lМНОГОЗАРЯДНОСТЬ!" to shooter
                # L20 — каждая 4-я стрела магическая (+3 урон + поджиг)
                if {_lv} >= 20:
                    add 1 to {archer_quiver::%{_su}%}
                    if {archer_quiver::%{_su}%} >= 4:
                        set {archer_quiver::%{_su}%} to 0
                        set {arrow_magic::%uuid of projectile%} to true
                        send action bar "&5&lМАГИЧЕСКИЙ КОЛЧАН!" to shooter
            # Легендарка Archer: автонаводка стрел
            if hasArtifact(shooter, "leg_archer") is true:
                set {arrow_homing::%uuid of projectile%} to true
                set {arrow_homing_suuid::%uuid of projectile%} to uuid of shooter
                delete {arrow_homing_tuuid::%uuid of projectile%}

every 1 tick:
    loop all projectiles:
        set {_pid} to uuid of loop-value
        if {arrow_homing::%{_pid}%} is true:
            if loop-value is not an arrow:
                delete {arrow_homing::%{_pid}%}
                delete {arrow_homing_suuid::%{_pid}%}
                delete {arrow_homing_tuuid::%{_pid}%}
            else if loop-value is on ground:
                delete {arrow_homing::%{_pid}%}
                delete {arrow_homing_suuid::%{_pid}%}
                delete {arrow_homing_tuuid::%{_pid}%}
            else:
                set {_ouid} to {arrow_homing_suuid::%{_pid}%}
                if {_ouid} is set:
                    set {_owner} to player from {_ouid}
                    if {_owner} is not a player:
                        delete {arrow_homing::%{_pid}%}
                        delete {arrow_homing_suuid::%{_pid}%}
                        delete {arrow_homing_tuuid::%{_pid}%}
                        set {_owner_ok} to false
                    else:
                        set {_owner_ok} to true
                    if {_owner_ok} is true:
                        set {_aloc} to location of loop-value
                        delete {_near}
                        # 1) Пытаемся вести стрелу к уже зафиксированной цели
                        set {_tuuid} to {arrow_homing_tuuid::%{_pid}%}
                        if {_tuuid} is set:
                            for each {_cand} in all living entities in radius 40 around {_aloc}:
                                if {_near} is not set:
                                    if "%uuid of {_cand}%" is {_tuuid}:
                                        set {_near} to {_cand}
                        # 2) Если цели ещё нет/потерялась — выбираем ближайшую и фиксируем
                        if {_near} is not set:
                            set {_nearD} to 10
                            for each {_cand} in all living entities in radius 10 around {_aloc}:
                                if {_cand} is not {_owner}:
                                    if {_cand} is not an armor stand:
                                        set {_ok} to true
                                        if {_cand} is a player:
                                            if areDuo({_owner}, {_cand}) is true:
                                                set {_ok} to false
                                        if {_ok} is true:
                                            set {_dd} to distance between {_aloc} and {_cand}
                                            if {_dd} < {_nearD}:
                                                set {_nearD} to {_dd}
                                                set {_near} to {_cand}
                            if {_near} is set:
                                set {arrow_homing_tuuid::%{_pid}%} to "%uuid of {_near}%"
                        if {_near} is set:
                            set {_nearD} to distance between {_aloc} and {_near}
                            # Финишный захват: вблизи цели принудительно засчитываем попадание,
                            # чтобы стрела не "кружила" рядом из-за частых телепортов.
                            if {_nearD} <= 2.35:
                                damage {_near} by 2 with fake damage cause projectile
                                if {arrow_magic::%{_pid}%} is true:
                                    damage {_near} by 1 with fake damage cause projectile
                                    ignite {_near} for 3 seconds
                                    delete {arrow_magic::%{_pid}%}
                                # Комбат-лог только за PvP: по мобам лега не должна вводить стрелка в бой
                                if {_near} is a player:
                                    if {_owner} is a player:
                                        tagCombat({_owner})
                                    tagCombat({_near})
                                delete {arrow_homing::%{_pid}%}
                                delete {arrow_homing_suuid::%{_pid}%}
                                delete {arrow_homing_tuuid::%{_pid}%}
                                delete loop-value
                            else:
                                set {_tloc} to location of {_near}
                                add 1 to y-coordinate of {_tloc}
                                set {_dx} to x-coordinate of {_tloc} - x-coordinate of {_aloc}
                                set {_dy} to y-coordinate of {_tloc} - y-coordinate of {_aloc}
                                set {_dz} to z-coordinate of {_tloc} - z-coordinate of {_aloc}
                                set {_len} to distance between {_aloc} and {_tloc}
                                if {_len} > 0.01:
                                    set {_nloc} to location of loop-value
                                    if {_nearD} <= 3:
                                        set {_pull} to 2.2
                                    else:
                                        set {_pull} to 1.35
                                    add ({_dx} / {_len}) * {_pull} to x-coordinate of {_nloc}
                                    add ({_dy} / {_len}) * {_pull} to y-coordinate of {_nloc}
                                    add ({_dz} / {_len}) * {_pull} to z-coordinate of {_nloc}
                                    teleport loop-value to {_nloc}

# Бонус урона: магические стрелы лучника и заряженные фаерболы мага
on damage:
    if attacker is an arrow:
        delete {arrow_homing::%uuid of attacker%}
        delete {arrow_homing_suuid::%uuid of attacker%}
        delete {arrow_homing_tuuid::%uuid of attacker%}
        if {arrow_magic::%uuid of attacker%} is true:
            set damage to damage + 3
            if victim is a living entity:
                ignite victim for 3 seconds
            delete {arrow_magic::%uuid of attacker%}
    if attacker is a fireball:
        if {fireball_charged::%uuid of attacker%} is true:
            set damage to damage * 1.5
            delete {fireball_charged::%uuid of attacker%}
        # Mage L23: +25% урон фаерболами (стрелок записан при касте)
        set {_fbid} to uuid of attacker
        set {_shu} to {fireball_shooter::%{_fbid}%}
        delete {fireball_shooter::%{_fbid}%}
        if {_shu} is set:
            set {_sh} to player from {_shu}
            if {_sh} is a player:
                if classOf({_sh}) is "Mage":
                    if levelOf({_sh}) >= 23:
                        set damage to damage * 1.25

# Легендарка Scout: удар по фантом-двойнику
on damage:
    if victim is an armor stand:
        set {_du} to uuid of victim
        if {leg_scout_decoy_owner::%{_du}%} is set:
            cancel event
            set {_ou} to {leg_scout_decoy_owner::%{_du}%}
            set {_ownerScout} to player from {_ou}
            set {_boom} to location of victim
            play sound "entity.generic.explode" with volume 0.9 and pitch 1.2 at {_boom} for all players
            strike lightning effect at {_boom}
            loop all living entities in radius 5 around {_boom}:
                set {_affect} to true
                if {_ownerScout} is a player:
                    if loop-entity is {_ownerScout}:
                        set {_affect} to false
                    if loop-entity is a player:
                        if areDuo({_ownerScout}, loop-entity) is true:
                            set {_affect} to false
                if {_affect} is true:
                    applyCappedDebuff(loop-entity, "slowness", "slowness", 2, 4)
                    applyCappedDebuff(loop-entity, "blindness", "blindness", 1, 3)
                    applyCappedDebuff(loop-entity, "glowing", "glowing", 1, 5)
            delete {leg_scout_decoy_owner::%{_du}%}
            delete victim

# Запрет взаимодействия с фантом-двойником (нельзя снять экипировку)
on right click on armor stand:
    set {_du} to uuid of event-entity
    if {leg_scout_decoy_owner::%{_du}%} is set:
        cancel event

# Запрет зачарования классовых предметов (стол опыта)
on enchant prepare:
    if isClassItem(enchant item) is true:
        cancel event
        stop

# Наковальня: классовые предметы (PrepareAnvil в Skript нельзя cancel — блокируем клики по слотам 1 и 2)
on inventory click:
    if event-inventory is set:
        if type of event-inventory is anvil inventory:
            if clicked inventory is event-inventory:
                set {_av0} to slot 0 of event-inventory
                set {_av1} to slot 1 of event-inventory
                set {_anvilBad} to false
                if isClassItem({_av0}) is true:
                    set {_anvilBad} to true
                if isClassItem({_av1}) is true:
                    set {_anvilBad} to true
                if {_anvilBad} is true:
                    set {_as} to index of event-slot
                    if {_as} is not set:
                        set {_as} to clicked slot
                    # слот 0 — можно только забрать/положить базовый предмет; слоты 1–2 — книга/имя/результат
                    if {_as} is 1:
                        cancel event
                        send "{@prefix} &cКлассовые предметы нельзя зачаровать или менять на наковальне." to player
                        stop
                    if {_as} is 2:
                        cancel event
                        send "{@prefix} &cКлассовые предметы нельзя зачаровать или менять на наковальне." to player
                        stop

# ==========================================
# SCOUT L25: Иммунитет к падению
# ==========================================
# ==========================================
# GUI ВЫБОРА КЛАССА
# ==========================================
command /wstats:
    aliases: /weapons, /wlvl
    trigger:
        set {_u} to player's uuid
        send "&8&l------ &6Уровни Оружия &8&l------"
        loop "sword", "axe", "bow" and "mace":
            set {_t} to loop-value
            set {_lvl} to {wlvl::%{_u}%::%{_t}%} ? 1
            set {_xp} to {wxp::%{_u}%::%{_t}%} ? 0
            set {_need} to wXPNeeded({_lvl})
            set {_bonus} to ({_lvl} - 1) * 6
            if {_lvl} >= wMaxLevel():
                send "%weaponName({_t})% &8» &eLv &6%{_lvl}% &8(MAX) &8| &a+%{_bonus}%%% урона"
            else:
                send "%weaponName({_t})% &8» &eLv &a%{_lvl}% &8| &b%{_xp}%&7/%{_need}% XP &8| &a+%{_bonus}%%%"
        # Урон от оружия в руке
        set {_curTool} to player's tool
        set {_tt} to weaponType({_curTool})
        if {_tt} is not "none":
            set {_eff} to effectiveDamage(player, {_curTool})
            set {_base} to baseDamage({_curTool})
            send " "
            send "&7В руке: &f%{_curTool}%"
            send "&7База &f%{_base}% &8→ &7Итого &c%{_eff}% &7урона"
        else if {_curTool} is blaze rod:
            if classOf(player) is "Mage":
                set {_eff} to effectiveDamage(player, blaze rod)
                send " "
                send "&7В руке: &dПосох Мага"
                send "&7Урон: &c%{_eff}% &8+ &c2 сек огня"
        send "&8&l-------------------------------"

command /class:
    trigger:
        set {_u} to player's uuid
        if {class::%{_u}%} is set:
            if {class::%{_u}%} is not "None":
                if {class_lock::%{_u}%} is not true:
                    if {level::%{_u}%} < {@max_level}:
                        send "{@prefix} &cСмена класса доступна только на макс. уровне!"
                        stop

        open chest inventory with 3 rows named "&8Choose your Class" to player
        loop 27 times:
            set slot (loop-number - 1) of player's current inventory to gray stained glass pane named " "

        set slot 9 of player's current inventory to iron sword named "&c&lWarrior"
        set lore of slot 9 of player's current inventory to "&7Танк-DPS ближнего боя", " ", "&8• &fДуал-меч (одинаковый материал = +скорость атаки)", "&8• &fСила при низком ❤", "&8• &fПарирование на L20 (возврат урона)"

        set slot 10 of player's current inventory to feather named "&b&lScout"
        set lore of slot 10 of player's current inventory to "&7Мобильный убийца", " ", "&8• &fSpeed I пассивно", "&8• &fКрит в спину +25%%", "&8• &fРывок на L5", "&8• &fИнвиз на L10", "&8• &fИммунитет к падению L25"

        set slot 11 of player's current inventory to shield named "&6&lTank"
        set lore of slot 11 of player's current inventory to "&7Защитник команды", " ", "&8• &fL25: &f20 ❤ &7макс.", "&8• &fДо L25: &f10 ❤ &7как у всех", "&8• &f-15%% получ. урона", "&8• &fШипы ½❤ на L10", "&8• &fАура защитника L15"

        set slot 12 of player's current inventory to bow named "&e&lArcher"
        set lore of slot 12 of player's current inventory to "&7Урон с дистанции", " ", "&8• &fSpeed I пассивно", "&8• &f+10%% урона луком", "&8• &f25%% крит x2 на L5", "&8• &fx1.4 урон на L10", "&8• &fОрлиный взор L25"

        set slot 13 of player's current inventory to blaze rod named "&d&lMage"
        set lore of slot 13 of player's current inventory to "&7Магия и поддержка", " ", "&8• &fФаербол с L1", "&8• &fРеген после килла", "&8• &fМасс-хил на L10", "&8• &fЭндер-перл L15", "&8• &fБольшой фаербол L25"

        set slot 14 of player's current inventory to bone named "&2&lNecromancer"
        set lore of slot 14 of player's current inventory to "&7Повелитель мёртвых", " ", "&8• &fПризыв миньона (КД 30с)", "&8• &fКостяной молот + Кража жизни", "&8• &fМетка смерти (L5) +20%% урона", "&8• &fДуша мстителя (L15)", "&8• &fАура смерти Wither (L20)", "&8• &fВосставший чемпион (L25)"

        # ===== Плейсхолдеры под будущие классы (справа подряд) =====
        set slot 15 of player's current inventory to barrier named "&8&l? ? ?"
        set lore of slot 15 of player's current inventory to "&7Слот под &fновый класс", " ", "&8Скоро..."

        set slot 16 of player's current inventory to barrier named "&8&l? ? ?"
        set lore of slot 16 of player's current inventory to "&7Слот под &fновый класс", " ", "&8Скоро..."

        set slot 17 of player's current inventory to barrier named "&8&l? ? ?"
        set lore of slot 17 of player's current inventory to "&7Слот под &fновый класс", " ", "&8Скоро..."


on inventory click:
    if name of event-inventory is "&8Choose your Class":
        cancel event
        if clicked inventory is player's current inventory:
            set {_n} to "None"
            if index of event-slot is 9:
                set {_n} to "Warrior"
            else if index of event-slot is 10:
                set {_n} to "Scout"
            else if index of event-slot is 11:
                set {_n} to "Tank"
            else if index of event-slot is 12:
                set {_n} to "Archer"
            else if index of event-slot is 13:
                set {_n} to "Mage"
            else if index of event-slot is 14:
                set {_n} to "Necromancer"

            if {_n} is not "None":
                set {class::%player's uuid%} to {_n}
                set {class_lock::%player's uuid%} to false
                set {level::%player's uuid%} to 1
                set {kills::%player's uuid%} to 0
                delete {perk::%player's uuid%}
                delete {perk_notified::%player's uuid%}
                close player's inventory
                send "{@prefix} &aВы выбрали: &l%{_n}%"
                giveClassKit(player)

# ==========================================
# АДМИН GUI АРТЕФАКТОВ
# ==========================================
command /artifacts:
    trigger:
        open chest inventory with 3 rows named "&8Artifacts Core" to player
        dbgEvo(player, "opened /artifacts GUI")
        loop 27 times:
            set slot (loop-number - 1) of player's current inventory to gray stained glass pane named " "

        set slot 4 of player's current inventory to nether star named "&6&lАРТЕФАКТЫ: ЯДРО"
        set lore of slot 4 of player's current inventory to "&75 слотов ядра (обычные артефакты)", "&7ПКМ: включить/выключить", "&7ЛКМ: извлечь в предмет", "&7Легендарные: &e/legendary"

        loop 5 times:
            set {_idx} to loop-number
            set {_slot} to 10 + loop-number
            set {_key} to artifactCoreKeyByIndex(player, {_idx})
            if {_key} is "":
                set slot {_slot} of player's current inventory to black stained glass pane named "&8Пустой слот ядра"
            else:
                set {_s} to artifactSlotFromKey({_key})
                if {_s} >= 0:
                    set {_art} to artifactMenuItem(player, {_s})
                    if {_art} is not air:
                        set slot {_slot} of player's current inventory to {_art}

on inventory click:
    if name of event-inventory contains "Artifacts Core":
        cancel event
        set {_slot} to index of event-slot
        if {_slot} is not between 0 and 26:
            stop
        set {_i} to artifactCoreGuiIndexBySlot({_slot})
        if {_i} is 0:
            stop
        set {_key} to artifactCoreKeyByIndex(player, {_i})
        if {_key} is "":
            stop
        set {_u} to uuid of player
        set {_enabled_now} to {art_enabled::%{_u}%::%{_key}%} ? false
        set {_click} to "%click type%"
        set {_isLeft} to false
        set {_isRight} to false
        if {_click} contains "left mouse button":
            set {_isLeft} to true
        if {_click} contains "right mouse button":
            set {_isRight} to true
        if {_isLeft} is true:
            if pullArtifactFromCore(player, {_key}) is true:
                send "{@prefix} &eАртефакт извлечён в предмет."
                play sound "item.bundle.remove_one" with volume 0.9 and pitch 1 at player for player
        else if {_isRight} is true:
            if {_enabled_now} is true:
                set {art_enabled::%{_u}%::%{_key}%} to false
            else:
                set {art_enabled::%{_u}%::%{_key}%} to true
            set {_enabled_after} to {art_enabled::%{_u}%::%{_key}%} ? false
            if {_key} is "cloudjump":
                if {_enabled_after} is false:
                    resetBalloonState(player)
            if {_enabled_after} is true:
                send "{@prefix} &aЭффект артефакта включён."
                play sound "entity.experience_orb.pickup" with volume 1 and pitch 1.2 at player for player
            else:
                send "{@prefix} &cЭффект артефакта выключен."
                play sound "block.note_block.bass" with volume 1 and pitch 0.8 at player for player
        else:
            stop
        # Перерисовываем 5 слотов после любого изменения.
        wait 1 tick
        loop 5 times:
            set {_idx} to loop-number
            set {_rslot} to 10 + loop-number
            set {_rkey} to artifactCoreKeyByIndex(player, {_idx})
            if {_rkey} is "":
                set slot {_rslot} of player's current inventory to black stained glass pane named "&8Пустой слот ядра"
            else:
                set {_rs} to artifactSlotFromKey({_rkey})
                if {_rs} >= 0:
                    set {_rit} to artifactMenuItem(player, {_rs})
                    if {_rit} is not air:
                        set slot {_rslot} of player's current inventory to {_rit}

command /legendary:
    trigger:
        open chest inventory with 3 rows named "&8Legendary Core" to player
        loop 27 times:
            set slot (loop-number - 1) of player's current inventory to black stained glass pane named " "
        loop 0, 1, 2, 6, 8, 9, 11, 15, 17, 18, 19, 20, 24, 25 and 26:
            set slot loop-value of player's current inventory to orange stained glass pane named " "
        set slot 4 of player's current inventory to nether star named "&6&l✦ ЛЕГЕНДАРНЫЙ АРТЕФАКТ ✦"
        set lore of slot 4 of player's current inventory to "&7Твой активный легендарный слот", "&7по текущему классу.", " ", "&aПКМ: включить/выключить", "&eЛКМ: извлечь в предмет"
        set slot 22 of player's current inventory to barrier named "&c&lЗакрыть"
        set lore of slot 22 of player's current inventory to "&7Нажми, чтобы закрыть меню"
        set {_k} to classLegendaryKey(player)
        if {_k} is "":
            set slot 13 of player's current inventory to barrier named "&cЛегендарка недоступна" with lore "&7Сначала выбери класс через &e/class", "&7Затем вернись в это меню"
            stop
        set {_s} to artifactSlotFromKey({_k})
        if {_s} < 0:
            set slot 13 of player's current inventory to barrier named "&cОшибка легендарки класса"
            stop
        set {_it} to artifactMenuItem(player, {_s})
        if {_it} is air:
            set slot 13 of player's current inventory to barrier named "&cЛегендарный артефакт недоступен"
        else:
            set slot 13 of player's current inventory to {_it}

on inventory click:
    if name of event-inventory contains "Legendary Core":
        cancel event
        if clicked inventory is not player's current inventory:
            stop
        set {_slot} to index of event-slot
        if {_slot} is 22:
            close player's inventory
            stop
        if {_slot} is not 13:
            stop
        set {_k} to classLegendaryKey(player)
        if {_k} is "":
            send "{@prefix} &cВыбери класс, чтобы использовать легендарный артефакт."
            stop
        set {_u} to player's uuid
        set {_owned} to {art_found::%{_u}%::%{_k}%} ? false
        if {_owned} is false:
            send "{@prefix} &cЭтот легендарный артефакт ещё не найден."
            send "{@prefix} &7Выдача: &e/evo <ник> artifactgive %{_k}%"
            play sound "entity.villager.no" with volume 0.7 and pitch 1 at player for player
            stop
        set {_click} to "%click type%"
        if {_click} contains "left mouse button":
            if pullArtifactFromCore(player, {_k}) is true:
                send "{@prefix} &eЛегендарный артефакт извлечён в предмет."
                play sound "item.bundle.remove_one" with volume 0.9 and pitch 1 at player for player
        else if {_click} contains "right mouse button":
            set {_now} to {art_enabled::%{_u}%::%{_k}%} ? false
            if {_now} is true:
                set {art_enabled::%{_u}%::%{_k}%} to false
                send "{@prefix} &cЛегендарный эффект выключен."
            else:
                loop "leg_warrior", "leg_scout", "leg_tank", "leg_archer", "leg_mage" and "leg_necro":
                    if loop-value is not {_k}:
                        set {art_enabled::%{_u}%::%loop-value%} to false
                set {art_enabled::%{_u}%::%{_k}%} to true
                send "{@prefix} &aЛегендарный эффект включён."
            play sound "entity.experience_orb.pickup" with volume 1 and pitch 1.2 at player for player
        set {_s} to artifactSlotFromKey({_k})
        set {_it} to artifactMenuItem(player, {_s})
        if {_it} is not air:
            set slot 13 of player's current inventory to {_it}

command /artifactpull <text>:
    trigger:
        set {_id} to arg-1 in lower case
        if {_id} is "all":
            set {_c} to 0
            loop "leg_warrior", "leg_scout", "leg_tank", "leg_archer", "leg_mage", "leg_necro", "hermes", "windring", "vampcharm", "etherdash", "mehrunes", "starfury", "icewalker", "frostheart", "ankhshield", "azura", "rottenapple", "voidcompass", "luckcoin", "cloudjump" and "crownmind":
                if pullArtifactFromCore(player, loop-value) is true:
                    add 1 to {_c}
            if {_c} > 0:
                send "{@prefix} &aИз ядра извлечено артефактов: &e%{_c}%"
                play sound "item.bundle.remove_one" with volume 0.9 and pitch 1 at player for player
            else:
                send "{@prefix} &7В ядре нет артефактов для извлечения."
            stop
        if {_id} is not "leg_warrior", "leg_scout", "leg_tank", "leg_archer", "leg_mage", "leg_necro", "hermes", "windring", "vampcharm", "etherdash", "mehrunes", "starfury", "icewalker", "frostheart", "ankhshield", "azura", "rottenapple", "voidcompass", "luckcoin", "cloudjump" or "crownmind":
            send "{@prefix} &cНеизвестный id артефакта."
            send "&7ID: &fleg_warrior, leg_scout, leg_tank, leg_archer, leg_mage, leg_necro, hermes, windring, vampcharm, etherdash, mehrunes, starfury, icewalker, frostheart, ankhshield, azura, rottenapple, voidcompass, luckcoin, cloudjump, crownmind"
            stop
        if pullArtifactFromCore(player, {_id}) is true:
            send "{@prefix} &aАртефакт &e%{_id}% &aизвлечён из ядра в предмет."
            play sound "item.bundle.remove_one" with volume 0.9 and pitch 1 at player for player
        else:
            send "{@prefix} &7Этот артефакт не найден в твоём ядре."

# ==========================================
# АДМИН-КОМАНДЫ
# ==========================================
command /evoruinspawn:
    permission: evo.admin
    permission message: {@prefix} &cУ вас нет прав!
    trigger:
        if artifactRuinAdminSpawnHere(player) is true:
            send "{@prefix} &aПостроена руина: &7чёрный камень = легендарный артефакт, &fцветной пол = обычный&a. Сундук в башне."
            play sound "block.beacon.activate" with volume 1 and pitch 1.2 at player for player
        else:
            send "{@prefix} &cНе удалось: нужен Оверворлд и твёрдая поверхность под колонкой X/Z."

command /evoruinlegspawn:
    permission: evo.admin
    permission message: {@prefix} &cУ вас нет прав!
    trigger:
        if artifactRuinAdminSpawnHereKind(player, "legendary") is true:
            send "{@prefix} &6Построена &lлегендарная&6 руина: &7чернокаменный стиль, в сундуке башни — &6легендарный&7 артефакт."
            play sound "block.respawn_anchor.set_spawn" with volume 1 and pitch 1.15 at player for player
        else:
            send "{@prefix} &cНе удалось: нужен Оверворлд и твёрдая поверхность под колонкой X/Z."

command /evogive <text> [<number>] [<player>]:
    permission: evo.admin
    permission message: {@prefix} &cУ вас нет прав!
    trigger:
        set {_id} to arg-1 in lower case
        set {_it} to evoAdminItemById({_id})
        if {_it} is air:
            send "{@prefix} &cНеизвестный id предмета: &e%{_id}%"
            send "&7Примеры: &fvoid_key, return_key, altar_hopper, ether_pick, flame_pick, vein_pick, fortune_pick, void_pick, omni_pick"
            send "&7Артефакты: &fleg_warrior, leg_scout, leg_tank, leg_archer, leg_mage, leg_necro, hermes, windring, vampcharm, etherdash, mehrunes, starfury, icewalker, frostheart, ankhshield, azura, rottenapple, voidcompass, luckcoin, cloudjump, crownmind"
            send "&7Новые: &fheater, dreamcatcher, desertheart, quantdup, facelessmask, cursedgift"
            send "&7Свитки: &fscroll_heater, scroll_dreamcatcher, scroll_desertheart, scroll_quantdup, scroll_facelessmask, scroll_cursedgift"
            stop

        set {_amount} to arg-2 parsed as number
        if {_amount} is not set:
            set {_amount} to 1
        if {_amount} < 1:
            set {_amount} to 1
        if {_amount} > 64:
            set {_amount} to 64
        set amount of {_it} to {_amount}

        set {_target} to player
        if arg-3 is set:
            set {_target} to arg-3
        if {_target} is not set:
            send "{@prefix} &cЦелевой игрок не найден."
            stop

        giveOrDrop({_it}, {_target}, location of {_target})
        send "{@prefix} &aВыдано: &e%{_id}% &7x%{_amount}% &aигроку &e%{_target}%&a."
        if {_target} is not player:
            send "{@prefix} &aАдмин выдал вам: &e%{_id}% &7x%{_amount}%" to {_target}

command /evo [<offline player>] [<text>] [<text>]:
    permission: evo.admin
    permission message: {@prefix} &cУ вас нет прав!
    trigger:
        if arg-1 is not set:
            send "&8&l--- {@prefix} &6ADMIN HELP &8&l---"
            send "&e/evo <player> setlevel <num>"
            send "&e/evo <player> setkills <num>"
            send "&e/evo <player> setclass <Warrior|Scout|Tank|Archer|Mage|None>"
            send "&e/evo <player> setperk <id|clear>"
            send "&e/evo <player> givehead [amount]"
            send "&e/evo <player> artifactgive <id|all>"
            send "&e/evo <player> cooldown <on|off>"
            send "&e/evo <player> sync"
            send "&e/evo <player> debug"
            send "&e/evo <player> reset"
            send "&e/evoruinspawn &7— тест: руина (тип как при спавне в мире)"
            send "&e/evoruinlegspawn &7— тест: &6легендарная&7 руина под ногами"
            send "&8&l----------------------------"
            stop

        set {_u} to uuid of arg-1

        if arg-2 is "setlevel":
            set {_val} to arg-3 parsed as number
            if {_val} is set:
                set {_fixed} to clampLevel({_val})
                set {level::%{_u}%} to {_fixed}
                set {kills::%{_u}%} to ({_fixed} - 1) * {@kills_per_level}
                send "{@prefix} &fУровень &e%arg-1%&f → &a%{_fixed}% &7(kill-опыт синхронизирован)"
            else:
                send "{@prefix} &cИспользование: /evo <player> setlevel <число>"

        else if arg-2 is "setkills":
            set {_val} to arg-3 parsed as number
            if {_val} is set:
                set {_val} to clampKills({_val})
                set {kills::%{_u}%} to {_val}
                set {level::%{_u}%} to calcLevel({_val})
                send "{@prefix} &fКиллы &e%arg-1%&f → &a%{_val}% &7(уровневые, макс 49)"
            else:
                send "{@prefix} &cИспользование: /evo <player> setkills <число>"

        else if arg-2 is "setclass":
            if arg-3 is "Warrior", "Scout", "Tank", "Archer", "Mage", "Necromancer" or "None":
                set {class::%{_u}%} to arg-3
                if arg-3 is "None":
                    delete {perk::%{_u}%}
                    delete {perk_notified::%{_u}%}
                send "{@prefix} &fКласс &e%arg-1%&f → &a%arg-3%"
                if arg-1 is online:
                    giveClassKit(arg-1)
            else:
                send "{@prefix} &cКлассы: Warrior, Scout, Tank, Archer, Mage, Necromancer, None"

        else if arg-2 is "setperk":
            if arg-3 is not set:
                send "{@prefix} &cИспользование: /evo <player> setperk <id|clear>"
                stop
            if arg-3 is "clear":
                delete {perk::%{_u}%}
                delete {perk_notified::%{_u}%}
                send "{@prefix} &fПерк &e%arg-1%&f → &aочищен"
                stop
            if arg-3 is "warrior_A", "warrior_B", "warrior_C", "warrior_D", "scout_A", "scout_B", "scout_C", "scout_D", "tank_A", "tank_B", "tank_C", "tank_D", "archer_A", "archer_B", "archer_C", "archer_D", "mage_A", "mage_B", "mage_C", "mage_D", "necro_A", "necro_B", "necro_C", "necro_D":
                set {perk::%{_u}%} to arg-3
                set {perk_notified::%{_u}%} to true
                send "{@prefix} &fПерк &e%arg-1%&f → &a%arg-3%"
                if arg-1 is online:
                    send "{@prefix} &aАдмин выдал вам перк: &e%arg-3%" to arg-1
            else:
                send "{@prefix} &cНеверный id перка. Пример: warrior_A или necro_D"

        else if arg-2 is "givehead":
            if arg-1 is not online:
                send "{@prefix} &cИгрок должен быть онлайн для выдачи головы."
                stop
            set {_n} to arg-3 parsed as number
            if {_n} is not set:
                set {_n} to 1
            if {_n} < 1:
                set {_n} to 1
            if {_n} > 64:
                set {_n} to 64
            set {_h} to player head
            set amount of {_h} to {_n}
            set name of {_h} to "&eГолова игрока"
            set lore of {_h} to "&7ПКМ — поглотить и получить &a+1 опыта"
            set {_t} to arg-1
            if {_t} is set:
                give {_h} to {_t}
            send "{@prefix} &aВыдано &e%{_n}% &aголов игроку &e%arg-1%&a."

        else if arg-2 is "artifactgive":
            if arg-3 is not set:
                send "{@prefix} &eИспользование: /evo <player> artifactgive <id|all>"
                send "&7ID: &fleg_warrior, leg_scout, leg_tank, leg_archer, leg_mage, leg_necro, hermes, windring, vampcharm, etherdash, mehrunes, starfury, icewalker, frostheart, ankhshield, azura, rottenapple, voidcompass, luckcoin, cloudjump, crownmind"
                stop
            if arg-1 is not online:
                send "{@prefix} &cИгрок должен быть онлайн для выдачи предмета артефакта."
                stop
            set {_t} to arg-1
            set {_id} to arg-3 in lower case
            if {_id} is "all":
                loop "leg_warrior", "leg_scout", "leg_tank", "leg_archer", "leg_mage", "leg_necro", "hermes", "windring", "vampcharm", "etherdash", "mehrunes", "starfury", "icewalker", "frostheart", "ankhshield", "azura", "rottenapple", "voidcompass", "luckcoin", "cloudjump" and "crownmind":
                    set {_s} to artifactSlotFromKey(loop-value)
                    if {_s} >= 0:
                        set {_it} to artifactFromSlot({_s})
                        if {_it} is not air:
                            give {_it} to {_t}
                send "{@prefix} &aИгроку &e%arg-1% &aвыданы все артефакты предметами в инвентарь."
                send "{@prefix} &aТебе выданы предметы артефактов. Поглощение: возьми в руку и нажми &eПКМ&a." to {_t}
                stop
            if {_id} is not "leg_warrior", "leg_scout", "leg_tank", "leg_archer", "leg_mage", "leg_necro", "hermes", "windring", "vampcharm", "etherdash", "mehrunes", "starfury", "icewalker", "frostheart", "ankhshield", "azura", "rottenapple", "voidcompass", "luckcoin", "cloudjump" or "crownmind":
                send "{@prefix} &cНеизвестный id артефакта."
                send "&7ID: &fleg_warrior, leg_scout, leg_tank, leg_archer, leg_mage, leg_necro, hermes, windring, vampcharm, etherdash, mehrunes, starfury, icewalker, frostheart, ankhshield, azura, rottenapple, voidcompass, luckcoin, cloudjump, crownmind"
                stop
            set {_s} to artifactSlotFromKey({_id})
            if {_s} < 0:
                send "{@prefix} &cНе удалось определить слот артефакта (%{_id}%)."
                stop
            set {_it} to artifactFromSlot({_s})
            if {_it} is air:
                send "{@prefix} &cНе удалось создать предмет артефакта (%{_id}%)."
                stop
            give {_it} to {_t}
            send "{@prefix} &aАртефакт &e%{_id}% &aвыдан игроку &e%arg-1% &aпредметом в инвентарь."
            send "{@prefix} &aТебе выдан артефакт-предмет: &e%{_id}%&a. Поглощение: возьми в руку и нажми &eПКМ&a." to {_t}

        else if arg-2 is "artifactpull":
            if arg-3 is not set:
                send "{@prefix} &eИспользование: /evo <player> artifactpull <id|all>"
                send "&7ID: &fleg_warrior, leg_scout, leg_tank, leg_archer, leg_mage, leg_necro, hermes, windring, vampcharm, etherdash, mehrunes, starfury, icewalker, frostheart, ankhshield, azura, rottenapple, voidcompass, luckcoin, cloudjump, crownmind"
                stop
            set {_id} to arg-3 in lower case
            if {_id} is "all":
                loop "leg_warrior", "leg_scout", "leg_tank", "leg_archer", "leg_mage", "leg_necro", "hermes", "windring", "vampcharm", "etherdash", "mehrunes", "starfury", "icewalker", "frostheart", "ankhshield", "azura", "rottenapple", "voidcompass", "luckcoin", "cloudjump" and "crownmind":
                    if {art_found::%{_u}%::%loop-value%} is true:
                        set {_s} to artifactSlotFromKey(loop-value)
                        set {_it} to artifactFromSlot({_s})
                        if {_it} is not air:
                            set {art_found::%{_u}%::%loop-value%} to false
                            set {art_enabled::%{_u}%::%loop-value%} to false
                            if arg-1 is online:
                                set {_t} to arg-1
                                if {_t} is set:
                                    give {_it} to {_t}
                send "{@prefix} &aВсе найденные артефакты извлечены из ядра игрока &e%arg-1%&a."
                if arg-1 is online:
                    send "{@prefix} &eВсе артефакты извлечены из ядра в предметы." to arg-1
                stop
            if {_id} is not "leg_warrior", "leg_scout", "leg_tank", "leg_archer", "leg_mage", "leg_necro", "hermes", "windring", "vampcharm", "etherdash", "mehrunes", "starfury", "icewalker", "frostheart", "ankhshield", "azura", "rottenapple", "voidcompass", "luckcoin", "cloudjump" or "crownmind":
                send "{@prefix} &cНеизвестный id артефакта."
                send "&7ID: &fleg_warrior, leg_scout, leg_tank, leg_archer, leg_mage, leg_necro, hermes, windring, vampcharm, etherdash, mehrunes, starfury, icewalker, frostheart, ankhshield, azura, rottenapple, voidcompass, luckcoin, cloudjump, crownmind"
                stop
            if {art_found::%{_u}%::%{_id}%} is not true:
                send "{@prefix} &cУ игрока нет этого артефакта в ядре."
                stop
            set {_s} to artifactSlotFromKey({_id})
            set {_it} to artifactFromSlot({_s})
            if {_it} is air:
                send "{@prefix} &cНе удалось создать предмет артефакта (%{_id}%)."
                stop
            set {art_found::%{_u}%::%{_id}%} to false
            set {art_enabled::%{_u}%::%{_id}%} to false
            if arg-1 is online:
                set {_t} to arg-1
                if {_t} is set:
                    give {_it} to {_t}
            send "{@prefix} &aАртефакт &e%{_id}% &aизвлечён из ядра игрока &e%arg-1%&a."
            if arg-1 is online:
                send "{@prefix} &eАртефакт &f%{_id}% &eизвлечён из ядра в предмет." to arg-1

        else if arg-2 is "cooldown":
            if arg-3 is not set:
                send "{@prefix} &cИспользование: /evo <player> cooldown <on|off>"
                stop
            if arg-3 is "off":
                if {admin_nocd::%{_u}%} is true:
                    send "{@prefix} &eКулдауны уже отключены для &e%arg-1%&e."
                    stop

                # Снапшот оставшихся кулдаунов: чтобы при включении обратно они восстановились
                set {admin_nocd_save_archer_eye_cd::%{_u}%} to {archer_eye_cd::%{_u}%} ? 0
                set {admin_nocd_save_warrior_secondwind_cd::%{_u}%} to {warrior_secondwind_cd::%{_u}%} ? 0
                set {admin_nocd_save_scout_bloodrush_cd::%{_u}%} to {scout_bloodrush_cd::%{_u}%} ? 0
                set {admin_nocd_save_scout_parachute_cd::%{_u}%} to {scout_parachute_cd::%{_u}%} ? 0
                set {admin_nocd_save_archer_triple_cd::%{_u}%} to {archer_triple_cd::%{_u}%} ? 0
                set {admin_nocd_save_mage_overload_cd::%{_u}%} to {mage_overload_cd::%{_u}%} ? 0
                set {admin_nocd_save_necro_grip_cd::%{_u}%} to {necro_grip_cd::%{_u}%} ? 0
                set {admin_nocd_save_tank_laststand_cd::%{_u}%} to {tank_laststand_cd::%{_u}%} ? 0
                set {admin_nocd_save_necro_lifesteal_until::%{_u}%} to {necro_lifesteal_until::%{_u}%} ? 0
                set {admin_nocd_save_scout_dash_window::%{_u}%} to {scout_dash_window::%{_u}%} ? 0

                if arg-1 is online:
                    set {admin_nocd_save_feather_cd::%{_u}%} to cooldown of feather for arg-1
                    set {admin_nocd_save_bone_cd::%{_u}%} to cooldown of bone for arg-1
                    set {admin_nocd_save_blaze_rod_cd::%{_u}%} to cooldown of blaze rod for arg-1
                    set {admin_nocd_save_splash_potion_cd::%{_u}%} to cooldown of splash potion for arg-1
                    set {admin_nocd_save_golden_apple_cd::%{_u}%} to cooldown of golden apple for arg-1
                    set {admin_nocd_save_mace_cd::%{_u}%} to cooldown of mace for arg-1
                    # Parry на мече использует vanilla cooldown оружия (cooldown of {_tool} for player),
                    # поэтому тоже делаем снапшот и восстановление.
                    set {admin_nocd_save_netherite_sword_cd::%{_u}%} to cooldown of netherite sword for arg-1
                    set {admin_nocd_save_diamond_sword_cd::%{_u}%} to cooldown of diamond sword for arg-1
                    set {admin_nocd_save_iron_sword_cd::%{_u}%} to cooldown of iron sword for arg-1
                    set {admin_nocd_save_golden_sword_cd::%{_u}%} to cooldown of golden sword for arg-1
                    set {admin_nocd_save_stone_sword_cd::%{_u}%} to cooldown of stone sword for arg-1
                    set {admin_nocd_save_wooden_sword_cd::%{_u}%} to cooldown of wooden sword for arg-1
                else:
                    delete {admin_nocd_save_feather_cd::%{_u}%}
                    delete {admin_nocd_save_bone_cd::%{_u}%}
                    delete {admin_nocd_save_blaze_rod_cd::%{_u}%}
                    delete {admin_nocd_save_splash_potion_cd::%{_u}%}
                    delete {admin_nocd_save_golden_apple_cd::%{_u}%}
                    delete {admin_nocd_save_mace_cd::%{_u}%}
                    delete {admin_nocd_save_netherite_sword_cd::%{_u}%}
                    delete {admin_nocd_save_diamond_sword_cd::%{_u}%}
                    delete {admin_nocd_save_iron_sword_cd::%{_u}%}
                    delete {admin_nocd_save_golden_sword_cd::%{_u}%}
                    delete {admin_nocd_save_stone_sword_cd::%{_u}%}
                    delete {admin_nocd_save_wooden_sword_cd::%{_u}%}

                set {admin_nocd::%{_u}%} to true
                send "{@prefix} &aКулдауны способностей для &e%arg-1% &aотключены."
                if arg-1 is online:
                    send "{@prefix} &6Тест-режим: &aкулдауны отключены." to arg-1
            else if arg-3 is "on":
                if {admin_nocd::%{_u}%} is not set:
                    send "{@prefix} &eКулдауны уже включены для &e%arg-1%&e."
                    stop

                delete {admin_nocd::%{_u}%}

                # Восстановить внутренние КД (таймеры/окна), которые очищались в noCooldownMode
                if {admin_nocd_save_archer_eye_cd::%{_u}%} > 0:
                    set {archer_eye_cd::%{_u}%} to {admin_nocd_save_archer_eye_cd::%{_u}%}
                else:
                    delete {archer_eye_cd::%{_u}%}
                if {admin_nocd_save_warrior_secondwind_cd::%{_u}%} > 0:
                    set {warrior_secondwind_cd::%{_u}%} to {admin_nocd_save_warrior_secondwind_cd::%{_u}%}
                else:
                    delete {warrior_secondwind_cd::%{_u}%}
                if {admin_nocd_save_scout_bloodrush_cd::%{_u}%} > 0:
                    set {scout_bloodrush_cd::%{_u}%} to {admin_nocd_save_scout_bloodrush_cd::%{_u}%}
                else:
                    delete {scout_bloodrush_cd::%{_u}%}
                if {admin_nocd_save_scout_parachute_cd::%{_u}%} > 0:
                    set {scout_parachute_cd::%{_u}%} to {admin_nocd_save_scout_parachute_cd::%{_u}%}
                else:
                    delete {scout_parachute_cd::%{_u}%}
                if {admin_nocd_save_archer_triple_cd::%{_u}%} > 0:
                    set {archer_triple_cd::%{_u}%} to {admin_nocd_save_archer_triple_cd::%{_u}%}
                else:
                    delete {archer_triple_cd::%{_u}%}
                if {admin_nocd_save_mage_overload_cd::%{_u}%} > 0:
                    set {mage_overload_cd::%{_u}%} to {admin_nocd_save_mage_overload_cd::%{_u}%}
                else:
                    delete {mage_overload_cd::%{_u}%}
                if {admin_nocd_save_necro_grip_cd::%{_u}%} > 0:
                    set {necro_grip_cd::%{_u}%} to {admin_nocd_save_necro_grip_cd::%{_u}%}
                else:
                    delete {necro_grip_cd::%{_u}%}
                if {admin_nocd_save_tank_laststand_cd::%{_u}%} > 0:
                    set {tank_laststand_cd::%{_u}%} to {admin_nocd_save_tank_laststand_cd::%{_u}%}
                else:
                    delete {tank_laststand_cd::%{_u}%}
                if {admin_nocd_save_necro_lifesteal_until::%{_u}%} > 0:
                    set {necro_lifesteal_until::%{_u}%} to {admin_nocd_save_necro_lifesteal_until::%{_u}%}
                else:
                    delete {necro_lifesteal_until::%{_u}%}
                if {admin_nocd_save_scout_dash_window::%{_u}%} > 0:
                    set {scout_dash_window::%{_u}%} to {admin_nocd_save_scout_dash_window::%{_u}%}
                else:
                    delete {scout_dash_window::%{_u}%}

                # Восстановить предметные КД (если игрок онлайн)
                if arg-1 is online:
                    set {_feather_cd} to {admin_nocd_save_feather_cd::%{_u}%} ? 0
                    set {_bone_cd} to {admin_nocd_save_bone_cd::%{_u}%} ? 0
                    set {_blaze_rod_cd} to {admin_nocd_save_blaze_rod_cd::%{_u}%} ? 0
                    set {_splash_potion_cd} to {admin_nocd_save_splash_potion_cd::%{_u}%} ? 0
                    set {_golden_apple_cd} to {admin_nocd_save_golden_apple_cd::%{_u}%} ? 0
                    set {_mace_cd} to {admin_nocd_save_mace_cd::%{_u}%} ? 0
                    set {_netherite_sword_cd} to {admin_nocd_save_netherite_sword_cd::%{_u}%} ? 0
                    set {_diamond_sword_cd} to {admin_nocd_save_diamond_sword_cd::%{_u}%} ? 0
                    set {_iron_sword_cd} to {admin_nocd_save_iron_sword_cd::%{_u}%} ? 0
                    set {_golden_sword_cd} to {admin_nocd_save_golden_sword_cd::%{_u}%} ? 0
                    set {_stone_sword_cd} to {admin_nocd_save_stone_sword_cd::%{_u}%} ? 0
                    set {_wooden_sword_cd} to {admin_nocd_save_wooden_sword_cd::%{_u}%} ? 0
                    set cooldown of feather for arg-1 to {_feather_cd} * 1 second
                    set cooldown of bone for arg-1 to {_bone_cd} * 1 second
                    set cooldown of blaze rod for arg-1 to {_blaze_rod_cd} * 1 second
                    set cooldown of splash potion for arg-1 to {_splash_potion_cd} * 1 second
                    set cooldown of golden apple for arg-1 to {_golden_apple_cd} * 1 second
                    set cooldown of mace for arg-1 to {_mace_cd} * 1 second
                    set cooldown of netherite sword for arg-1 to {_netherite_sword_cd} * 1 second
                    set cooldown of diamond sword for arg-1 to {_diamond_sword_cd} * 1 second
                    set cooldown of iron sword for arg-1 to {_iron_sword_cd} * 1 second
                    set cooldown of golden sword for arg-1 to {_golden_sword_cd} * 1 second
                    set cooldown of stone sword for arg-1 to {_stone_sword_cd} * 1 second
                    set cooldown of wooden sword for arg-1 to {_wooden_sword_cd} * 1 second

                delete {admin_nocd_save_archer_eye_cd::%{_u}%}
                delete {admin_nocd_save_warrior_secondwind_cd::%{_u}%}
                delete {admin_nocd_save_scout_bloodrush_cd::%{_u}%}
                delete {admin_nocd_save_scout_parachute_cd::%{_u}%}
                delete {admin_nocd_save_archer_triple_cd::%{_u}%}
                delete {admin_nocd_save_mage_overload_cd::%{_u}%}
                delete {admin_nocd_save_necro_grip_cd::%{_u}%}
                delete {admin_nocd_save_tank_laststand_cd::%{_u}%}
                delete {admin_nocd_save_necro_lifesteal_until::%{_u}%}
                delete {admin_nocd_save_scout_dash_window::%{_u}%}
                delete {admin_nocd_save_feather_cd::%{_u}%}
                delete {admin_nocd_save_bone_cd::%{_u}%}
                delete {admin_nocd_save_blaze_rod_cd::%{_u}%}
                delete {admin_nocd_save_splash_potion_cd::%{_u}%}
                delete {admin_nocd_save_golden_apple_cd::%{_u}%}
                delete {admin_nocd_save_mace_cd::%{_u}%}
                delete {admin_nocd_save_netherite_sword_cd::%{_u}%}
                delete {admin_nocd_save_diamond_sword_cd::%{_u}%}
                delete {admin_nocd_save_iron_sword_cd::%{_u}%}
                delete {admin_nocd_save_golden_sword_cd::%{_u}%}
                delete {admin_nocd_save_stone_sword_cd::%{_u}%}
                delete {admin_nocd_save_wooden_sword_cd::%{_u}%}

                send "{@prefix} &aКулдауны способностей для &e%arg-1% &aвключены."
                if arg-1 is online:
                    send "{@prefix} &6Тест-режим: &cкулдауны включены." to arg-1
            else:
                send "{@prefix} &cИспользование: /evo <player> cooldown <on|off>"

        else if arg-2 is "sync":
            if arg-1 is online:
                syncProgress(arg-1)
                send "{@prefix} &aСинхронизация завершена для &e%arg-1%&a."
            else:
                set {_k} to clampKills({kills::%{_u}%} ? 0)
                set {kills::%{_u}%} to {_k}
                set {level::%{_u}%} to calcLevel({_k})
                send "{@prefix} &aСинхронизация завершена для &e%arg-1% &7(offline)."

        else if arg-2 is "debug":
            if arg-3 is "on":
                set {evo_debug::%{_u}%} to true
            else if arg-3 is "off":
                delete {evo_debug::%{_u}%}
            else:
                if {evo_debug::%{_u}%} is true:
                    delete {evo_debug::%{_u}%}
                else:
                    set {evo_debug::%{_u}%} to true
            set {_dbg} to {evo_debug::%{_u}%} ? false
            if {_dbg} is true:
                send "{@prefix} &eDebug-режим для &f%arg-1%&e: &aON"
            else:
                send "{@prefix} &eDebug-режим для &f%arg-1%&e: &cOFF"
            send "{@prefix} &7Использование: &f/evo <player> debug <on|off>"
            if arg-1 is online:
                if {_dbg} is true:
                    send "{@prefix} &eDebug включен. Теперь будут видны тех-сообщения [DBG]." to arg-1
                else:
                    send "{@prefix} &7Debug выключен." to arg-1
            set {_foundCount} to 0
            set {_enabledCount} to 0
            send "{@prefix} &8[DBG] --- ARTIFACT CORE STATE: %arg-1% ---"
            loop "leg_warrior", "leg_scout", "leg_tank", "leg_archer", "leg_mage", "leg_necro", "hermes", "windring", "vampcharm", "etherdash", "mehrunes", "starfury", "icewalker", "frostheart", "ankhshield", "azura", "rottenapple", "voidcompass", "luckcoin", "cloudjump" and "crownmind":
                set {_f} to {art_found::%{_u}%::%loop-value%} ? false
                set {_e} to {art_enabled::%{_u}%::%loop-value%} ? false
                if {_f} is true:
                    add 1 to {_foundCount}
                if {_e} is true:
                    add 1 to {_enabledCount}
                send "{@prefix} &8[DBG] %loop-value% -> found=%{_f}% enabled=%{_e}%"
            send "{@prefix} &8[DBG] totals: found=%{_foundCount}% enabled=%{_enabledCount}%"

        else if arg-2 is "reset":
            set {kills::%{_u}%} to 0
            set {total_kills::%{_u}%} to 0
            set {level::%{_u}%} to 1
            set {class::%{_u}%} to "None"
            set {class_lock::%{_u}%} to false
            delete {wlvl::%{_u}%::*}
            delete {wxp::%{_u}%::*}
            delete {perk::%{_u}%}
            delete {perk_notified::%{_u}%}
            delete {admin_nocd::%{_u}%}
            delete {admin_nocd_save_archer_eye_cd::%{_u}%}
            delete {admin_nocd_save_warrior_secondwind_cd::%{_u}%}
            delete {admin_nocd_save_scout_bloodrush_cd::%{_u}%}
            delete {admin_nocd_save_scout_parachute_cd::%{_u}%}
            delete {admin_nocd_save_archer_triple_cd::%{_u}%}
            delete {admin_nocd_save_mage_overload_cd::%{_u}%}
            delete {admin_nocd_save_necro_grip_cd::%{_u}%}
            delete {admin_nocd_save_tank_laststand_cd::%{_u}%}
            delete {admin_nocd_save_necro_lifesteal_until::%{_u}%}
            delete {admin_nocd_save_scout_dash_window::%{_u}%}
            delete {admin_nocd_save_feather_cd::%{_u}%}
            delete {admin_nocd_save_bone_cd::%{_u}%}
            delete {admin_nocd_save_blaze_rod_cd::%{_u}%}
            delete {admin_nocd_save_splash_potion_cd::%{_u}%}
            delete {admin_nocd_save_golden_apple_cd::%{_u}%}
            delete {admin_nocd_save_mace_cd::%{_u}%}
            delete {admin_nocd_save_netherite_sword_cd::%{_u}%}
            delete {admin_nocd_save_diamond_sword_cd::%{_u}%}
            delete {admin_nocd_save_iron_sword_cd::%{_u}%}
            delete {admin_nocd_save_golden_sword_cd::%{_u}%}
            delete {admin_nocd_save_stone_sword_cd::%{_u}%}
            delete {admin_nocd_save_wooden_sword_cd::%{_u}%}
            # Полная очистка ядра артефактов и связанных состояний
            delete {art_found::%{_u}%::*}
            delete {art_enabled::%{_u}%::*}
            delete {art_hermes_prev::%{_u}%}
            delete {art_azura_charge::%{_u}%}
            delete {art_last_death::%{_u}%}
            delete {art_voidcompass_nonce::%{_u}%}
            delete {art_voidcompass_pending::%{_u}%}
            delete {art_etherdash_cd::%{_u}%}
            delete {art_etherdash_immune_until::%{_u}%}
            delete {art_cloud_used::%{_u}%}
            delete {art_cloud_fallimmune::%{_u}%}
            delete {art_cloud_fallimmune_until::%{_u}%}
            delete {art_cloud_cd::%{_u}%}
            delete {art_icewalker_cd::%{_u}%}
            delete {art_leg_scout_cd::%{_u}%}
            delete {art_leg_tank_cd::%{_u}%}
            delete {art_leg_mage_cd::%{_u}%}
            delete {art_leg_necro_souls::%{_u}%}
            if arg-1 is online:
                resetBalloonState(arg-1)
            send "{@prefix} &4WIPED &fигрок &e%arg-1% &7(включая все артефакты)"
            if arg-1 is online:
                send "{@prefix} &cВаши данные и все артефакты ядра сброшены админом!" to arg-1

        else:
            send "{@prefix} &cНеизвестное действие."

# Таб-комплит отключён: текущая версия Skript не поддерживает on tab complete

# ==========================================
# СИСТЕМА ДУО (ПАРЫ)
# ==========================================
# Хранение:
#   {duo::%uuid%}            = uuid напарника
#   {duo_invite::%uuid%}     = uuid пригласившего (ожидает accept)
#   {duo_invite_time::%uuid%} = время приглашения

function duoPartner(p: player) :: offline player:
    set {_id} to {duo::%uuid of {_p}%}
    if {_id} is not set:
        return {_p}  # сам себе, чтоб не было null
    return offline player from {_id}

function inDuo(p: player) :: boolean:
    if {duo::%uuid of {_p}%} is set:
        return true
    return false

function areDuo(a: player, b: player) :: boolean:
    if {duo::%uuid of {_a}%} is uuid of {_b}:
        return true
    return false

command /duo [<text>] [<offline player>]:
    aliases: /pair, /team
    trigger:
        set {_u} to player's uuid
        if arg-1 is not set:
            send "&8&l------ {@prefix} &6ДУО &8&l------"
            if inDuo(player) is true:
                set {_p} to duoPartner(player)
                send "&7Ваш напарник: &a%{_p}%"
                send "&e/duo leave &7— покинуть дуо"
            else:
                send "&7Вы не в дуо."
                send "&e/duo invite <игрок> &7— пригласить"
                send "&e/duo accept &7— принять"
                send "&e/duo deny &7— отклонить"
            send "&8&l-----------------------------"
            stop

        # ----- INVITE -----
        if arg-1 is "invite":
            if arg-2 is not set:
                send "{@prefix} &cУкажите игрока: /duo invite <ник>"
                stop
            if arg-2 is offline:
                send "{@prefix} &cИгрок не онлайн."
                stop
            if arg-2 is player:
                send "{@prefix} &cНельзя пригласить себя."
                stop
            if inDuo(player) is true:
                send "{@prefix} &cВы уже в дуо. /duo leave"
                stop
            if inDuo(arg-2) is true:
                send "{@prefix} &c%arg-2% уже в дуо."
                stop
            set {duo_invite::%uuid of arg-2%} to {_u}
            set {duo_invite_time::%uuid of arg-2%} to now
            send "{@prefix} &aПриглашение отправлено &e%arg-2%&a."
            send "{@prefix} &e%player% &aпригласил вас в дуо! &7/duo accept &8| &7/duo deny" to arg-2
            play sound "entity.experience_orb.pickup" at arg-2 for arg-2
            stop

        # ----- ACCEPT -----
        if arg-1 is "accept":
            if {duo_invite::%{_u}%} is not set:
                send "{@prefix} &cНет активных приглашений."
                stop
            set {_inv} to {duo_invite::%{_u}%}
            set {_t} to {duo_invite_time::%{_u}%}
            if difference between {_t} and now > 60 seconds:
                delete {duo_invite::%{_u}%}
                delete {duo_invite_time::%{_u}%}
                send "{@prefix} &cПриглашение истекло."
                stop
            set {_invP} to offline player from {_inv}
            if {_invP} is offline:
                send "{@prefix} &cПригласивший не онлайн."
                stop
            set {_inDuo1} to inDuo(player)
            set {_inDuo2} to inDuo({_invP})
            if {_inDuo1} is true:
                send "{@prefix} &cКто-то из вас уже в дуо."
                stop
            if {_inDuo2} is true:
                send "{@prefix} &cКто-то из вас уже в дуо."
                stop
            set {duo::%{_u}%} to {_inv}
            set {duo::%{_inv}%} to {_u}
            delete {duo_invite::%{_u}%}
            delete {duo_invite_time::%{_u}%}
            send "{@prefix} &aВы в дуо с &e%{_invP}%&a!"
            send "{@prefix} &aВы в дуо с &e%player%&a!" to {_invP}
            play sound "ui.toast.challenge_complete" at player for player
            play sound "ui.toast.challenge_complete" at {_invP} for {_invP}
            stop

        # ----- DENY -----
        if arg-1 is "deny":
            if {duo_invite::%{_u}%} is not set:
                send "{@prefix} &cНет активных приглашений."
                stop
            set {_inv} to {duo_invite::%{_u}%}
            delete {duo_invite::%{_u}%}
            delete {duo_invite_time::%{_u}%}
            set {_invP} to offline player from {_inv}
            send "{@prefix} &cПриглашение отклонено."
            if {_invP} is online:
                send "{@prefix} &c%player% отклонил ваше приглашение." to {_invP}
            stop

        # ----- LEAVE -----
        if arg-1 is "leave":
            if inDuo(player) is not true:
                send "{@prefix} &cВы не в дуо."
                stop
            set {_p} to duoPartner(player)
            delete {duo::%{_u}%}
            delete {duo::%uuid of {_p}%}
            send "{@prefix} &7Вы покинули дуо."
            if {_p} is online:
                send "{@prefix} &c%player% покинул ваше дуо." to {_p}
            stop

        # ----- INFO -----
        if arg-1 is "info":
            if inDuo(player) is true:
                set {_p} to duoPartner(player)
                send "{@prefix} &7Напарник: &a%{_p}%"
            else:
                send "{@prefix} &cВы не в дуо."
            stop

        send "{@prefix} &cНеизвестная команда. Используйте /duo"

# ----- Запрет фрэндли-фаер между напарниками (тихо) -----
on damage:
    if attacker is a player:
        if victim is a player:
            if areDuo(attacker, victim) is true:
                cancel event

# ----- Уведомление о приближении напарника при логине -----
on join:
    set {_u} to player's uuid
    if inDuo(player) is true:
        set {_p} to duoPartner(player)
        if {_p} is online:
            send "{@prefix} &aВаш напарник &e%{_p}% &aонлайн." to player
            send "{@prefix} &a%player% &aзашёл на сервер." to {_p}
# ==========================================
# СИСТЕМА ВЫБОРА ПЕРКА (L15+) — меню как у класса
# ==========================================
command /perk:
    trigger:
        set {_u} to player's uuid
        set {_cls} to {class::%{_u}%} ? "None"
        set {_lvl} to {level::%{_u}%} ? 1
        if {_cls} is "None":
            send "{@prefix} &cСначала выбери класс: &e/class"
            stop
        if {_lvl} < 15:
            send "{@prefix} &cПерк доступен только с 15 уровня."
            stop
        if {perk::%{_u}%} is set:
            send "{@prefix} &eТекущий перк: &6%{perk::%{_u}%}%"
            if {_lvl} > 15:
                set {_after} to {_lvl} - 5
                send "{@prefix} &c&lВНИМАНИЕ: &cсмена перка стоит &f-5 уровней&c!"
                send "{@prefix} &7Будет: &fL%{_lvl}% &7→ &cL%{_after}%"
            else:
                set {_need} to 16 - {_lvl}
                send "{@prefix} &cСмена перка доступна только с &f16 уровня&c."
                send "{@prefix} &7Тебе нужно ещё &e%{_need}% &7уровней."
                stop
            send "{@prefix} &7Кликай на новый перк, чтобы заменить."

        open chest inventory with 1 rows named "&8Choose your Perk" to player
        # Заполнение фоновыми панелями
        set slot 0 of player's current inventory to gray stained glass pane named " "
        set slot 2 of player's current inventory to gray stained glass pane named " "
        set slot 6 of player's current inventory to gray stained glass pane named " "
        set slot 8 of player's current inventory to gray stained glass pane named " "

        if {_cls} is "Warrior":
            set slot 1 of player's current inventory to iron sword named "&6&lA — Палач"
            set lore of slot 1 of player's current inventory to "&7Удар по цели с ❤≤4 наносит", "&c+75%% урона &7+ &cStrength I &7на 3с", "", "&8» Добивай раненых одним ударом"
            set slot 3 of player's current inventory to redstone named "&4&lB — Кровавая клятва"
            set lore of slot 3 of player's current inventory to "&7При ❤<6 — постоянно &cStr II + Speed I", "&7Но получаешь &c+15%% входящего урона", "", "&8» Отчаянный режим выживания"
            set slot 5 of player's current inventory to shield named "&e&lC — Идеальное парирование"
            set lore of slot 5 of player's current inventory to "&7Парирование возвращает &cx1.5 урона", "&7+ Slowness II &7+ &8Blindness на 4с", "&7КД парирования &c-50%%", "&8(броня атакующего поглощает урон)", "", "&8» Мастер боя 1-в-1"
            set slot 7 of player's current inventory to totem of undying named "&a&lD — Второй ветер"
            set lore of slot 7 of player's current inventory to "&7Раз в 3 минуты при смертельном ударе:", "&aспасение на 6❤ + Resistance II + Regen II", "&7на 6с", "", "&8» Ангел-хранитель"

        else if {_cls} is "Scout":
            set slot 1 of player's current inventory to sugar named "&b&lA — Двойной рывок"
            set lore of slot 1 of player's current inventory to "&7Можно сделать &fдва рывка &7подряд", "&7(КД 1-го: 4с, 2-й сразу за 1-м)", "", "&8» Молниеносная мобильность"
            set slot 3 of player's current inventory to iron sword named "&5&lB — Невидимый клинок"
            set lore of slot 3 of player's current inventory to "&7Удар в невидимости даёт &c+100%% урона", "&7+ невидимость &fне снимается &7ещё 2с", "&8(макс. цепочка инвиза — &f30с&8)", "", "&8» Атака из тени"
            set slot 5 of player's current inventory to phantom membrane named "&f&lC — Парашют"
            set lore of slot 5 of player's current inventory to "&7Shift в воздухе при падении >5 блоков", "&7= &fSlow Falling 5с &7(КД 30с)", "", "&8» Никогда не разобьёшься"
            set slot 7 of player's current inventory to ghast tear named "&c&lD — Кровопийца"
            set lore of slot 7 of player's current inventory to "&7Каждый &f4-й удар &7лечит &c+½❤", "&7При ❤<6 даёт &fSpeed III &7на 5с (КД 20с)", "", "&8» Вампирский темп"

        else if {_cls} is "Tank":
            set slot 1 of player's current inventory to magma cream named "&c&lA — Магма-броня"
            set lore of slot 1 of player's current inventory to "&7Атакующий поджигается на &c4с", "&7+ получает &c2❤ огнём", "", "&8» Враги горят рядом с тобой"
            set slot 3 of player's current inventory to anvil named "&8&lB — Сейсмический удар"
            set lore of slot 3 of player's current inventory to "&7Каждый &f4-й удар &7по тебе автоматически", "&7вызывает толчок: всех врагов в радиусе 4", "&7отталкивает + &fSlowness II &7на 3с", "", "&8» Реактивная защита — нажимать ничего не надо"
            set slot 5 of player's current inventory to netherite ingot named "&4&lC — Несокрушимый"
            set lore of slot 5 of player's current inventory to "&7При ≤40%% макс. ❤ — &cResistance III &7+ &c-30%% урона", "&7сверху", "", "&8» Чем меньше ❤, тем мощнее броня"
            set slot 7 of player's current inventory to golden apple named "&6&lD — Защитник дуо"
            set lore of slot 7 of player's current inventory to "&7Союзник дуо в радиусе 8 получает", "&aResistance II + Regen I &7пассивно", "&7Ты получаешь &c50%% его урона", "", "&8» Истинный танк-бабсилитер"

        else if {_cls} is "Archer":
            set slot 1 of player's current inventory to spectral arrow named "&e&lA — Снайпер"
            set lore of slot 1 of player's current inventory to "&7Стрелы наносят &c+50%% урона", "&7если цель дальше &f20 блоков", "", "&8» Дальнобойная резня"
            set slot 3 of player's current inventory to packed ice named "&b&lB — Морозная стрела"
            set lore of slot 3 of player's current inventory to "&7Стрела даёт цели:", "&fSlowness III + Mining Fatigue II + Weakness I", "&7на 5с", "", "&8» Полная парализация"
            set slot 5 of player's current inventory to bow named "&6&lC — Тройной выстрел"
            set lore of slot 5 of player's current inventory to "&7Shift+ПКМ луком — &fвыпустить 3 стрелы", "&7веером сразу (КД 12с)", "", "&8» Пулемёт"
            set slot 7 of player's current inventory to ender pearl named "&d&lD — Рикошет"
            set lore of slot 7 of player's current inventory to "&7Стрела наносит &c75%% урона", "&7ближайшему врагу в радиусе 6", "&7от первой цели", "", "&8» Цепная стрельба"

        else if {_cls} is "Mage":
            set slot 1 of player's current inventory to fire charge named "&c&lA — Метеор"
            set lore of slot 1 of player's current inventory to "&7Большой фаербол &fдоступен с L1", "&7через Shift+ПКМ блейз-родом (КД 20с)", "", "&8» Досрочный ульт"
            set slot 3 of player's current inventory to packed ice named "&b&lB — Ледяной взрыв"
            set lore of slot 3 of player's current inventory to "&7Фаербол при попадании замораживает", "&7врагов в радиусе 4: &fSlowness III &7на 6с", "", "&8» AoE контроль"
            set slot 5 of player's current inventory to glistering melon slice named "&a&lC — Аура регена"
            set lore of slot 5 of player's current inventory to "&7Союзники в радиусе 10 пассивно", "&7получают &aRegeneration I", "", "&8» Группа всегда живёт"
            set slot 7 of player's current inventory to amethyst shard named "&d&lD — Арканная перегрузка"
            set lore of slot 7 of player's current inventory to "&7При получении удара (КД 20с):", "&7враг получает &fSlow II + Weakness I 4с", "&7а ты — &fSpeed II 3с", "", "&8» Контроль дистанции и кайт"

        else if {_cls} is "Necromancer":
            set slot 1 of player's current inventory to soul lantern named "&2&lA — Армия мёртвых"
            set lore of slot 1 of player's current inventory to "&7Призыв даёт &f+1 миньон сверху", "&7Время жизни — &f75с &7(вместо 45с)", "", "&8» Маленькая армия"
            set slot 3 of player's current inventory to fermented spider eye named "&5&lB — Чумной взрыв"
