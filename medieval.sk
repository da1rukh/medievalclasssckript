    if {_pid} is "archer_C":
        return "&6&lC — Тройной выстрел"
    if {_pid} is "archer_D":
        return "&d&lD — Рикошет"
    if {_pid} is "mage_A":
        return "&c&lA — Метеор"
    if {_pid} is "mage_B":
        return "&b&lB — Ледяной взрыв"
    if {_pid} is "mage_C":
