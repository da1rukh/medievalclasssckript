function artifactCoreIds() :: texts:
    delete {_ids::*}
    loop "leg_warrior", "leg_scout", "leg_tank", "leg_archer", "leg_mage", "leg_necro", "hermes", "windring", "vampcharm", "etherdash", "mehrunes", "starfury", "icewalker", "frostheart", "ankhshield", "azura", "rottenapple", "voidcompass", "luckcoin", "cloudjump", "crownmind", "heater", "dreamcatcher", "desertheart", "quantdup", "facelessmask", "cursedgift", "lootmagnet" and "nightlens":
        add loop-value to {_ids::*}
    return {_ids::*}

function isKnownArtifactId(id: text) :: boolean:
    set {_id} to {_id} in lower case
    if artifactSlotFromKey({_id}) >= 0:
        return true
    return false

function artifactCoreIdsHint() :: text:
    return "leg_warrior, leg_scout, leg_tank, leg_archer, leg_mage, leg_necro, hermes, windring, vampcharm, etherdash, mehrunes, starfury, icewalker, frostheart, ankhshield, azura, rottenapple, voidcompass, luckcoin, cloudjump, crownmind, heater, dreamcatcher, desertheart, quantdup, facelessmask, cursedgift, lootmagnet, nightlens"

function artifactKeyFromItemName(n: text) :: text:
    if {_n} contains "Печать Пространственного Разреза":
        return "leg_warrior"
    else if {_n} contains "Тень Фантома":
        return "leg_scout"
    else if {_n} contains "Якорь Мироздания":
        return "leg_tank"
    else if {_n} contains "Око Хищника":
        return "leg_archer"
    else if {_n} contains "Эфирный Разум":
        return "leg_mage"
    else if {_n} contains "Амулет Гнилого Родства":
        return "leg_necro"
    else if {_n} contains "Сапоги Гермеса":
        return "hermes"
    else if {_n} contains "Кольцо Ветра":
        return "windring"
    else if {_n} contains "Амулет вампира":
        return "vampcharm"
    else if {_n} contains "Эфирный рывок":
        return "etherdash"
    else if {_n} contains "Бритва Мерунеса":
        return "mehrunes"
    else if {_n} contains "Звёздная ярость":
        return "starfury"
    else if {_n} contains "Счастливая подкова":
        return "cloudjump"
    else if {_n} contains "Воздушный шарик":
        return "cloudjump"
    else if {_n} contains "Ледяной след":
        return "icewalker"
    else if {_n} contains "Сердце ледяного великана":
        return "frostheart"
    else if {_n} contains "Щит Анх":
        return "ankhshield"
    else if {_n} contains "Звезда Азуры":
        return "azura"
    else if {_n} contains "Гнилое яблоко":
        return "rottenapple"
    else if {_n} contains "Компас Пустоты":
        return "voidcompass"
    else if {_n} contains "Монета удачи":
        return "luckcoin"
    else if {_n} contains "Корона Высшего Разума":
        return "crownmind"
    else if {_n} contains "Портативный Нагреватель":
        return "heater"
    else if {_n} contains "Ловец Снов":
        return "dreamcatcher"
    else if {_n} contains "Сердце Пустыни":
        return "desertheart"
    else if {_n} contains "Квантовый Дубликатор":
        return "quantdup"
    else if {_n} contains "Маска Безликого":
        return "facelessmask"
    else if {_n} contains "Дар Проклятого Короля":
        return "cursedgift"
    else if {_n} contains "Магнит Добытчика":
        return "lootmagnet"
    else if {_n} contains "Ночная Линза":
        return "nightlens"
    return ""

function artifactDesc(k: text) :: texts:
    delete {_d::*}
    if {_k} is "leg_warrior":
        add "&6Легендарный (Warrior): длинный красный луч и бонус при ударе мечом/буловой" to {_d::*}
        add "&7ЛКМ по воздуху — красные частицы вдоль взгляда; удар по мобу — +40%%." to {_d::*}
        add "&740%% урона по существу летит лезвием до 10 блоков." to {_d::*}
    else if {_k} is "leg_scout":
        add "&6Легендарный (Scout): шанс 25%% игнорировать удар" to {_d::*}
        add "&7Даёт Invisibility + Speed III на 3с. КД 8с." to {_d::*}
    else if {_k} is "leg_tank":
        add "&6Легендарный (Tank): аура давления вблизи" to {_d::*}
        add "&71❤/с рядом с танком + волна при падении без урона." to {_d::*}
    else if {_k} is "leg_archer":
        add "&6Легендарный (Archer): автоаим стрел" to {_d::*}
        add "&7Стрелы мягко доворачиваются к ближней цели." to {_d::*}
    else if {_k} is "leg_mage":
        add "&6Легендарный (Mage): инверсия дебаффов" to {_d::*}
        add "&7Wither -> Regen, Slowness -> Speed, Weakness -> Strength." to {_d::*}
    else if {_k} is "leg_necro":
        add "&6Легендарный (Necromancer): нежить не атакует первой" to {_d::*}
        add "&7Следует за хозяином и фокусит его цель. Пассивная регенерация от смерти." to {_d::*}
    else if {_k} is "hermes":
        add "&7Пассивно: постоянный &fSpeed II" to {_d::*}
        add "&7Работает, пока артефакт включён в ядре." to {_d::*}
    else if {_k} is "windring":
        add "&7Пассивно: &a+15%% урона и Speed I" to {_d::*}
        add "&7Цена: быстрее тратится голод." to {_d::*}
    else if {_k} is "vampcharm":
        add "&7Пассивно лечит от части твоего урона" to {_d::*}
        add "&7Работает от любых обычных ударов." to {_d::*}
    else if {_k} is "etherdash":
        add "&7При уроне от сущности: короткий эфирный телепорт" to {_d::*}
        add "&7Текущий урон полностью отменяется. КД: 20с." to {_d::*}
    else if {_k} is "mehrunes":
        add "&7Шанс &c13.33%% &7казнить цель (кроме боссов/игроков)" to {_d::*}
        add "&7Срабатывает от любого твоего удара." to {_d::*}
    else if {_k} is "starfury":
        add "&7Шанс кометы: визуальная молния и поджог" to {_d::*}
        add "&7Основная цель получает двойной урон." to {_d::*}
    else if {_k} is "icewalker":
        add "&7Постоянно создаёт временные ледяные блоки под тобой" to {_d::*}
        add "&7На воздухе/воде/лаве, с откатом через 35 тиков." to {_d::*}
    else if {_k} is "frostheart":
        add "&7При получении урона атакер замедляется" to {_d::*}
        add "&7Контроль милишников." to {_d::*}
    else if {_k} is "ankhshield":
        add "&7Иммун к Poison / Slowness / Weakness" to {_d::*}
        add "&7Постоянная анти-контроль защита." to {_d::*}
    else if {_k} is "azura":
        add "&7Убийства заряжают звезду (до 200)" to {_d::*}
        add "&7Пассивно конвертит заряд в опыт при пороге." to {_d::*}
    else if {_k} is "rottenapple":
        add "&7x2 урон по нейтральным животным" to {_d::*}
        add "&7Фарм-артефакт." to {_d::*}
    else if {_k} is "voidcompass":
        add "&7Пассивно сохраняет место смерти" to {_d::*}
        add "&7Даёт аварийный возврат (внутренний КД)." to {_d::*}
    else if {_k} is "luckcoin":
        add "&7Шанс 25%% на бонусный ресурс с убийства" to {_d::*}
        add "&7Экономический буст." to {_d::*}
    else if {_k} is "cloudjump":
        add "&7Воздушный шарик: двойной прыжок в воздухе" to {_d::*}
        add "&7и гашение урона от падения после подброса." to {_d::*}
    else if {_k} is "crownmind":
        add "&7Корона Высшего Разума: х3 опыт из всех источников" to {_d::*}
        add "&7Все твои зачарования работают как будто на +1 уровень." to {_d::*}
    else if {_k} is "heater":
        add "&7Портативный Нагреватель: авто-жарка еды в руке" to {_d::*}
        add "&7Срабатывает каждые 5 секунд." to {_d::*}
    else if {_k} is "dreamcatcher":
        add "&7Ловец Снов: сон мгновенно завершает ночь" to {_d::*}
        add "&7И даёт Luck I на следующий день." to {_d::*}
    else if {_k} is "desertheart":
        add "&7Сердце Пустыни: испаряет воду вокруг" to {_d::*}
        add "&7Накладывает Hunger/Wither на врагов рядом." to {_d::*}
    else if {_k} is "quantdup":
        add "&7Квантовый Дубликатор: шанс +1 копии крафта" to {_d::*}
        add "&7Не работает для алтарных/артефактных предметов." to {_d::*}
    else if {_k} is "facelessmask":
        add "&7Маска Безликого: скрывает никнейм над головой." to {_d::*}
    else if {_k} is "cursedgift":
        add "&7Дар Проклятого Короля: воскрешает союзника-дуо рядом." to {_d::*}
        add "&7Цена: -10 уровней, КД 5 минут на цель." to {_d::*}
    else if {_k} is "lootmagnet":
        add "&7Магнит Добытчика: притягивает лут в радиусе 6 блоков." to {_d::*}
    else if {_k} is "nightlens":
        add "&7Ночная Линза: постоянное ночное зрение." to {_d::*}
    else:
        add "&7Описание отсутствует." to {_d::*}
    return {_d::*}

function artifactMenuItem(p: player, s: number) :: item:
    set {_it} to artifactFromSlot({_s})
    if {_it} is air:
        return air
    set {_k} to artifactKeyFromSlot({_s})
    set {_u} to uuid of {_p}
    set {_owned} to {art_found::%{_u}%::%{_k}%} ? false
    set {_on} to {art_enabled::%{_u}%::%{_k}%} ? false
    set {_baseName} to name of {_it}
    if {_owned} is false:
        set name of {_it} to "&8[НЕ НАЙДЕН] %{_baseName}%"
        set lore of {_it} to artifactDesc({_k})
        add " " to lore of {_it}
        add "&7Сначала найди этот артефакт" to lore of {_it}
        add "&8Статус: &cне найден" to lore of {_it}
    else if {_on} is true:
        set name of {_it} to "&a[ON] %{_baseName}%"
        set lore of {_it} to artifactDesc({_k})
        add " " to lore of {_it}
        add "&7Статус: &aвключен" to lore of {_it}
        add "&7ПКМ: выключить" to lore of {_it}
        add "&7ЛКМ: извлечь в предмет" to lore of {_it}
    else:
        set name of {_it} to "&c[OFF] %{_baseName}%"
        set lore of {_it} to artifactDesc({_k})
        add " " to lore of {_it}
        add "&7Статус: &cвыключен" to lore of {_it}
        add "&7ПКМ: включить" to lore of {_it}
        add "&7ЛКМ: извлечь в предмет" to lore of {_it}
    return {_it}

function utilityMenuItem(p: player, s: number) :: item:
    set {_it} to artifactFromSlot({_s})
    if {_it} is air:
        return air
    set {_k} to artifactKeyFromSlot({_s})
    set {_u} to uuid of {_p}
    set {_owned} to {util_found::%{_u}%::%{_k}%} ? false
    set {_on} to {util_enabled::%{_u}%::%{_k}%} ? false
    set {_baseName} to name of {_it}
    if {_owned} is false:
        set name of {_it} to "&8[НЕ НАЙДЕН] %{_baseName}%"
        set lore of {_it} to artifactDesc({_k})
        add " " to lore of {_it}
        add "&7Сначала найди этот utility-артефакт" to lore of {_it}
        add "&8Статус: &cне найден" to lore of {_it}
    else if {_on} is true:
        set name of {_it} to "&a[ON] %{_baseName}%"
        set lore of {_it} to artifactDesc({_k})
        add " " to lore of {_it}
        add "&7Статус: &aвключен (utility)" to lore of {_it}
        add "&7ПКМ: выключить" to lore of {_it}
        add "&7ЛКМ: извлечь в предмет" to lore of {_it}
    else:
        set name of {_it} to "&c[OFF] %{_baseName}%"
        set lore of {_it} to artifactDesc({_k})
        add " " to lore of {_it}
        add "&7Статус: &cвыключен (utility)" to lore of {_it}
        add "&7ПКМ: включить" to lore of {_it}
        add "&7ЛКМ: извлечь в предмет" to lore of {_it}
    return {_it}

function isEvoDebug(p: player) :: boolean:
    if {evo_debug::%uuid of {_p}%} is true:
        return true
    return false

function dbgEvo(p: player, msg: text):
    if isEvoDebug({_p}) is true:
        send "{@prefix} &8[DBG] %{_msg}%" to {_p}

# --- Руины с артефактами (редкий спавн в мире): много сундуков, стражи; на всю руину ровно 1 артефакт (главный сундук) ---
function artifactRuinLegendaryRandomArtifact() :: item:
    set {_leg::*} to 0, 1, 2, 6, 7 and 8
    set {_pick} to random element out of {_leg::*}
    return artifactFromSlot({_pick})

function artifactRuinCommonArtifactRandom() :: item:
    set {_pool::*} to 10, 11, 12, 13, 14, 15, 16, 19, 20, 21, 22, 23, 24, 25 and 26
    set {_pick} to random element out of {_pool::*}
    return artifactFromSlot({_pick})

function artifactRuinRandomAltarScrollItem() :: item:
    set {_ids::*} to altarLocalRecipeIds()
    if size of {_ids::*} <= 0:
        return ancientScrollItem("ether_pick")
    set {_pick} to random element out of {_ids::*}
    set {_sc} to ancientScrollItem({_pick})
    if {_sc} is air:
        return ancientScrollItem("ether_pick")
    return {_sc}

function artifactRuinScrollPoolIds() :: texts:
    delete {_ids::*}
    set {_coreIds::*} to artifactCoreIds()
    loop {_coreIds::*}:
        add loop-value to {_ids::*}
    add "ruin_summon" to {_ids::*}
    set {_altarIds::*} to altarLocalRecipeIds()
    loop {_altarIds::*}:
        add loop-value to {_ids::*}
    return {_ids::*}

function artifactRuinRandomScrollItem() :: item:
    set {_ids::*} to artifactRuinScrollPoolIds()
    set {_pick} to random element out of {_ids::*}
    set {_sc} to ancientScrollItem({_pick})
    if {_sc} is air:
        return ancientScrollItem("hermes")
    return {_sc}

# Только ресурсы; артефактов здесь нет. modest / boss_common — для обычных руин (слабее), boss / rich — для легендарных
function artifactRuinLootMaterialsOnly(tier: text) :: item:
    if {_tier} is "modest":
        set {_rw} to random integer between 1 and 100
        if {_rw} <= 30:
            set {_it} to iron ingot
            set amount of {_it} to random integer between 2 and 10
            return {_it}
        if {_rw} <= 52:
            set {_it} to gold ingot
            set amount of {_it} to random integer between 2 and 6
            return {_it}
        if {_rw} <= 66:
            set {_it} to emerald
            set amount of {_it} to random integer between 1 and 4
            return {_it}
        if {_rw} <= 76:
            set {_it} to diamond
            set amount of {_it} to random integer between 1 and 2
            return {_it}
        if {_rw} <= 86:
            set {_it} to coal
            set amount of {_it} to random integer between 6 and 20
            return {_it}
        if {_rw} <= 93:
            set {_it} to experience bottle
            set amount of {_it} to random integer between 2 and 7
            return {_it}
        if {_rw} <= 97:
            set {_it} to golden apple
            set amount of {_it} to 1
            return {_it}
        return bread
    if {_tier} is "boss_common":
        set {_rw} to random integer between 1 and 100
        set {_rw} to {_rw} - 5
        if {_rw} < 1:
            set {_rw} to 1
        if {_rw} <= 22:
            set {_it} to diamond
            set amount of {_it} to random integer between 1 and 3
            return {_it}
        if {_rw} <= 40:
            set {_it} to emerald
            set amount of {_it} to random integer between 2 and 6
            return {_it}
        if {_rw} <= 56:
            set {_it} to gold ingot
            set amount of {_it} to random integer between 3 and 10
            return {_it}
        if {_rw} <= 66:
            set {_it} to ancient debris
            set amount of {_it} to 1
            return {_it}
        if {_rw} <= 74:
            set {_it} to netherite scrap
            set amount of {_it} to random integer between 1 and 2
            return {_it}
        if {_rw} <= 86:
            set {_it} to experience bottle
            set amount of {_it} to random integer between 4 and 12
            return {_it}
        if {_rw} <= 94:
            set {_it} to golden apple
            set amount of {_it} to 1
            return {_it}
        return iron ingot
    set {_rw} to random integer between 1 and 100
    if {_tier} is "boss":
        set {_rw} to {_rw} - 12
    else if {_tier} is "rich":
        set {_rw} to {_rw} - 5
    if {_rw} < 1:
        set {_rw} to 1
    if {_rw} <= 20:
        set {_it} to diamond
        set amount of {_it} to random integer between 1 and 5
        return {_it}
    if {_rw} <= 36:
        set {_it} to emerald
        set amount of {_it} to random integer between 3 and 10
        return {_it}
    if {_rw} <= 50:
        set {_it} to gold ingot
        set amount of {_it} to random integer between 4 and 14
        return {_it}
    if {_rw} <= 60:
        set {_it} to ancient debris
        set amount of {_it} to random integer between 1 and 2
        return {_it}
    if {_rw} <= 70:
        set {_it} to netherite scrap
        set amount of {_it} to random integer between 1 and 3
        return {_it}
    if {_rw} <= 84:
        set {_it} to experience bottle
        set amount of {_it} to random integer between 6 and 16
        return {_it}
    if {_rw} <= 94:
        return enchanted golden apple
    set {_it} to golden apple
    set amount of {_it} to random integer between 1 and 2
    return {_it}

function artifactRuinFillChest(loc: location, tier: text):
    set {_b} to block at {_loc}
    set {_fp} to 34
    if {_tier} is "boss_common":
        set {_fp} to 26
    else if {_tier} is "modest":
        set {_fp} to 24
    loop 27 times:
        set {_sl} to loop-number - 1
        set {_rn} to random integer between 1 and 100
        if {_rn} <= {_fp}:
            set {_retp} to "{@artifact_ruin_side_chest_return_key_percent}" parsed as number
            if {_retp} is not set:
                set {_retp} to 11
            if {_retp} < 0:
                set {_retp} to 0
            if {_retp} > 100:
                set {_retp} to 100
            set {_voidp} to "{@artifact_ruin_side_chest_void_key_percent}" parsed as number
            if {_voidp} is not set:
                set {_voidp} to 3
            if {_voidp} < 0:
                set {_voidp} to 0
            if {_voidp} > 100:
                set {_voidp} to 100
            set {_keyhi} to {_retp} + {_voidp}
            if {_keyhi} > 100:
                set {_keyhi} to 100
            set {_rkey} to random integer between 1 and 100
            if {_rkey} <= {_retp}:
                set slot {_sl} of inventory of {_b} to evoAdminItemById("return_key")
            else if {_rkey} <= {_keyhi}:
                set slot {_sl} of inventory of {_b} to evoAdminItemById("void_key")
            else:
                set {_subp} to "{@artifact_ruin_side_chest_scroll_substitute_percent}" parsed as number
                if {_subp} is not set:
                    set {_subp} to 30
                if {_subp} < 0:
                    set {_subp} to 0
                if {_subp} > 100:
                    set {_subp} to 100
                set {_rsc} to random integer between 1 and 100
                if {_rsc} <= {_subp}:
                    if random integer between 1 and 100 <= 50:
                        set slot {_sl} of inventory of {_b} to artifactRuinRandomAltarScrollItem()
                    else:
                        set slot {_sl} of inventory of {_b} to artifactRuinRandomDiaryPageItem()
                else:
                    set slot {_sl} of inventory of {_b} to artifactRuinLootMaterialsOnly({_tier})

function artifactRuinFillChestBoss(loc: location, kind: text):
    if {_kind} is "legendary":
        artifactRuinFillChest({_loc}, "boss")
    else:
        artifactRuinFillChest({_loc}, "boss_common")
    set {_b} to block at {_loc}
    set {_bsp} to "{@artifact_ruin_boss_chest_scroll_percent}" parsed as number
    if {_bsp} is not set:
        set {_bsp} to 78
    if {_bsp} < 0:
        set {_bsp} to 0
    if {_bsp} > 100:
        set {_bsp} to 100
    set {_rb} to random integer between 1 and 100
    if {_rb} <= {_bsp}:
        set slot 13 of inventory of {_b} to artifactRuinRandomScrollItem()
    else:
        if {_kind} is "legendary":
            set slot 13 of inventory of {_b} to artifactRuinLegendaryRandomArtifact()
        else:
            set slot 13 of inventory of {_b} to artifactRuinCommonArtifactRandom()

function artifactRuinRandomKind() :: text:
    set {_lp} to "{@artifact_ruin_legendary_chance_percent}" parsed as number
    if {_lp} is not set:
        set {_lp} to 14
    if {_lp} < 1:
        return "common"
    if {_lp} > 100:
        set {_lp} to 100
    set {_r} to random integer between 1 and 100
    if {_r} <= {_lp}:
        return "legendary"
    return "common"

function artifactRuinSpawnGuards(cx: number, cz: number, w: world, kind: text):
    if {_kind} is "legendary":
        loop 10 times:
            set {_gx} to {_cx} + random integer between -9 and 9
            set {_gz} to {_cz} + random integer between -9 and 9
            set {_gsy} to artifactRuinSurfaceY({_gx}, {_gz}, {_w})
            if {_gsy} > -90:
                spawn a vindicator at location at {_gx}, {_gsy} + 1, {_gz} in {_w}
                set name of last spawned entity to "&6&lСтраж реликвии"
        chance of 78%:
            set {_gx} to {_cx} + random integer between -4 and 8
            set {_gz} to {_cz} + random integer between -4 and 4
            set {_gsy} to artifactRuinSurfaceY({_gx}, {_gz}, {_w})
            if {_gsy} > -90:
                spawn an evoker at location at {_gx}, {_gsy} + 1, {_gz} in {_w}
                set name of last spawned entity to "&4&lХранитель эха"
    else:
        loop 7 times:
            set {_gx} to {_cx} + random integer between -9 and 9
            set {_gz} to {_cz} + random integer between -9 and 9
            set {_gsy} to artifactRuinSurfaceY({_gx}, {_gz}, {_w})
            if {_gsy} > -90:
                spawn a vindicator at location at {_gx}, {_gsy} + 1, {_gz} in {_w}
                set name of last spawned entity to "&4&lСтраж руин"
        chance of 55%:
            set {_gx} to {_cx} + random integer between -4 and 8
            set {_gz} to {_cz} + random integer between -4 and 4
            set {_gsy} to artifactRuinSurfaceY({_gx}, {_gz}, {_w})
            if {_gsy} > -90:
                spawn an evoker at location at {_gx}, {_gsy} + 1, {_gz} in {_w}
                set name of last spawned entity to "&5&lКапитан стражи"

function isRuinGuardianEntity(e: entity) :: boolean:
    if {_e} is not set:
        return false
    set {_n} to name of {_e}
    if {_n} is not set:
        return false
    if {_n} contains "Страж реликвии":
        return true
    if {_n} contains "Хранитель эха":
        return true
    if {_n} contains "Страж руин":
        return true
    if {_n} contains "Капитан стражи":
        return true
    return false

# Одна палитра на всю руину: ковры одного цвета, «граффити» — только родственные оттенки
function artifactRuinCarpetForTheme(t: number) :: item:
    if {_t} is 1:
        return red carpet
    if {_t} is 2:
        return light blue carpet
    if {_t} is 3:
        return purple carpet
    if {_t} is 4:
        return yellow carpet
    return lime carpet

function artifactRuinAccentPaint(t: number) :: item:
    set {_r} to random integer between 1 and 3
    if {_t} is 1:
        if {_r} is 1:
            return red concrete
        if {_r} is 2:
            return orange concrete
        return red terracotta
    if {_t} is 2:
        if {_r} is 1:
            return cyan concrete
        if {_r} is 2:
            return light blue concrete
        return blue concrete
    if {_t} is 3:
        if {_r} is 1:
            return purple concrete
        if {_r} is 2:
            return magenta concrete
        return purple terracotta
    if {_t} is 4:
        if {_r} is 1:
            return yellow concrete
        if {_r} is 2:
            return orange concrete
        return yellow terracotta
    if {_t} is 5:
        if {_r} is 1:
            return lime concrete
        if {_r} is 2:
            return green concrete
        return green terracotta
    return lime concrete

function artifactRuinFloorPieceThemed(t: number) :: item:
    set {_r} to random integer between 1 and 100
    if {_r} <= 21:
        return cobbled deepslate
    if {_r} <= 39:
        return deepslate tiles
    if {_r} <= 54:
        return cracked deepslate tiles
    if {_r} <= 69:
        return polished deepslate
    if {_r} <= 80:
        return deepslate bricks
    if {_r} <= 88:
        return moss block
    if {_r} <= 93:
        return artifactRuinAccentPaint({_t})
    return gravel

function artifactRuinCenterFloor() :: item:
    set {_r} to random integer between 1 and 100
    if {_r} <= 42:
        return crying obsidian
    if {_r} <= 73:
        return cracked deepslate bricks
    return lodestone

# Вариант «легендарной руины»: тёмный камень; обычная — прежний тематический сланец
function artifactRuinFloorPieceForKind(t: number, kind: text) :: item:
    if {_kind} is "legendary":
        set {_r} to random integer between 1 and 100
        if {_r} <= 26:
            return polished blackstone
        if {_r} <= 46:
            return blackstone
        if {_r} <= 64:
            return cracked polished blackstone bricks
        if {_r} <= 77:
            return gilded blackstone
        if {_r} <= 90:
            return deepslate tiles
        return polished deepslate
    return artifactRuinFloorPieceThemed({_t})

function artifactRuinCenterFloorForKind(kind: text) :: item:
    if {_kind} is "legendary":
        set {_r} to random integer between 1 and 100
        if {_r} <= 38:
            return crying obsidian
        if {_r} <= 68:
            return ancient debris
        if {_r} <= 88:
            return netherite block
        return lodestone
    return artifactRuinCenterFloor()

function artifactRuinPillarPieceForKind(t: number, kind: text) :: item:
    if {_kind} is "legendary":
        set {_r} to random integer between 1 and 100
        if {_r} <= 28:
            return blackstone
        if {_r} <= 52:
            return polished blackstone
        if {_r} <= 72:
            return deepslate bricks
        if {_r} <= 88:
            return gilded blackstone
        return polished deepslate
    return artifactRuinPillarPieceThemed({_t})

function artifactRuinCarpetForKind(t: number, kind: text) :: item:
    if {_kind} is "legendary":
        set {_r} to random integer between 1 and 3
        if {_r} is 1:
            return purple carpet
        if {_r} is 2:
            return black carpet
        return gray carpet
    return artifactRuinCarpetForTheme({_t})

function artifactRuinTowerPadForKind(kind: text) :: item:
    if {_kind} is "legendary":
        return polished blackstone
    return deepslate bricks

function artifactRuinPillarPieceThemed(t: number) :: item:
    set {_r} to random integer between 1 and 100
    if {_r} <= 24:
        return polished deepslate
    if {_r} <= 46:
        return deepslate bricks
    if {_r} <= 62:
        return cracked deepslate bricks
    if {_r} <= 71:
        return blackstone
    return artifactRuinAccentPaint({_t})

function artifactRuinSurfaceY(wx: number, wz: number, w: world) :: number:
    set {_probe} to location at {_wx}, 320, {_wz} in {_w}
    set {_top} to highest solid block at {_probe}
    if {_top} is not set:
        return -999
    return y-coordinate of location of {_top}

function artifactRuinTerrainTooSteep(cx: number, cz: number, rad: number, w: world) :: boolean:
    set {_minSy} to 500
    set {_maxSy} to -500
    set {_ox} to 0 - {_rad}
    while {_ox} <= {_rad}:
        set {_oz} to 0 - {_rad}
        while {_oz} <= {_rad}:
            set {_lx} to {_cx} + {_ox}
            set {_lz} to {_cz} + {_oz}
            set {_sy} to artifactRuinSurfaceY({_lx}, {_lz}, {_w})
            if {_sy} < -90:
                return true
            if {_sy} < {_minSy}:
                set {_minSy} to {_sy}
            if {_sy} > {_maxSy}:
                set {_maxSy} to {_sy}
            add 1 to {_oz}
        add 1 to {_ox}
    if {_maxSy} - {_minSy} > 12:
        return true
    return false

function artifactRuinFeetAtColumn(bx: number, bz: number, w: world) :: location:
    # Поверхность мира: highest solid block = по карте высот (не потолок пещеры под одним столбом воздуха)
    set {_probe} to location at {_bx}, 320, {_bz} in {_w}
    set {_top} to highest solid block at {_probe}
    if {_top} is not set:
        return location at 0, -512, 0 in {_w}
    set {_hy} to y-coordinate of location of {_top}
    if {_hy} < -59:
        return location at 0, -512, 0 in {_w}
    set {_feet} to location at {_bx}, {_hy} + 1, {_bz} in {_w}
    set {_bf} to block at {_feet}
    if {_bf} is water:
        return location at 0, -512, 0 in {_w}
    if {_bf} is minecraft:lava:
        return location at 0, -512, 0 in {_w}
    if {_bf} is air:
        return {_feet}
    if {_bf} is cave air:
        return {_feet}
    if {_bf} is snow:
        return {_feet}
    return location at 0, -512, 0 in {_w}

function artifactRuinFeetValid(feet: location) :: boolean:
    set {_y} to y-coordinate of {_feet}
    if {_y} < -100:
        return false
    return true

function artifactRuinFarFromSpawn(feet: location, w: world) :: boolean:
    set {_min} to "{@artifact_ruin_min_spawn_blocks}" parsed as number
    if {_min} is not set:
        set {_min} to 400
    if {_min} <= 0:
        return true
    set {_sp} to spawn of {_w}
    set {_dx} to x-coordinate of {_feet} - x-coordinate of {_sp}
    set {_dz} to z-coordinate of {_feet} - z-coordinate of {_sp}
    set {_d2} to {_dx} * {_dx} + {_dz} * {_dz}
    set {_need} to {_min} * {_min}
    if {_d2} < {_need}:
        return false
    return true

function artifactRuinBuild(feet: location, kind: text) :: boolean:
    set {_w} to world of {_feet}
    set {_cx} to floor(x-coordinate of {_feet})
    set {_cz} to floor(z-coordinate of {_feet})
    if artifactRuinTerrainTooSteep({_cx}, {_cz}, 9, {_w}) is true:
        return false
    set {_pal} to random integer between 1 and 5
    if {_kind} is "legendary":
        set {_pal} to random integer between 3 and 5
    set {_var} to random integer between 1 and 6
    set {_plazaR} to 5
    set {_doWalls} to true
    set {_doStubs} to true
    set {_doCorners} to true
    set {_satN} to 6
    if {_var} is 2:
        set {_doWalls} to false
    else if {_var} is 3:
        set {_doStubs} to false
    else if {_var} is 4:
        set {_doWalls} to false
        set {_doStubs} to false
    else if {_var} is 5:
        set {_plazaR} to 4
    else if {_var} is 6:
        set {_plazaR} to 4
        set {_doWalls} to false
        set {_doStubs} to false
        set {_doCorners} to false
        set {_satN} to 2
    set {_satT} to "modest"
    if {_kind} is "legendary":
        set {_satT} to "rich"
    set {_ox} to -9
    while {_ox} <= 9:
        set {_oz} to -9
        while {_oz} <= 9:
            set {_lx} to {_cx} + {_ox}
            set {_lz} to {_cz} + {_oz}
            set {_sy} to artifactRuinSurfaceY({_lx}, {_lz}, {_w})
            if {_sy} > -90:
                loop 16 times:
                    set {_ly} to {_sy} + loop-number
                    set block at location at {_lx}, {_ly}, {_lz} in {_w} to air
            add 1 to {_oz}
        add 1 to {_ox}
    set {_dx} to 0 - {_plazaR}
    while {_dx} <= {_plazaR}:
        set {_dz} to 0 - {_plazaR}
        while {_dz} <= {_plazaR}:
            set {_lx} to {_cx} + {_dx}
            set {_lz} to {_cz} + {_dz}
            set {_sy} to artifactRuinSurfaceY({_lx}, {_lz}, {_w})
            if {_sy} > -90:
                if {_dx} is 0:
                    if {_dz} is 0:
                        set block at location at {_lx}, {_sy}, {_lz} in {_w} to artifactRuinCenterFloorForKind({_kind})
                    else:
                        set block at location at {_lx}, {_sy}, {_lz} in {_w} to artifactRuinFloorPieceForKind({_pal}, {_kind})
                else:
                    set block at location at {_lx}, {_sy}, {_lz} in {_w} to artifactRuinFloorPieceForKind({_pal}, {_kind})
            add 1 to {_dz}
        add 1 to {_dx}
    set {_pc} to {_plazaR}
    set {_nmPc} to 0 - {_pc}
    if {_doCorners} is true:
        set {_hp1} to random integer between 2 and 4
        set {_hp2} to random integer between 2 and 4
        set {_hp3} to random integer between 2 and 4
        set {_hp4} to random integer between 2 and 4
        set {_syP1} to artifactRuinSurfaceY({_cx} - {_pc}, {_cz} - {_pc}, {_w})
        loop {_hp1} times:
            set {_py} to {_syP1} + loop-number
            chance of 90%:
                set block at location at {_cx} - {_pc}, {_py}, {_cz} - {_pc} in {_w} to artifactRuinPillarPieceForKind({_pal}, {_kind})
        set {_syP2} to artifactRuinSurfaceY({_cx} - {_pc}, {_cz} + {_pc}, {_w})
        loop {_hp2} times:
            set {_py} to {_syP2} + loop-number
            chance of 90%:
                set block at location at {_cx} - {_pc}, {_py}, {_cz} + {_pc} in {_w} to artifactRuinPillarPieceForKind({_pal}, {_kind})
        set {_syP3} to artifactRuinSurfaceY({_cx} + {_pc}, {_cz} - {_pc}, {_w})
        loop {_hp3} times:
            set {_py} to {_syP3} + loop-number
            chance of 90%:
                set block at location at {_cx} + {_pc}, {_py}, {_cz} - {_pc} in {_w} to artifactRuinPillarPieceForKind({_pal}, {_kind})
        set {_syP4} to artifactRuinSurfaceY({_cx} + {_pc}, {_cz} + {_pc}, {_w})
        loop {_hp4} times:
            set {_py} to {_syP4} + loop-number
            chance of 90%:
                set block at location at {_cx} + {_pc}, {_py}, {_cz} + {_pc} in {_w} to artifactRuinPillarPieceForKind({_pal}, {_kind})
        set {_top1} to {_syP1} + {_hp1} + 1
        set {_top2} to {_syP2} + {_hp2} + 1
        set {_top3} to {_syP3} + {_hp3} + 1
        set {_top4} to {_syP4} + {_hp4} + 1
        if {_kind} is "legendary":
            set block at location at {_cx} - {_pc}, {_top1}, {_cz} - {_pc} in {_w} to soul lantern
            set block at location at {_cx} - {_pc}, {_top2}, {_cz} + {_pc} in {_w} to soul lantern
            set block at location at {_cx} + {_pc}, {_top3}, {_cz} - {_pc} in {_w} to soul lantern
            set block at location at {_cx} + {_pc}, {_top4}, {_cz} + {_pc} in {_w} to soul lantern
        else:
            chance of 50%:
                set block at location at {_cx} - {_pc}, {_top1}, {_cz} - {_pc} in {_w} to soul lantern
            else:
                set block at location at {_cx} - {_pc}, {_top1}, {_cz} - {_pc} in {_w} to lantern
            chance of 50%:
                set block at location at {_cx} - {_pc}, {_top2}, {_cz} + {_pc} in {_w} to soul lantern
            else:
                set block at location at {_cx} - {_pc}, {_top2}, {_cz} + {_pc} in {_w} to lantern
            chance of 50%:
                set block at location at {_cx} + {_pc}, {_top3}, {_cz} - {_pc} in {_w} to soul lantern
            else:
                set block at location at {_cx} + {_pc}, {_top3}, {_cz} - {_pc} in {_w} to lantern
            chance of 50%:
                set block at location at {_cx} + {_pc}, {_top4}, {_cz} + {_pc} in {_w} to soul lantern
            else:
                set block at location at {_cx} + {_pc}, {_top4}, {_cz} + {_pc} in {_w} to lantern
    set {_txSpan} to 2 * {_plazaR}
    loop 18 times:
        set {_tx} to {_nmPc} + (random integer between 0 and {_txSpan})
        set {_tz} to {_nmPc} + (random integer between 0 and {_txSpan})
        set {_carpetOk} to true
        if {_tx} is 0:
            if {_tz} is 0:
                set {_carpetOk} to false
        if {_tx} is {_nmPc}:
            if {_tz} is {_nmPc}:
                set {_carpetOk} to false
            if {_tz} is {_pc}:
                set {_carpetOk} to false
        if {_tx} is {_pc}:
            if {_tz} is {_nmPc}:
                set {_carpetOk} to false
            if {_tz} is {_pc}:
                set {_carpetOk} to false
        if {_tx} >= 4:
            if {_tx} <= 6:
                if {_tz} >= -1:
                    if {_tz} <= 1:
                        set {_carpetOk} to false
        if {_carpetOk} is true:
            set {_lsx} to {_cx} + {_tx}
            set {_lsz} to {_cz} + {_tz}
            set {_lsy} to artifactRuinSurfaceY({_lsx}, {_lsz}, {_w})
            if {_lsy} > -90:
                chance of 52%:
                    set block at location at {_lsx}, {_lsy} + 1, {_lsz} in {_w} to artifactRuinCarpetForKind({_pal}, {_kind})
    if {_doWalls} is true:
        set {_lz} to {_cz} - 8
        set {_lx} to {_cx} - 9
        while {_lx} <= {_cx} - 4:
            set {_wsy} to artifactRuinSurfaceY({_lx}, {_lz}, {_w})
            if {_wsy} > -90:
                chance of 62%:
                    set block at location at {_lx}, {_wsy} + 1, {_lz} in {_w} to artifactRuinPillarPieceForKind({_pal}, {_kind})
                chance of 48%:
                    set block at location at {_lx}, {_wsy} + 2, {_lz} in {_w} to artifactRuinPillarPieceForKind({_pal}, {_kind})
            add 1 to {_lx}
        set {_lx} to {_cx} + 5
        set {_lz} to {_cz} + 6
        while {_lz} <= {_cz} + 10:
            set {_wsy} to artifactRuinSurfaceY({_lx}, {_lz}, {_w})
            if {_wsy} > -90:
                chance of 58%:
                    set block at location at {_lx}, {_wsy} + 1, {_lz} in {_w} to artifactRuinPillarPieceForKind({_pal}, {_kind})
                chance of 40%:
                    set block at location at {_lx}, {_wsy} + 2, {_lz} in {_w} to artifactRuinPillarPieceForKind({_pal}, {_kind})
            add 1 to {_lz}
    if {_doStubs} is true:
        set {_txx} to {_cx} + 8
        set {_tzz} to {_cz} - 5
        set {_stub} to random integer between 2 and 4
        loop {_stub} times:
            set {_sty} to artifactRuinSurfaceY({_txx}, {_tzz}, {_w}) + loop-number
            chance of 85%:
                set block at location at {_txx}, {_sty}, {_tzz} in {_w} to artifactRuinPillarPieceForKind({_pal}, {_kind})
        set {_txx} to {_cx} - 7
        set {_tzz} to {_cz} + 7
        set {_stub} to random integer between 2 and 3
        loop {_stub} times:
            set {_sty} to artifactRuinSurfaceY({_txx}, {_tzz}, {_w}) + loop-number
            chance of 85%:
                set block at location at {_txx}, {_sty}, {_tzz} in {_w} to artifactRuinPillarPieceForKind({_pal}, {_kind})
    loop 22 times:
        set {_rx} to {_cx} + random integer between -10 and 10
        set {_rz} to {_cz} + random integer between -10 and 10
        set {_ox} to {_rx} - {_cx}
        set {_oz} to {_rz} - {_cz}
        set {_rubbleOk} to true
        if {_ox} >= {_nmPc}:
            if {_ox} <= {_pc}:
                if {_oz} >= {_nmPc}:
                    if {_oz} <= {_pc}:
                        set {_rubbleOk} to false
        if {_rubbleOk} is true:
            set {_rsy} to artifactRuinSurfaceY({_rx}, {_rz}, {_w})
            if {_rsy} > -90:
                set {_rr} to random integer between 1 and 100
                if {_rr} <= 35:
                    set block at location at {_rx}, {_rsy}, {_rz} in {_w} to gravel
                else if {_rr} <= 70:
                    set block at location at {_rx}, {_rsy}, {_rz} in {_w} to cobblestone
                else if {_rr} <= 88:
                    set block at location at {_rx}, {_rsy} + 1, {_rz} in {_w} to moss carpet
                else if {_rr} <= 100:
                    set block at location at {_rx}, {_rsy}, {_rz} in {_w} to dead bush
    chance of 55%:
        set {_wsy} to artifactRuinSurfaceY({_cx} - 4, {_cz} - 6, {_w})
        if {_wsy} > -90:
            set block at location at {_cx} - 4, {_wsy} + 3, {_cz} - 6 in {_w} to cobweb
    chance of 45%:
        set {_wsy} to artifactRuinSurfaceY({_cx} + 4, {_cz} + 6, {_w})
        if {_wsy} > -90:
            set block at location at {_cx} + 4, {_wsy} + 3, {_cz} + 6 in {_w} to cobweb
    set {_tdx} to 4
    while {_tdx} <= 6:
        set {_tdz} to -1
        while {_tdz} <= 1:
            set {_tlx} to {_cx} + {_tdx}
            set {_tlz} to {_cz} + {_tdz}
            set {_tsy} to artifactRuinSurfaceY({_tlx}, {_tlz}, {_w})
            if {_tsy} > -90:
                set block at location at {_tlx}, {_tsy}, {_tlz} in {_w} to artifactRuinTowerPadForKind({_kind})
            add 1 to {_tdz}
        add 1 to {_tdx}
    set {_twSy} to artifactRuinSurfaceY({_cx} + 5, {_cz}, {_w})
    if {_twSy} > -90:
        loop 7 times:
            if loop-number is 1:
                set {_wdx} to 4
                set {_wdz} to -1
            else if loop-number is 2:
                set {_wdx} to 5
                set {_wdz} to -1
            else if loop-number is 3:
                set {_wdx} to 6
                set {_wdz} to -1
            else if loop-number is 4:
                set {_wdx} to 4
                set {_wdz} to 1
            else if loop-number is 5:
                set {_wdx} to 5
                set {_wdz} to 1
            else if loop-number is 6:
                set {_wdx} to 6
                set {_wdz} to 1
            else:
                set {_wdx} to 6
                set {_wdz} to 0
            set {_wlx} to {_cx} + {_wdx}
            set {_wlz} to {_cz} + {_wdz}
            set {_wsy} to artifactRuinSurfaceY({_wlx}, {_wlz}, {_w})
            if {_wsy} > -90:
                chance of 72%:
                    set block at location at {_wlx}, {_wsy} + 1, {_wlz} in {_w} to artifactRuinPillarPieceForKind({_pal}, {_kind})
                chance of 58%:
                    set block at location at {_wlx}, {_wsy} + 2, {_wlz} in {_w} to artifactRuinPillarPieceForKind({_pal}, {_kind})
        set {_chestLoc} to location at {_cx} + 5, {_twSy} + 1, {_cz} in {_w}
        set block at {_chestLoc} to chest
        artifactRuinFillChestBoss({_chestLoc}, {_kind})
        set {_towerKey} to evoBlockLocKey(block at {_chestLoc})
        set {evo_ruin_tower_locked::%{_towerKey}%} to true
        delete {evo_ruin_tower_unlocked::%{_towerKey}%}
    set {_ci} to {_plazaR} - 1
    if {_satN} is 2:
        set {_pya} to artifactRuinSurfaceY({_cx} - {_ci}, {_cz} - {_ci}, {_w})
        if {_pya} > -90:
            set {_p1l} to location at {_cx} - {_ci}, {_pya} + 1, {_cz} - {_ci} in {_w}
            set block at {_p1l} to chest
            artifactRuinFillChest({_p1l}, {_satT})
        set {_pyd} to artifactRuinSurfaceY({_cx} + {_ci}, {_cz} + {_ci}, {_w})
        if {_pyd} > -90:
            set {_p4l} to location at {_cx} + {_ci}, {_pyd} + 1, {_cz} + {_ci} in {_w}
            set block at {_p4l} to chest
            artifactRuinFillChest({_p4l}, {_satT})
    else:
        set {_pya} to artifactRuinSurfaceY({_cx} - {_ci}, {_cz} - {_ci}, {_w})
        if {_pya} > -90:
            set {_p1l} to location at {_cx} - {_ci}, {_pya} + 1, {_cz} - {_ci} in {_w}
            set block at {_p1l} to chest
            artifactRuinFillChest({_p1l}, {_satT})
        if {_satN} >= 4:
            set {_pyb} to artifactRuinSurfaceY({_cx} - {_ci}, {_cz} + {_ci}, {_w})
            if {_pyb} > -90:
                set {_p2l} to location at {_cx} - {_ci}, {_pyb} + 1, {_cz} + {_ci} in {_w}
                set block at {_p2l} to chest
                artifactRuinFillChest({_p2l}, {_satT})
            set {_pyc} to artifactRuinSurfaceY({_cx} + {_ci}, {_cz} - {_ci}, {_w})
            if {_pyc} > -90:
                set {_p3l} to location at {_cx} + {_ci}, {_pyc} + 1, {_cz} - {_ci} in {_w}
                set block at {_p3l} to chest
                artifactRuinFillChest({_p3l}, {_satT})
            set {_pyd} to artifactRuinSurfaceY({_cx} + {_ci}, {_cz} + {_ci}, {_w})
            if {_pyd} > -90:
                set {_p4l} to location at {_cx} + {_ci}, {_pyd} + 1, {_cz} + {_ci} in {_w}
                set block at {_p4l} to chest
                artifactRuinFillChest({_p4l}, {_satT})
        if {_satN} >= 6:
            if {_doWalls} is true:
                set {_pye} to artifactRuinSurfaceY({_cx} - 6, {_cz} - 7, {_w})
                if {_pye} > -90:
                    set {_rwl} to location at {_cx} - 6, {_pye} + 1, {_cz} - 7 in {_w}
                    set block at {_rwl} to chest
                    artifactRuinFillChest({_rwl}, {_satT})
                set {_pyf} to artifactRuinSurfaceY({_cx} + 7, {_cz} + 7, {_w})
                if {_pyf} > -90:
                    set {_rw2} to location at {_cx} + 7, {_pyf} + 1, {_cz} + 7 in {_w}
                    set block at {_rw2} to chest
                    artifactRuinFillChest({_rw2}, {_satT})
    artifactRuinSpawnGuards({_cx}, {_cz}, {_w}, {_kind})
    return true

function artifactRuinAdminSpawnHereKind(p: player, kind: text) :: boolean:
    set {_w} to world of {_p}
    if environment of {_w} is not normal:
        return false
    set {_bx} to floor(x-coordinate of location of {_p})
    set {_bz} to floor(z-coordinate of location of {_p})
    set {_feet} to artifactRuinFeetAtColumn({_bx}, {_bz}, {_w})
    if artifactRuinFeetValid({_feet}) is false:
        return false
    return artifactRuinBuild({_feet}, {_kind})

function artifactRuinAdminSpawnHere(p: player) :: boolean:
    set {_rk} to artifactRuinRandomKind()
    return artifactRuinAdminSpawnHereKind({_p}, {_rk})

function artifactRuinGoodNeighborForNetherrack(nb: block) :: boolean:
    if {_nb} is not set:
        return false
    if {_nb} is air:
        return false
    if {_nb} is cave air:
        return false
    if {_nb} is void air:
        return false
    if {_nb} is water:
        return false
    if {_nb} is minecraft:lava:
        return false
    if {_nb} is netherrack:
        return false
    if {_nb} is obsidian:
        return false
    if {_nb} is crying obsidian:
        return false
    if {_nb} is gold block:
        return false
    if {_nb} is gold ore:
        return false
    if {_nb} is nether gold ore:
        return false
    if {_nb} is magma block:
        return false
    if {_nb} is chest:
        return false
    if {_nb} is trapped chest:
        return false
    if {_nb} is iron bars:
        return false
    if "%type of {_nb}%" is "minecraft:chain":
        return false
    if {_nb} is stone bricks:
        return false
    if {_nb} is cracked stone bricks:
        return false
    if {_nb} is chiseled stone bricks:
        return false
    if {_nb} is mossy stone bricks:
        return false
    if {_nb} is stone brick slab:
        return false
    if {_nb} is stone brick stairs:
        return false
    if {_nb} is stone brick wall:
        return false
    set {_ty} to "%type of {_nb}%"
    if {_ty} contains "minecraft:blackstone":
        return false
    return true

function artifactRuinRemoveRuinedPortalScrap(center: location):
    set {_w} to world of {_center}
    loop blocks in radius 26 around {_center}:
        set {_ty} to "%type of loop-block%"
        if {_ty} contains "minecraft:blackstone":
            set loop-block to air
        else if loop-block is stone bricks:
            set loop-block to air
        else if loop-block is cracked stone bricks:
            set loop-block to air
        else if loop-block is chiseled stone bricks:
            set loop-block to air
        else if loop-block is mossy stone bricks:
            set loop-block to air
        else if loop-block is stone brick slab:
            set loop-block to air
        else if loop-block is stone brick stairs:
            set loop-block to air
        else if loop-block is stone brick wall:
            set loop-block to air
        else if loop-block is obsidian:
            set loop-block to air
        else if loop-block is crying obsidian:
            set loop-block to air
        else if loop-block is gold block:
            set loop-block to air
        else if loop-block is gold ore:
            set loop-block to air
        else if loop-block is nether gold ore:
            set loop-block to air
        else if loop-block is magma block:
            set loop-block to air
        else if loop-block is minecraft:lava:
            set loop-block to air
        else if loop-block is iron bars:
            set loop-block to air
        else if loop-block is chest:
            set loop-block to air
        else if loop-block is trapped chest:
            set loop-block to air
        else if "%type of loop-block%" is "minecraft:chain":
            set loop-block to air

function artifactRuinHealNetherrackAround(center: location):
    set {_w} to world of {_center}
    loop blocks in radius 26 around {_center}:
        if loop-block is netherrack:
            set {_bx} to floor(x-coordinate of location of loop-block)
            set {_by} to floor(y-coordinate of location of loop-block)
            set {_bz} to floor(z-coordinate of location of loop-block)
            set {_nb} to block at location at {_bx} + 1, {_by}, {_bz} in {_w}
            if artifactRuinGoodNeighborForNetherrack({_nb}) is true:
                set loop-block to {_nb}
            else:
                set {_nb} to block at location at {_bx} - 1, {_by}, {_bz} in {_w}
                if artifactRuinGoodNeighborForNetherrack({_nb}) is true:
                    set loop-block to {_nb}
                else:
                    set {_nb} to block at location at {_bx}, {_by} + 1, {_bz} in {_w}
                    if artifactRuinGoodNeighborForNetherrack({_nb}) is true:
                        set loop-block to {_nb}
                    else:
                        set {_nb} to block at location at {_bx}, {_by} - 1, {_bz} in {_w}
                        if artifactRuinGoodNeighborForNetherrack({_nb}) is true:
                            set loop-block to {_nb}
                        else:
                            set {_nb} to block at location at {_bx}, {_by}, {_bz} + 1 in {_w}
                            if artifactRuinGoodNeighborForNetherrack({_nb}) is true:
                                set loop-block to {_nb}
                            else:
                                set {_nb} to block at location at {_bx}, {_by}, {_bz} - 1 in {_w}
                                if artifactRuinGoodNeighborForNetherrack({_nb}) is true:
                                    set loop-block to {_nb}
                                else:
                                    set loop-block to stone

function artifactRuinChunkLooksLikeRuinedPortal(mid: location) :: boolean:
    set {_cry} to 0
    set {_obs} to 0
    loop blocks in radius 20 around {_mid}:
        if loop-block is crying obsidian:
            add 1 to {_cry}
        else if loop-block is obsidian:
            add 1 to {_obs}
    if {_cry} < 1:
        return false
    if {_obs} < 2:
        return false
    if {_cry} + {_obs} < 6:
        return false
    return true

function artifactRuinTryReplaceRuinedPortalFromChunk(ch: chunk):
    set {_w} to world of {_ch}
    if environment of {_w} is not normal:
        stop
    set {_wcx} to x coordinate of {_ch}
    set {_wcz} to z coordinate of {_ch}
    set {_rc} to "{@artifact_ruin_region_chunks}" parsed as number
    if {_rc} is not set:
        set {_rc} to 6
    if {_rc} < 1:
        set {_rc} to 6
    set {_rx} to floor({_wcx} / {_rc})
    set {_rz} to floor({_wcz} / {_rc})
    set {_wn} to "%{_w}%"
    if {evo_ruin_reg::%{_wn}%::%{_rx}%::%{_rz}%} is true:
        stop
    set {_bx} to {_wcx} * 16 + 8
    set {_bz} to {_wcz} * 16 + 8
    set {_sy} to artifactRuinSurfaceY({_bx}, {_bz}, {_w})
    if {_sy} < -90:
        stop
    set {_mid} to location at {_bx}, {_sy} + 2, {_bz} in {_w}
    if artifactRuinChunkLooksLikeRuinedPortal({_mid}) is false:
        stop
    set {_legMax} to "{@artifact_ruin_portal_roll_legendary_max}" parsed as number
    set {_comMax} to "{@artifact_ruin_portal_roll_common_max}" parsed as number
    if {_legMax} is not set:
        set {_legMax} to 10
    if {_comMax} is not set:
        set {_comMax} to 60
    set {_spawnx} to {_bx}
    set {_spawnz} to {_bz}
    loop blocks in radius 24 around {_mid}:
        if loop-block is chest:
            set {_spawnx} to floor(x-coordinate of location of loop-block)
            set {_spawnz} to floor(z-coordinate of location of loop-block)
            exit loop
        if loop-block is trapped chest:
            set {_spawnx} to floor(x-coordinate of location of loop-block)
            set {_spawnz} to floor(z-coordinate of location of loop-block)
            exit loop
    set {_roll} to random integer between 1 and 100
    if {_roll} > {_comMax}:
        stop
    set {_kind} to "common"
    if {_roll} <= {_legMax}:
        set {_kind} to "legendary"
    set {_preFeet} to artifactRuinFeetAtColumn({_spawnx}, {_spawnz}, {_w})
    if artifactRuinFeetValid({_preFeet}) is false:
        stop
    if artifactRuinFarFromSpawn({_preFeet}, {_w}) is false:
        stop
    set {_cx} to floor(x-coordinate of {_preFeet})
    set {_cz} to floor(z-coordinate of {_preFeet})
    if artifactRuinTerrainTooSteep({_cx}, {_cz}, 9, {_w}) is true:
        stop
    artifactRuinRemoveRuinedPortalScrap({_mid})
    artifactRuinHealNetherrackAround({_mid})
    set {_feet} to artifactRuinFeetAtColumn({_spawnx}, {_spawnz}, {_w})
    if artifactRuinBuild({_feet}, {_kind}) is true:
        set {evo_ruin_reg::%{_wn}%::%{_rx}%::%{_rz}%} to true

function artifactRuinTrySpawnChunk(wcx: number, wcz: number, w: world):
    set {_rc} to "{@artifact_ruin_region_chunks}" parsed as number
    if {_rc} is not set:
        set {_rc} to 6
    if {_rc} < 1:
        set {_rc} to 6
    set {_rx} to floor({_wcx} / {_rc})
    set {_rz} to floor({_wcz} / {_rc})
    set {_wn} to "%{_w}%"
    if {evo_ruin_reg::%{_wn}%::%{_rx}%::%{_rz}%} is true:
        stop
    loop 12 times:
        set {_bx} to {_wcx} * 16 + random integer between 3 and 12
        set {_bz} to {_wcz} * 16 + random integer between 3 and 12
        set {_feet} to artifactRuinFeetAtColumn({_bx}, {_bz}, {_w})
        if artifactRuinFeetValid({_feet}) is true:
            if artifactRuinFarFromSpawn({_feet}, {_w}) is true:
                set {_rk} to artifactRuinRandomKind()
                if artifactRuinBuild({_feet}, {_rk}) is true:
                    set {evo_ruin_reg::%{_wn}%::%{_rx}%::%{_rz}%} to true
                    stop

function artifactRuinSummonObeliskItem() :: item:
    set {_i} to respawn anchor named "&6&lЗов Руин"
    set lore of {_i} to "&7Сундук: &fпервые 5 слотов &7(верхний ряд):" and "&7плачущий обсидиан, обсидиан, аметистовый блок," and "&7эндер-жемчуг, незеритовый лом" and "&7— открой сундук, когда всё положил." and "&7Shift+ПКМ по блоку в Оверворлде — руина." and "&0EVORUINSUMMON"
    return {_i}

function isArtifactRuinSummonItem(i: item) :: boolean:
    if {_i} is air:
        return false
    set {_ls::*} to lore of {_i}
    loop {_ls::*}:
        if "%loop-value%" contains "EVORUINSUMMON":
            return true
    return false

function artifactRuinRegisterRegionForBlock(w: world, bx: number, bz: number):
    set {_rc} to "{@artifact_ruin_region_chunks}" parsed as number
    if {_rc} is not set:
        set {_rc} to 6
    if {_rc} < 1:
        set {_rc} to 6
    set {_wcx} to floor({_bx} / 16)
    set {_wcz} to floor({_bz} / 16)
    set {_rx} to floor({_wcx} / {_rc})
    set {_rz} to floor({_wcz} / {_rc})
    set {_wn} to "%{_w}%"
    set {evo_ruin_reg::%{_wn}%::%{_rx}%::%{_rz}%} to true

# ----- Алтарь пробуждения (Незер): сундук → оболочка 3×3×3 + именная воронка в инвентарь → установка на центральный аметист -----
# Дыры по центру боковых граней среднего слоя (доступ); низ и верх центра не «дыры»: аметист и плачущий обсидиан.

function isAwakeningAltarFaceHoleMiddle(dx: number, dz: number) :: boolean:
    if {_dx} is -1:
        if {_dz} is 0:
            return true
    if {_dx} is 1:
        if {_dz} is 0:
            return true
    if {_dx} is 0:
        if {_dz} is -1:
            return true
        if {_dz} is 1:
            return true
    return false

function isAwakeningAltarTopButtonRel(dx: number, dz: number) :: boolean:
    if {_dx} is 0:
        if {_dz} is 1:
            return true
    return false

function awakeningHopperTokenItem() :: item:
    set {_h} to hopper
    set name of {_h} to "&5&lАлтарь Создания"
    set lore of {_h} to "&7Установи на центральный аметист алтаря" and "&7(центр нижнего слоя куба)" and "&8После установки откроется крафт воронки"
    return {_h}

function isAwakeningHopperToken(i: item) :: boolean:
    if {_i} is not hopper:
        return false
    set {_n} to name of {_i}
    if {_n} is not set:
        return false
    if {_n} contains "Алтарь Создания":
        return true
    return false

function altarAwakeningVoidKey(i: item) :: boolean:
    set {_n} to name of {_i}
    if {_n} is not set:
        return false
    if {_n} contains "Ключ Пустоты":
        return true
    if {_n} contains "Ключ пустоты":
        return true
    return false

function altarAwakeningReturnKey(i: item) :: boolean:
    set {_n} to name of {_i}
    if {_n} is not set:
        return false
    if {_n} contains "Ключ возврата":
        return true
    if {_n} contains "Ключ Возврата":
        return true
    if {_n} contains "Возврат":
        return true
    if {_n} contains "возврат":
        return true
    return false

function isAltarChestRecipeExact(inv: inventory) :: boolean:
    set {_voidN} to 0
    set {_cryN} to 0
    set {_obsN} to 0
    set {_amtN} to 0
    set {_bad} to false
    loop all items in {_inv}:
        if loop-value is air:
            stop
        if altarAwakeningVoidKey(loop-value) is true:
            add amount of loop-value to {_voidN}
        else if loop-value is crying obsidian:
            add amount of loop-value to {_cryN}
        else if loop-value is obsidian:
            add amount of loop-value to {_obsN}
        else if loop-value is amethyst shard:
            add amount of loop-value to {_amtN}
        else:
            set {_bad} to true
    if {_bad} is true:
        return false
    if {_voidN} is not 5:
        return false
    if {_cryN} is not 3:
        return false
    if {_obsN} is not 3:
        return false
    if {_amtN} is not 3:
        return false
    return true

function altarStructureShellOk(base: location, middleCenterMustBeHopper: boolean) :: boolean:
    set {_w} to world of {_base}
    set {_x} to floor(x-coordinate of {_base})
    set {_y} to floor(y-coordinate of {_base})
    set {_z} to floor(z-coordinate of {_base})
    set {_dx} to -1
    while {_dx} <= 1:
        set {_dz} to -1
        while {_dz} <= 1:
            set {_b0} to block at location at {_x} + {_dx}, {_y}, {_z} + {_dz} in {_w}
            if {_dx} is 0:
                if {_dz} is 0:
                    if {_b0} is not amethyst block:
                        return false
                else:
                    if {_b0} is not polished blackstone bricks:
                        return false
            else:
                if {_b0} is not polished blackstone bricks:
                    return false
            add 1 to {_dz}
        add 1 to {_dx}
    set {_dx} to -1
    while {_dx} <= 1:
        set {_dz} to -1
        while {_dz} <= 1:
            if {_dx} is 0:
                if {_dz} is 0:
                    set {_b1} to block at location at {_x}, {_y} + 1, {_z} in {_w}
                    if {_middleCenterMustBeHopper} is true:
                        if {_b1} is not hopper:
                            return false
                        if isAwakeningAltarHopperComplete({_b1}) is false:
                            return false
                    else:
                        if {_b1} is not air:
                            return false
                else:
                    set {_b1} to block at location at {_x} + {_dx}, {_y} + 1, {_z} + {_dz} in {_w}
                    if isAwakeningAltarFaceHoleMiddle({_dx}, {_dz}) is true:
                        if {_b1} is not air:
                            return false
                    else if {_b1} is not blackstone:
                        return false
            else:
                set {_b1} to block at location at {_x} + {_dx}, {_y} + 1, {_z} + {_dz} in {_w}
                if isAwakeningAltarFaceHoleMiddle({_dx}, {_dz}) is true:
                    if {_b1} is not air:
                        return false
                else if {_b1} is not blackstone:
                    return false
            add 1 to {_dz}
        add 1 to {_dx}
    set {_dx} to -1
    while {_dx} <= 1:
        set {_dz} to -1
        while {_dz} <= 1:
            set {_b2} to block at location at {_x} + {_dx}, {_y} + 2, {_z} + {_dz} in {_w}
            if {_dx} is 0:
                if {_dz} is 0:
                    if {_b2} is not crying obsidian:
                        return false
            add 1 to {_dz}
        add 1 to {_dx}
    set {_b3} to block at location at {_x}, {_y} + 2, {_z} - 1 in {_w}
    if {_b3} is not stone button:
        return false
    return true

function altarStructureCoreOk(base: location) :: boolean:
    return altarStructureShellOk({_base}, true)

function isAwakeningAltarHopperComplete(b: block) :: boolean:
    if {_b} is not hopper:
        return false
    # Не завязываемся на заголовок GUI: на некоторых сборках/клиентах
    # имя воронки может отображаться как Item Hopper.
    return true

function tryBuildAwakeningAltarAtChestBlock(cb: block, opener: player):
    set {_chestOk} to false
    if {_cb} is chest:
        set {_chestOk} to true
    else if {_cb} is trapped chest:
        set {_chestOk} to true
    if {_chestOk} is true:
        set {_cinv} to inventory of {_cb}
        if isArtifactRecipeByFive({_cinv}, crying obsidian, obsidian, amethyst block, ender pearl, netherite scrap) is true:
            loop 5 times:
                set slot (loop-number - 1) of {_cinv} to air
            set {_gift} to artifactRuinSummonObeliskItem()
            set {_cloc} to location of {_cb}
            giveOrDrop({_gift}, {_opener}, {_cloc})
            play sound "block.enchantment_table.use" with volume 1 and pitch 0.85 at {_cloc} for all players
            execute console command "execute positioned %x-coordinate of {_cloc}% %y-coordinate of {_cloc}% %z-coordinate of {_cloc}% run particle minecraft:enchant ~ ~1 ~ 0.35 0.2 0.35 0.02 28 force"
            set {_rid} to diaryRecipeEntryFromItem({_gift})
            if {_rid} is not "":
                addDiaryRecipePage({_opener}, {_rid})
                send action bar "&6+Рецепт в Дневник" to {_opener}
            send "{@prefix} &6Сундук выдал &eЗов Руин&6 — Shift+ПКМ по блоку в Оверворлде." to {_opener}
            stop
        if isAltarChestRecipeExact({_cinv}) is true:
            clear {_cinv}
            buildAwakeningAltarFromChest({_cb}, {_opener})

function tryBuildAwakeningAltarAtChestBlock(cb: block):
    set {_chestOk} to false
    if {_cb} is chest:
        set {_chestOk} to true
    else if {_cb} is trapped chest:
        set {_chestOk} to true
    if {_chestOk} is true:
        set {_cinv} to inventory of {_cb}
        if isArtifactRecipeByFive({_cinv}, crying obsidian, obsidian, amethyst block, ender pearl, netherite scrap) is true:
            loop 5 times:
                set slot (loop-number - 1) of {_cinv} to air
            set {_gift} to artifactRuinSummonObeliskItem()
            set {_cloc} to location of {_cb}
            drop {_gift} at {_cloc}
            play sound "block.enchantment_table.use" with volume 1 and pitch 0.85 at {_cloc} for all players
            execute console command "execute positioned %x-coordinate of {_cloc}% %y-coordinate of {_cloc}% %z-coordinate of {_cloc}% run particle minecraft:enchant ~ ~1 ~ 0.35 0.2 0.35 0.02 28 force"
            stop
        if isAltarChestRecipeExact({_cinv}) is true:
            clear {_cinv}
            buildAwakeningAltarShellFromChest({_cb})

function tryBuildAwakeningAltarFromInventoryHolder(h: object, opener: player):
    if {_h} is chest:
        tryBuildAwakeningAltarAtChestBlock({_h}, {_opener})
    else if {_h} is trapped chest:
        tryBuildAwakeningAltarAtChestBlock({_h}, {_opener})

function tryBuildAwakeningAltarFromInventoryHolder(h: object):
    if {_h} is chest:
        tryBuildAwakeningAltarAtChestBlock({_h})
    else if {_h} is trapped chest:
        tryBuildAwakeningAltarAtChestBlock({_h})

function buildAwakeningAltarShellFromChest(ch: block):
    set {_w} to world of {_ch}
    set {_x} to floor(x-coordinate of {_ch})
    set {_y} to floor(y-coordinate of {_ch})
    set {_z} to floor(z-coordinate of {_ch})
    set block at {_ch} to air
    set {_dx} to -1
    while {_dx} <= 1:
        set {_dz} to -1
        while {_dz} <= 1:
            if {_dx} is 0:
                if {_dz} is 0:
                    set block at location at {_x}, {_y}, {_z} in {_w} to amethyst block
                else:
                    set block at location at {_x} + {_dx}, {_y}, {_z} + {_dz} in {_w} to polished blackstone bricks
            else:
                set block at location at {_x} + {_dx}, {_y}, {_z} + {_dz} in {_w} to polished blackstone bricks
            add 1 to {_dz}
        add 1 to {_dx}
    set {_dx} to -1
    while {_dx} <= 1:
        set {_dz} to -1
        while {_dz} <= 1:
            if {_dx} is 0:
                if {_dz} is 0:
                    set block at location at {_x}, {_y} + 1, {_z} in {_w} to air
                else:
                    set block at location at {_x} + {_dx}, {_y} + 1, {_z} + {_dz} in {_w} to blackstone
            else:
                set block at location at {_x} + {_dx}, {_y} + 1, {_z} + {_dz} in {_w} to blackstone
            add 1 to {_dz}
        add 1 to {_dx}
    set {_dx} to -1
    while {_dx} <= 1:
        set {_dz} to -1
        while {_dz} <= 1:
            set block at location at {_x} + {_dx}, {_y} + 2, {_z} + {_dz} in {_w} to air
            add 1 to {_dz}
        add 1 to {_dx}
    set block at location at {_x}, {_y} + 2, {_z} in {_w} to crying obsidian
    # Одна физическая кнопка: на центральном плачущем обсидиане (сбоку), с северной стороны (-Z).
    set block at location at {_x}, {_y} + 2, {_z} - 1 in {_w} to stone button
    set block at location at {_x} - 1, {_y} + 1, {_z} in {_w} to air
    set block at location at {_x} + 1, {_y} + 1, {_z} in {_w} to air
    set block at location at {_x}, {_y} + 1, {_z} - 1 in {_w} to air
    set block at location at {_x}, {_y} + 1, {_z} + 1 in {_w} to air
    set {_core} to location at {_x}, {_y}, {_z} in {_w}
    add {_core} to {awakening_altar_bases::*}
    set {_fx} to location at {_x}, {_y} + 1, {_z} in {_w}
    strike lightning effect at {_fx}
    play sound "block.beacon.activate" with volume 1 and pitch 0.8 at {_fx} for all players
    execute console command "execute positioned %x-coordinate of {_fx}% %y-coordinate of {_fx}% %z-coordinate of {_fx}% run particle minecraft:witch ~ ~ ~ 0.45 0.35 0.45 0.01 45 force"
    execute console command "execute positioned %x-coordinate of {_fx}% %y-coordinate of {_fx}% %z-coordinate of {_fx}% run particle minecraft:portal ~ ~0.4 ~ 0.55 0.35 0.55 0.01 60 force"

function buildAwakeningAltarFromChest(ch: block, opener: player):
    buildAwakeningAltarShellFromChest({_ch})
    set {_tok} to awakeningHopperTokenItem()
    if {_opener} has space for {_tok}:
        give {_tok} to {_opener}
        send "{@prefix} &dПолучена воронка &5Алтарь Создания&d — поставь её на центральный аметист." to {_opener}
    else:
        drop {_tok} at {_opener}
        send "{@prefix} &eИнвентарь полон: воронка &5Алтарь Создания &eвыпала рядом." to {_opener}

function tryCompleteAwakeningAltarHopper(placer: player, hb: block, placed: item):
    if {_hb} is not hopper:
        stop
    set {_tok} to false
    if isAwakeningHopperToken({_placed}) is true:
        set {_tok} to true
    if {_tok} is false:
        if isAwakeningHopperToken(tool of {_placer}) is true:
            set {_tok} to true
    if {_tok} is false:
        stop
    set {_w} to world of {_hb}
    set {_hx} to floor(x-coordinate of {_hb})
    set {_hy} to floor(y-coordinate of {_hb})
    set {_hz} to floor(z-coordinate of {_hb})
    set {_below} to block at location at {_hx}, {_hy} - 1, {_hz} in {_w}
    if {_below} is not amethyst block:
        stop
    set {_bx} to {_hx}
    set {_by} to {_hy} - 1
    set {_bz} to {_hz}
    set {_baseLoc} to location at {_bx}, {_by}, {_bz} in {_w}
    set {_listed} to false
    loop {awakening_altar_bases::*}:
        if loop-value is {_baseLoc}:
            set {_listed} to true
            exit loop
    if {_listed} is false:
        stop
    if altarStructureShellOk({_baseLoc}, false) is false:
        stop
    set {_already} to false
    loop {awakening_altars::*}:
        if loop-value is location of {_hb}:
            set {_already} to true
            exit loop
    if {_already} is true:
        stop
    set name of inventory of {_hb} to "&5&lАлтарь Создания"
    add location of {_hb} to {awakening_altars::*}
    play sound "block.beacon.activate" with volume 1 and pitch 1 at {_hb} for all players
    send "{@prefix} &dАлтарь создания завершён — можно крафтить в воронке." to {_placer}

function altarEtherPickaxeItem() :: item:
    set {_p} to diamond pickaxe
    set name of {_p} to "&dЭфирная Кирка"
    set lore of {_p} to "&8✦ Алтарная кирка" and "&8ЭФИР_КИРКА" and "&7ПКМ: &fшёлковое касание &7(целые блоки вкл/выкл)" and "&7Shift+ПКМ: &fэфирный режим &7(пыль с мусора)" and "&7Руды -> &aмгновенно в инвентарь" and "&8∞ Неразрушимая"
    enchant {_p} with unbreaking 10
    return {_p}

function altarFlamePickaxeItem() :: item:
    set {_p} to diamond pickaxe
    set name of {_p} to "&cПламенная Кирка"
    set lore of {_p} to "&8✦ Алтарная кирка" and "&8ПЛАМЯ_КИРКА" and "&7Руды сразу плавятся в &6слитки" and "&7Пылающая добыча + доп. опыт" and "&8∞ Неразрушимая"
    enchant {_p} with unbreaking 10
    return {_p}

function altarVeinPickaxeItem() :: item:
    set {_p} to diamond pickaxe
    set name of {_p} to "&aЖильная Кирка"
    set lore of {_p} to "&8✦ Алтарная кирка" and "&8ЖИЛА_КИРКА" and "&7Ломает соседнюю жилу руды" and "&7До &f27 &7блоков за один удар" and "&8∞ Неразрушимая"
    enchant {_p} with unbreaking 10
    return {_p}

function altarFortunePickaxeItem() :: item:
    set {_p} to diamond pickaxe
    set name of {_p} to "&eКирка Удачи"
    set lore of {_p} to "&8✦ Алтарная кирка" and "&8УДАЧА_КИРКА" and "&7Усиленная добыча редких ресурсов" and "&7Бонусный дроп с руд" and "&8∞ Неразрушимая"
    enchant {_p} with unbreaking 10
    return {_p}

function altarVoidPickaxeItem() :: item:
    set {_p} to diamond pickaxe
    set name of {_p} to "&5Кирка Пустоты"
    set lore of {_p} to "&8✦ Алтарная кирка" and "&8ПУСТОТА_КИРКА" and "&7Добыча втягивается сквозь пустоту" and "&7Шанс получить &5эндер-жемчуг" and "&8∞ Неразрушимая"
    enchant {_p} with unbreaking 10
    return {_p}

function altarOmniPickaxeItem() :: item:
    set {_p} to netherite pickaxe
    set name of {_p} to "&6&lОмни-Кирка Алтаря"
    set lore of {_p} to "&8✦ Финальное слияние" and "&8ОМНИ_КИРКА" and "&7ПКМ: &fшёлковое касание &7(целые блоки)" and "&7Shift+ПКМ: &fэфирный режим &7(пыль с мусора)" and "&7Автосбор + плавка + жила + удача + пустота" and "&8∞ Неразрушимая"
    enchant {_p} with unbreaking 10
    enchant {_p} with efficiency 6
    return {_p}

function syncAltarSilkEnchant(p: player):
    set {_u} to uuid of {_p}
    set {_tk} to {_p}'s tool
    if isAltarPickaxeTool({_tk}) is not true:
        stop
    set {_on} to {altar_pick_silk_mode::%{_u}%} ? false
    if {_on} is true:
        enchant {_tk} with silk touch 1
        set {_p}'s tool to {_tk}
        stop
    # При выключении возвращаем базовый вариант кирки без Silk Touch.
    if isOmniPickaxe({_tk}) is true:
        set {_p}'s tool to altarOmniPickaxeItem()
    else if isFlamePickaxe({_tk}) is true:
        set {_p}'s tool to altarFlamePickaxeItem()
    else if isVeinPickaxe({_tk}) is true:
        set {_p}'s tool to altarVeinPickaxeItem()
    else if isFortunePickaxe({_tk}) is true:
        set {_p}'s tool to altarFortunePickaxeItem()
    else if isVoidPickaxe({_tk}) is true:
        set {_p}'s tool to altarVoidPickaxeItem()
    else if isEtherPickaxe({_tk}) is true:
        set {_p}'s tool to altarEtherPickaxeItem()

function isEtherPickaxe(i: item) :: boolean:
    if {_i} is not diamond pickaxe:
        return false
    set {_n} to name of {_i}
    if {_n} is not set:
        return false
    if {_n} contains "Эфирная Кирка":
        return true
    return false

function pickaxeHasTag(i: item, tag: text) :: boolean:
    if {_i} is not diamond pickaxe:
        if {_i} is not netherite pickaxe:
            return false
    set {_l::*} to lore of {_i}
    loop {_l::*}:
        if loop-value contains {_tag}:
            return true
    return false

function isFlamePickaxe(i: item) :: boolean:
    return pickaxeHasTag({_i}, "ПЛАМЯ_КИРКА")

function isVeinPickaxe(i: item) :: boolean:
    return pickaxeHasTag({_i}, "ЖИЛА_КИРКА")

function isFortunePickaxe(i: item) :: boolean:
    return pickaxeHasTag({_i}, "УДАЧА_КИРКА")

function isVoidPickaxe(i: item) :: boolean:
    return pickaxeHasTag({_i}, "ПУСТОТА_КИРКА")

function isOmniPickaxe(i: item) :: boolean:
    return pickaxeHasTag({_i}, "ОМНИ_КИРКА")

function isAltarPickaxeTool(i: item) :: boolean:
    if isEtherPickaxe({_i}) is true:
        return true
    if isFlamePickaxe({_i}) is true:
        return true
    if isVeinPickaxe({_i}) is true:
        return true
    if isFortunePickaxe({_i}) is true:
        return true
    if isVoidPickaxe({_i}) is true:
        return true
    if isOmniPickaxe({_i}) is true:
        return true
    return false

# ---- Артефакты: боевые эффекты ----
on damage:
    # Корона Высшего Разума: зачарования работают на +1 уровень (боевой эквивалент).
    if attacker is a player:
        if hasArtifact(attacker, "crownmind") is true:
            if attacker's tool is enchanted with sharpness:
                add 1 to damage
            if projectile is set:
                if attacker's tool is enchanted with power:
                    set damage to damage * 1.1

    if victim is a player:
        if hasArtifact(victim, "crownmind") is true:
            set {_protBoost} to 0
            loop helmet, chestplate, leggings and boots of victim:
                if loop-value is enchanted with protection:
                    add 0.04 to {_protBoost}
            if {_protBoost} > 0:
                set damage to damage * (1 - {_protBoost})

    # Временная неуязвимость легендарки Scout
    if victim is a player:
        set {_vuImm} to victim's uuid
        set {_immUntil} to {leg_scout_immortal_until::%{_vuImm}%} ? 0
        if {_immUntil} > unix timestamp of now:
            cancel event
            stop

    # Гнилое яблоко: x2 урон по нейтральным животным (раньше вложенных damage victim, иначе set damage ломается)
    if attacker is a player:
        if hasArtifact(attacker, "rottenapple") is true:
            if victim is a cow:
                set damage to damage * 2
            else if victim is a sheep:
                set damage to damage * 2
            else if victim is a pig:
                set damage to damage * 2
            else if victim is a chicken:
                set damage to damage * 2
            else if victim is a rabbit:
                set damage to damage * 2

    # Алтарные мечи: бонусы при ударе
    if attacker is a player:
        if isAltarSwordTool(attacker's tool) is true:
            syncAltarGearDurability(attacker)
            if victim is a living entity:
                if victim is not attacker:
                    applyAltarSwordOnHit(attacker, victim, damage)

    # Алтарная броня: защита и контратаки
    if victim is a player:
        syncAltarGearDurability(victim)
        set {_altarDc} to "%damage cause%" in lower case
        loop helmet, chestplate, leggings and boots of victim:
            if altarArmorPieceBlocksDamage(victim, loop-value, {_altarDc}) is true:
                cancel event
                stop
            set {_altarMult} to altarArmorPieceDamageMult(victim, loop-value, {_altarDc})
            set damage to damage * {_altarMult}
        applyAltarArmorHitEffects(victim, attacker)

    # Легендарка Warrior: Печать Пространственного Разреза
    # Тип оружия — как у бонуса L1 воина: isSword() (любой материал) + булава 1.21
    if attacker is a player:
        if classOf(attacker) is "Warrior":
            if hasArtifact(attacker, "leg_warrior") is true:
                # Красный разрез (air slash) сам наносит урон — не дублируем пассивку от fake damage
                set {_warAuid} to uuid of attacker
                if {leg_warrior_slashing::%{_warAuid}%} is not set:
                    if levelOf(attacker) < 20:
                        if isNetherite(attacker's tool) is true:
                            stop
                    if victim is a living entity:
                        if victim is not attacker:
                            if warriorLegMeleeWeapon(attacker) is true:
                                set {_slash} to damage * 0.4
                                if {_slash} < 1:
                                    set {_slash} to 1
                                damage victim by {_slash}
                                set {_vlocSlash} to location of victim
                                execute console command "particle minecraft:sweep_attack %x-coordinate of {_vlocSlash}% %y-coordinate of {_vlocSlash}% %z-coordinate of {_vlocSlash}% 0.25 0.25 0.25 0 4 force"
                                send action bar "&6&lПРОСТРАНСТВЕННЫЙ РАЗРЕЗ!" to attacker
                                loop all living entities in radius 10 around attacker:
                                    if loop-entity is not attacker:
                                        if loop-entity is not victim:
                                            if distance between loop-entity and victim <= 2.5:
                                                damage loop-entity by {_slash}

    # Кольцо Ветра: +15% урона в бою
    if attacker is a player:
        set {_auCore} to attacker's uuid
        if {class::%{_auCore}%} is "Necromancer":
            if hasArtifact(attacker, "leg_necro") is true:
                if victim is a living entity:
                    set {art_leg_necro_focus::%{_auCore}%} to "%uuid of victim%"
        if hasArtifact(attacker, "windring") is true:
            set damage to damage * 1.15
        if hasArtifact(attacker, "vampcharm") is true:
            heal attacker by damage * 0.25

    # Бритва Мерунеса: шанс казни 2% (кроме боссов и игроков)
    if attacker is a player:
        if hasArtifact(attacker, "mehrunes") is true:
            if victim is a living entity:
                if victim is not a player:
                    if victim is not an ender dragon:
                        if victim is not a wither:
                            if victim is not a warden:
                                chance of 13.33%:
                                    set health of victim to 0
                                    send action bar "&4&lКАЗНЬ!" to attacker
                                    play sound "entity.evoker.cast_spell" with volume 1 and pitch 0.6 at attacker for attacker

    # Звёздная ярость: комета по области при ударах мечом
    if attacker is a player:
        if hasArtifact(attacker, "starfury") is true:
            chance of 35%:
                set {_vloc} to location of victim
                # Только визуальный эффект молнии (без реального удара)
                strike lightning effect at {_vloc}
                # Основная цель получает бонус, равный базовому урону (x2 суммарно)
                set {_bonus} to damage
                if {_bonus} < 1:
                    set {_bonus} to 1
                damage victim by {_bonus}
                ignite victim for 5 seconds
                play sound "entity.generic.explode" with volume 1 and pitch 1.15 at {_vloc} for all players
                loop all living entities in radius 4 around {_vloc}:
                    if loop-entity is not attacker:
                        if loop-entity is not victim:
                            damage loop-entity by 6
                            ignite loop-entity for 4 seconds
                send action bar "&f&lКОМЕТА!" to attacker
    # Сердце ледяного великана: замедляет атакующего
    if victim is a player:
        if hasArtifact(victim, "frostheart") is true:
            if attacker is a living entity:
                remove slowness from attacker
                remove mining fatigue from attacker
                apply slowness 2 without particles to attacker for 15 seconds
                apply mining fatigue 1 without particles to attacker for 15 seconds

    # Легендарка Scout: Тень Фантома
    if victim is a player:
        set {_vuScout} to victim's uuid
        if {class::%{_vuScout}%} is "Scout":
            if hasArtifact(victim, "leg_scout") is true:
                if attacker is a living entity:
                    set {_cdScout} to {art_leg_scout_cd::%{_vuScout}%} ? 0
                    set {_nowScout} to unix timestamp of now
                    if {_nowScout} >= {_cdScout}:
                        chance of 25%:
                            set {_fromScout} to location of victim
                            cancel event
                            set {_toScout} to {_fromScout}
                            set {_foundScout} to false
                            loop 8 times:
                                if {_foundScout} is false:
                                    set {_candScout} to location of victim
                                    set {_dxScout} to random integer between -5 and 5
                                    set {_dzScout} to random integer between -5 and 5
                                    if {_dxScout} is 0:
                                        if {_dzScout} is 0:
                                            set {_dxScout} to 1
                                    add {_dxScout} to x-coordinate of {_candScout}
                                    add {_dzScout} to z-coordinate of {_candScout}
                                    add 0.2 to y-coordinate of {_candScout}
                                    set {_feetScout} to block at {_candScout}
                                    set {_headScout} to block above {_feetScout}
                                    set {_groundScout} to block below {_candScout}
                                    if {_feetScout} is air:
                                        if {_headScout} is air:
                                            if {_groundScout} is not air:
                                                if "%type of {_groundScout}%" is not "minecraft:lava":
                                                    set {_toScout} to {_candScout}
                                                    set {_foundScout} to true
                            if {_foundScout} is true:
                                teleport victim to {_toScout}
                            set {leg_scout_saved_helm::%{_vuScout}%} to helmet of victim
                            set {leg_scout_saved_chest::%{_vuScout}%} to chestplate of victim
                            set {leg_scout_saved_legs::%{_vuScout}%} to leggings of victim
                            set {leg_scout_saved_boots::%{_vuScout}%} to boots of victim
                            set {_hadAnyArmor} to false
                            if {leg_scout_saved_helm::%{_vuScout}%} is not air:
                                set {_hadAnyArmor} to true
                            if {leg_scout_saved_chest::%{_vuScout}%} is not air:
                                set {_hadAnyArmor} to true
                            if {leg_scout_saved_legs::%{_vuScout}%} is not air:
                                set {_hadAnyArmor} to true
                            if {leg_scout_saved_boots::%{_vuScout}%} is not air:
                                set {_hadAnyArmor} to true
                            set helmet of victim to air
                            set chestplate of victim to air
                            set leggings of victim to air
                            set boots of victim to air
                            ignite victim for 0 seconds
                            set {leg_scout_immortal_until::%{_vuScout}%} to (unix timestamp of now) + 3
                            apply invisibility without particles to victim for 3 seconds
                            apply speed 3 without particles to victim for 3 seconds
                            if {_hadAnyArmor} is true:
                                spawnScoutPhantomDecoy(victim, {_fromScout}, false, {leg_scout_saved_helm::%{_vuScout}%}, {leg_scout_saved_chest::%{_vuScout}%}, {leg_scout_saved_legs::%{_vuScout}%}, {leg_scout_saved_boots::%{_vuScout}%})
                            else:
                                spawnScoutPhantomDecoy(victim, {_fromScout}, true, air, air, air, air)
                            set {art_leg_scout_cd::%{_vuScout}%} to {_nowScout} + 8
                            send action bar "&6&lТЕНЬ ФАНТОМА!" to victim
                            wait 3 seconds
                            if victim is online:
                                if uuid of victim is {_vuScout}:
                                    if {_hadAnyArmor} is true:
                                        set helmet of victim to {leg_scout_saved_helm::%{_vuScout}%}
                                        set chestplate of victim to {leg_scout_saved_chest::%{_vuScout}%}
                                        set leggings of victim to {leg_scout_saved_legs::%{_vuScout}%}
                                        set boots of victim to {leg_scout_saved_boots::%{_vuScout}%}
                            delete {leg_scout_saved_helm::%{_vuScout}%}
                            delete {leg_scout_saved_chest::%{_vuScout}%}
                            delete {leg_scout_saved_legs::%{_vuScout}%}
                            delete {leg_scout_saved_boots::%{_vuScout}%}
                            delete {leg_scout_immortal_until::%{_vuScout}%}
                            stop

    # Легендарка Tank: Якорь Мироздания (ударная волна при падении)
    if victim is a player:
        set {_vuTank} to victim's uuid
        if {class::%{_vuTank}%} is "Tank":
            if hasArtifact(victim, "leg_tank") is true:
                if damage cause is fall:
                    if victim's fall distance <= 8:
                        stop
                    delete {art_cloud_fallimmune::%{_vuTank}%}
                    delete {art_cloud_fallimmune_until::%{_vuTank}%}
                    set {_fd} to victim's fall distance
                    if {_fd} < 3:
                        set {_fd} to 3
                    # Нерф: меньше базовый множитель, урон снижается бронёй как обычный melee-hit
                    set {_shockDmg} to round({_fd} * 0.35)
                    if {_shockDmg} < 2:
                        set {_shockDmg} to 2
                    if {_shockDmg} > 8:
                        set {_shockDmg} to 8
                    set {_pushY} to 0.6 + ({_fd} * 0.03)
                    if {_pushY} > 1.4:
                        set {_pushY} to 1.4
                    cancel event
                    execute console command "execute as %victim% at %victim% run particle minecraft:explosion_emitter ~ ~1 ~ 0 0 0 0 1 force"
                    execute console command "execute as %victim% at %victim% run particle minecraft:cloud ~ ~0.2 ~ 0.7 0.2 0.7 0.02 35 force"
                    execute console command "execute as %victim% at %victim% run particle minecraft:poof ~ ~0.2 ~ 1.2 0.25 1.2 0.03 45 force"
                    loop all living entities in radius 10 around victim:
                        if loop-entity is not victim:
                            execute console command "execute as %victim% at %victim% run particle minecraft:cloud %x-coordinate of loop-entity% %y-coordinate of loop-entity% %z-coordinate of loop-entity% 0.25 0.1 0.25 0.01 8 force"
                            set {leg_tank_wave_killer::%uuid of loop-entity%} to uuid of victim
                            damage loop-entity by {_shockDmg} with fake damage cause entity attack
                            delete {leg_tank_wave_killer::%uuid of loop-entity%}
                            if victim is a player:
                                tagCombat(victim)
                            if loop-entity is a player:
                                tagCombat(loop-entity)
                            push loop-entity upwards at speed {_pushY}
                    loop blocks in radius 3 around victim:
                        if loop-block is glass:
                            set loop-block to air
                        if "%type of loop-block%" contains "leaves":
                            set loop-block to air
                    play sound "entity.generic.explode" with volume 0.9 and pitch 0.7 at victim for all players
                    send action bar "&6&lЯКОРЬ МИРОЗДАНИЯ!" to victim
                    stop

    # Легендарка Necromancer: нежить не атакует первой (утопленник, хаск, stray, bogged и др.)
    if victim is a player:
        set {_vuNec} to victim's uuid
        if {class::%{_vuNec}%} is "Necromancer":
            if hasArtifact(victim, "leg_necro") is true:
                if attacker is a living entity:
                    if isLegNecroPacifiedUndead(attacker) is true:
                        cancel event
                        stop

    # Эфирный телепорт: при входящем уроне от сущности телепортирует и отменяет урон
    if victim is a player:
        if hasArtifact(victim, "etherdash") is true:
            if attacker is not a living entity:
                stop
            set {_vu} to victim's uuid
            set {_now} to unix timestamp of now
            set {_cd} to {art_etherdash_cd::%{_vu}%} ? 0
            if {_now} < {_cd}:
                stop
            # Смертельный удар + тотем в руке — не отменять (иначе тотем не сработает)
            if damage >= victim's health:
                if playerHoldsTotemOfUndying(victim) is true:
                    stop
            # Снимаем урон от самого попадания
            cancel event
            # Короткий иммун к урону после телепорта
            set {art_etherdash_immune_until::%{_vu}%} to {_now} + 2
            set {art_etherdash_cd::%{_vu}%} to {_now} + 20
            set {_from} to location of victim
            set {_to} to {_from}
            set {_foundSafe} to false
            loop 8 times:
                if {_foundSafe} is false:
                    set {_cand} to location of victim
                    set {_dx} to random integer between -5 and 5
                    set {_dz} to random integer between -5 and 5
                    if {_dx} is 0:
                        if {_dz} is 0:
                            set {_dx} to 1
                    add {_dx} to x-coordinate of {_cand}
                    add {_dz} to z-coordinate of {_cand}
                    add 0.2 to y-coordinate of {_cand}
                    set {_feet} to block at {_cand}
                    set {_head} to block above {_feet}
                    set {_ground} to block below {_cand}
                    if {_feet} is air:
                        if {_head} is air:
                            if {_ground} is not air:
                                if "%type of {_ground}%" is not "minecraft:lava":
                                    set {_to} to {_cand}
                                    set {_foundSafe} to true
            if {_foundSafe} is true:
                teleport victim to {_to}
            execute console command "particle minecraft:portal %x-coordinate of {_from}% %y-coordinate of {_from}% %z-coordinate of {_from}% 0.35 0.5 0.35 0 45 force"
            if {_foundSafe} is true:
                execute console command "particle minecraft:portal %x-coordinate of {_to}% %y-coordinate of {_to}% %z-coordinate of {_to}% 0.35 0.5 0.35 0 45 force"
            play sound "entity.enderman.teleport" with volume 0.9 and pitch 1.35 at victim for all players
            if {_foundSafe} is true:
                send action bar "&d&lЭФИРНЫЙ ТЕЛЕПОРТ!" to victim
            else:
                send action bar "&d&lЭФИРНЫЙ ЩИТ!" to victim
            stop

    # Эфирный телепорт: короткий иммун после срабатывания
    if victim is a player:
        set {_ivu} to victim's uuid
        set {_iuntil} to {art_etherdash_immune_until::%{_ivu}%} ? 0
        if {_iuntil} > unix timestamp of now:
            cancel event
            stop

# ---- Артефакты: смерть/заряды/награды ----
on death of player:
    set {art_last_death::%victim's uuid%} to location of victim

on respawn:
    set {_u} to player's uuid
    if hasArtifact(player, "voidcompass") is true:
        set {_nowVc} to unix timestamp of now
        set {_cdVc} to {art_voidcompass_cd::%{_u}%} ? 0
        if {_nowVc} < {_cdVc}:
            stop
        set {_base} to {art_last_death::%{_u}%}
        if {_base} is set:
            add 1 to {art_voidcompass_nonce::%{_u}%}
            set {_nonce} to {art_voidcompass_nonce::%{_u}%}
            set {art_voidcompass_pending::%{_u}%} to {_nonce}
            send "{@prefix} &8Компас Пустоты: &7возврат к месту смерти через &f10с&7..." to player
            send action bar "&7ПКМ компасом или /voidcancel: &cотменить возврат" to player
            execute console command "execute as %player% run tellraw @s [{""text"":""[Evo] "",""color"":""aqua"",""bold"":true},{""text"":""Компас Пустоты: "",""color"":""dark_gray""},{""text"":""[ОТМЕНИТЬ ВОЗВРАТ]"",""color"":""red"",""underlined"":true,""clickEvent"":{""action"":""run_command"",""value"":""/voidcancel""}}]"
            wait 10 seconds
            if player is online:
                if {art_voidcompass_pending::%{_u}%} is not {_nonce}:
                    stop
                set {_safe} to location of player
                set {_found} to false
                # Ищем безопасную точку в радиусе 10
                loop blocks in radius 10 around {_base}:
                    if {_found} is false:
                        if loop-block is not air:
                            set {_above} to block above loop-block
                            set {_above2} to block above {_above}
                            if {_above} is air:
                                if {_above2} is air:
                                    set {_safe} to location of {_above}
                                    set {_found} to true
                teleport player to {_safe}
                delete {art_voidcompass_pending::%{_u}%}
                set {art_voidcompass_cd::%{_u}%} to (unix timestamp of now) + 300
                play sound "entity.enderman.teleport" with volume 1 and pitch 0.9 at player for all players
                send title "&8&lКОМПАС ПУСТОТЫ" with subtitle "&7Возврат к месту гибели" to player for 2 seconds

on death:
    if isRuinGuardianEntity(victim) is true:
        # Стражи руин не должны дропать ресурсы вообще.
        clear drops
        # dropped experience нельзя менять в общем on death — убираем орбы после тика.
        wait 1 tick
        set {_dloc} to location of victim
        loop all entities in radius 3 around {_dloc}:
            if loop-entity is experience orb:
                kill loop-entity
    if attacker is a player:
        set {_u} to attacker's uuid

        # Звезда Азуры: заряд от убийств
        if hasArtifact(attacker, "azura") is true:
            add 1 to {art_azura_charge::%{_u}%}
            if {art_azura_charge::%{_u}%} > 200:
                set {art_azura_charge::%{_u}%} to 200

        # Монета удачи: шанс бонусного ресурса
        if hasArtifact(attacker, "luckcoin") is true:
            if isRuinGuardianEntity(victim) is false:
                chance of 25%:
                    set {_roll} to random integer between 1 and 4
                    if {_roll} is 1:
                        drop 2 emerald at location of victim
                    else if {_roll} is 2:
                        drop 3 gold ingot at location of victim
                    else if {_roll} is 3:
                        drop 1 diamond at location of victim
                    else:
                        drop 4 iron ingot at location of victim
                    send action bar "&6&lМОНЕТА УДАЧИ! &7Бонусный лут выпал" to attacker

        # Алтарный меч: бонусы за убийство (PvE и PvP)
        if isAltarSwordTool(attacker's tool) is true:
            if victim is a living entity:
                if victim is not attacker:
                    applyAltarSwordOnKill(attacker)

        # Алтарная броня: бонусы за убийства
        applyAltarArmorOnKill(attacker)
        set {_altarXp} to altarArmorFortuneXpBonus(attacker)
        if {_altarXp} > 0:
            giveArtifactScaledExperience(attacker, {_altarXp})

on pickup:
    if event-item is set:
        set {_nm} to name of event-item
        if {_nm} does not contain "Артефакт:":
            if {_nm} does not contain "Легендарный артефакт:":
                stop
        set {_key} to artifactKeyFromItemName({_nm})
        dbgEvo(player, "artifact pickup: key=%{_key}% item=%{_nm}%")
        if {_key} is not "":
            send "{@prefix} &eНайден артефакт-предмет: &f%{_nm}%" to player
            send "{@prefix} &7Чтобы зачислить в ядро, возьми его в руку и нажми &fПКМ&7." to player

# ----- Главная функция: открыть chest GUI -----
function openStatsMenu(viewer: player, target: player):
    set {_u} to uuid of {_target}
    set {_c} to {class::%{_u}%} ? "None"
    set {_l} to {level::%{_u}%} ? 1
    set {_k} to {kills::%{_u}%} ? 0
    set {_tk} to {total_kills::%{_u}%} ? 0
    set {_role} to classRoleName({_c})
    set {_rc} to roleColor({_role})
    set {_clsDisp} to classDisplayName({_c})

    open chest inventory with 6 rows named "&8&l⚜ Stats: %{_target}%" to {_viewer}
    wait 2 ticks

    # ----- декоративный фон -----
    loop 54 times:
        set slot (loop-number - 1) of {_viewer}'s current inventory to gray stained glass pane named " "
    loop 9 times:
        set slot (loop-number - 1) of {_viewer}'s current inventory to black stained glass pane named " "
        set slot (loop-number + 44) of {_viewer}'s current inventory to black stained glass pane named " "

    # ===== Slot 4: голова игрока =====
    set {_head} to player head
    set name of {_head} to "&e&l%{_target}%"
    if {_c} is "None":
        set lore of {_head} to "&7Класс: &fНет" and "&7Уровень: &e%{_l}%" and "&7Killов всего: &b%{_tk}%"
    else:
        set lore of {_head} to "&7Класс: %{_clsDisp}%" and "&7Роль: %{_rc}%%{_role}%" and "&7Уровень: &e%{_l}%&7/&625" and "&7Killов всего: &b%{_tk}%"
    set slot 4 of {_viewer}'s current inventory to {_head}

    # ===== Slot 11: Класс =====
    if {_c} is "None":
        set {_noClass} to barrier
        set name of {_noClass} to "&7Класс: &fНет"
        set lore of {_noClass} to "&8Используй &e/class &8чтобы выбрать"
        set slot 11 of {_viewer}'s current inventory to {_noClass}
    else:
        set {_ci} to classIcon({_c})
        set name of {_ci} to "&6&l☆ %{_clsDisp}%"
        set {_l10} to classL10Bonus({_c})
        delete {_clore::*}
        add "%{_rc}%Роль: &l%{_role}%" to {_clore::*}
        loop classPlaystyle({_c}):
            add loop-value to {_clore::*}
        add " " to {_clore::*}
        add {_l10} to {_clore::*}
        add " " to {_clore::*}
        add "&8/class — сменить класс" to {_clore::*}
        set lore of {_ci} to {_clore::*}
        set slot 11 of {_viewer}'s current inventory to {_ci}

    # ===== Slot 13: Уровень / XP =====
    set {_xpItem} to experience bottle
    if {_l} >= 25:
        set name of {_xpItem} to "&6&l✪ Уровень: &eMAX (25)"
        set lore of {_xpItem} to "&7Killов всего: &b%{_tk}%" and "&aМаксимальный уровень достигнут!"
    else:
        set {_kForLvl} to floor({_k} / 2) * 2
        set {_kInLvl} to {_k} - {_kForLvl}
        set {_kNeed} to 2 - {_kInLvl}
        set name of {_xpItem} to "&e&l⬆ Уровень: &6%{_l}% &7/ &e25"
        set lore of {_xpItem} to "&7XP: &a%{_k}%&7/&f49 killов" and "&7Killов всего: &b%{_tk}%" and " " and "&7До след. уровня: &e%{_kNeed}% &7killов"
    set slot 13 of {_viewer}'s current inventory to {_xpItem}

    # ===== Slot 15: Роль =====
    if {_c} is "None":
        set {_noRole} to paper
        set name of {_noRole} to "&7Роль: &fНе выбрана"
        set slot 15 of {_viewer}'s current inventory to {_noRole}
    else:
        set {_ri} to roleIcon({_role})
        set name of {_ri} to "%{_rc}%&l%{_role}%"
        set lore of {_ri} to roleDescription({_role})
        set slot 15 of {_viewer}'s current inventory to {_ri}

    # ===== Slot 20: Primary ability =====
    if {_c} is "None":
        set {_pBar} to barrier
        set name of {_pBar} to "&cНет способности"
        set lore of {_pBar} to "&8Выбери класс"
        set slot 20 of {_viewer}'s current inventory to {_pBar}
    else:
        set {_pi} to blaze powder
        set name of {_pi} to "&6&l▶ Primary"
        set {_pAbil} to classAbilityName({_c}, "primary")
        set lore of {_pi} to "%{_pAbil}%" and " " and "&7Главная способность класса" and "&8Активируется автоматически или ПКМ"
        set slot 20 of {_viewer}'s current inventory to {_pi}

    # ===== Slot 22: Перк =====
    if {_l} < 15:
        set {_perkLocked} to red stained glass pane
        set name of {_perkLocked} to "&7Перк: &cЗаблокирован"
        set lore of {_perkLocked} to "&8Откроется на &615 уровне" and "&7Сейчас: &eL%{_l}%"
        set slot 22 of {_viewer}'s current inventory to {_perkLocked}
    else:
        if {perk::%{_u}%} is set:
            set {_pid} to {perk::%{_u}%}
            set {_perkItem} to perkIcon({_pid})
            set {_perkN} to perkName({_pid})
            set name of {_perkItem} to "%{_perkN}%"
            delete {_perkLore::*}
            loop perkDesc({_pid}):
                add loop-value to {_perkLore::*}
            add " " to {_perkLore::*}
            add "&8/perk — сменить (откатит до L15)" to {_perkLore::*}
            set lore of {_perkItem} to {_perkLore::*}
            set slot 22 of {_viewer}'s current inventory to {_perkItem}
        else:
            set {_perkPick} to nether star
            set name of {_perkPick} to "&6&l⚡ Перк не выбран!"
            set lore of {_perkPick} to "&eИспользуй &6/perk &eчтобы выбрать" and "&8Один из 4 на класс"
            set slot 22 of {_viewer}'s current inventory to {_perkPick}

    # ===== Slot 24: Secondary ability =====
    if {_c} is "None":
        set {_sBar} to barrier
        set name of {_sBar} to "&cНет способности"
        set lore of {_sBar} to "&8Выбери класс"
        set slot 24 of {_viewer}'s current inventory to {_sBar}
    else:
        set {_si} to nether star
        set name of {_si} to "&b&l◢ Secondary"
        set {_sAbil} to classAbilityName({_c}, "secondary")
        set lore of {_si} to "%{_sAbil}%" and " " and "&7Вторая способность класса" and "&8Раскрывается с уровнем"
        set slot 24 of {_viewer}'s current inventory to {_si}

    # ===== Slot 26: Legendary =====
    if {_c} is "None":
        set {_lg} to barrier
        set name of {_lg} to "&6Легендарный артефакт"
        set lore of {_lg} to "&7Недоступно без класса" and "&8Сначала выбери класс"
    else:
        set {_lgKey} to classLegendaryKey({_target})
        if {_lgKey} is "":
            set {_lg} to barrier
            set name of {_lg} to "&6Легендарный артефакт"
            set lore of {_lg} to "&7Для этого класса легендарка не найдена"
        else:
            set {_lgSlot} to artifactSlotFromKey({_lgKey})
            set {_lg} to artifactFromSlot({_lgSlot})
            if {_lg} is air:
                set {_lg} to barrier
                set name of {_lg} to "&6Легендарный артефакт"
                set lore of {_lg} to "&7Ошибка отображения легендарки"
            else:
                set {_ownedLg} to {art_found::%{_u}%::%{_lgKey}%} ? false
                set {_onLg} to {art_enabled::%{_u}%::%{_lgKey}%} ? false
                if {_ownedLg} is true:
                    if {_onLg} is true:
                        set name of {_lg} to "&a[ON] %name of {_lg}%"
                    else:
                        set name of {_lg} to "&c[OFF] %name of {_lg}%"
                else:
                    set name of {_lg} to "&8[НЕ НАЙДЕН] %name of {_lg}%"
                set lore of {_lg} to artifactDesc({_lgKey})
                add " " to lore of {_lg}
                add "&eКлик: открыть /legendary" to lore of {_lg}
    set slot 26 of {_viewer}'s current inventory to {_lg}

    # ===== Row 4 (28..34): Оружие =====
    set {_swLvl} to {wlvl::%{_u}%::sword} ? 1
    set {_axLvl} to {wlvl::%{_u}%::axe} ? 1
    set {_bwLvl} to {wlvl::%{_u}%::bow} ? 1
    set {_mcLvl} to {wlvl::%{_u}%::mace} ? 1
    set {_swXp} to {wxp::%{_u}%::sword} ? 0
    set {_axXp} to {wxp::%{_u}%::axe} ? 0
    set {_bwXp} to {wxp::%{_u}%::bow} ? 0
    set {_mcXp} to {wxp::%{_u}%::mace} ? 0

    set {_swItem} to iron sword
    set name of {_swItem} to "&cМеч &8» &eLv %{_swLvl}%"
    set {_swNeed} to wXPNeeded({_swLvl})
    set {_swBonus} to ({_swLvl} - 1) * 6
    set lore of {_swItem} to "&7Бонус урона: &a+%{_swBonus}%%%" and "&7XP: &b%{_swXp}%&7/&f%{_swNeed}%"
    set slot 28 of {_viewer}'s current inventory to {_swItem}

    set {_axItem} to iron axe
    set name of {_axItem} to "&6Топор &8» &eLv %{_axLvl}%"
    set {_axNeed} to wXPNeeded({_axLvl})
    set {_axBonus} to ({_axLvl} - 1) * 6
    set lore of {_axItem} to "&7Бонус урона: &a+%{_axBonus}%%%" and "&7XP: &b%{_axXp}%&7/&f%{_axNeed}%"
    set slot 30 of {_viewer}'s current inventory to {_axItem}

    set {_bwItem} to bow
    set name of {_bwItem} to "&aЛук &8» &eLv %{_bwLvl}%"
    set {_bwNeed} to wXPNeeded({_bwLvl})
    set {_bwBonus} to ({_bwLvl} - 1) * 6
    set lore of {_bwItem} to "&7Бонус урона: &a+%{_bwBonus}%%%" and "&7XP: &b%{_bwXp}%&7/&f%{_bwNeed}%"
    set slot 32 of {_viewer}'s current inventory to {_bwItem}

    set {_mcItem} to mace
    set name of {_mcItem} to "&5Булава &8» &eLv %{_mcLvl}%"
    set {_mcNeed} to wXPNeeded({_mcLvl})
    set {_mcBonus} to ({_mcLvl} - 1) * 6
    set lore of {_mcItem} to "&7Бонус урона: &a+%{_mcBonus}%%%" and "&7XP: &b%{_mcXp}%&7/&f%{_mcNeed}%"
    set slot 34 of {_viewer}'s current inventory to {_mcItem}

    # ===== Row 5 (37..43): 7 milestones (L1, L5, L8, L10★, L15, L20, L25) =====
    if {_c} is not "None":
        set {_lvls::1} to 1
        set {_lvls::2} to 5
        set {_lvls::3} to 8
        set {_lvls::4} to 10
        set {_lvls::5} to 15
        set {_lvls::6} to 20
        set {_lvls::7} to 25
        set {_mslot::1} to 37
        set {_mslot::2} to 38
        set {_mslot::3} to 39
        set {_mslot::4} to 40
        set {_mslot::5} to 41
        set {_mslot::6} to 42
        set {_mslot::7} to 43
        loop 7 times:
            set {_idx} to loop-number
            set {_lreq} to {_lvls::%{_idx}%}
            set {_sl} to {_mslot::%{_idx}%}
            if {_lreq} is 10:
                set {_descRaw} to classL10Bonus({_c})
                set {_desc} to "%{_descRaw}%"
                replace "&aL10: " with "" in {_desc}
            else:
                set {_desc} to milestoneDesc({_c}, {_lreq})
            if {_l} >= {_lreq}:
                set {_pane} to lime stained glass pane
                set name of {_pane} to "&a✔ &fLv %{_lreq}%"
                set lore of {_pane} to "&f%{_desc}%" and " " and "&aОТКРЫТО"
                set slot {_sl} of {_viewer}'s current inventory to {_pane}
            else:
                set {_pane} to red stained glass pane
                set name of {_pane} to "&c✘ &7Lv %{_lreq}%"
                set lore of {_pane} to "&7%{_desc}%" and " " and "&cЗакрыто &8(%{_l}%/%{_lreq}%)"
                set slot {_sl} of {_viewer}'s current inventory to {_pane}
    set {_label} to nether star
    set name of {_label} to "&6&lПрокачка класса"
    set lore of {_label} to "&7Тиры: &fL1 L5 L8 &aL10★ &fL15 L20 L25" and "&8Открываются по уровню"
    set slot 36 of {_viewer}'s current inventory to {_label}

    # ===== Slot 44: Дуо =====
    if inDuo({_target}) is true:
        set {_partner} to duoPartner({_target})
        set {_duoItem} to player head
        set name of {_duoItem} to "&aДуо: &f%{_partner}%"
        set lore of {_duoItem} to "&7Партнёр в дуо" and "&8Многие способности усиливаются"
        set slot 44 of {_viewer}'s current inventory to {_duoItem}
    else:
        set {_noDuo} to compass
        set name of {_noDuo} to "&7Дуо: &cнет"
        set lore of {_noDuo} to "&8/duo <ник> — пригласить" and "&8Многие классы получают бонусы в дуо"
        set slot 44 of {_viewer}'s current inventory to {_noDuo}

    # ===== Slot 49: Закрыть =====
    set {_closeBtn} to barrier
    set name of {_closeBtn} to "&c&lЗакрыть"
    set slot 49 of {_viewer}'s current inventory to {_closeBtn}


command /stats [<player>]:
    aliases: /stat, /info
    trigger:
        set {_t} to player
        if arg-1 is set:
            set {_t} to arg-1
        openStatsMenu(player, {_t})

# ----- Клик / drag в меню /stats -----
on inventory click:
    if name of event-inventory contains "Stats:":
        cancel event
        if clicked inventory is not player's current inventory:
            stop
        set {_s} to index of event-slot
        if {_s} is 49:
            close player's inventory
        else if {_s} is 11:
            close player's inventory
            wait 2 ticks
            make player execute command "/class"
        else if {_s} is 22:
            close player's inventory
            wait 2 ticks
            make player execute command "/perk"
        else if {_s} is 28 or 30 or 32 or 34:
            close player's inventory
            wait 2 ticks
            make player execute command "/wstats"
        else if {_s} is 26:
            close player's inventory
            wait 2 ticks
            make player execute command "/legendary"

on inventory drag:
    if name of event-inventory contains "Stats:":
        cancel event


# ==========================================
# ОГРАНИЧЕНИЕ ЭКИПИРОВКИ ПО УРОВНЮ
# ==========================================

# --- СНЯТИЕ БРОНИ ПРИ ПОПЫТКЕ НАДЕТЬ (on armor change) ---
on armor change:
    set {_u} to player's uuid
    set {_l} to {level::%{_u}%} ? 1

    # 1. ПРОВЕРКА ЭЛИТР (15 УРОВЕНЬ)
    if event-item is elytra:
        if {_l} < 15:
            wait 1 tick
            if player's chestplate is elytra:
                set player's chestplate to air
                if player has space for elytra:
                    give elytra to player
                    send action bar "&eЭлитры сняты (нужен 15 уровень)" to player
                else:
                    drop elytra at player
                    send action bar "&cМеста нет! Элитры упали рядом" to player

    # 2. ПРОВЕРКА НЕЗЕРИТА (20 УРОВЕНЬ)
    if isNetherite(event-item) is true:
        if {_l} < 20:
            wait 1 tick
            # Проходим по всем слотам брони, чтобы снять всё нелегальное
            loop helmet, chestplate, leggings and boots of player:
                if isNetherite(loop-value) is true:
                    set {_bad_item} to loop-value
                    if loop-value is player's helmet:
                        set player's helmet to air
                    else if loop-value is player's chestplate:
                        set player's chestplate to air
                    else if loop-value is player's leggings:
                        set player's leggings to air
                    else if loop-value is player's boots:
                        set player's boots to air
                    
                    if player has space for {_bad_item}:
                        give {_bad_item} to player
                        send action bar "&eНезерит снят (нужен 20 уровень)" to player
                    else:
                        drop {_bad_item} at player

# --- ЗАПРЕТ ИСПОЛЬЗОВАНИЯ ЭЛИТР В ВОЗДУХЕ ---
on flight toggle:
    if player is wearing elytra:
        if {level::%player's uuid%} < 15:
            cancel event
            set player's gliding state to false
            send action bar "&cВы еще не умеете летать!" to player

# --- SCOUT Перк C "Парашют" — Shift в воздухе при падении >5 → Slow Falling 5с (КД 30с) ---
on toggle sneak:
    if player is not sneaking:
        stop
    set {_u} to player's uuid
    if {class::%{_u}%} is "Scout":
        if {perk::%{_u}%} is "scout_C":
            if {scout_parachute_cd::%{_u}%} ? 0 > 0:
                stop
            if player's fall distance > 5:
                if block below player is air:
                    apply slow falling 1 without particles to player for 5 seconds
                    set {scout_parachute_cd::%{_u}%} to 30
                    play sound "entity.phantom.flap" with volume 1 and pitch 1.2 at player for player
                    send action bar "&f&lПАРАШЮТ!" to player

# --- MAGE Перк B "Ледяной взрыв" / ARCHER Перк D "Рикошет" — на попадание снаряда ---
on damage:
    projectile is set
    set {_proj} to projectile
    set {_shooter} to shooter
    if {_shooter} is a player:
        set {_su} to {_shooter}'s uuid
        # Mage_B: малый/большой фаербол → AoE Slowness III 6с в радиусе 4
        if {perk::%{_su}%} is "mage_B":
            if "%{_proj}%" contains "fireball":
                if victim is a living entity:
                    set {_hit} to location of victim
                    play sound "block.glass.break" with volume 1 and pitch 1.5 at {_hit} for all players
                    execute console command "particle minecraft:snowflake %x-coordinate of {_hit}% %y-coordinate of {_hit}% %z-coordinate of {_hit}% 0.35 0.35 0.35 0.05 30 force"
                    loop all living entities in radius 4 around {_hit}:
                        if loop-entity is not {_shooter}:
                            apply slowness 3 without particles to loop-entity for 6 seconds
                    send action bar "&b&lЛЕДЯНОЙ ВЗРЫВ!" to {_shooter}
        # Archer_D: стрела наносит 75% урона ближайшему другому врагу в радиусе 6
        if {perk::%{_su}%} is "archer_D":
            if {_proj} is an arrow:
                if victim is a living entity:
                    if {archer_ricochet_lock::%uuid of {_proj}%} is not set:
                        set {archer_ricochet_lock::%uuid of {_proj}%} to true
                        set {_orig_dmg} to damage
                        set {_hit2} to location of victim
                        set {_chain_dmg} to {_orig_dmg} * 0.75
                        loop all living entities in radius 6 around {_hit2}:
                            if loop-entity is not {_shooter}:
                                if loop-entity is not victim:
                                    if loop-entity is a player or a monster:
                                        damage loop-entity by {_chain_dmg} with fake damage cause entity attack
                                        play sound "entity.arrow.hit" with volume 1 and pitch 1.4 at loop-entity for all players
                                        send action bar "&d&lРИКОШЕТ!" to {_shooter}
                                        exit loop

# ==========================================
# СУПЕР ЗАПРЕТ НЕЗЕРИТОВЫХ ИНСТРУМЕНТОВ И ОРУЖИЯ (20 УРОВЕНЬ)
# ==========================================

# 1. Запрет атаковать мобов и игроков
on damage:
    if attacker is a player:
        set {_u} to attacker's uuid
        set {_l} to {level::%{_u}%} ? 1
        if {_l} < 20:
            if isNetherite(attacker's tool) is true:
                cancel event
                send action bar "&4&l✕ &cСлишком тяжелое оружие (нужен 20 лвл)!" to attacker

# 2. Запрет ломать любые блоки
on break:
    if isAwakeningAltarStructurePart(location of event-block) is true:
        cancel event
        send "{@prefix} &cАлтарь неразрушим." to player
        stop
    set {_altarPick} to false
    if isEtherPickaxe(player's tool) is true:
        set {_altarPick} to true
    else if isFlamePickaxe(player's tool) is true:
        set {_altarPick} to true
    else if isVeinPickaxe(player's tool) is true:
        set {_altarPick} to true
    else if isFortunePickaxe(player's tool) is true:
        set {_altarPick} to true
    else if isVoidPickaxe(player's tool) is true:
        set {_altarPick} to true
    else if isOmniPickaxe(player's tool) is true:
        set {_altarPick} to true
    if {_altarPick} is true:
        set {_b} to event-block
        # Реальная «неразрушимость» для серверов, где флаг unbreakable не применяется.
        set durability of player's tool to 99999
        set {_flameOn} to true
        set {_veinOn} to true
        set {_fortuneOn} to true
        set {_voidOn} to true
        if isEtherTrashBlock({_b}) is true:
            if {altar_pick_silk_mode::%uuid of player%} is true:
                cancel event
                set event-block to air
                giveAltarSilkBlockItem(player, {_b}, location of {_b})
                giveArtifactScaledExperience(player, 1)
                stop
            if {altar_ether_trash_mode::%uuid of player%} is not true:
                stop
            cancel event
            set event-block to air
            if isFlamePickaxe(player's tool) is true:
                if {_flameOn} is true:
                    set {_drop} to smooth stone
                    giveOrDrop({_drop}, player, location of {_b})
                if {_flameOn} is false:
                    set {_dust} to gunpowder
                    giveOrDrop({_dust}, player, location of {_b})
            if isFlamePickaxe(player's tool) is not true:
                if isVoidPickaxe(player's tool) is true:
                    if {_voidOn} is true:
                        set {_drop} to obsidian
                        giveOrDrop({_drop}, player, location of player)
                    if {_voidOn} is not true:
                        set {_dust} to gunpowder
                        giveOrDrop({_dust}, player, location of {_b})
                if isVoidPickaxe(player's tool) is not true:
                    set {_dust} to gunpowder
                    giveOrDrop({_dust}, player, location of {_b})
            giveArtifactScaledExperience(player, 1)
            stop
        if isEtherValuableOre({_b}) is true:
            cancel event
            set {_dropLoc} to location of {_b}
            set event-block to air
            if {altar_pick_silk_mode::%uuid of player%} is true:
                giveAltarSilkBlockItem(player, {_b}, {_dropLoc})
                giveAltarSilkOreXp(player, {_b})
                stop
            if {_b} is diamond ore:
                set {_cnt} to 1
                if {_fortuneOn} is true:
                    add 3 to {_cnt}
                if isOmniPickaxe(player's tool) is true:
                    add 3 to {_cnt}
                loop {_cnt} times:
                    set {_it} to diamond
                    giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 3)
            else if {_b} is deepslate diamond ore:
                set {_cnt} to 1
                if {_fortuneOn} is true:
                    add 3 to {_cnt}
                if isOmniPickaxe(player's tool) is true:
                    add 3 to {_cnt}
                loop {_cnt} times:
                    set {_it} to diamond
                    giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 3)
            else if {_b} is gold ore:
                set {_it} to raw gold
                if isFlamePickaxe(player's tool) is true:
                    if {_flameOn} is true:
                        set {_it} to gold ingot
                if isOmniPickaxe(player's tool) is true:
                    set {_it} to gold ingot
                giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 2)
            else if {_b} is deepslate gold ore:
                set {_it} to raw gold
                if isFlamePickaxe(player's tool) is true:
                    if {_flameOn} is true:
                        set {_it} to gold ingot
                if isOmniPickaxe(player's tool) is true:
                    set {_it} to gold ingot
                giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 2)
            else if {_b} is nether gold ore:
                set {_nug} to 2
                if {_fortuneOn} is true:
                    add 6 to {_nug}
                if isOmniPickaxe(player's tool) is true:
                    add 6 to {_nug}
                loop {_nug} times:
                    set {_it} to gold nugget
                    giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 2)
            else if {_b} is iron ore:
                set {_it} to raw iron
                if isFlamePickaxe(player's tool) is true:
                    if {_flameOn} is true:
                        set {_it} to iron ingot
                if isOmniPickaxe(player's tool) is true:
                    set {_it} to iron ingot
                giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 2)
            else if {_b} is deepslate iron ore:
                set {_it} to raw iron
                if isFlamePickaxe(player's tool) is true:
                    if {_flameOn} is true:
                        set {_it} to iron ingot
                if isOmniPickaxe(player's tool) is true:
                    set {_it} to iron ingot
                giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 2)
            else if {_b} is coal ore:
                set {_cnt} to 1
                if {_fortuneOn} is true:
                    add 3 to {_cnt}
                if isOmniPickaxe(player's tool) is true:
                    add 3 to {_cnt}
                loop {_cnt} times:
                    set {_it} to coal
                    giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 2)
            else if {_b} is deepslate coal ore:
                set {_cnt} to 1
                if {_fortuneOn} is true:
                    add 3 to {_cnt}
                if isOmniPickaxe(player's tool) is true:
                    add 3 to {_cnt}
                loop {_cnt} times:
                    set {_it} to coal
                    giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 2)
            else if {_b} is lapis ore:
                set {_cnt} to 4
                if {_fortuneOn} is true:
                    set {_cnt} to 16
                if isOmniPickaxe(player's tool) is true:
                    set {_cnt} to 16
                loop {_cnt} times:
                    set {_it} to lapis lazuli
                    giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 3)
            else if {_b} is deepslate lapis ore:
                set {_cnt} to 4
                if {_fortuneOn} is true:
                    set {_cnt} to 16
                if isOmniPickaxe(player's tool) is true:
                    set {_cnt} to 16
                loop {_cnt} times:
                    set {_it} to lapis lazuli
                    giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 3)
            else if {_b} is redstone ore:
                set {_cnt} to 3
                if {_fortuneOn} is true:
                    set {_cnt} to 12
                if isOmniPickaxe(player's tool) is true:
                    set {_cnt} to 12
                loop {_cnt} times:
                    set {_it} to redstone
                    giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 3)
            else if {_b} is deepslate redstone ore:
                set {_cnt} to 3
                if {_fortuneOn} is true:
                    set {_cnt} to 12
                if isOmniPickaxe(player's tool) is true:
                    set {_cnt} to 12
                loop {_cnt} times:
                    set {_it} to redstone
                    giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 3)
            else if {_b} is ancient debris:
                set {_it} to ancient debris
                giveOrDrop({_it}, player, {_dropLoc})
                giveArtifactScaledExperience(player, 5)
            # Жильная/Омни: дополнительно срубает руду того же типа в радиусе 1.
            set {_veinMode} to false
            if isVeinPickaxe(player's tool) is true:
                if {_veinOn} is true:
                    set {_veinMode} to true
            if isOmniPickaxe(player's tool) is true:
                set {_veinMode} to true
            if {_veinMode} is true:
                set {_bt} to "%type of {_b}%"
                loop blocks in radius 1 around {_dropLoc}:
                    if "%type of loop-block%" is {_bt}:
                        set {_sid} to "%type of loop-block%"
                        set {_lb} to location of loop-block
                        set loop-block to air
                        if {altar_pick_silk_mode::%uuid of player%} is true:
                            giveAltarSilkBlockItemById(player, {_sid}, {_lb})
                            giveAltarSilkOreXp(player, {_b})
                        else if {_b} is diamond ore:
                            set {_it} to diamond
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 2)
                        else if {_b} is deepslate diamond ore:
                            set {_it} to diamond
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 2)
                        else if {_b} is gold ore:
                            set {_it} to raw gold
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 1)
                        else if {_b} is deepslate gold ore:
                            set {_it} to raw gold
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 1)
                        else if {_b} is nether gold ore:
                            set {_it} to gold nugget
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 1)
                        else if {_b} is iron ore:
                            set {_it} to raw iron
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 1)
                        else if {_b} is deepslate iron ore:
                            set {_it} to raw iron
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 1)
                        else if {_b} is coal ore:
                            set {_it} to coal
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 1)
                        else if {_b} is deepslate coal ore:
                            set {_it} to coal
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 1)
                        else if {_b} is lapis ore:
                            set {_it} to lapis lazuli
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 1)
                        else if {_b} is deepslate lapis ore:
                            set {_it} to lapis lazuli
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 1)
                        else if {_b} is redstone ore:
                            set {_it} to redstone
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 1)
                        else if {_b} is deepslate redstone ore:
                            set {_it} to redstone
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 1)
                        else if {_b} is ancient debris:
                            set {_it} to ancient debris
                            giveOrDrop({_it}, player, {_lb})
                            giveArtifactScaledExperience(player, 2)
            # Доп. бафы Омни.
            # Кирка Пустоты: короткий рывок к дропу после добычи руды.
            if isVoidPickaxe(player's tool) is true:
                if {_voidOn} is true:
                    if random integer between 1 and 100 <= 25:
                        apply speed 2 without particles to player for 2 seconds
            stop
    set {_u} to player's uuid
    set {_l} to {level::%{_u}%} ? 1
    if {_l} < 20:
        if isNetherite(player's tool) is true:
            cancel event
            send action bar "&4&l✕ &cВы не умеете копать этим (нужен 20 лвл)!" to player

# 3. Запрет любого взаимодействия (ПКМ/ЛКМ по воздуху, блокам, сундукам и т.д.)
on right click:
    # Shift+ПКМ с алтарной киркой: вкл/выкл эфирный режим (пыль с мусорных блоков; выкл = обычная добыча камня).
    if player is sneaking:
        set {_tk} to player's tool
        if isAltarPickaxeTool({_tk}) is true:
            cancel event
            set {_u} to uuid of player
            if {altar_ether_trash_mode::%{_u}%} is true:
                delete {altar_ether_trash_mode::%{_u}%}
                send action bar "&7Эфирный режим: &cВЫКЛ &8(камень как обычно)" to player
            else:
                set {altar_ether_trash_mode::%{_u}%} to true
                send action bar "&7Эфирный режим: &aВКЛ &8(мусор -> пыль)" to player
            play sound "ui.button.click" with volume 0.85 and pitch 1.2 at player for player
            stop
    # ПКМ без Shift: шёлковое касание.
    if player is not sneaking:
        set {_tk} to player's tool
        # Омни: переключение всегда по ПКМ (чтобы не зависеть от targeted block).
        if isOmniPickaxe({_tk}) is true:
            cancel event
            set {_u} to uuid of player
            if {altar_pick_silk_mode::%{_u}%} is true:
                delete {altar_pick_silk_mode::%{_u}%}
                send action bar "&7Шёлковое касание: &cВЫКЛ" to player
            else:
                set {altar_pick_silk_mode::%{_u}%} to true
                send action bar "&7Шёлковое касание: &aВКЛ &8(целые блоки)" to player
            syncAltarSilkEnchant(player)
            play sound "ui.button.click" with volume 0.85 and pitch 1.15 at player for player
            stop
        # Для остальных алтарных кирок — только по воздуху, Эфирная исключена.
        if isAltarPickaxeTool({_tk}) is true:
            if isEtherPickaxe({_tk}) is true:
                stop
            if targeted block is not set:
                cancel event
                set {_u} to uuid of player
                if {altar_pick_silk_mode::%{_u}%} is true:
                    delete {altar_pick_silk_mode::%{_u}%}
                    send action bar "&7Шёлковое касание: &cВЫКЛ" to player
                else:
                    set {altar_pick_silk_mode::%{_u}%} to true
                    send action bar "&7Шёлковое касание: &aВКЛ &8(целые блоки)" to player
                syncAltarSilkEnchant(player)
                play sound "ui.button.click" with volume 0.85 and pitch 1.15 at player for player
                stop
    set {_u} to player's uuid
    set {_l} to {level::%{_u}%} ? 1
    if {_l} < 20:
        if isNetherite(player's tool) is true:
            cancel event
            send action bar "&4&l✕ &cНезерит недоступен до 20 уровня!" to player

on left click:
    set {_u} to player's uuid
    set {_l} to {level::%{_u}%} ? 1
    if {_l} < 20:
        if isNetherite(player's tool) is true:
            cancel event
            send action bar "&4&l✕ &cНезерит недоступен до 20 уровня!" to player
            stop
    # Легендарка Warrior: красный разрез только при взмахе мечом
    if classOf(player) is "Warrior":
        if hasArtifact(player, "leg_warrior") is true:
            if {_l} < 20:
                if isNetherite(player's tool) is true:
                    stop
            if isSword(player's tool) is not true:
                stop
            if noCooldownMode(player) is false:
                if {leg_warrior_air_last::%{_u}%} is set:
                    if difference between {leg_warrior_air_last::%{_u}%} and now < 1.05 seconds:
                        stop
            set {leg_warrior_air_last::%{_u}%} to now
            warriorLegSpatialAirSlash(player)

# --- КУРАЦИЯ КЛАССОВЫХ ПРЕДМЕТОВ ---

every 1 second:
    loop all players:
        loop all items in loop-player's inventory:
            if isClassItem(loop-value-2) is true:
                set durability of loop-value-2 to 99999
            if isAltarSwordTool(loop-value-2) is true:
                set durability of loop-value-2 to 99999
            if isAltarArmorPiece(loop-value-2) is true:
                set durability of loop-value-2 to 99999
        syncAltarGearDurability(loop-player)
        applyAltarArmorPassiveEffects(loop-player)
        set {_pu} to loop-player's uuid
        if noCooldownMode(loop-player) is true:
            # Во время "cooldown off" кулдауны очищаются, поэтому нужно постоянно сохранять
            # текущие значения, чтобы при "cooldown on" они вернулись с последнего использования.
            set {admin_nocd_save_archer_eye_cd::%{_pu}%} to {archer_eye_cd::%{_pu}%} ? 0
            set {admin_nocd_save_warrior_secondwind_cd::%{_pu}%} to {warrior_secondwind_cd::%{_pu}%} ? 0
            set {admin_nocd_save_scout_bloodrush_cd::%{_pu}%} to {scout_bloodrush_cd::%{_pu}%} ? 0
            set {admin_nocd_save_scout_parachute_cd::%{_pu}%} to {scout_parachute_cd::%{_pu}%} ? 0
            set {admin_nocd_save_archer_triple_cd::%{_pu}%} to {archer_triple_cd::%{_pu}%} ? 0
            set {admin_nocd_save_mage_overload_cd::%{_pu}%} to {mage_overload_cd::%{_pu}%} ? 0
            set {admin_nocd_save_necro_grip_cd::%{_pu}%} to {necro_grip_cd::%{_pu}%} ? 0
            set {admin_nocd_save_tank_laststand_cd::%{_pu}%} to {tank_laststand_cd::%{_pu}%} ? 0
            set {admin_nocd_save_necro_lifesteal_until::%{_pu}%} to {necro_lifesteal_until::%{_pu}%} ? 0
            set {admin_nocd_save_scout_dash_window::%{_pu}%} to {scout_dash_window::%{_pu}%} ? 0

            if loop-player is online:
                set {admin_nocd_save_feather_cd::%{_pu}%} to cooldown of feather for loop-player
                set {admin_nocd_save_bone_cd::%{_pu}%} to cooldown of bone for loop-player
                set {admin_nocd_save_blaze_rod_cd::%{_pu}%} to cooldown of blaze rod for loop-player
                set {admin_nocd_save_splash_potion_cd::%{_pu}%} to cooldown of splash potion for loop-player
                set {admin_nocd_save_golden_apple_cd::%{_pu}%} to cooldown of golden apple for loop-player
                set {admin_nocd_save_mace_cd::%{_pu}%} to cooldown of mace for loop-player
                set {admin_nocd_save_netherite_sword_cd::%{_pu}%} to cooldown of netherite sword for loop-player
                set {admin_nocd_save_diamond_sword_cd::%{_pu}%} to cooldown of diamond sword for loop-player
                set {admin_nocd_save_iron_sword_cd::%{_pu}%} to cooldown of iron sword for loop-player
                set {admin_nocd_save_golden_sword_cd::%{_pu}%} to cooldown of golden sword for loop-player
                set {admin_nocd_save_stone_sword_cd::%{_pu}%} to cooldown of stone sword for loop-player
                set {admin_nocd_save_wooden_sword_cd::%{_pu}%} to cooldown of wooden sword for loop-player
            # Важно: не удаляем и не обнуляем cooldown'ы,
            # иначе при включении обратно они не восстанавливаются.
        else:
            # Орлиный взор — таймер КД и индикатор
            if {archer_eye_cd::%{_pu}%} ? 0 > 0:
                subtract 1 from {archer_eye_cd::%{_pu}%}
                if {archer_eye_cd::%{_pu}%} <= 0:
                    delete {archer_eye_cd::%{_pu}%}
                    if {class::%{_pu}%} is "Archer":
                        send action bar "&a&lОРЛИНЫЙ ВЗОР готов!" to loop-player
                else if loop-player's tool is bow:
                    send action bar "&6Орлиный взор: &e%{archer_eye_cd::%{_pu}%}%с" to loop-player
            # Декремент КД новых перков
            if {warrior_secondwind_cd::%{_pu}%} ? 0 > 0:
                subtract 1 from {warrior_secondwind_cd::%{_pu}%}
                if {warrior_secondwind_cd::%{_pu}%} <= 0:
                    delete {warrior_secondwind_cd::%{_pu}%}
            if {scout_bloodrush_cd::%{_pu}%} ? 0 > 0:
                subtract 1 from {scout_bloodrush_cd::%{_pu}%}
                if {scout_bloodrush_cd::%{_pu}%} <= 0:
                    delete {scout_bloodrush_cd::%{_pu}%}
            if {scout_parachute_cd::%{_pu}%} ? 0 > 0:
                subtract 1 from {scout_parachute_cd::%{_pu}%}
                if {scout_parachute_cd::%{_pu}%} <= 0:
                    delete {scout_parachute_cd::%{_pu}%}
            if {archer_triple_cd::%{_pu}%} ? 0 > 0:
                subtract 1 from {archer_triple_cd::%{_pu}%}
                if {archer_triple_cd::%{_pu}%} <= 0:
                    delete {archer_triple_cd::%{_pu}%}
            if {mage_overload_cd::%{_pu}%} ? 0 > 0:
                subtract 1 from {mage_overload_cd::%{_pu}%}
                if {mage_overload_cd::%{_pu}%} <= 0:
                    delete {mage_overload_cd::%{_pu}%}
            if {necro_grip_cd::%{_pu}%} ? 0 > 0:
                subtract 1 from {necro_grip_cd::%{_pu}%}
                if {necro_grip_cd::%{_pu}%} <= 0:
                    delete {necro_grip_cd::%{_pu}%}
            # Очистка просроченного окна второго рывка
            if {scout_dash_window::%{_pu}%} is set:
                if {scout_dash_window::%{_pu}%} < unix timestamp of now:
                    delete {scout_dash_window::%{_pu}%}

# ==========================================
# ПАССИВНЫЕ БАФФЫ КЛАССОВ
# ==========================================
every 4 ticks:
    loop all players:
        set {_u} to loop-player's uuid
        set {_dual} to false
        if {class::%{_u}%} is "Warrior":
            set {_m1} to swordMat(loop-player's tool)
            set {_m2} to swordMat(loop-player's off hand tool)
            if {_m1} is not "":
                if {_m1} is {_m2}:
                    set {_dual} to true
        if {_dual} is true:
            if {dualwield_active::%{_u}%} is not true:
                set {dualwield_active::%{_u}%} to true
                set attack speed attribute of loop-player to 8
        else:
            if {dualwield_active::%{_u}%} is true:
                delete {dualwield_active::%{_u}%}
                set attack speed attribute of loop-player to 4

every 5 seconds:
    loop all players:
        set {_u} to loop-player's uuid
        set {_c} to {class::%{_u}%} ? "None"
        set {_l} to {level::%{_u}%} ? 1
        # Страховка от "залипания" анти-кнокбека у не-танков
        if {_c} is not "Tank":
            set knockback resistance attribute of loop-player to 0

        if {ghost::%{_u}%} is not true:
            syncPlayerMaxHealth(loop-player)

        # ===== WARRIOR =====
        if {_c} is "Warrior":
            if loop-player's health < 6:
                # Перк B "Кровавая клятва": при ❤<6 → Strength II + Speed I
                if {perk::%{_u}%} is "warrior_B":
                    apply strength 2 without particles to loop-player for 100 ticks
                    apply speed 1 without particles to loop-player for 100 ticks
                else:
                    apply strength 1 without particles to loop-player for 100 ticks
            if {_l} >= 15:
                apply haste 1 without particles to loop-player for 100 ticks
            if {_l} >= 25:
                apply resistance 1 without particles to loop-player for 100 ticks

        # ===== SCOUT =====
        else if {_c} is "Scout":
            apply speed 1 without particles to loop-player for 100 ticks
            if {_l} >= 15:
                apply jump boost 1 without particles to loop-player for 100 ticks
            if {_l} >= 20:
                if loop-player has potion effect slowness:
                    remove slowness from loop-player
            # Перк D "Кровопийца": при ❤<6 → Speed III на 5с (КД 20с)
            if {perk::%{_u}%} is "scout_D":
                if evoAdminAbilityDisabled("scout_bloodrush") is false:
                    if loop-player's health < 6:
                        if {scout_bloodrush_cd::%{_u}%} ? 0 <= 0:
                            apply speed 3 without particles to loop-player for 100 ticks
                            set {scout_bloodrush_cd::%{_u}%} to 20
                            play sound "entity.vampire.ambient" with volume 0.5 and pitch 1.5 at loop-player for loop-player
                            send action bar "&c&lКРОВОПИЙЦА! &7Speed III 5с" to loop-player
            # L25 — флай для двойного прыжка (вкл. в каждом тике, не только при join)

        # ===== TANK =====
        else if {_c} is "Tank":
            # max health: syncPlayerMaxHealth (база 10/20 ❤ + бонус алтарной брони)
            # L3 — Knockback Resistance 50%, L13 — 100%
            if {_l} >= 13:
                set knockback resistance attribute of loop-player to 1
            else if {_l} >= 3:
                set knockback resistance attribute of loop-player to 0.5
            else:
                set knockback resistance attribute of loop-player to 0
            # L17 — Fire Resistance пассивно
            if {_l} >= 17:
                apply fire resistance 1 without particles to loop-player for 100 ticks
            # L25 — снимать Slowness и Mining Fatigue
            if {_l} >= 25:
                if loop-player has potion effect slowness:
                    remove slowness from loop-player
                if loop-player has potion effect mining fatigue:
                    remove mining fatigue from loop-player
            if {_l} >= 5:
                # Перк C "Несокрушимый": при ≤40%% макс. ❤ (доля от max health) → Resistance III
                if {perk::%{_u}%} is "tank_C":
                    if tankHpBelowC(loop-player) is true:
                        apply resistance 3 without particles to loop-player for 101 ticks
                    else:
                        apply resistance 1 without particles to loop-player for 100 ticks
                else:
                    apply resistance 1 without particles to loop-player for 100 ticks
            # L15 — Аура защитника: только напарнику в радиусе 5 блоков
            if {_l} >= 15:
                if inDuo(loop-player) is true:
                    set {_partner} to duoPartner(loop-player)
                    if {_partner} is online:
                        if distance between loop-player and {_partner} <= 5:
                            apply resistance 1 without particles to {_partner} for 100 ticks
            # Перк D "Защитник дуо": усиленная аура — Resistance II + Regen I в радиусе 8
            if {perk::%{_u}%} is "tank_D":
                if inDuo(loop-player) is true:
                    set {_partner} to duoPartner(loop-player)
                    if {_partner} is online:
                        if distance between loop-player and {_partner} <= 8:
                            apply resistance 2 without particles to {_partner} for 100 ticks
                            apply regeneration 1 without particles to {_partner} for 100 ticks

        # ===== ARCHER =====
        else if {_c} is "Archer":
            apply speed 1 without particles to loop-player for 100 ticks
            # L7 — иммунитет к Slowness (снимаем если есть)
            if {_l} >= 7:
                if loop-player has potion effect slowness:
                    remove slowness from loop-player
            if {_l} >= 15:
                apply night vision 1 without particles to loop-player for 100 ticks

        # ===== MAGE =====
        else if {_c} is "Mage":
            # L7 — иммунитет к Wither и Poison
            if {_l} >= 7:
                if loop-player has potion effect wither:
                    remove wither from loop-player
                if loop-player has potion effect poison:
                    remove poison from loop-player
            if {_l} >= 20:
                apply resistance 1 without particles to loop-player for 100 ticks
            # L17 — Аура ослабления: враги (моббы и не-дуо игроки) в радиусе 5 → Weakness I
            if {_l} >= 17:
                for each {_ae} in all living entities in radius 5 around loop-player:
                    if uuid of {_ae} is not {_u}:
                        if {_ae} is a monster:
                            apply weakness 1 without particles to {_ae} for 100 ticks
                        else if {_ae} is a player:
                            if areDuo(loop-player, {_ae}) is not true:
                                apply weakness 1 without particles to {_ae} for 100 ticks
            # Перк C "Аура регена": союзникам в радиусе 10 — Regen I
            if {perk::%{_u}%} is "mage_C":
                set {_mageCaster} to loop-player
                for each {_ally} in all players in radius 10 around {_mageCaster}:
                    if uuid of {_ally} is not {_u}:
                        if areDuo({_mageCaster}, {_ally}) is true:
                            apply regeneration 1 without particles to {_ally} for 100 ticks

        # ===== NECROMANCER =====
        # Некромант — повелитель смерти, бьёт через миньонов и дебаффы.
        # РЕГЕНА БОЛЬШЕ НЕТ как пассивки — заменено на Восставшего чемпиона (см. on death of player).
        else if {_c} is "Necromancer":
            # L1 — Призрачный взор: Night Vision пассивно (перенесено с L15)
            apply night vision 1 without particles to loop-player for 100 ticks
            # L10 — Иммунитет к Wither (свой же эффект ауры на себя не действует)
            if {_l} >= 10:
                if loop-player has potion effect wither:
                    remove wither from loop-player
            # L20 — Аура смерти: враги-мобы в 4 блоках получают Wither I (2с)
            if {_l} >= 20:
                for each {_ae} in all living entities in radius 4 around loop-player:
                    if uuid of {_ae} is not {_u}:
                        if {_ae} is a monster:
                            set {_eid2} to uuid of {_ae}
                            # не баффать своих же миньонов
                            if {minion_owner::%{_eid2}%} is not set:
                                apply wither 1 without particles to {_ae} for 100 ticks


# ==========================================
# БОЕВАЯ ЛОГИКА
# ==========================================
on damage:
    # Активное парирование Воина (L20+) — окно открыто игроком через ПКМ с мечом
    if victim is a player:
        set {_uv} to victim's uuid
        if {parry_until::%{_uv}%} is set:
            if {parry_until::%{_uv}%} > unix timestamp of now:
                if attacker is a living entity:
                    cancel event
                    # Перк C "Идеальное парирование": x1.5 урон + Slowness II 4с
                    if {perk::%{_uv}%} is "warrior_C":
                        set {_dmg} to damage * 1.5
                        damage attacker by {_dmg} with fake damage cause entity attack
                        if attacker is a living entity:
                            apply slowness 2 without particles to attacker for 4 seconds
                            apply blindness 1 without particles to attacker for 4 seconds
                        send action bar "&e&lИДЕАЛЬНОЕ ПАРИРОВАНИЕ!" to victim
                    else:
                        set {_dmg} to damage * 1
                        damage attacker by {_dmg} with fake damage cause entity attack
                        if attacker is a living entity:
                            apply blindness 1 without particles to attacker for 4 seconds
                        send action bar "&e&lPARRY!" to victim
                    set {_maxhp} to victim's max health
                    # +5 в тех же ед., что health игрока (на сервере — целые ❤)
                    set victim's health to min({_maxhp}, victim's health + 5)
                    play sound "block.vault.open_shutter" with volume 1 and pitch 1 at victim for all players
                    delete {parry_until::%{_uv}%}
                    set {parry_used::%{_uv}%} to true
                    stop

on damage:
    attacker is a player
    set {_u} to attacker's uuid
    set {_c} to {class::%{_u}%} ? "None"
    set {_l} to {level::%{_u}%} ? 1

    if {_c} is not "None":
        if evoAdminClassDisabled({_c}) is true:
            stop

    # ----- Дуал-вилд (мечи в обеих руках) — только Воин -----
    # Скорость атаки повышается через атрибут на самом игроке (см. периодический лоуп ниже).

    # ----- Кулдаун булавы (SkBee) -----
    if attacker's tool is a mace:
        if cooldown of mace for attacker > 0 seconds:
            if evoAdminNoCdFor(attacker, "mace") is false:
                cancel event
                stop
            set cooldown of mace for attacker to 0 seconds
        if evoAdminNoCdFor(attacker, "mace") is false:
            set cooldown of mace for attacker to 60 seconds

    # ===== БАФФ УРОНА ОТ УРОВНЯ ОРУЖИЯ =====
    set {_wt} to weaponType(attacker's tool)
    if {_wt} is "bow":
        if projectile is not an arrow:
            set {_wt} to "none"
    if {_wt} is not "none":
        set {_wlvl} to {wlvl::%attacker's uuid%::%{_wt}%} ? 1
        set damage to damage * wDamageMult({_wlvl})
        addWXP(attacker, {_wt}, 1)

    # ===== БАФФЫ УРОНА ПО КЛАССАМ =====
    if {_c} is "Warrior":
        # L1 — +10% урона мечом всегда
        if isSword(attacker's tool) is true:
            set damage to damage * 1.1
        # L3 — общий бонус
        if {_l} >= 3:
            set damage to damage * 1.15
        # Перк A "Палач": цель с ❤≤4 — +75% урона + Strength I 3с
        if {perk::%{_u}%} is "warrior_A":
            if victim is a living entity:
                if victim's health <= 4:
                    set damage to damage * 1.75
                    apply strength 1 without particles to attacker for 3 seconds
                    send action bar "&4&lПАЛАЧ!" to attacker
        # Воин — меч-онли: топоры не дают бонусов

    else if {_c} is "Scout":
        # L1 — удар в спину: атакующий должен находиться позади жертвы по позиции
        if victim is a living entity:
            set {_vyr} to yaw of victim * 0.017453292519943295
            set {_vx} to (0 - sin({_vyr}))
            set {_vz} to cos({_vyr})
            set {_dx} to x-coordinate of attacker - x-coordinate of victim
            set {_dz} to z-coordinate of attacker - z-coordinate of victim
            set {_dot} to ({_vx} * {_dx}) + ({_vz} * {_dz})
            if {_dot} < -0.35:
                set damage to damage * 1.4
                send action bar "&e&lУДАР В СПИНУ!" to attacker
        # L1 — крит при sneak (стандартный «sneak attack»)
        if attacker is sneaking:
            set damage to damage * 1.15
        # L13 — Кровавый след: +30% урона 3с после рывка
        if {_l} >= 13:
            if {scout_dash::%{_u}%} is set:
                if difference between {scout_dash::%{_u}%} and now < 3 seconds:
                    set damage to damage * 1.3
                    send action bar "&c&lКРОВАВЫЙ СЛЕД!" to attacker
        # Перк B "Невидимый клинок": удар в инвизе — +100% и продлевает инвиз на 2с
        # Суммарный лимит инвиза в одной цепочке — 30с (см. scoutApplyInvis)
        if {perk::%{_u}%} is "scout_B":
            if attacker has potion effect invisibility:
                set damage to damage * 2
                scoutApplyInvis(attacker, 2)
                send action bar "&5&lНЕВИДИМЫЙ КЛИНОК!" to attacker
        # Перк D "Кровопийца": каждый 4-й удар → heal 0.5 (½❤ в лоре)
        if {perk::%{_u}%} is "scout_D":
            add 1 to {scout_lifesteal_hits::%{_u}%}
            if {scout_lifesteal_hits::%{_u}%} >= 4:
                set {scout_lifesteal_hits::%{_u}%} to 0
                heal attacker by 0.5
                send action bar "&c&lКРОВОПИЙЦА! &7+½❤" to attacker

    else if {_c} is "Tank":
        # L10 — шипы при получении урона (см. блок ниже)
        # L1 — наносит меньше урона, но почти не получает (см. ниже в on damage of player)
        set damage to damage * 0.85

    else if {_c} is "Archer":
        if {_l} >= 10:
            if projectile is an arrow:
                set damage to damage * 1.4
        # L1 — лук бьёт чуть сильнее
        if projectile is an arrow:
            set damage to damage * 1.1
            # L3 — +1 флэт урона стрелой
            if {_l} >= 3:
                set damage to damage + 1
            # L13 — снайперский урон: +25% по целям дальше 15 блоков
            if {_l} >= 13:
                if victim is a living entity:
                    if distance between attacker and victim > 15:
                        set damage to damage * 1.25
            # L17 — Slowness I на 2с
            if {_l} >= 17:
                if victim is a living entity:
                    applyCappedDebuff(victim, "slowness", "slowness", 1, 2)
            # Перк A "Снайпер": +50% урона если цель дальше 20 блоков
            if {perk::%attacker's uuid%} is "archer_A":
                if victim is a living entity:
                    if distance between attacker and victim > 20:
                        set damage to damage * 1.5
                        send action bar "&e&lСНАЙПЕР!" to attacker
            # Перк B "Морозная стрела": Slowness III + Mining Fatigue II + Weakness I
            if {perk::%attacker's uuid%} is "archer_B":
                if victim is a living entity:
                    applyCappedDebuff(victim, "slowness", "slowness", 3, 5)
                    applyCappedDebuff(victim, "mining_fatigue", "mining_fatigue", 2, 5)
                    applyCappedDebuff(victim, "weakness", "weakness", 1, 4)
        # L5 — шанс крит-стрелы (x2 урон), L23 — 40% вместо 25%
        if {_l} >= 23:
            if projectile is an arrow:
                chance of 40%:
                    set damage to damage * 2
                    send action bar "&e&lКРИТ!" to attacker
        else if {_l} >= 5:
            if projectile is an arrow:
                chance of 25%:
                    set damage to damage * 2
                    send action bar "&e&lКРИТ!" to attacker
        # Легендарка Archer «Око Хищника»: самонаводка уже сильная — режем суммарный урон со стрел
        if projectile is an arrow:
            if hasArtifact(attacker, "leg_archer") is true:
                set damage to damage * 0.68

    else if {_c} is "Mage":
        # L1 — палочка (blaze rod) наносит магический урон
        if attacker's tool is a blaze rod:
            set damage to damage + 1
            if victim is a living entity:
                # L3 — огонь дольше: 4с вместо 2с
                if {_l} >= 3:
                    ignite victim for 4 seconds
                else:
                    ignite victim for 2 seconds
                # L13 — Цепь молний: бьёт ещё одного врага рядом на 50% урона
                if {_l} >= 13:
                    set {_chained} to false
                    loop all living entities in radius 5 around victim:
                        if {_chained} is false:
                            if loop-entity is not victim:
                                if loop-entity is not attacker:
                                    if areDuo(attacker, loop-entity) is not true:
                                        set {_chain_dmg2} to damage * 0.5
                                        damage loop-entity by {_chain_dmg2} with fake damage cause entity attack
                                        ignite loop-entity for 2 seconds
                                        play sound "entity.lightning_bolt.thunder" with volume 0.4 and pitch 1.8 at loop-entity for all players
                                        send action bar "&b&lЦЕПЬ МОЛНИЙ!" to attacker
                                        set {_chained} to true

    else if {_c} is "Necromancer":
        # Бьёт через миньонов и дебаффы — оружие слабое, но с механиками.
        if attacker's tool is a bone:
            if "%{attacker's tool}%" contains "Жезл Некроманта":
                if victim is a living entity:
                    if victim is not attacker:
                        set {_vidPending} to uuid of victim
                        if {necro_staff_bomb_pending::%{_vidPending}%} is set:
                            cancel event
                            stop
                        # Удар по чужой нежити: без урона от удара, ИИ выкл., взрыв через 3 с, +1½❤, AoE (всё после wait — без set damage: ивент уже прошёл)
                        set {_useNecStaffBomb} to false
                        if victim is not a player:
                            if victim is not an ender dragon:
                                if victim is not a wither:
                                    if victim is not a warden:
                                        if isLegNecroPacifiedUndead(victim) is true:
                                            set {_vid} to uuid of victim
                                            if {minion_owner::%{_vid}%} is not {_u}:
                                                if {necro_staff_bomb_pending::%{_vid}%} is not set:
                                                    set {_useNecStaffBomb} to true
                        if {_useNecStaffBomb} is true:
                            cancel event
                            set ai of victim to false
                            set {_necBombAnchor} to location of victim
                            set {necro_staff_bomb_pending::%{_vid}%} to true
                            set {necro_staff_bomb_caster::%{_vid}%} to {_u}
                            send action bar "&8&lФАНТОМНАЯ ЖЕРТВА &7— взрыв через &f3с" to attacker
                            play sound "entity.evoker.prepare_summon" with volume 1 and pitch 0.65 at victim for all players
                            wait 3 seconds
                            if {necro_staff_bomb_pending::%{_vid}%} is not set:
                                stop
                            delete {necro_staff_bomb_pending::%{_vid}%}
                            set {_casterSaved} to {necro_staff_bomb_caster::%{_vid}%}
                            delete {necro_staff_bomb_caster::%{_vid}%}
                            delete {_boomMob}
                            loop all living entities in radius 8 around {_necBombAnchor}:
                                if uuid of loop-entity is {_vid}:
                                    set {_boomMob} to loop-entity
                                    stop loop
                            set {_casterPl} to player from {_casterSaved}
                            if {_boomMob} is set:
                                if {_boomMob} is a living entity:
                                    if {_casterPl} is online:
                                        set {_bloc} to location of {_boomMob}
                                        necroStaffPhantomBurst({_bloc}, {_boomMob}, {_casterPl})
                                        kill {_boomMob}
                                        heal {_casterPl} by 1.5
                                        send action bar "&2&lПОГЛОЩЕНИЕ &7+1½❤" to {_casterPl}
                                    else:
                                        kill {_boomMob}
                            stop
                        else:
                            # L1 — Костяной молот: +1 урон, 30% слабость 1 на 2с
                            set damage to damage + 1
                            chance of 30%:
                                apply slowness 1 without particles to victim for 2 seconds
                            # L1 — Кража жизни: лечит 1❤ за удар (КД 2с)
                            set {_now} to unix timestamp of now
                            if noCooldownMode(attacker) is true:
                                heal attacker by 1
                            else if {necro_lifesteal_until::%{_u}%} is not set:
                                heal attacker by 1
                                set {necro_lifesteal_until::%{_u}%} to {_now} + 2
                            else if {necro_lifesteal_until::%{_u}%} < {_now}:
                                heal attacker by 1
                                set {necro_lifesteal_until::%{_u}%} to {_now} + 2
                            # L5 — Метка смерти: +20% урона по цели от тебя и миньонов 5с
                            if {_l} >= 5:
                                set {necro_mark::%uuid of victim%} to {_now} + 5
                                set {necro_mark_owner::%uuid of victim%} to {_u}
                            # L20 — Wither удар костью
                            if {_l} >= 20:
                                apply wither 1 without particles to victim for 4 seconds

# ----- Tank L1: получает -15% урона; L10: шипы -----
on damage:
    if victim is a player:
        set {_uv} to victim's uuid
        set {_cv} to {class::%{_uv}%} ? "None"
        set {_lv} to {level::%{_uv}%} ? 1

        if attacker is a living entity:
            if {_cv} is "Tank":
                # L20 — -25% урона, иначе L1 -15%
                if {_lv} >= 20:
                    set damage to damage * 0.75
                else:
                    set damage to damage * 0.85
                # Перк C "Несокрушимый": при ≤40%% макс. ❤ → -30%% дополнительно
                if {perk::%{_uv}%} is "tank_C":
                    if tankHpBelowC(victim) is true:
                        set damage to damage * 0.7
                # L7 — Якорь: атакующий получает Slowness I на 2с
                if {_lv} >= 7:
                    if attacker is a player:
                        if areDuo(victim, attacker) is not true:
                            apply slowness 1 without particles to attacker for 2 seconds
                    else:
                        apply slowness 1 without particles to attacker for 2 seconds
                # L8 — Последний рубеж: при ≤30%% макс. ❤ → Resistance II 5с (КД 30с)
                if {_lv} >= 8:
                    if evoAdminAbilityDisabled("tank_laststand") is false:
                        if tankHpBelowLastStand(victim) is true:
                            set {_now_ts} to unix timestamp of now
                            set {_cd} to {tank_laststand_cd::%{_uv}%} ? 0
                            set {_allowLaststand} to false
                            if {_cd} <= {_now_ts}:
                                set {_allowLaststand} to true
                            if noCooldownMode(victim) is true:
                                set {_allowLaststand} to true
                            if evoAdminCdDisabled("tank_laststand") is true:
                                set {_allowLaststand} to true
                            if {_allowLaststand} is true:
                                apply resistance 2 without particles to victim for 5 seconds
                                set {tank_laststand_cd::%{_uv}%} to {_now_ts} + 30
                                set {_vloc} to location of victim
                                play sound "block.beacon.activate" with volume 0.8 and pitch 1.5 at {_vloc} for victim
                                send action bar "&4&l⛨ ПОСЛЕДНИЙ РУБЕЖ!" to victim
                if {_lv} >= 10:
                    if attacker is a player:
                        if areDuo(victim, attacker) is not true:
                            damage attacker by 1 with fake damage cause entity attack
                            send action bar "&7Шипы!" to attacker
                    else:
                        damage attacker by 1 with fake damage cause entity attack
                # Перк A "Магма-броня": атакующий поджигается + 2❤ огнём
                if {perk::%{_uv}%} is "tank_A":
                    if attacker is a player:
                        if areDuo(victim, attacker) is not true:
                            ignite attacker for 4 seconds
                            damage attacker by 2 with fake damage cause entity attack
                            send action bar "&c&lМАГМА-БРОНЯ!" to attacker
                    else:
                        ignite attacker for 4 seconds
                        damage attacker by 2 with fake damage cause entity attack
                # Перk B "Сейсмический удар" (пассивный, реактивный):
                if {perk::%{_uv}%} is "tank_B":
                    if evoAdminAbilityDisabled("tank_seismic") is false:
                        add 1 to {tank_seismic_hits::%{_uv}%}
                        if {tank_seismic_hits::%{_uv}%} >= 4:
                            set {tank_seismic_hits::%{_uv}%} to 0
                            set {_pl} to location of victim
                            play sound "entity.generic.explode" with volume 0.8 and pitch 0.6 at {_pl} for all players
                            execute console command "particle minecraft:large_smoke %x-coordinate of {_pl}% %y-coordinate of {_pl}% %z-coordinate of {_pl}% 0.4 0.4 0.4 0.1 30 force"
                            loop all living entities in radius 4 around victim:
                                if loop-entity is not victim:
                                    if loop-entity is a player:
                                        if areDuo(victim, loop-entity) is not true:
                                            apply slowness 2 without particles to loop-entity for 3 seconds
                                            push loop-entity upwards at speed 0.4
                                            push loop-entity backwards at speed 0.7
                                    else:
                                        apply slowness 2 without particles to loop-entity for 3 seconds
                                        push loop-entity upwards at speed 0.4
                                        push loop-entity backwards at speed 0.7
                            send action bar "&8&lСЕЙСМИЧЕСКИЙ УДАР!" to victim

    # Перк B "Кровавая клятва" (Warrior): +15% входящего урона
        if {_cv} is "Warrior":
            if {perk::%{_uv}%} is "warrior_B":
                set damage to damage * 1.15

    # Перк D "Защитник дуо" (Tank): партнёр получает урон, Tank принимает 50% на себя
        if {_cv} is not "Tank":
            if inDuo(victim) is true:
                set {_partner} to duoPartner(victim)
                if {_partner} is online:
                    if classOf({_partner}) is "Tank":
                        if {perk::%uuid of {_partner}%} is "tank_D":
                            if distance between victim and {_partner} <= 8:
                                if {_partner} is not attacker:
                                    set {_redirect} to damage * 0.5
                                    set damage to damage * 0.5
                                    damage {_partner} by {_redirect} with fake damage cause entity attack
                                    send action bar "&6&lТАНК ЗАЩИЩАЕТ" to victim
                                    send action bar "&6&lТЫ ПРИНЯЛ УДАР" to {_partner}

    # Перk D "Второй ветер" (Warrior): спасение от смертельного удара (КД 180с)
        if {_cv} is "Warrior":
            if {perk::%{_uv}%} is "warrior_D":
                if evoAdminAbilityDisabled("warrior_second_wind") is false:
                    if damage >= victim's health:
                        set {_swCd} to {warrior_secondwind_cd::%{_uv}%} ? 0
                        set {_allowSecondwind} to false
                        if {_swCd} <= 0:
                            set {_allowSecondwind} to true
                        if noCooldownMode(victim) is true:
                            set {_allowSecondwind} to true
                        if evoAdminCdDisabled("warrior_second_wind") is true:
                            set {_allowSecondwind} to true
                        if {_allowSecondwind} is true:
                            if playerHoldsTotemOfUndying(victim) is false:
                                cancel event
                                set victim's health to 6
                                apply resistance 2 without particles to victim for 6 seconds
                                apply regeneration 2 without particles to victim for 6 seconds
                                set {warrior_secondwind_cd::%{_uv}%} to 180
                                play sound "item.totem.use" with volume 1 and pitch 1 at victim for all players
                                send title "&a&lВТОРОЙ ВЕТЕР!" with subtitle "&7Спасение от смерти" to victim for 2 seconds

    # Перk D "Арканная перегрузка" (Mage): реактивный контр-импульс (КД 20с)
        if {_cv} is "Mage":
            if {perk::%{_uv}%} is "mage_D":
                set {_molCd} to {mage_overload_cd::%{_uv}%} ? 0
                set {_allowOverload} to false
                if {_molCd} <= 0:
                    set {_allowOverload} to true
                if noCooldownMode(victim) is true:
                    set {_allowOverload} to true
                if {_allowOverload} is true:
                    if attacker is a living entity:
                        if attacker is not victim:
                            apply slowness 2 without particles to attacker for 4 seconds
                            apply weakness 1 without particles to attacker for 4 seconds
                            send action bar "&d&lАРКАННЫЙ ИМПУЛЬС!" to victim
                            play sound "block.amethyst_block.resonate" with volume 1 and pitch 1.2 at victim for all players
                    apply speed 2 without particles to victim for 3 seconds
                    set {mage_overload_cd::%{_uv}%} to 20

# ==========================================
# НЕКРОМАНТ: Метка смерти — +20% урона по отмеченной цели
# Действует и для хозяина, и для его миньонов.
# ==========================================
on damage:
    if victim is a living entity:
        set {_vid} to uuid of victim
        if {necro_mark::%{_vid}%} is set:
            if {necro_mark::%{_vid}%} > unix timestamp of now:
                set {_owner} to {necro_mark_owner::%{_vid}%}
                set {_apply} to false
                if attacker is a player:
                    if uuid of attacker is {_owner}:
                        set {_apply} to true
                else if attacker is a living entity:
                    set {_aid} to uuid of attacker
                    if {minion_owner::%{_aid}%} is {_owner}:
                        set {_apply} to true
                if {_apply} is true:
                    set damage to damage * 1.2
            else:
                delete {necro_mark::%{_vid}%}
                delete {necro_mark_owner::%{_vid}%}

# ==========================================
# СПОСОБНОСТИ ПО ПКМ
# ==========================================

# ---- Кулдаун золотых яблок (для всех) ----
on right click with golden apple:
    if evoAdminNoCdFor(player, "golden_apple") is true:
        stop
    if cooldown of golden apple for player > 0 seconds:
        cancel event
        send action bar "&cЗолотые яблоки на кулдауне!" to player

on consume of golden apple:
    if evoAdminNoCdFor(player, "golden_apple") is true:
        set cooldown of golden apple for player to 0 seconds
        stop
    set cooldown of golden apple for player to 10 seconds

# ==========================================
# СПОСОБНОСТИ ПО ПКМ — единый обработчик
# ==========================================
# Один общий on right click с проверкой класса и предмета — надёжнее
# чем `on right click with X`, который иногда не фаерится.

on right click:
    set {_u} to player's uuid
    set {_c} to {class::%{_u}%} ? "None"
    set {_l} to {level::%{_u}%} ? 1
    if {_c} is not "None":
        if evoAdminClassDisabled({_c}) is true:
            send action bar "&cКласс &f%{_c}% &cотключён администратором." to player
            stop

    set {_tool} to player's tool

    # ===== WARRIOR L20: Активное парирование (ПКМ с мечом, КД 15с) =====
    if {_c} is "Warrior":
        if {_l} >= 20:
            if isSword({_tool}) is true:
                if evoAdminAbilityDisabled("warrior_parry") is true:
                    stop
                if evoAdminNoCdFor(player, "sword_parry") is false:
                    if cooldown of {_tool} for player > 0 seconds:
                        stop
                # Перк C "Идеальное парирование": КД -50% (30с → 15с)
                if {perk::%{_u}%} is "warrior_C":
                    set cooldown of {_tool} for player to 15 seconds
                else:
                    set cooldown of {_tool} for player to 30 seconds
                set {parry_until::%{_u}%} to (unix timestamp of now) + 1
                delete {parry_used::%{_u}%}
                play sound "item.trident.throw" with volume 1 and pitch 1 at player for all players
                send action bar "&e&lPARRY! &7(окно 1с)" to player
                wait 1.05 seconds
                if {parry_used::%{_u}%} is not set:
                    delete {parry_until::%{_u}%}
                    apply weakness 2 without particles to player for 5 seconds
                    apply slowness 2 without particles to player for 5 seconds
                    play sound "block.anvil.land" with volume 1 and pitch 0.7 at player for all players
                    send action bar "&c&lPARRY FAIL &cпромах!" to player
                delete {parry_used::%{_u}%}
                stop

    # ===== SCOUT: Рывок (L5) и Невидимость (L10) пером =====
    if {_c} is "Scout":
        if {_tool} is feather:
            # shift = инвиз (L10)
            if player is sneaking:
                if evoAdminAbilityDisabled("scout_invis") is true:
                    stop
                if {_l} >= 10:
                    if evoAdminNoCdFor(player, "feather") is false:
                        if cooldown of feather for player > 0 seconds:
                            send action bar "&cНевидимость на КД!" to player
                            stop
                    scoutApplyInvis(player, 5)
                    send action bar "&7&lИсчезновение..." to player
                    play sound "entity.illusioner.mirror_move" at player for all players
                    set cooldown of feather for player to 60 seconds
                else:
                    send action bar "&cНевидимость с 10 уровня!" to player
                stop
            # без shift = рывок (L5)
            else:
                if evoAdminAbilityDisabled("scout_dash") is true:
                    stop
                if {_l} >= 5:
                    # Перk A "Двойной рывок": два рывка в окне 5с с КД 4с между; затем общий КД 15с
                    if {perk::%{_u}%} is "scout_A":
                        # Если в окне второго рывка (один уже использован)
                        if {scout_dash_window::%{_u}%} is set:
                            if {scout_dash_window::%{_u}%} > unix timestamp of now:
                                push player forwards at speed 1.8
                                push player upwards at speed 0.5
                                play sound "entity.firework_rocket.launch" at player for all players
                                delete {scout_dash_window::%{_u}%}
                                set cooldown of feather for player to 15 seconds
                                set {scout_dash::%{_u}%} to now
                                set {scout_dash_fallimmune::%{_u}%} to true
                                send action bar "&b&lВТОРОЙ РЫВОК!" to player
                                stop
                        if evoAdminNoCdFor(player, "feather") is false:
                            if cooldown of feather for player > 0 seconds:
                                send action bar "&cРывок на КД!" to player
                                stop
                        # Первый рывок — открыть окно на 5с для второго, КД короткий 4с
                        push player forwards at speed 1.8
                        push player upwards at speed 0.5
                        play sound "entity.firework_rocket.launch" at player for all players
                        set cooldown of feather for player to 4 seconds
                        set {scout_dash_window::%{_u}%} to (unix timestamp of now) + 5
                        set {scout_dash::%{_u}%} to now
                        set {scout_dash_fallimmune::%{_u}%} to true
                        send action bar "&b&lРЫВОК!" to player
                        stop
                    if evoAdminNoCdFor(player, "feather") is false:
                        if cooldown of feather for player > 0 seconds:
                            send action bar "&cРывок на КД!" to player
                            stop
                    push player forwards at speed 1.8
                    push player upwards at speed 0.5
                    play sound "entity.firework_rocket.launch" at player for all players
                    set cooldown of feather for player to 15 seconds
                    set {scout_dash::%{_u}%} to now
                    set {scout_dash_fallimmune::%{_u}%} to true
                    send action bar "&b&lРЫВОК!" to player
                else:
                    send action bar "&cРывок с 5 уровня!" to player
                stop

    # (Tank L15 теперь имеет пассивную ауру — см. блок пассивных баффов)

    # ===== ARCHER: Shift+ПКМ луком =====
    if {_c} is "Archer":
        if {_tool} is bow:
            if player is sneaking:
                # Перk C "Тройной выстрел" — приоритет над Орлиным взором
                if {perk::%{_u}%} is "archer_C":
                    if evoAdminAbilityDisabled("archer_triple") is true:
                        stop
                    if evoAdminNoCdFor(player, "archer_triple") is false:
                        if {archer_triple_cd::%{_u}%} ? 0 > 0:
                            send action bar "&cТройной выстрел: КД &e%{archer_triple_cd::%{_u}%}%с" to player
                            stop
                    cancel event
                    set {_arr} to amount of arrow in player's inventory
                    if {_arr} < 3:
                        send action bar "&cНужно 3 стрелы!" to player
                        stop
                    remove 3 of arrow from player
                    shoot an arrow from player at speed 2.5
                    set {_a1} to last shot projectile
                    shoot an arrow from player at speed 2.5
                    set {_a2} to last shot projectile
                    shoot an arrow from player at speed 2.5
                    set {_a3} to last shot projectile
                    if {_a2} is set:
                        push {_a2} to the right at speed 0.3
                    if {_a3} is set:
                        push {_a3} to the left at speed 0.3
                    play sound "entity.skeleton.shoot" with volume 1 and pitch 0.8 at player for all players
                    set {archer_triple_cd::%{_u}%} to 12
                    send action bar "&6&lТРОЙНОЙ ВЫСТРЕЛ!" to player
                    stop
                if {_l} >= 25:
                    if evoAdminAbilityDisabled("archer_eagle") is true:
                        stop
                    if evoAdminNoCdFor(player, "archer_eagle") is false:
                        if {archer_eye_cd::%player's uuid%} ? 0 > 0:
                            send action bar "&cОрлиный взор: КД &e%{archer_eye_cd::%player's uuid%}%с" to player
                            stop
                    cancel event
                    set {_n} to 0
                    delete {archer_marked::%player's uuid%::*}
                    loop all living entities in radius 25 around player:
                        if loop-entity is not player:
                            apply glowing 1 without particles to loop-entity for 8 seconds
                            add uuid of loop-entity to {archer_marked::%player's uuid%::*}
                            add 1 to {_n}
                    set {archer_eye::%player's uuid%} to now
                    set {archer_eye_cd::%player's uuid%} to 45
                    apply speed 2 without particles to player for 8 seconds
                    apply night vision 1 without particles to player for 8 seconds
                    play sound "item.spyglass.use" with volume 1 and pitch 0.7 at player for all players
                    send action bar "&6&lОРЛИНЫЙ ВЗОР!" to player
                    stop

    # ===== TANK: активных способностей по щиту НЕТ — танк пассивный =====
    # (Перк B "Сейсмический удар" — реактивный, см. блок on damage of player)

    # ===== NECROMANCER: ПКМ костью — Призыв миньона =====
    if {_c} is "Necromancer":
        if {_tool} is bone:
            # Перk C "Мёртвая хватка": Shift+ПКМ костью — притянуть врага
            if player is sneaking:
                if {perk::%{_u}%} is "necro_C":
                    if evoAdminAbilityDisabled("necro_grip") is true:
                        stop
                    if evoAdminNoCdFor(player, "necro_grip") is false:
                        if {necro_grip_cd::%{_u}%} ? 0 > 0:
                            send action bar "&cМёртвая хватка: КД &e%{necro_grip_cd::%{_u}%}%с" to player
                            stop
                    set {_target} to target entity of player
                    if {_target} is a living entity:
                        if {_target} is not player:
                            if distance between player and {_target} <= 20:
                                set {_pl} to location of player
                                teleport {_target} to {_pl}
                                apply slowness 3 without particles to {_target} for 4 seconds
                                play sound "entity.zombie.attack_iron_door" with volume 1 and pitch 0.6 at player for all players
                                set {necro_grip_cd::%{_u}%} to 20
                                send action bar "&8&lМЁРТВАЯ ХВАТКА!" to player
                            else:
                                send action bar "&cЦель слишком далеко" to player
                        else:
                            send action bar "&cНет цели" to player
                    else:
                        send action bar "&cНаведись на врага" to player
                    stop
            if evoAdminAbilityDisabled("necro_minion") is true:
                stop
            if evoAdminNoCdFor(player, "bone") is false:
                if cooldown of bone for player > 0 seconds:
                    send action bar "&cПризыв на КД!" to player
                    stop
            spawnNecroMinion(player, {_l})
            set cooldown of bone for player to 30 seconds
            send action bar "&2&lПРИЗЫВ!" to player
            stop

    # ===== MAGE: Фаербол / Эндер-перл блейз родом =====
    if {_c} is "Mage":
        if {_tool} is blaze rod:
            # shift = эндер-перл (L15)
            if player is sneaking:
                if evoAdminAbilityDisabled("mage_teleport") is true:
                    stop
                if {_l} >= 15:
                    if evoAdminNoCdFor(player, "blaze_rod") is false:
                        if cooldown of blaze rod for player > 0 seconds:
                            send action bar "&cТелепорт на КД!" to player
                            stop
                    shoot an ender pearl from player at speed 1.6
                    play sound "entity.ender_pearl.throw" with volume 1 and pitch 1 at player for all players
                    set cooldown of blaze rod for player to 25 seconds
                    send action bar "&d&lЭНДЕР-ПЁРЛ!" to player
                else:
                    send action bar "&cЭндер-перл с 15 уровня!" to player
                stop
            # без shift = фаербол (L1+ малый, L25+ большой)
            else:
                if evoAdminAbilityDisabled("mage_fireball") is true:
                    stop
                if evoAdminNoCdFor(player, "blaze_rod") is false:
                    if cooldown of blaze rod for player > 0 seconds:
                        send action bar "&cФаербол на КД!" to player
                        stop
                # Заряд маны (L5+) — пометить следующий фаербол
                set {_charged} to false
                if {mage_charge::%{_u}%} is set:
                    if {mage_charge::%{_u}%} > unix timestamp of now:
                        set {_charged} to true
                    delete {mage_charge::%{_u}%}
                # Перk A "Метеор": большой фаербол доступен с L1 (КД 20с)
                if {perk::%{_u}%} is "mage_A":
                    shoot a fireball from player at speed 2
                    set {fireball_shooter::%uuid of last spawned entity%} to {_u}
                    if {_charged} is true:
                        set {fireball_charged::%uuid of last spawned entity%} to true
                    set cooldown of blaze rod for player to 20 seconds
                    play sound "entity.ghast.shoot" with volume 1 and pitch 0.7 at player for all players
                    if {_charged} is true:
                        send action bar "&c&lМЕТЕОР!" to player
                    else:
                        send action bar "&c&lМЕТЕОР!" to player
                    stop
                if {_l} >= 25:
                    shoot a fireball from player at speed 2
                    set {fireball_shooter::%uuid of last spawned entity%} to {_u}
                    if {_charged} is true:
                        set {fireball_charged::%uuid of last spawned entity%} to true
                    set cooldown of blaze rod for player to 8 seconds
                    if {_charged} is true:
                        send action bar "&c&lБОЛЬШОЙ ФАЕРБОЛ!" to player
                    else:
                        send action bar "&c&lБОЛЬШОЙ ФАЕРБОЛ!" to player
                else:
                    shoot a small fireball from player at speed 2
                    set {fireball_shooter::%uuid of last spawned entity%} to {_u}
                    if {_charged} is true:
                        set {fireball_charged::%uuid of last spawned entity%} to true
                    set cooldown of blaze rod for player to 4 seconds
                    if {_charged} is true:
                        send action bar "&d&lЗАРЯЖЕННЫЙ ФАЕРБОЛ!" to player
                    else:
                        send action bar "&6&lФаербол!" to player
                stop

        # MAGE L10: Масс-хил зельем (радиус 6)
        if {_l} >= 10:
            if "%{_tool}%" contains "potion":
                if evoAdminAbilityDisabled("mage_mass_heal") is true:
                    stop
                if evoAdminNoCdFor(player, "splash_potion") is false:
                    if cooldown of splash potion for player > 0 seconds:
                        send action bar "&cМасс-хил на КД!" to player
                        stop
                cancel event
                set {_n} to 0
                loop all players in radius 6 around player:
                    heal loop-player by 4
                    apply regeneration 2 without particles to loop-player for 4 seconds
                    add 1 to {_n}
                play sound "block.beacon.activate" at player for all players
                set cooldown of splash potion for player to 30 seconds
                send action bar "&a&lМАСС-ХИЛ!" to player
                stop

# ==========================================
# ARCHER L8/L20 — Многозарядность и Магический колчан
# ==========================================
on shoot:
    if shooter is a player:
        if projectile is an arrow:
            set {_su} to uuid of shooter
            if {class::%{_su}%} is "Archer":
                set {_lv} to {level::%{_su}%} ? 1
                # L8 — каждая 5-я стрела возвращается обратно в инвентарь
                if {_lv} >= 8:
                    add 1 to {archer_shots::%{_su}%}
                    if {archer_shots::%{_su}%} >= 5:
                        set {archer_shots::%{_su}%} to 0
                        give 1 arrow to shooter
                        send action bar "&e&lМНОГОЗАРЯДНОСТЬ!" to shooter
                # L20 — каждая 4-я стрела магическая (+3 урон + поджиг)
                if {_lv} >= 20:
                    add 1 to {archer_quiver::%{_su}%}
                    if {archer_quiver::%{_su}%} >= 4:
                        set {archer_quiver::%{_su}%} to 0
                        set {arrow_magic::%uuid of projectile%} to true
                        send action bar "&5&lМАГИЧЕСКИЙ КОЛЧАН!" to shooter
            # Легендарка Archer: автонаводка стрел
            if hasArtifact(shooter, "leg_archer") is true:
                set {arrow_homing::%uuid of projectile%} to true
                set {arrow_homing_suuid::%uuid of projectile%} to uuid of shooter
                delete {arrow_homing_tuuid::%uuid of projectile%}

every 1 tick:
    loop all projectiles:
        set {_pid} to uuid of loop-value
        if {arrow_homing::%{_pid}%} is true:
            if loop-value is not an arrow:
                delete {arrow_homing::%{_pid}%}
                delete {arrow_homing_suuid::%{_pid}%}
                delete {arrow_homing_tuuid::%{_pid}%}
            else if loop-value is on ground:
                delete {arrow_homing::%{_pid}%}
                delete {arrow_homing_suuid::%{_pid}%}
                delete {arrow_homing_tuuid::%{_pid}%}
            else:
                set {_ouid} to {arrow_homing_suuid::%{_pid}%}
                if {_ouid} is set:
                    set {_owner} to player from {_ouid}
                    if {_owner} is not a player:
                        delete {arrow_homing::%{_pid}%}
                        delete {arrow_homing_suuid::%{_pid}%}
                        delete {arrow_homing_tuuid::%{_pid}%}
                        set {_owner_ok} to false
                    else:
                        set {_owner_ok} to true
                    if {_owner_ok} is true:
                        set {_aloc} to location of loop-value
                        delete {_near}
                        # 1) Пытаемся вести стрелу к уже зафиксированной цели
                        set {_tuuid} to {arrow_homing_tuuid::%{_pid}%}
                        if {_tuuid} is set:
                            for each {_cand} in all living entities in radius 40 around {_aloc}:
                                if {_near} is not set:
                                    if "%uuid of {_cand}%" is {_tuuid}:
                                        set {_near} to {_cand}
                        # 2) Если цели ещё нет/потерялась — выбираем ближайшую и фиксируем
                        if {_near} is not set:
                            set {_nearD} to 10
                            for each {_cand} in all living entities in radius 10 around {_aloc}:
                                if {_cand} is not {_owner}:
                                    if {_cand} is not an armor stand:
                                        set {_ok} to true
                                        if {_cand} is a player:
                                            if areDuo({_owner}, {_cand}) is true:
                                                set {_ok} to false
                                        if {_ok} is true:
                                            set {_dd} to distance between {_aloc} and {_cand}
                                            if {_dd} < {_nearD}:
                                                set {_nearD} to {_dd}
                                                set {_near} to {_cand}
                            if {_near} is set:
                                set {arrow_homing_tuuid::%{_pid}%} to "%uuid of {_near}%"
                        if {_near} is set:
                            set {_nearD} to distance between {_aloc} and {_near}
                            # Финишный захват: вблизи цели принудительно засчитываем попадание,
                            # чтобы стрела не "кружила" рядом из-за частых телепортов.
                            if {_nearD} <= 2.35:
                                damage {_near} by 2 with fake damage cause projectile
                                if {arrow_magic::%{_pid}%} is true:
                                    damage {_near} by 1 with fake damage cause projectile
                                    ignite {_near} for 3 seconds
                                    delete {arrow_magic::%{_pid}%}
                                # Комбат-лог только за PvP: по мобам лега не должна вводить стрелка в бой
                                if {_near} is a player:
                                    if {_owner} is a player:
                                        tagCombat({_owner})
                                    tagCombat({_near})
                                delete {arrow_homing::%{_pid}%}
                                delete {arrow_homing_suuid::%{_pid}%}
                                delete {arrow_homing_tuuid::%{_pid}%}
                                delete loop-value
                            else:
                                set {_tloc} to location of {_near}
                                add 1 to y-coordinate of {_tloc}
                                set {_dx} to x-coordinate of {_tloc} - x-coordinate of {_aloc}
                                set {_dy} to y-coordinate of {_tloc} - y-coordinate of {_aloc}
                                set {_dz} to z-coordinate of {_tloc} - z-coordinate of {_aloc}
                                set {_len} to distance between {_aloc} and {_tloc}
                                if {_len} > 0.01:
                                    set {_nloc} to location of loop-value
                                    if {_nearD} <= 3:
                                        set {_pull} to 2.2
                                    else:
                                        set {_pull} to 1.35
                                    add ({_dx} / {_len}) * {_pull} to x-coordinate of {_nloc}
                                    add ({_dy} / {_len}) * {_pull} to y-coordinate of {_nloc}
                                    add ({_dz} / {_len}) * {_pull} to z-coordinate of {_nloc}
                                    teleport loop-value to {_nloc}

# Бонус урона: магические стрелы лучника и заряженные фаерболы мага
on damage:
    if attacker is an arrow:
        delete {arrow_homing::%uuid of attacker%}
        delete {arrow_homing_suuid::%uuid of attacker%}
        delete {arrow_homing_tuuid::%uuid of attacker%}
        if {arrow_magic::%uuid of attacker%} is true:
            set damage to damage + 3
            if victim is a living entity:
                ignite victim for 3 seconds
            delete {arrow_magic::%uuid of attacker%}
    if attacker is a fireball:
        if {fireball_charged::%uuid of attacker%} is true:
            set damage to damage * 1.5
            delete {fireball_charged::%uuid of attacker%}
        # Mage L23: +25% урон фаерболами (стрелок записан при касте)
        set {_fbid} to uuid of attacker
        set {_shu} to {fireball_shooter::%{_fbid}%}
        delete {fireball_shooter::%{_fbid}%}
        if {_shu} is set:
            set {_sh} to player from {_shu}
            if {_sh} is a player:
                if classOf({_sh}) is "Mage":
                    if levelOf({_sh}) >= 23:
                        set damage to damage * 1.25

# Легендарка Scout: удар по фантом-двойнику
on damage:
    if victim is an armor stand:
        set {_du} to uuid of victim
        if {leg_scout_decoy_owner::%{_du}%} is set:
            cancel event
            set {_ou} to {leg_scout_decoy_owner::%{_du}%}
            set {_ownerScout} to player from {_ou}
            set {_boom} to location of victim
            play sound "entity.generic.explode" with volume 0.9 and pitch 1.2 at {_boom} for all players
            strike lightning effect at {_boom}
            loop all living entities in radius 5 around {_boom}:
                set {_affect} to true
                if {_ownerScout} is a player:
                    if loop-entity is {_ownerScout}:
                        set {_affect} to false
                    if loop-entity is a player:
                        if areDuo({_ownerScout}, loop-entity) is true:
                            set {_affect} to false
                if {_affect} is true:
                    applyCappedDebuff(loop-entity, "slowness", "slowness", 2, 4)
                    applyCappedDebuff(loop-entity, "blindness", "blindness", 1, 3)
                    applyCappedDebuff(loop-entity, "glowing", "glowing", 1, 5)
            delete {leg_scout_decoy_owner::%{_du}%}
            delete victim

# Запрет взаимодействия с фантом-двойником (нельзя снять экипировку)
on right click on armor stand:
    set {_du} to uuid of event-entity
    if {leg_scout_decoy_owner::%{_du}%} is set:
        cancel event

# Запрет зачарования классовых предметов (стол опыта)
on enchant prepare:
    if isClassItem(enchant item) is true:
        cancel event
        stop

# Корона Высшего Разума: стол зачарований даёт +1 уровень каждому полученному зачару.
on enchant:
    if hasArtifact(player, "crownmind") is true:
        wait 1 tick
        set {_it} to event-item
        if player's current inventory is set:
            if type of player's current inventory is enchanting table inventory:
                set {_slot0} to slot 0 of player's current inventory
                if {_slot0} is not air:
                    set {_it} to {_slot0}
        if {_it} is not set:
            stop
        if {_it} is enchanted with protection:
            set {_lv} to level of protection of {_it}
            if {_lv} is between 1 and 20:
                add 1 to {_lv}
                enchant {_it} with protection {_lv}
        if {_it} is enchanted with fire protection:
            set {_lv} to level of fire protection of {_it}
            if {_lv} is between 1 and 20:
                add 1 to {_lv}
                enchant {_it} with fire protection {_lv}
        if {_it} is enchanted with blast protection:
