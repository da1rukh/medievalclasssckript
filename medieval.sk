    if {_nm} is set:
        if {_nm} contains "Алтар":
            return true
        if {_nm} contains "Артефакт:":
            return true
        if {_nm} contains "Легендарный артефакт:":
            return true
    return false

function isFiveItemRecipeExact(inv: inventory, a: item, b: item, c: item, d: item, e: item) :: boolean:
    set {_an} to 0
    set {_bn} to 0
    set {_cn} to 0
    set {_dn} to 0
    set {_en} to 0
    set {_total} to 0
    set {_bad} to false
    loop 5 times:
        set {_it} to slot (loop-number - 1) of {_inv}
        if {_it} is air:
            set {_bad} to true
        else:
            add 1 to {_total}
            if {_it} is {_a}:
                add 1 to {_an}
            else if {_it} is {_b}:
                add 1 to {_bn}
            else if {_it} is {_c}:
                add 1 to {_cn}
            else if {_it} is {_d}:
                add 1 to {_dn}
            else if {_it} is {_e}:
                add 1 to {_en}
            else:
                set {_bad} to true
    if {_bad} is true:
        return false
    if {_total} is not 5:
        return false
    if {_an} is not 1:
        return false
    if {_bn} is not 1:
        return false
    if {_cn} is not 1:
        return false
    if {_dn} is not 1:
        return false
    if {_en} is not 1:
        return false
    return true

