function hasArtifactItemInInventory(p: player, mark: text) :: boolean:
    loop all items in {_p}'s inventory:
        set {_nm} to name of loop-value
        if {_nm} is set:
            if {_nm} contains {_mark}:
                return true
    return false

function isArtifactResultBlockedForQuantDup(it: item) :: boolean:
