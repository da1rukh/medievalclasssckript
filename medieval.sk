function isCrownHigherMindAltarRecipe(inv: inventory) :: boolean:
    set {_mindN} to 0
    set {_azuraN} to 0
    set {_helmN} to 0
    set {_bookN} to 0
    set {_xpBottleN} to 0
    set {_total} to 0
    set {_bad} to false
    loop 5 times:
        set {_it} to slot (loop-number - 1) of {_inv}
        if {_it} is air:
            set {_bad} to true
        else:
            add 1 to {_total}
            set {_nm} to name of {_it}
            if {_nm} is set:
                if {_nm} contains "Эфирный Разум":
                    add 1 to {_mindN}
                else if {_nm} contains "Звезда Азуры":
                    add 1 to {_azuraN}
                else:
                    if {_it} is golden helmet:
                        add 1 to {_helmN}
                    else if {_it} is enchanted book:
                        add 1 to {_bookN}
                    else if {_it} is experience bottle:
                        add 1 to {_xpBottleN}
                    else:
                        set {_bad} to true
            else:
                if {_it} is golden helmet:
                    add 1 to {_helmN}
                else if {_it} is enchanted book:
                    add 1 to {_bookN}
                else if {_it} is experience bottle:
                    add 1 to {_xpBottleN}
                else:
                    set {_bad} to true
    if {_bad} is true:
        return false
    if {_total} is not 5:
        return false
    if {_mindN} is not 1:
        return false
    if {_azuraN} is not 1:
        return false
    if {_helmN} is not 1:
        return false
    if {_bookN} is not 1:
        return false
    if {_xpBottleN} is not 1:
        return false
    return true

