    enchant {_p} with unbreaking 10
    enchant {_p} with efficiency 6
    return {_p}

function isEtherPickaxe(i: item) :: boolean:
    if {_i} is not diamond pickaxe:
        return false
    set {_n} to name of {_i}
    if {_n} is not set:
        return false
    if {_n} contains "Эфирная Кирка":
        return true
    return false

function pickaxeHasTag(i: item, tag: text) :: boolean:
    if {_i} is not diamond pickaxe:
        if {_i} is not netherite pickaxe:
            return false
    set {_l::*} to lore of {_i}
    loop {_l::*}:
        if loop-value contains {_tag}:
            return true
    return false

function isFlamePickaxe(i: item) :: boolean:
    return pickaxeHasTag({_i}, "ПЛАМЯ_КИРКА")

function isVeinPickaxe(i: item) :: boolean:
    return pickaxeHasTag({_i}, "ЖИЛА_КИРКА")

function isFortunePickaxe(i: item) :: boolean:
    return pickaxeHasTag({_i}, "УДАЧА_КИРКА")

function isVoidPickaxe(i: item) :: boolean:
    return pickaxeHasTag({_i}, "ПУСТОТА_КИРКА")

function isOmniPickaxe(i: item) :: boolean:
    return pickaxeHasTag({_i}, "ОМНИ_КИРКА")

function isAltarPickaxeTool(i: item) :: boolean:
    if isEtherPickaxe({_i}) is true:
        return true
    if isFlamePickaxe({_i}) is true:
        return true
    if isVeinPickaxe({_i}) is true:
        return true
    if isFortunePickaxe({_i}) is true:
        return true
    if isVoidPickaxe({_i}) is true:
        return true
    if isOmniPickaxe({_i}) is true:
        return true
    return false

function isEtherTrashBlock(b: block) :: boolean:
    if {_b} is stone:
        return true
    if {_b} is cobblestone:
        return true
    if {_b} is dirt:
        return true
    if {_b} is gravel:
        return true
    if {_b} is deepslate:
        return true
    return false

function isEtherValuableOre(b: block) :: boolean:
    if {_b} is diamond ore:
        return true
    if {_b} is deepslate diamond ore:
        return true
    if {_b} is redstone ore:
        return true
    if {_b} is deepslate redstone ore:
        return true
    if {_b} is lapis ore:
        return true
    if {_b} is deepslate lapis ore:
        return true
    if {_b} is coal ore:
        return true
    if {_b} is deepslate coal ore:
        return true
    if {_b} is gold ore:
        return true
    if {_b} is deepslate gold ore:
        return true
    if {_b} is nether gold ore:
        return true
    if {_b} is iron ore:
        return true
    if {_b} is deepslate iron ore:
        return true
    if {_b} is ancient debris:
        return true
    return false

# Целый блок как при шёлковом касании (через give — работает для любого minecraft:id).
function giveAltarSilkBlockItemById(p: player, id: text):
    if {_id} does not contain ":":
        set {_id} to "minecraft:%{_id}%"
    execute console command "give %{_p}% %{_id}% 1"

function giveAltarSilkBlockItem(p: player, b: block, loc: location):
    giveAltarSilkBlockItemById({_p}, "%type of {_b}%")

# Опыт как у обычной добычи руды (под шёлк).
function giveAltarSilkOreXp(p: player, b: block):
    if {_b} is diamond ore:
        give 3 experience to {_p}
    else if {_b} is deepslate diamond ore:
        give 3 experience to {_p}
    else if {_b} is gold ore:
        give 2 experience to {_p}
    else if {_b} is deepslate gold ore:
        give 2 experience to {_p}
    else if {_b} is nether gold ore:
        give 2 experience to {_p}
    else if {_b} is iron ore:
        give 2 experience to {_p}
    else if {_b} is deepslate iron ore:
        give 2 experience to {_p}
    else if {_b} is coal ore:
        give 2 experience to {_p}
    else if {_b} is deepslate coal ore:
        give 2 experience to {_p}
    else if {_b} is lapis ore:
        give 3 experience to {_p}
    else if {_b} is deepslate lapis ore:
        give 3 experience to {_p}
    else if {_b} is redstone ore:
        give 3 experience to {_p}
    else if {_b} is deepslate redstone ore:
        give 3 experience to {_p}
    else if {_b} is ancient debris:
        give 5 experience to {_p}

function giveOrDrop(it: item, p: player, loc: location):
    if {_p} has space for {_it}:
        give {_it} to {_p}
    else:
        drop {_it} at {_loc}

function clearAltarCraftSlots(inv: inventory):
    set slot 0 of {_inv} to air
    set slot 1 of {_inv} to air
    set slot 2 of {_inv} to air
    set slot 3 of {_inv} to air
    set slot 4 of {_inv} to air

function isPickaxeRecipeByCore(inv: inventory, core: item, catalyst: item) :: boolean:
    set {_voidN} to 0
    set {_retN} to 0
    set {_pickN} to 0
    set {_coreN} to 0
    set {_catN} to 0
    set {_total} to 0
    set {_bad} to false
    loop 5 times:
        set {_it} to slot (loop-number - 1) of {_inv}
        if {_it} is air:
            set {_bad} to true
        else:
            add 1 to {_total}
            if altarAwakeningVoidKey({_it}) is true:
                add 1 to {_voidN}
            else if altarAwakeningReturnKey({_it}) is true:
                add 1 to {_retN}
            else if {_it} is diamond pickaxe:
                add 1 to {_pickN}
            else if {_it} is {_core}:
                add 1 to {_coreN}
            else if {_it} is {_catalyst}:
                add 1 to {_catN}
            else:
                set {_bad} to true
    if {_bad} is true:
        return false
    if {_total} is not 5:
        return false
    if {_voidN} is not 1:
        return false
    if {_retN} is not 1:
        return false
    if {_pickN} is not 1:
        return false
    if {_coreN} is not 1:
        return false
    if {_catN} is not 1:
        return false
    return true

function isOmniPickaxeAltarRecipe(inv: inventory) :: boolean:
    set {_ether} to 0
    set {_flame} to 0
    set {_vein} to 0
    set {_fortune} to 0
    set {_voidp} to 0
    set {_total} to 0
    set {_bad} to false
    loop 5 times:
        set {_it} to slot (loop-number - 1) of {_inv}
        if {_it} is air:
            set {_bad} to true
        else:
            add 1 to {_total}
            if isEtherPickaxe({_it}) is true:
                add 1 to {_ether}
            else if isFlamePickaxe({_it}) is true:
                add 1 to {_flame}
            else if isVeinPickaxe({_it}) is true:
                add 1 to {_vein}
            else if isFortunePickaxe({_it}) is true:
                add 1 to {_fortune}
            else if isVoidPickaxe({_it}) is true:
                add 1 to {_voidp}
            else:
                set {_bad} to true
    if {_bad} is true:
        return false
    if {_total} is not 5:
        return false
    if {_ether} is not 1:
        return false
    if {_flame} is not 1:
        return false
    if {_vein} is not 1:
        return false
    if {_fortune} is not 1:
        return false
    if {_voidp} is not 1:
        return false
    return true

function isEtherPickaxeAltarRecipeExact(inv: inventory) :: boolean:
    set {_voidN} to 0
    set {_retN} to 0
    set {_pickN} to 0
    set {_blockN} to 0
    set {_amN} to 0
    set {_total} to 0
    set {_bad} to false
    loop 5 times:
        set {_si} to loop-number - 1
        set {_it} to slot {_si} of {_inv}
        if {_it} is air:
            set {_bad} to true
        else:
            add 1 to {_total}
            if altarAwakeningVoidKey({_it}) is true:
                add 1 to {_voidN}
            else if altarAwakeningReturnKey({_it}) is true:
                add 1 to {_retN}
            else if {_it} is diamond pickaxe:
                add 1 to {_pickN}
            else if {_it} is diamond block:
                add 1 to {_blockN}
            else if {_it} is amethyst shard:
                add 1 to {_amN}
            else:
                set {_bad} to true
    if {_bad} is true:
        return false
    if {_total} is not 5:
        return false
    if {_voidN} is not 1:
        return false
    if {_retN} is not 1:
        return false
    if {_pickN} is not 1:
        return false
    if {_blockN} is not 1:
        return false
    if {_amN} is not 1:
        return false
    return true

