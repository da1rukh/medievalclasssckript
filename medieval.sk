            set slot 7 of player's current inventory to wither skeleton skull named "&4&lD — Могильный лорд"
            set lore of slot 7 of player's current inventory to "&7Миньоны: &fx2 ❤ + 30%% урона", "&7+ накладывают &fWither I &7при ударе", "", "&8» Босс-армия"

        set slot 4 of player's current inventory to book named "&eВыбор перка" with lore "&7Выбор &cокончательный&7.", "&8Класс: &f%{_cls}%", "", "&7Кликай на любой из четырёх перков"

on inventory click:
    if name of event-inventory is "&8Choose your Perk":
        cancel event
        set {_u} to player's uuid
        set {_cls} to {class::%{_u}%} ? "None"
        set {_letter} to ""
        if index of event-slot is 1:
            set {_letter} to "A"
        else if index of event-slot is 3:
            set {_letter} to "B"
        else if index of event-slot is 5:
            set {_letter} to "C"
        else if index of event-slot is 7:
            set {_letter} to "D"
        if {_letter} is not "":
            set {_oldPerk} to {perk::%{_u}%}
            set {_newPerk} to ""
            if {_cls} is "Warrior":
                set {_newPerk} to "warrior_%{_letter}%"
            else if {_cls} is "Scout":
                set {_newPerk} to "scout_%{_letter}%"
            else if {_cls} is "Tank":
                set {_newPerk} to "tank_%{_letter}%"
            else if {_cls} is "Archer":
                set {_newPerk} to "archer_%{_letter}%"
            else if {_cls} is "Mage":
                set {_newPerk} to "mage_%{_letter}%"
            else if {_cls} is "Necromancer":
                set {_newPerk} to "necro_%{_letter}%"
            # Если игрок просто пере-выбирает тот же перк — ничего не делаем
            if {_oldPerk} is {_newPerk}:
                close player's inventory
                send "{@prefix} &7Этот перк уже выбран — ничего не изменилось."
                stop
            # Проверка минимального уровня для смены перка (L16 / выше 15)
            if {_oldPerk} is set:
                set {_curLvl} to {level::%{_u}%} ? 1
                if {_curLvl} < 16:
                    set {_need2} to 16 - {_curLvl}
                    close player's inventory
                    send "{@prefix} &cСмена перка доступна только с &f16 уровня&c."
                    send "{@prefix} &7Тебе нужно ещё &e%{_need2}% &7уровней."
                    play sound "entity.villager.no" with volume 0.7 and pitch 1.0 at player for player
                    stop
            set {perk::%{_u}%} to {_newPerk}
            close player's inventory
            # Списываем 5 уровней при смене перка (был ≥20)
            if {_oldPerk} is set:
                set {_curLvl} to {level::%{_u}%} ? 1
                set {_newLvl} to {_curLvl} - 5
                set {kills::%{_u}%} to ({_newLvl} - 1) * {@kills_per_level}
                set {level::%{_u}%} to {_newLvl}
                send "{@prefix} &cУровень: &fL%{_curLvl}% &c→ &fL%{_newLvl}% &7(-5 за смену перка)"
                play sound "entity.wither.hurt" with volume 0.7 and pitch 1.4 at player for player
                send "{@prefix} &eПерк изменён: &7%{_oldPerk}% &8→ &6%{_newPerk}%"
            else:
                send "{@prefix} &aПерк выбран: &e%{_newPerk}%"
            play sound "ui.toast.challenge_complete" at player for player

# ==========================================
# ДУАЛ ВИЛД: HASTE III ПРИ ДВУХ ОДИНАКОВЫХ ПРЕДМЕТАХ В РУКАХ
# ==========================================
every 3 seconds:
    loop all players:
        set {_main} to loop-player's tool
        set {_off} to loop-player's off hand tool
        if {_main} is set:
            if {_off} is set:
                if {_main} is not air:
                    if {_off} is not air:
                        if type of {_main} is type of {_off}:
                            apply haste 3 without particles to loop-player for 60 ticks

# ==========================================
# /duotpa — ТЕЛЕПОРТ К НАПАРНИКУ ПО ДУО (L5+)
# Полноценный /tpa-стиль: запрос → accept → мгновенный телепорт.
# Никаких эндер-перлов.
#
# Хранение:
#   {duotpa_req::%uuid%}      = uuid игрока, который просит ТП К адресату (адресат = ключ)
#   {duotpa_req_time::%uuid%} = unix timestamp выдачи запроса (TTL 60с)
#   {duotpa_cd::%uuid%}       = unix timestamp, до которого инициатору нельзя слать новый запрос
# ==========================================
command /duotpa [<text>]:
    aliases: /dtpa, /duotp
    trigger:
        set {_u} to player's uuid
        set {_l} to {level::%{_u}%} ? 1
        set {_now} to unix timestamp of now

        # ----- accept / deny не требуют дуо/уровня -----
        if arg-1 is "accept":
            if {duotpa_req::%{_u}%} is not set:
                send "{@prefix} &cНет активных запросов."
                stop
            set {_inv} to {duotpa_req::%{_u}%}
            set {_t} to {duotpa_req_time::%{_u}%} ? 0
            if {_now} - {_t} > {@duotpa_request_ttl}:
                delete {duotpa_req::%{_u}%}
                delete {duotpa_req_time::%{_u}%}
                send "{@prefix} &cЗапрос истёк."
                stop
            set {_invP} to player from {_inv}
            if {_invP} is not online:
                delete {duotpa_req::%{_u}%}
                delete {duotpa_req_time::%{_u}%}
                send "{@prefix} &cЗапросивший игрок не онлайн."
                stop
            # Combat-log: запретить ТП в бою
            if inCombat(player) is true:
                send "{@prefix} &cТы в бою — нельзя принимать ТП ещё &e%combatLeft(player)%с&c."
                stop
            if inCombat({_invP}) is true:
                send "{@prefix} &c%{_invP}% в бою — ТП недоступен ещё &e%combatLeft({_invP})%с&c."
                send "{@prefix} &cТы в бою — телепорт отменён." to {_invP}
                stop
            delete {duotpa_req::%{_u}%}
            delete {duotpa_req_time::%{_u}%}
            # Подтверждение обоим
            send "{@prefix} &aЗапрос принят. &e%{_invP}% &aтелепортируется через &f{@duotpa_warmup}с&a..." to player
            send "{@prefix} &a%player% &aпринял твой запрос! Телепорт через &f{@duotpa_warmup}с&a..." to {_invP}
            play sound "entity.experience_orb.pickup" at {_invP} for {_invP}
            # Запоминаем стартовую точку для отмены при движении
            set {duotpa_warm_loc::%{_inv}%} to location of {_invP}
            set {duotpa_warm_target::%{_inv}%} to {_u}
            set {duotpa_warm_until::%{_inv}%} to {_now} + {@duotpa_warmup}
            stop

        if arg-1 is "deny":
            if {duotpa_req::%{_u}%} is not set:
                send "{@prefix} &cНет активных запросов."
                stop
            set {_inv} to {duotpa_req::%{_u}%}
            delete {duotpa_req::%{_u}%}
            delete {duotpa_req_time::%{_u}%}
            set {_invP} to player from {_inv}
            send "{@prefix} &cЗапрос отклонён."
            if {_invP} is online:
                send "{@prefix} &c%player% отклонил твой запрос телепорта." to {_invP}
            stop

        if arg-1 is "cancel":
            # Отменить свой исходящий запрос (если ещё висит)
            set {_found} to false
            loop all players:
                set {_pid} to uuid of loop-player
                if {duotpa_req::%{_pid}%} is {_u}:
                    delete {duotpa_req::%{_pid}%}
                    delete {duotpa_req_time::%{_pid}%}
                    send "{@prefix} &7Запрос телепорта отменён." to player
                    send "{@prefix} &7%player% отменил запрос телепорта." to loop-player
                    set {_found} to true
            # Также отменить активный warmup
            if {duotpa_warm_until::%{_u}%} is set:
                delete {duotpa_warm_until::%{_u}%}
                delete {duotpa_warm_loc::%{_u}%}
                delete {duotpa_warm_target::%{_u}%}
                send "{@prefix} &7Телепортация отменена." to player
                set {_found} to true
            if {_found} is false:
                send "{@prefix} &cНечего отменять."
            stop

        # ----- запрос требует дуо и уровень -----
        if {_l} < 5:
            send "{@prefix} &cТелепорт к напарнику открывается с 5 уровня."
            stop
        if inDuo(player) is not true:
            send "{@prefix} &cУ тебя нет дуо. Создай дуо: &e/duo invite <ник>"
            stop
        set {_partner} to duoPartner(player)
        if {_partner} is offline:
            send "{@prefix} &cНапарник не онлайн."
            stop

        if arg-1 is not set:
            # Combat-log: запретить запрос ТП в бою
            if inCombat(player) is true:
                send "{@prefix} &cТы в бою — ТП недоступен ещё &e%combatLeft(player)%с&c."
                stop
            if inCombat({_partner}) is true:
                send "{@prefix} &cНапарник в бою — ТП недоступен ещё &e%combatLeft({_partner})%с&c."
                stop
            # Кулдаун инициатора
            set {_cd} to {duotpa_cd::%{_u}%} ? 0
            if {_now} < {_cd}:
                set {_left} to {_cd} - {_now}
                send action bar "&cТелепорт на КД ещё &e%{_left}%с" to player
                stop
            # Уже идёт warmup?
            if {duotpa_warm_until::%{_u}%} is set:
                send "{@prefix} &cТы уже телепортируешься. &e/duotpa cancel"
                stop
            # Уже есть исходящий запрос?
            if {duotpa_req::%uuid of {_partner}%} is {_u}:
                send "{@prefix} &cУ тебя уже есть активный запрос к этому игроку."
                stop
            set {duotpa_req::%uuid of {_partner}%} to {_u}
            set {duotpa_req_time::%uuid of {_partner}%} to {_now}
            send "{@prefix} &aЗапрос телепорта отправлен &e%{_partner}%&a. &7(истечёт через {@duotpa_request_ttl}с)"
            send "{@prefix} &7Отменить: &e/duotpa cancel"
            send "{@prefix} &e%player% &aпросит телепорт к тебе! &a/duotpa accept &8| &c/duotpa deny" to {_partner}
            play sound "entity.experience_orb.pickup" at {_partner} for {_partner}
            stop

        send "{@prefix} &cИспользование: &e/duotpa &7| &aaccept &7| &cdeny &7| &7cancel"

# ==========================================
# DUOTPA: WARMUP — каждую секунду тикает; телепорт срабатывает,
# когда warmup истекает. Отменяется при движении или получении урона.
# ==========================================
every 1 second:
    loop all players:
        set {_uu} to uuid of loop-player
        if {duotpa_warm_until::%{_uu}%} is set:
            set {_now} to unix timestamp of now
            set {_until} to {duotpa_warm_until::%{_uu}%}
            set {_left} to {_until} - {_now}
            # Проверка движения (более 0.5 блока от стартовой точки)
            set {_start} to {duotpa_warm_loc::%{_uu}%}
            if {_start} is set:
                if distance between location of loop-player and {_start} > 0.5:
                    delete {duotpa_warm_until::%{_uu}%}
                    delete {duotpa_warm_loc::%{_uu}%}
                    delete {duotpa_warm_target::%{_uu}%}
                    send "{@prefix} &cТелепорт прерван — ты сдвинулся!" to loop-player
                    play sound "block.note_block.bass" at loop-player for loop-player
                    stop
            # Время вышло — телепортируем
            if {_left} <= 0:
                set {_tid} to {duotpa_warm_target::%{_uu}%}
                delete {duotpa_warm_until::%{_uu}%}
                delete {duotpa_warm_loc::%{_uu}%}
                delete {duotpa_warm_target::%{_uu}%}
                set {_tgt} to player from {_tid}
                if {_tgt} is online:
                    teleport loop-player to {_tgt}
                    play sound "entity.enderman.teleport" at loop-player for all players
                    play sound "entity.enderman.teleport" at {_tgt} for all players
                    send action bar "&d&lТЕЛЕПОРТ К НАПАРНИКУ!" to loop-player
                    set {duotpa_cd::%{_uu}%} to {_now} + {@duotpa_cooldown}
                else:
                    send "{@prefix} &cНапарник вышел — телепорт отменён." to loop-player
            else:
                send action bar "&dТелепорт через &f%{_left}%с &7(не двигайся)" to loop-player

# Прервать warmup при получении урона
on damage:
    if victim is a player:
        set {_vid} to victim's uuid
        if {duotpa_warm_until::%{_vid}%} is set:
            delete {duotpa_warm_until::%{_vid}%}
            delete {duotpa_warm_loc::%{_vid}%}
            delete {duotpa_warm_target::%{_vid}%}
            send "{@prefix} &cТелепорт прерван — тебя ударили!" to victim
            play sound "block.note_block.bass" at victim for victim

# ===== COMBAT-LOG: тегировать обоих участников PvP =====
on damage:
    if attacker is a player:
        if victim is a player:
            if attacker is not victim:
                if areDuo(attacker, victim) is not true:
                    tagCombat(attacker)
                    tagCombat(victim)

# ===== COMBAT-LOG: смерть при выходе в бою =====
on quit:
    set {_qid} to player's uuid
    if inCombat(player) is true:
        kill player
        broadcast "{@prefix} &c&l%player% &cсбежал из боя и был убит!"
    delete {combat_until::%{_qid}%}
    delete {leg_warrior_air_last::%{_qid}%}
    delete {duotpa_warm_until::%{_qid}%}
    delete {duotpa_warm_loc::%{_qid}%}
    delete {duotpa_warm_target::%{_qid}%}
    delete {duotpa_req::%{_qid}%}
    delete {duotpa_req_time::%{_qid}%}
    # И снять входящие запросы от вышедшего игрока
    loop all players:
        set {_pid} to uuid of loop-player
        if {duotpa_req::%{_pid}%} is {_qid}:
            delete {duotpa_req::%{_pid}%}
            delete {duotpa_req_time::%{_pid}%}

# Снять combat-метку при смерти и при заходе
on death of player:
    delete {combat_until::%uuid of victim%}

on join:
    delete {combat_until::%player's uuid%}

# Оповещение об окончании combat-log
every 1 second:
    set {_now} to unix timestamp of now
    loop all players:
        set {_uid} to uuid of loop-player
        if {combat_until::%{_uid}%} is set:
            if {combat_until::%{_uid}%} <= {_now}:
                delete {combat_until::%{_uid}%}
                send action bar "&a&lБОЙ ОКОНЧЕН! &7Можно выходить и юзать ТП" to loop-player
                play sound "block.note_block.bell" with volume 0.6 and pitch 1.5 at loop-player for loop-player


# ==========================================
# СПОНСОРСКИЕ ПЛЮШКИ (Supporter)
# Один ранг для всех, кто поддержал проект.
# НИКАКИХ боевых преимуществ — только косметика и мелкое удобство.
#
# Управление (только OP):
#   /sponsor add <player>     — выдать
#   /sponsor remove <player>  — снять
#   /sponsor list             — список
#
# Плюшки игроку:
#   • Префикс ★ перед ником в чате
#   • /workbench (/wb)        — переносной верстак
#   • /hat                    — надеть предмет с руки на голову
#   • /trail [type|off]       — частицы под ногами при ходьбе
#   • /sponsorkit             — космет.набор: знамя, фейерверки, пластинка (КД 24ч)
# ==========================================

function isSponsor(p: player) :: boolean:
    if {sponsor::%uuid of {_p}%} is set:
        return true
    return false

function spCdLeft(p: player, key: text) :: number:
    set {_v} to {sponsor_cd::%uuid of {_p}%::%{_key}%} ? 0
    set {_now} to unix timestamp of now
    if {_v} > {_now}:
        return {_v} - {_now}
    return 0

function spSetCd(p: player, key: text, secs: number):
    set {sponsor_cd::%uuid of {_p}%::%{_key}%} to (unix timestamp of now) + {_secs}

function spFmtTime(s: number) :: text:
    if {_s} >= 3600:
        return "%floor({_s} / 3600)%ч %floor((mod({_s}, 3600)) / 60)%м"
    if {_s} >= 60:
        return "%floor({_s} / 60)%м %mod({_s}, 60)%с"
    return "%{_s}%с"

# ===== Префикс ★ в чате =====
on chat:
    set {_u} to player's uuid
    set {_cls} to classDisplayName(classOf(player))
    set {_lvl} to calcLevel(clampKills({kills::%{_u}%} ? 0))
    set {level::%{_u}%} to {_lvl}
    set {_title} to classTitle(classOf(player), {_lvl})
    if classOf(player) is "None":
        set {_chatPrefix} to "&8[&7Без класса&8] "
    else:
        set {_chatPrefix} to "&8[%{_title}%&8] "
    if isSponsor(player) is true:
        set {_chatPrefix} to "&6★ %{_chatPrefix}%"
    set chat format to "%{_chatPrefix}%&r<%player's display name%&r> %message%"

# ===== /sponsor (управление + просмотр) =====
command /sponsor [<text>] [<offline player>]:
    trigger:
        # Без аргументов — показать свой статус
        if arg-1 is not set:
            send "&8&l▬▬▬▬▬▬ &6&l★ СПОНСОР &8&l▬▬▬▬▬▬"
            if isSponsor(player) is true:
                send "&7Ты — &6&l★ Спонсор&7. Спасибо за поддержку!"
                send ""
                send "&7Доступные команды:"
                send "&e/workbench &8(или /wb) — мобильный верстак"
                send "&e/hat &8— предмет с руки на голову"
                send "&e/trail [type|off] &8— частицы под ногами"
                send "&e/sponsorkit &8— космет.набор &7(КД 24ч)"
                send ""
                send "&8Все плюшки чисто косметические — без боевого преимущества."
            else:
                send "&7Ты пока не спонсор."
                send "&8Поддержи проект, чтобы получить ★"
            stop

        # ===== Управление — только OP =====
        if player is not op:
            send "{@prefix} &cНет прав"
            stop

        if arg-1 is "add":
            if arg-2 is not set:
                send "{@prefix} &cИспользование: /sponsor add <player>"
                stop
            set {_target} to arg-2
            set {_uid} to "%uuid of {_target}%"
            if {_uid} is "<none>":
                send "{@prefix} &cИгрок &e%arg-2% &cне найден (никогда не заходил на сервер)"
                stop
            if {_uid} is "":
                send "{@prefix} &cНе удалось получить UUID игрока &e%arg-2%"
                stop
            set {sponsor::%{_uid}%} to true
            send "{@prefix} &a%arg-2% &7теперь &6★ Спонсор &8(uuid: %{_uid}%)"
            if {_target} is online:
                send "" to {_target}
                send "&8&l▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬" to {_target}
                send "&6&l★ ТЕБЕ ВЫДАН РАНГ СПОНСОРА!" to {_target}
                send "&7Спасибо за поддержку проекта" to {_target}
                send "&8Команды: &f/sponsor" to {_target}
                send "&8&l▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬" to {_target}
                play sound "ui.toast.challenge_complete" at {_target} for {_target}
                play sound "entity.player.levelup" with volume 1 and pitch 1.2 at {_target} for {_target}
            stop

        if arg-1 is "remove":
            if arg-2 is not set:
                send "{@prefix} &cИспользование: /sponsor remove <player>"
                stop
            set {_target} to arg-2
            set {_uid} to "%uuid of {_target}%"
            if {_uid} is "<none>":
                send "{@prefix} &cИгрок не найден"
                stop
            delete {sponsor::%{_uid}%}
            delete {sponsor_cd::%{_uid}%::*}
            delete {sponsor_trail::%{_uid}%}
            send "{@prefix} &cРанг снят с %arg-2%"
            if {_target} is online:
                send "&cТвой спонсорский ранг был снят" to {_target}
            stop

        if arg-1 is "list":
            send "&8&l▬▬▬▬ &6&l★ Спонсоры &8&l▬▬▬▬"
            set {_n} to 0
            loop {sponsor::*}:
                set {_pname} to loop-index parsed as offline player
                send "&7• %{_pname}%"
                add 1 to {_n}
            if {_n} is 0:
                send "&8(пусто)"
            stop

        # Подсказка
        send "{@prefix} &eИспользование:"
        send "&7/sponsor &8— твой статус"
        send "&c/sponsor add <player> &8(OP)"
        send "&c/sponsor remove <player> &8(OP)"
        send "&c/sponsor list &8(OP)"

# ===== /workbench — переносной верстак =====
command /workbench:
    aliases: /wb
    trigger:
        if isSponsor(player) is not true:
            send "{@prefix} &cТолько для спонсоров"
            stop
        open workbench inventory to player

# ===== /hat — предмет с руки на голову =====
command /hat:
    trigger:
        if isSponsor(player) is not true:
            send "{@prefix} &cТолько для спонсоров"
            stop
        if player's tool is air:
            send "{@prefix} &cВ руке ничего нет"
            stop
        set {_old} to player's helmet
        set player's helmet to player's tool
        if {_old} is set:
            set player's tool to {_old}
        else:
            set player's tool to air
        send "{@prefix} &eГотово — стиляга!"

# ===== /trail — космет.частицы под ногами =====
command /trail [<text>]:
    trigger:
        if isSponsor(player) is not true:
            send "{@prefix} &cТолько для спонсоров"
            stop
        if arg-1 is not set:
            send "&8&l▬▬ &6Частицы &8&l▬▬"
            send "&7Текущий: &e%{sponsor_trail::%player's uuid%} ? "off"%"
            send ""
            send "&7Доступные:"
            send "&8• &fheart &8• &fflame &8• &fnote &8• &fcrit"
            send "&8• &fend_rod &8• &fhappy &8• &fcloud &8• &fsoul"
            send "&8• &foff &7(выключить)"
            send "&8/trail <type>"
            stop
        set {_trailArg} to arg-1 in lower case
        if {_trailArg} is "off":
            delete {sponsor_trail::%player's uuid%}
            send "{@prefix} &7Частицы выключены"
            stop
        if {_trailArg} is not "heart":
            if {_trailArg} is not "flame":
                if {_trailArg} is not "note":
                    if {_trailArg} is not "crit":
                        if {_trailArg} is not "end_rod":
                            if {_trailArg} is not "happy":
                                if {_trailArg} is not "cloud":
                                    if {_trailArg} is not "soul":
                                        send "{@prefix} &cНеизвестный тип. /trail для списка"
                                        stop
        set {sponsor_trail::%player's uuid%} to {_trailArg}
        send "{@prefix} &eЧастицы: &f%{_trailArg}%"

# Рендер частиц — раз в 5 тиков (1/4 сек)
every 5 ticks:
    loop all players:
        set {_u} to loop-player's uuid
        if {sponsor_trail::%{_u}%} is set:
            set {_type} to {sponsor_trail::%{_u}%}
            set {_loc} to location of loop-player
            if {_type} is "heart":
                execute console command "particle minecraft:heart %x-coordinate of {_loc}% %y-coordinate of {_loc}% %z-coordinate of {_loc}% 0.2 0.3 0.2 0 1 force"
            else if {_type} is "flame":
                execute console command "particle minecraft:flame %x-coordinate of {_loc}% %y-coordinate of {_loc}% %z-coordinate of {_loc}% 0.15 0.05 0.15 0 3 force"
            else if {_type} is "note":
                execute console command "particle minecraft:note %x-coordinate of {_loc}% %y-coordinate of {_loc}% %z-coordinate of {_loc}% 0.3 0.1 0.3 0 1 force"
            else if {_type} is "crit":
                execute console command "particle minecraft:crit %x-coordinate of {_loc}% %y-coordinate of {_loc}% %z-coordinate of {_loc}% 0.2 0.2 0.2 0 4 force"
            else if {_type} is "end_rod":
                execute console command "particle minecraft:end_rod %x-coordinate of {_loc}% %y-coordinate of {_loc}% %z-coordinate of {_loc}% 0.12 0.12 0.12 0 2 force"
            else if {_type} is "happy":
                execute console command "particle minecraft:happy_villager %x-coordinate of {_loc}% %y-coordinate of {_loc}% %z-coordinate of {_loc}% 0.25 0.25 0.25 0 3 force"
            else if {_type} is "cloud":
                execute console command "particle minecraft:cloud %x-coordinate of {_loc}% %y-coordinate of {_loc}% %z-coordinate of {_loc}% 0.2 0.05 0.2 0 3 force"
            else if {_type} is "soul":
                execute console command "particle minecraft:soul %x-coordinate of {_loc}% %y-coordinate of {_loc}% %z-coordinate of {_loc}% 0.1 0.1 0.1 0 2 force"

# ===== /sponsorkit — чисто космет.набор (КД 24ч) =====
command /sponsorkit:
    aliases: /spkit
    trigger:
        if isSponsor(player) is not true:
            send "{@prefix} &cТолько для спонсоров"
            stop
        set {_left} to spCdLeft(player, "kit")
        if {_left} > 0:
            send "{@prefix} &cКД: &e%spFmtTime({_left})%"
            stop
        # Косметика — никакого боевого/прочного снаряжения
        give 4 firework rocket to player
        give 1 yellow banner to player
        give 1 red banner to player
        give 1 name tag to player
        give 1 music disc 13 to player
        give 1 painting to player
        give 4 cake to player
        spSetCd(player, "kit", 86400)
        send "{@prefix} &eПолучен спонсорский космет.набор!"
        play sound "ui.toast.challenge_complete" at player for player


# ---- Новые крафтабельные артефакты (инвентарь) ----
every 5 seconds:
    if {evo_faceless_team_ready} is not true:
        execute console command "team add evo_faceless"
        execute console command "team modify evo_faceless nametagVisibility never"
        set {evo_faceless_team_ready} to true
    loop all players:
        if hasArtifactItemInInventory(loop-player, "Портативный Нагреватель") is true:
            set {_t} to loop-player's tool
            if {_t} is beef:
                remove 1 beef from loop-player
                give 1 cooked beef to loop-player
            else if {_t} is porkchop:
                remove 1 porkchop from loop-player
                give 1 cooked porkchop to loop-player
            else if {_t} is chicken:
                remove 1 chicken from loop-player
                give 1 cooked chicken to loop-player
            else if {_t} is mutton:
                remove 1 mutton from loop-player
                give 1 cooked mutton to loop-player
            else if {_t} is rabbit:
                remove 1 rabbit from loop-player
                give 1 cooked rabbit to loop-player
            else if {_t} is cod:
                remove 1 cod from loop-player
                give 1 cooked cod to loop-player
            else if {_t} is salmon:
                remove 1 salmon from loop-player
                give 1 cooked salmon to loop-player

        set {_pu} to uuid of loop-player
        if hasArtifactItemInInventory(loop-player, "Маска Безликого") is true:
            if {evo_faceless_applied::%{_pu}%} is not true:
                execute console command "team join evo_faceless %loop-player%"
                set {evo_faceless_applied::%{_pu}%} to true
        else:
            if {evo_faceless_applied::%{_pu}%} is true:
                execute console command "team leave %loop-player%"
                delete {evo_faceless_applied::%{_pu}%}

on bed enter:
    if hasArtifactItemInInventory(player, "Ловец Снов") is true:
        set time in world of player to 6:00
        clear weather in world of player
        apply luck 1 without particles to player for 1200 seconds
        send action bar "&d&lЛОВЕЦ СНОВ: ночь мгновенно рассеялась" to player

on craft:
    if hasArtifactItemInInventory(player, "Квантовый Дубликатор") is true:
        set {_res} to event-item
        set {_blocked} to false
        set {_nm} to name of {_res}
        if {_nm} is set:
            if {_nm} contains "Алтар":
                set {_blocked} to true
            if {_nm} contains "Артефакт:":
                set {_blocked} to true
            if {_nm} contains "Легендарный артефакт:":
                set {_blocked} to true
        if {_blocked} is false:
            chance of 10%:
                wait 1 tick
                if {_res} is set:
                    give {_res} to player
                    send action bar "&b&lКВАНТОВЫЙ ДУБЛИКАТОР: +1 копия!" to player

# Сердце Пустыни и Дар Проклятого Короля
on death of player:
    set {_vu} to victim's uuid
    loop all players:
        if hasArtifactItemInInventory(loop-player, "Дар Проклятого Короля") is true:
            if loop-player is not victim:
                if distance between loop-player and victim <= 10:
                    if areDuo(loop-player, victim) is true:
                        set {_ou} to uuid of loop-player
                        set {_cd} to {cursedgift_cd::%{_ou}%::%{_vu}%} ? 0
                        if {_cd} <= unix timestamp of now:
                            set {_lv} to {level::%{_ou}%} ? 1
                            if {_lv} > 10:
                                set {cursedgift_cd::%{_ou}%::%{_vu}%} to (unix timestamp of now) + 300
                                set {cursedgift_pending::%{_vu}%} to {_ou}
                                set {level::%{_ou}%} to {_lv} - 10
                                set {kills::%{_ou}%} to ({level::%{_ou}%} - 1) * {@kills_per_level}
                                send action bar "&4Дар Проклятого Короля: -10 уровней" to loop-player
                                exit loop

on respawn:
    set {_vu} to player's uuid
    if {cursedgift_pending::%{_vu}%} is set:
        set {_ou} to {cursedgift_pending::%{_vu}%}
        delete {cursedgift_pending::%{_vu}%}
        set {_owner} to player from {_ou}
        if {_owner} is online:
            teleport player to {_owner}
            set health of player to 2
            send title "&4&lВОСКРЕШЕНИЕ" with subtitle "&7Дар Проклятого Короля" to player for 2 seconds
            send action bar "&cСоюзник воскрешён рядом" to {_owner}

every 2 ticks:
    loop all players:
        if hasArtifactItemInInventory(loop-player, "Сердце Пустыни") is true:
            loop blocks in radius 5 around loop-player:
                if loop-block is water:
                    set {_ploc} to location of loop-block
                    set loop-block to air
                    execute console command "particle minecraft:cloud %x-coordinate of {_ploc}% %y-coordinate of {_ploc}% %z-coordinate of {_ploc}% 0.2 0.2 0.2 0.01 8 force"
            loop all living entities in radius 3 around loop-player:
                set {_target} to loop-entity-1
                if {_target} is a player:
                    if uuid of {_target} is uuid of loop-player:
                        continue
                    if areDuo(loop-player, {_target}) is true:
                        continue
                apply hunger 1 without particles to {_target} for 3 seconds
                apply wither 1 without particles to {_target} for 2 seconds

# ---- Древние свитки ----
function initAncientScrollRecipes():
    delete {ancient_scroll_recipes::*}
    set {ancient_scroll_recipes::heater::name} to "Портативный Нагреватель"
    set {ancient_scroll_recipes::heater::tier} to "medium"
    set {ancient_scroll_recipes::heater::ing::*} to "Печка", "Огненный порошок", "Медный блок", "Уголь", "Слиток железа"
    set {ancient_scroll_recipes::dreamcatcher::name} to "Ловец Снов"
    set {ancient_scroll_recipes::dreamcatcher::tier} to "medium"
    set {ancient_scroll_recipes::dreamcatcher::ing::*} to "Нить", "Паутина", "Светокаменная пыль", "Перо", "Золотой самородок"
    set {ancient_scroll_recipes::desertheart::name} to "Сердце Пустыни"
    set {ancient_scroll_recipes::desertheart::tier} to "medium"
    set {ancient_scroll_recipes::desertheart::ing::*} to "Кактус", "Песок душ", "Огненный порошок", "Золотой слиток", "Кремень"
    set {ancient_scroll_recipes::quantdup::name} to "Квантовый Дубликатор"
    set {ancient_scroll_recipes::quantdup::tier} to "medium"
    set {ancient_scroll_recipes::quantdup::ing::*} to "Раздатчик", "Аметист", "Медный слиток", "Редстоун блок", "Светокаменная пыль"
    set {ancient_scroll_recipes::facelessmask::name} to "Маска Безликого"
    set {ancient_scroll_recipes::facelessmask::tier} to "medium"
    set {ancient_scroll_recipes::facelessmask::ing::*} to "Кожа", "Белая шерсть", "Зелье невидимости", "Чернильный мешок", "Золотой слиток"
    set {ancient_scroll_recipes::cursedgift::name} to "Дар Проклятого Короля"
    set {ancient_scroll_recipes::cursedgift::tier} to "absolute"
    set {ancient_scroll_recipes::cursedgift::ing::*} to "Посох Некро-Тирана", "Корона Высшего Разума", "Зачарованное золотое яблоко", "Голова игрока", "Слиток незерита"

function ancientScrollItem(id: text) :: item:
    set {_n} to {ancient_scroll_recipes::%{_id}%::name}
    if {_n} is not set:
        return air
    set {_it} to paper named "&6Древний Свиток: %{_n}%"
    enchant {_it} with unbreaking 1
    set lore of {_it} to "&7Нажмите ПКМ, чтобы изучить рецепт."
    return {_it}

function ancientScrollIdFromItem(i: item) :: text:
    set {_nm} to name of {_i}
    if {_nm} is not set:
        return ""
    loop "heater", "dreamcatcher", "desertheart", "quantdup", "facelessmask" and "cursedgift":
        set {_n} to {ancient_scroll_recipes::%loop-value%::name}
        if {_n} is set:
            if {_nm} contains {_n}:
                return loop-value
    return ""

function isRuinDimension(w: world) :: boolean:
    set {_wn} to "%{_w}%" in lower case
    if {_wn} contains "руин":
        return true
    if {_wn} contains "ruin":
        return true
    return false

on load:
    initAncientScrollRecipes()

on right click:
    if player's tool is paper:
        set {_sid} to ancientScrollIdFromItem(player's tool)
        if {_sid} is not "":
            cancel event
            set {_name} to {ancient_scroll_recipes::%{_sid}%::name}
            send title "&6Древний Свиток" with subtitle "&f%{_name}%" to player for 2 seconds
            send "{@prefix} &6Рецепт артефакта: &f%{_name}%" to player
            loop {ancient_scroll_recipes::%{_sid}%::ing::*}:
                send "&8 • &f%loop-value%" to player
            execute console command "particle minecraft:spell %x-coordinate of player% %y-coordinate of player% %z-coordinate of player% 0.4 0.6 0.4 0.03 25 force"
            play sound "block.enchantment_table.use" with volume 1 and pitch 1 at player for player
            remove 1 of player's tool from player
            stop

on death:
    if victim is not a player:
        if isRuinDimension(world of victim) is true:
            chance of 0.5%:
                set {_as} to ancientScrollItem("cursedgift")
                if {_as} is not air:
                    drop {_as} at location of victim
            else:
                chance of 2%:
                    set {_mid::*} to "heater", "dreamcatcher", "desertheart", "quantdup" and "facelessmask"
                    set {_pick} to random element out of {_mid::*}
                    set {_ms} to ancientScrollItem({_pick})
                    if {_ms} is not air:
                        drop {_ms} at location of victim
