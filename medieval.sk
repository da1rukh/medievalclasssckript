# Наковальня: классовые предметы (PrepareAnvil в Skript нельзя cancel — блокируем клики по слотам 1 и 2)
on inventory click:
    if event-inventory is set:
        if type of event-inventory is anvil inventory:
            if clicked inventory is event-inventory:
                set {_av0} to slot 0 of event-inventory
                set {_av1} to slot 1 of event-inventory
                set {_anvilBad} to false
                if isClassItem({_av0}) is true:
                    set {_anvilBad} to true
                if isClassItem({_av1}) is true:
                    set {_anvilBad} to true
                if {_anvilBad} is true:
                    set {_as} to index of event-slot
                    if {_as} is not set:
                        set {_as} to clicked slot
                    # слот 0 — можно только забрать/положить базовый предмет; слоты 1–2 — книга/имя/результат
                    if {_as} is 1:
                        cancel event
                        send "{@prefix} &cКлассовые предметы нельзя зачаровать или менять на наковальне." to player
                        stop
                    if {_as} is 2:
                        cancel event
                        send "{@prefix} &cКлассовые предметы нельзя зачаровать или менять на наковальне." to player
                        stop

# ==========================================
# SCOUT L25: Иммунитет к падению
# ==========================================
# ==========================================
# GUI ВЫБОРА КЛАССА
# ==========================================
command /wstats:
    aliases: /weapons, /wlvl
    trigger:
        set {_u} to player's uuid
        send "&8&l------ &6Уровни Оружия &8&l------"
        loop "sword", "axe", "bow" and "mace":
            set {_t} to loop-value
            set {_lvl} to {wlvl::%{_u}%::%{_t}%} ? 1
            set {_xp} to {wxp::%{_u}%::%{_t}%} ? 0
            set {_need} to wXPNeeded({_lvl})
            set {_bonus} to ({_lvl} - 1) * 6
            if {_lvl} >= wMaxLevel():
                send "%weaponName({_t})% &8» &eLv &6%{_lvl}% &8(MAX) &8| &a+%{_bonus}%%% урона"
            else:
                send "%weaponName({_t})% &8» &eLv &a%{_lvl}% &8| &b%{_xp}%&7/%{_need}% XP &8| &a+%{_bonus}%%%"
        # Урон от оружия в руке
        set {_curTool} to player's tool
        set {_tt} to weaponType({_curTool})
        if {_tt} is not "none":
            set {_eff} to effectiveDamage(player, {_curTool})
            set {_base} to baseDamage({_curTool})
            send " "
            send "&7В руке: &f%{_curTool}%"
            send "&7База &f%{_base}% &8→ &7Итого &c%{_eff}% &7урона"
        else if {_curTool} is blaze rod:
            if classOf(player) is "Mage":
                set {_eff} to effectiveDamage(player, blaze rod)
                send " "
                send "&7В руке: &dПосох Мага"
                send "&7Урон: &c%{_eff}% &8+ &c2 сек огня"
        send "&8&l-------------------------------"

command /class:
    trigger:
        set {_u} to player's uuid
        if {class::%{_u}%} is set:
            if {class::%{_u}%} is not "None":
                if {class_lock::%{_u}%} is not true:
                    if {level::%{_u}%} < {@max_level}:
                        send "{@prefix} &cСмена класса доступна только на макс. уровне!"
                        stop

        open chest inventory with 3 rows named "&8Choose your Class" to player
        loop 27 times:
            set slot (loop-number - 1) of player's current inventory to gray stained glass pane named " "

        set slot 9 of player's current inventory to iron sword named "&c&lWarrior"
        set lore of slot 9 of player's current inventory to "&7Танк-DPS ближнего боя" and " " and "&8• &fДуал-меч (одинаковый материал = +скорость атаки)" and "&8• &fСила при низком ❤" and "&8• &fПарирование на L20 (возврат урона)"

        set slot 10 of player's current inventory to feather named "&b&lScout"
        set lore of slot 10 of player's current inventory to "&7Мобильный убийца" and " " and "&8• &fSpeed I пассивно" and "&8• &fКрит в спину +25%%" and "&8• &fРывок на L5" and "&8• &fИнвиз на L10" and "&8• &fИммунитет к падению L25"

        set slot 11 of player's current inventory to shield named "&6&lTank"
        set lore of slot 11 of player's current inventory to "&7Защитник команды" and " " and "&8• &fL25: &f20 ❤ &7макс." and "&8• &fДо L25: &f10 ❤ &7как у всех" and "&8• &f-15%% получ. урона" and "&8• &fШипы ½❤ на L10" and "&8• &fАура защитника L15"

        set slot 12 of player's current inventory to bow named "&e&lArcher"
        set lore of slot 12 of player's current inventory to "&7Урон с дистанции" and " " and "&8• &fSpeed I пассивно" and "&8• &f+10%% урона луком" and "&8• &f25%% крит x2 на L5" and "&8• &fx1.4 урон на L10" and "&8• &fОрлиный взор L25"

        set slot 13 of player's current inventory to blaze rod named "&d&lMage"
        set lore of slot 13 of player's current inventory to "&7Магия и поддержка" and " " and "&8• &fФаербол с L1" and "&8• &fРеген после килла" and "&8• &fМасс-хил на L10" and "&8• &fЭндер-перл L15" and "&8• &fБольшой фаербол L25"

        set slot 14 of player's current inventory to bone named "&2&lNecromancer"
        set lore of slot 14 of player's current inventory to "&7Повелитель мёртвых" and " " and "&8• &fПризыв миньона (КД 30с)" and "&8• &fКостяной молот + Кража жизни" and "&8• &fМетка смерти (L5) +20%% урона" and "&8• &fДуша мстителя (L15)" and "&8• &fАура смерти Wither (L20)" and "&8• &fВосставший чемпион (L25)"

        # ===== Плейсхолдеры под будущие классы (справа подряд) =====
        set slot 15 of player's current inventory to barrier named "&8&l? ? ?"
        set lore of slot 15 of player's current inventory to "&7Слот под &fновый класс" and " " and "&8Скоро..."

        set slot 16 of player's current inventory to barrier named "&8&l? ? ?"
        set lore of slot 16 of player's current inventory to "&7Слот под &fновый класс" and " " and "&8Скоро..."

        set slot 17 of player's current inventory to barrier named "&8&l? ? ?"
        set lore of slot 17 of player's current inventory to "&7Слот под &fновый класс" and " " and "&8Скоро..."


on inventory click:
    if name of event-inventory is "&8Choose your Class":
        cancel event
        if clicked inventory is player's current inventory:
            set {_n} to "None"
            if index of event-slot is 9:
                set {_n} to "Warrior"
            else if index of event-slot is 10:
                set {_n} to "Scout"
            else if index of event-slot is 11:
                set {_n} to "Tank"
            else if index of event-slot is 12:
                set {_n} to "Archer"
            else if index of event-slot is 13:
                set {_n} to "Mage"
            else if index of event-slot is 14:
                set {_n} to "Necromancer"

            if {_n} is not "None":
                if evoAdminClassDisabled({_n}) is true:
                    send "{@prefix} &cКласс &f%{_n}% &cотключён администратором." to player
                    play sound "entity.villager.no" with volume 0.8 and pitch 1 at player for player
                    stop
                set {class::%player's uuid%} to {_n}
                set {class_lock::%player's uuid%} to false
                set {level::%player's uuid%} to 1
                set {kills::%player's uuid%} to 0
                delete {perk::%player's uuid%}
                delete {perk_notified::%player's uuid%}
                close player's inventory
                send "{@prefix} &aВы выбрали: &l%{_n}%"
                giveClassKit(player)


# --- Модули: medieval-altar.sk (алтарь), medieval-commands.sk (команды/init) ---

