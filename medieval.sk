function artifactKeyFromItemName(n: text) :: text:
    if {_n} contains "Печать Пространственного Разреза":
        return "leg_warrior"
    else if {_n} contains "Тень Фантома":
        return "leg_scout"
    else if {_n} contains "Якорь Мироздания":
        return "leg_tank"
    else if {_n} contains "Око Хищника":
        return "leg_archer"
    else if {_n} contains "Эфирный Разум":
        return "leg_mage"
    else if {_n} contains "Амулет Гнилого Родства":
        return "leg_necro"
    else if {_n} contains "Сапоги Гермеса":
        return "hermes"
    else if {_n} contains "Кольцо Ветра":
        return "windring"
    else if {_n} contains "Амулет вампира":
        return "vampcharm"
    else if {_n} contains "Эфирный рывок":
        return "etherdash"
    else if {_n} contains "Бритва Мерунеса":
        return "mehrunes"
    else if {_n} contains "Звёздная ярость":
        return "starfury"
    else if {_n} contains "Счастливая подкова":
        return "cloudjump"
    else if {_n} contains "Воздушный шарик":
        return "cloudjump"
    else if {_n} contains "Ледяной след":
        return "icewalker"
    else if {_n} contains "Сердце ледяного великана":
        return "frostheart"
    else if {_n} contains "Щит Анх":
        return "ankhshield"
    else if {_n} contains "Звезда Азуры":
        return "azura"
    else if {_n} contains "Гнилое яблоко":
        return "rottenapple"
    else if {_n} contains "Компас Пустоты":
        return "voidcompass"
    else if {_n} contains "Монета удачи":
        return "luckcoin"
    else if {_n} contains "Корона Высшего Разума":
        return "crownmind"
    return ""

function artifactDesc(k: text) :: texts:
    delete {_d::*}
    if {_k} is "leg_warrior":
        add "&6Легендарный (Warrior): длинный красный луч и бонус при ударе мечом/буловой" to {_d::*}
        add "&7ЛКМ по воздуху — красные частицы вдоль взгляда; удар по мобу — +40%%." to {_d::*}
        add "&740%% урона по существу летит лезвием до 10 блоков." to {_d::*}
    else if {_k} is "leg_scout":
        add "&6Легендарный (Scout): шанс 25%% игнорировать удар" to {_d::*}
        add "&7Даёт Invisibility + Speed III на 3с. КД 8с." to {_d::*}
    else if {_k} is "leg_tank":
        add "&6Легендарный (Tank): аура давления вблизи" to {_d::*}
        add "&71❤/с рядом с танком + волна при падении без урона." to {_d::*}
    else if {_k} is "leg_archer":
        add "&6Легендарный (Archer): автоаим стрел" to {_d::*}
        add "&7Стрелы мягко доворачиваются к ближней цели." to {_d::*}
    else if {_k} is "leg_mage":
        add "&6Легендарный (Mage): инверсия дебаффов" to {_d::*}
        add "&7Wither -> Regen, Slowness -> Speed, Weakness -> Strength." to {_d::*}
    else if {_k} is "leg_necro":
        add "&6Легендарный (Necromancer): нежить не атакует первой" to {_d::*}
        add "&7Следует за хозяином и фокусит его цель. Пассивная регенерация от смерти." to {_d::*}
    else if {_k} is "hermes":
        add "&7Пассивно: постоянный &fSpeed II" to {_d::*}
        add "&7Работает, пока артефакт включён в ядре." to {_d::*}
    else if {_k} is "windring":
        add "&7Пассивно: &a+15%% урона и Speed I" to {_d::*}
        add "&7Цена: быстрее тратится голод." to {_d::*}
    else if {_k} is "vampcharm":
        add "&7Пассивно лечит от части твоего урона" to {_d::*}
        add "&7Работает от любых обычных ударов." to {_d::*}
    else if {_k} is "etherdash":
        add "&7При уроне от сущности: короткий эфирный телепорт" to {_d::*}
        add "&7Текущий урон полностью отменяется. КД: 20с." to {_d::*}
    else if {_k} is "mehrunes":
        add "&7Шанс &c13.33%% &7казнить цель (кроме боссов/игроков)" to {_d::*}
        add "&7Срабатывает от любого твоего удара." to {_d::*}
    else if {_k} is "starfury":
        add "&7Шанс кометы: визуальная молния и поджог" to {_d::*}
        add "&7Основная цель получает двойной урон." to {_d::*}
    else if {_k} is "icewalker":
        add "&7Постоянно создаёт временные ледяные блоки под тобой" to {_d::*}
        add "&7На воздухе/воде/лаве, с откатом через 35 тиков." to {_d::*}
    else if {_k} is "frostheart":
        add "&7При получении урона атакер замедляется" to {_d::*}
        add "&7Контроль милишников." to {_d::*}
    else if {_k} is "ankhshield":
        add "&7Иммун к Poison / Slowness / Weakness" to {_d::*}
        add "&7Постоянная анти-контроль защита." to {_d::*}
    else if {_k} is "azura":
        add "&7Убийства заряжают звезду (до 200)" to {_d::*}
        add "&7Пассивно конвертит заряд в опыт при пороге." to {_d::*}
    else if {_k} is "rottenapple":
        add "&7x2 урон по нейтральным животным" to {_d::*}
        add "&7Фарм-артефакт." to {_d::*}
    else if {_k} is "voidcompass":
        add "&7Пассивно сохраняет место смерти" to {_d::*}
        add "&7Даёт аварийный возврат (внутренний КД)." to {_d::*}
    else if {_k} is "luckcoin":
        add "&7Шанс 25%% на бонусный ресурс с убийства" to {_d::*}
        add "&7Экономический буст." to {_d::*}
    else if {_k} is "cloudjump":
        add "&7Воздушный шарик: двойной прыжок в воздухе" to {_d::*}
        add "&7и гашение урона от падения после подброса." to {_d::*}
    else if {_k} is "crownmind":
        add "&7Корона Высшего Разума: х3 опыт из всех источников" to {_d::*}
        add "&7Все твои зачарования работают как будто на +1 уровень." to {_d::*}
    else:
        add "&7Описание отсутствует." to {_d::*}
    return {_d::*}

function artifactMenuItem(p: player, s: number) :: item:
    set {_it} to artifactFromSlot({_s})
    if {_it} is air:
        return air
    set {_k} to artifactKeyFromSlot({_s})
    set {_u} to uuid of {_p}
    set {_owned} to {art_found::%{_u}%::%{_k}%} ? false
    set {_on} to {art_enabled::%{_u}%::%{_k}%} ? false
    set {_baseName} to name of {_it}
    if {_owned} is false:
        set name of {_it} to "&8[НЕ НАЙДЕН] %{_baseName}%"
        set lore of {_it} to artifactDesc({_k})
        add " " to lore of {_it}
        add "&7Сначала найди этот артефакт" to lore of {_it}
        add "&8Статус: &cне найден" to lore of {_it}
    else if {_on} is true:
        set name of {_it} to "&a[ON] %{_baseName}%"
        set lore of {_it} to artifactDesc({_k})
        add " " to lore of {_it}
        add "&7Статус: &aвключен" to lore of {_it}
        add "&7ПКМ: выключить" to lore of {_it}
        add "&7ЛКМ: извлечь в предмет" to lore of {_it}
    else:
        set name of {_it} to "&c[OFF] %{_baseName}%"
        set lore of {_it} to artifactDesc({_k})
        add " " to lore of {_it}
        add "&7Статус: &cвыключен" to lore of {_it}
        add "&7ПКМ: включить" to lore of {_it}
        add "&7ЛКМ: извлечь в предмет" to lore of {_it}
    return {_it}

function isEvoDebug(p: player) :: boolean:
    if {evo_debug::%uuid of {_p}%} is true:
        return true
    return false

function dbgEvo(p: player, msg: text):
    if isEvoDebug({_p}) is true:
        send "{@prefix} &8[DBG] %{_msg}%" to {_p}

# --- Руины с артефактами (редкий спавн в мире): много сундуков, стражи; на всю руину ровно 1 артефакт (главный сундук) ---
function artifactRuinLegendaryRandomArtifact() :: item:
    set {_leg::*} to 0, 1, 2, 6, 7 and 8
    set {_pick} to random element out of {_leg::*}
    return artifactFromSlot({_pick})

function artifactRuinCommonArtifactRandom() :: item:
    set {_pool::*} to 10, 11, 12, 13, 14, 15, 16, 19, 20, 21, 22, 23, 24, 25 and 26
    set {_pick} to random element out of {_pool::*}
    return artifactFromSlot({_pick})

# Только ресурсы; артефактов здесь нет. modest / boss_common — для обычных руин (слабее), boss / rich — для легендарных
function artifactRuinLootMaterialsOnly(tier: text) :: item:
    if {_tier} is "modest":
        set {_rw} to random integer between 1 and 100
        if {_rw} <= 30:
            set {_it} to iron ingot
            set amount of {_it} to random integer between 2 and 10
            return {_it}
        if {_rw} <= 52:
            set {_it} to gold ingot
            set amount of {_it} to random integer between 2 and 6
            return {_it}
        if {_rw} <= 66:
            set {_it} to emerald
            set amount of {_it} to random integer between 1 and 4
            return {_it}
        if {_rw} <= 76:
            set {_it} to diamond
            set amount of {_it} to random integer between 1 and 2
            return {_it}
        if {_rw} <= 86:
            set {_it} to coal
            set amount of {_it} to random integer between 6 and 20
            return {_it}
        if {_rw} <= 93:
            set {_it} to experience bottle
            set amount of {_it} to random integer between 2 and 7
            return {_it}
        if {_rw} <= 97:
            set {_it} to golden apple
            set amount of {_it} to 1
            return {_it}
        return bread
    if {_tier} is "boss_common":
        set {_rw} to random integer between 1 and 100
        set {_rw} to {_rw} - 5
        if {_rw} < 1:
            set {_rw} to 1
        if {_rw} <= 22:
            set {_it} to diamond
            set amount of {_it} to random integer between 1 and 3
            return {_it}
        if {_rw} <= 40:
            set {_it} to emerald
            set amount of {_it} to random integer between 2 and 6
            return {_it}
        if {_rw} <= 56:
            set {_it} to gold ingot
            set amount of {_it} to random integer between 3 and 10
            return {_it}
        if {_rw} <= 66:
            set {_it} to ancient debris
            set amount of {_it} to 1
            return {_it}
        if {_rw} <= 74:
            set {_it} to netherite scrap
            set amount of {_it} to random integer between 1 and 2
            return {_it}
        if {_rw} <= 86:
            set {_it} to experience bottle
            set amount of {_it} to random integer between 4 and 12
            return {_it}
        if {_rw} <= 94:
            set {_it} to golden apple
            set amount of {_it} to 1
            return {_it}
        return iron ingot
    set {_rw} to random integer between 1 and 100
    if {_tier} is "boss":
        set {_rw} to {_rw} - 12
    else if {_tier} is "rich":
        set {_rw} to {_rw} - 5
    if {_rw} < 1:
        set {_rw} to 1
    if {_rw} <= 20:
        set {_it} to diamond
        set amount of {_it} to random integer between 1 and 5
        return {_it}
    if {_rw} <= 36:
        set {_it} to emerald
        set amount of {_it} to random integer between 3 and 10
        return {_it}
    if {_rw} <= 50:
        set {_it} to gold ingot
        set amount of {_it} to random integer between 4 and 14
        return {_it}
    if {_rw} <= 60:
        set {_it} to ancient debris
        set amount of {_it} to random integer between 1 and 2
        return {_it}
    if {_rw} <= 70:
        set {_it} to netherite scrap
        set amount of {_it} to random integer between 1 and 3
        return {_it}
    if {_rw} <= 84:
        set {_it} to experience bottle
        set amount of {_it} to random integer between 6 and 16
        return {_it}
    if {_rw} <= 94:
        return enchanted golden apple
    set {_it} to golden apple
    set amount of {_it} to random integer between 1 and 2
    return {_it}

function artifactRuinFillChest(loc: location, tier: text):
    set {_b} to block at {_loc}
    set {_fp} to 34
    if {_tier} is "boss_common":
        set {_fp} to 26
    else if {_tier} is "modest":
        set {_fp} to 24
    loop 27 times:
        set {_sl} to loop-number - 1
        set {_rn} to random integer between 1 and 100
        if {_rn} <= {_fp}:
            set slot {_sl} of inventory of {_b} to artifactRuinLootMaterialsOnly({_tier})

function artifactRuinFillChestBoss(loc: location, kind: text):
    if {_kind} is "legendary":
        artifactRuinFillChest({_loc}, "boss")
    else:
        artifactRuinFillChest({_loc}, "boss_common")
    set {_b} to block at {_loc}
    if {_kind} is "legendary":
        set slot 13 of inventory of {_b} to artifactRuinLegendaryRandomArtifact()
    else:
        set slot 13 of inventory of {_b} to artifactRuinCommonArtifactRandom()

function artifactRuinRandomKind() :: text:
    set {_lp} to "{@artifact_ruin_legendary_chance_percent}" parsed as number
    if {_lp} is not set:
        set {_lp} to 14
    if {_lp} < 1:
        return "common"
    if {_lp} > 100:
        set {_lp} to 100
    set {_r} to random integer between 1 and 100
    if {_r} <= {_lp}:
        return "legendary"
    return "common"

function artifactRuinSpawnGuards(cx: number, cz: number, w: world, kind: text):
    if {_kind} is "legendary":
        loop 10 times:
            set {_gx} to {_cx} + random integer between -9 and 9
            set {_gz} to {_cz} + random integer between -9 and 9
            set {_gsy} to artifactRuinSurfaceY({_gx}, {_gz}, {_w})
            if {_gsy} > -90:
                spawn a vindicator at location at {_gx}, {_gsy} + 1, {_gz} in {_w}
                set name of last spawned entity to "&6&lСтраж реликвии"
        chance of 78%:
            set {_gx} to {_cx} + random integer between -4 and 8
            set {_gz} to {_cz} + random integer between -4 and 4
            set {_gsy} to artifactRuinSurfaceY({_gx}, {_gz}, {_w})
            if {_gsy} > -90:
                spawn an evoker at location at {_gx}, {_gsy} + 1, {_gz} in {_w}
                set name of last spawned entity to "&4&lХранитель эха"
    else:
        loop 7 times:
            set {_gx} to {_cx} + random integer between -9 and 9
            set {_gz} to {_cz} + random integer between -9 and 9
            set {_gsy} to artifactRuinSurfaceY({_gx}, {_gz}, {_w})
            if {_gsy} > -90:
                spawn a vindicator at location at {_gx}, {_gsy} + 1, {_gz} in {_w}
                set name of last spawned entity to "&4&lСтраж руин"
        chance of 55%:
            set {_gx} to {_cx} + random integer between -4 and 8
            set {_gz} to {_cz} + random integer between -4 and 4
            set {_gsy} to artifactRuinSurfaceY({_gx}, {_gz}, {_w})
            if {_gsy} > -90:
                spawn an evoker at location at {_gx}, {_gsy} + 1, {_gz} in {_w}
                set name of last spawned entity to "&5&lКапитан стражи"

# Одна палитра на всю руину: ковры одного цвета, «граффити» — только родственные оттенки
function artifactRuinCarpetForTheme(t: number) :: item:
    if {_t} is 1:
        return red carpet
    if {_t} is 2:
        return light blue carpet
    if {_t} is 3:
        return purple carpet
    if {_t} is 4:
        return yellow carpet
    return lime carpet

function artifactRuinAccentPaint(t: number) :: item:
    set {_r} to random integer between 1 and 3
    if {_t} is 1:
        if {_r} is 1:
            return red concrete
        if {_r} is 2:
            return orange concrete
        return red terracotta
    if {_t} is 2:
        if {_r} is 1:
            return cyan concrete
        if {_r} is 2:
            return light blue concrete
        return blue concrete
    if {_t} is 3:
        if {_r} is 1:
            return purple concrete
        if {_r} is 2:
            return magenta concrete
        return purple terracotta
    if {_t} is 4:
        if {_r} is 1:
            return yellow concrete
        if {_r} is 2:
            return orange concrete
        return yellow terracotta
    if {_t} is 5:
        if {_r} is 1:
            return lime concrete
        if {_r} is 2:
            return green concrete
        return green terracotta
    return lime concrete

function artifactRuinFloorPieceThemed(t: number) :: item:
    set {_r} to random integer between 1 and 100
    if {_r} <= 21:
        return cobbled deepslate
    if {_r} <= 39:
        return deepslate tiles
    if {_r} <= 54:
        return cracked deepslate tiles
    if {_r} <= 69:
        return polished deepslate
    if {_r} <= 80:
        return deepslate bricks
    if {_r} <= 88:
        return moss block
    if {_r} <= 93:
        return artifactRuinAccentPaint({_t})
    return gravel

function artifactRuinCenterFloor() :: item:
    set {_r} to random integer between 1 and 100
    if {_r} <= 42:
        return crying obsidian
    if {_r} <= 73:
        return cracked deepslate bricks
    return lodestone

# Вариант «легендарной руины»: тёмный камень; обычная — прежний тематический сланец
function artifactRuinFloorPieceForKind(t: number, kind: text) :: item:
    if {_kind} is "legendary":
        set {_r} to random integer between 1 and 100
        if {_r} <= 26:
            return polished blackstone
        if {_r} <= 46:
            return blackstone
        if {_r} <= 64:
            return cracked polished blackstone bricks
        if {_r} <= 77:
            return gilded blackstone
        if {_r} <= 90:
            return deepslate tiles
        return polished deepslate
    return artifactRuinFloorPieceThemed({_t})

function artifactRuinCenterFloorForKind(kind: text) :: item:
    if {_kind} is "legendary":
        set {_r} to random integer between 1 and 100
        if {_r} <= 38:
            return crying obsidian
        if {_r} <= 68:
            return ancient debris
        if {_r} <= 88:
            return netherite block
        return lodestone
    return artifactRuinCenterFloor()

function artifactRuinPillarPieceForKind(t: number, kind: text) :: item:
    if {_kind} is "legendary":
        set {_r} to random integer between 1 and 100
        if {_r} <= 28:
            return blackstone
        if {_r} <= 52:
            return polished blackstone
        if {_r} <= 72:
            return deepslate bricks
        if {_r} <= 88:
            return gilded blackstone
        return polished deepslate
    return artifactRuinPillarPieceThemed({_t})

function artifactRuinCarpetForKind(t: number, kind: text) :: item:
    if {_kind} is "legendary":
        set {_r} to random integer between 1 and 3
        if {_r} is 1:
            return purple carpet
        if {_r} is 2:
            return black carpet
        return gray carpet
    return artifactRuinCarpetForTheme({_t})

function artifactRuinTowerPadForKind(kind: text) :: item:
    if {_kind} is "legendary":
        return polished blackstone
    return deepslate bricks

function artifactRuinPillarPieceThemed(t: number) :: item:
    set {_r} to random integer between 1 and 100
    if {_r} <= 24:
        return polished deepslate
    if {_r} <= 46:
        return deepslate bricks
    if {_r} <= 62:
        return cracked deepslate bricks
    if {_r} <= 71:
        return blackstone
    return artifactRuinAccentPaint({_t})

function artifactRuinSurfaceY(wx: number, wz: number, w: world) :: number:
    set {_probe} to location at {_wx}, 320, {_wz} in {_w}
    set {_top} to highest solid block at {_probe}
    if {_top} is not set:
        return -999
    return y-coordinate of location of {_top}

function artifactRuinTerrainTooSteep(cx: number, cz: number, rad: number, w: world) :: boolean:
    set {_minSy} to 500
    set {_maxSy} to -500
    set {_ox} to 0 - {_rad}
    while {_ox} <= {_rad}:
        set {_oz} to 0 - {_rad}
        while {_oz} <= {_rad}:
            set {_lx} to {_cx} + {_ox}
            set {_lz} to {_cz} + {_oz}
            set {_sy} to artifactRuinSurfaceY({_lx}, {_lz}, {_w})
            if {_sy} < -90:
                return true
            if {_sy} < {_minSy}:
                set {_minSy} to {_sy}
            if {_sy} > {_maxSy}:
                set {_maxSy} to {_sy}
            add 1 to {_oz}
        add 1 to {_ox}
    if {_maxSy} - {_minSy} > 12:
        return true
    return false

function artifactRuinFeetAtColumn(bx: number, bz: number, w: world) :: location:
    # Поверхность мира: highest solid block = по карте высот (не потолок пещеры под одним столбом воздуха)
    set {_probe} to location at {_bx}, 320, {_bz} in {_w}
    set {_top} to highest solid block at {_probe}
    if {_top} is not set:
        return location at 0, -512, 0 in {_w}
    set {_hy} to y-coordinate of location of {_top}
    if {_hy} < -59:
        return location at 0, -512, 0 in {_w}
    set {_feet} to location at {_bx}, {_hy} + 1, {_bz} in {_w}
    set {_bf} to block at {_feet}
    if {_bf} is water:
        return location at 0, -512, 0 in {_w}
    if {_bf} is lava:
        return location at 0, -512, 0 in {_w}
    if {_bf} is air:
        return {_feet}
    if {_bf} is cave air:
        return {_feet}
    if {_bf} is snow:
        return {_feet}
    return location at 0, -512, 0 in {_w}

function artifactRuinFeetValid(feet: location) :: boolean:
    set {_y} to y-coordinate of {_feet}
    if {_y} < -100:
        return false
    return true

function artifactRuinFarFromSpawn(feet: location, w: world) :: boolean:
    set {_min} to "{@artifact_ruin_min_spawn_blocks}" parsed as number
    if {_min} is not set:
        set {_min} to 400
    if {_min} <= 0:
        return true
    set {_sp} to spawn of {_w}
    set {_dx} to x-coordinate of {_feet} - x-coordinate of {_sp}
    set {_dz} to z-coordinate of {_feet} - z-coordinate of {_sp}
    set {_d2} to {_dx} * {_dx} + {_dz} * {_dz}
    set {_need} to {_min} * {_min}
    if {_d2} < {_need}:
        return false
    return true

function artifactRuinBuild(feet: location, kind: text) :: boolean:
    set {_w} to world of {_feet}
    set {_cx} to floor(x-coordinate of {_feet})
    set {_cz} to floor(z-coordinate of {_feet})
    if artifactRuinTerrainTooSteep({_cx}, {_cz}, 9, {_w}) is true:
        return false
    set {_pal} to random integer between 1 and 5
    if {_kind} is "legendary":
        set {_pal} to random integer between 3 and 5
    set {_var} to random integer between 1 and 6
    set {_plazaR} to 5
    set {_doWalls} to true
    set {_doStubs} to true
    set {_doCorners} to true
    set {_satN} to 6
    if {_var} is 2:
        set {_doWalls} to false
    else if {_var} is 3:
        set {_doStubs} to false
    else if {_var} is 4:
        set {_doWalls} to false
        set {_doStubs} to false
    else if {_var} is 5:
        set {_plazaR} to 4
    else if {_var} is 6:
        set {_plazaR} to 4
        set {_doWalls} to false
        set {_doStubs} to false
        set {_doCorners} to false
        set {_satN} to 2
    set {_satT} to "modest"
    if {_kind} is "legendary":
        set {_satT} to "rich"
    set {_ox} to -9
    while {_ox} <= 9:
        set {_oz} to -9
        while {_oz} <= 9:
            set {_lx} to {_cx} + {_ox}
            set {_lz} to {_cz} + {_oz}
            set {_sy} to artifactRuinSurfaceY({_lx}, {_lz}, {_w})
            if {_sy} > -90:
                loop 16 times:
                    set {_ly} to {_sy} + loop-number
                    set block at location at {_lx}, {_ly}, {_lz} in {_w} to air
            add 1 to {_oz}
        add 1 to {_ox}
    set {_dx} to 0 - {_plazaR}
    while {_dx} <= {_plazaR}:
        set {_dz} to 0 - {_plazaR}
        while {_dz} <= {_plazaR}:
            set {_lx} to {_cx} + {_dx}
            set {_lz} to {_cz} + {_dz}
            set {_sy} to artifactRuinSurfaceY({_lx}, {_lz}, {_w})
            if {_sy} > -90:
                if {_dx} is 0:
                    if {_dz} is 0:
                        set block at location at {_lx}, {_sy}, {_lz} in {_w} to artifactRuinCenterFloorForKind({_kind})
                    else:
                        set block at location at {_lx}, {_sy}, {_lz} in {_w} to artifactRuinFloorPieceForKind({_pal}, {_kind})
                else:
                    set block at location at {_lx}, {_sy}, {_lz} in {_w} to artifactRuinFloorPieceForKind({_pal}, {_kind})
            add 1 to {_dz}
        add 1 to {_dx}
    set {_pc} to {_plazaR}
    set {_nmPc} to 0 - {_pc}
    if {_doCorners} is true:
        set {_hp1} to random integer between 2 and 4
        set {_hp2} to random integer between 2 and 4
        set {_hp3} to random integer between 2 and 4
        set {_hp4} to random integer between 2 and 4
        set {_syP1} to artifactRuinSurfaceY({_cx} - {_pc}, {_cz} - {_pc}, {_w})
        loop {_hp1} times:
            set {_py} to {_syP1} + loop-number
            chance of 90%:
                set block at location at {_cx} - {_pc}, {_py}, {_cz} - {_pc} in {_w} to artifactRuinPillarPieceForKind({_pal}, {_kind})
        set {_syP2} to artifactRuinSurfaceY({_cx} - {_pc}, {_cz} + {_pc}, {_w})
        loop {_hp2} times:
            set {_py} to {_syP2} + loop-number
            chance of 90%:
                set block at location at {_cx} - {_pc}, {_py}, {_cz} + {_pc} in {_w} to artifactRuinPillarPieceForKind({_pal}, {_kind})
        set {_syP3} to artifactRuinSurfaceY({_cx} + {_pc}, {_cz} - {_pc}, {_w})
        loop {_hp3} times:
            set {_py} to {_syP3} + loop-number
            chance of 90%:
                set block at location at {_cx} + {_pc}, {_py}, {_cz} - {_pc} in {_w} to artifactRuinPillarPieceForKind({_pal}, {_kind})
        set {_syP4} to artifactRuinSurfaceY({_cx} + {_pc}, {_cz} + {_pc}, {_w})
        loop {_hp4} times:
            set {_py} to {_syP4} + loop-number
            chance of 90%:
                set block at location at {_cx} + {_pc}, {_py}, {_cz} + {_pc} in {_w} to artifactRuinPillarPieceForKind({_pal}, {_kind})
        set {_top1} to {_syP1} + {_hp1} + 1
        set {_top2} to {_syP2} + {_hp2} + 1
        set {_top3} to {_syP3} + {_hp3} + 1
        set {_top4} to {_syP4} + {_hp4} + 1
        if {_kind} is "legendary":
            set block at location at {_cx} - {_pc}, {_top1}, {_cz} - {_pc} in {_w} to soul lantern
            set block at location at {_cx} - {_pc}, {_top2}, {_cz} + {_pc} in {_w} to soul lantern
            set block at location at {_cx} + {_pc}, {_top3}, {_cz} - {_pc} in {_w} to soul lantern
            set block at location at {_cx} + {_pc}, {_top4}, {_cz} + {_pc} in {_w} to soul lantern
        else:
            chance of 50%:
                set block at location at {_cx} - {_pc}, {_top1}, {_cz} - {_pc} in {_w} to soul lantern
            else:
                set block at location at {_cx} - {_pc}, {_top1}, {_cz} - {_pc} in {_w} to lantern
            chance of 50%:
                set block at location at {_cx} - {_pc}, {_top2}, {_cz} + {_pc} in {_w} to soul lantern
            else:
                set block at location at {_cx} - {_pc}, {_top2}, {_cz} + {_pc} in {_w} to lantern
            chance of 50%:
                set block at location at {_cx} + {_pc}, {_top3}, {_cz} - {_pc} in {_w} to soul lantern
            else:
                set block at location at {_cx} + {_pc}, {_top3}, {_cz} - {_pc} in {_w} to lantern
            chance of 50%:
                set block at location at {_cx} + {_pc}, {_top4}, {_cz} + {_pc} in {_w} to soul lantern
            else:
                set block at location at {_cx} + {_pc}, {_top4}, {_cz} + {_pc} in {_w} to lantern
    set {_txSpan} to 2 * {_plazaR}
    loop 18 times:
        set {_tx} to {_nmPc} + (random integer between 0 and {_txSpan})
        set {_tz} to {_nmPc} + (random integer between 0 and {_txSpan})
        set {_carpetOk} to true
        if {_tx} is 0:
            if {_tz} is 0:
                set {_carpetOk} to false
        if {_tx} is {_nmPc}:
            if {_tz} is {_nmPc}:
                set {_carpetOk} to false
            if {_tz} is {_pc}:
                set {_carpetOk} to false
        if {_tx} is {_pc}:
            if {_tz} is {_nmPc}:
                set {_carpetOk} to false
            if {_tz} is {_pc}:
                set {_carpetOk} to false
        if {_tx} >= 4:
            if {_tx} <= 6:
                if {_tz} >= -1:
                    if {_tz} <= 1:
                        set {_carpetOk} to false
        if {_carpetOk} is true:
            set {_lsx} to {_cx} + {_tx}
            set {_lsz} to {_cz} + {_tz}
            set {_lsy} to artifactRuinSurfaceY({_lsx}, {_lsz}, {_w})
            if {_lsy} > -90:
                chance of 52%:
                    set block at location at {_lsx}, {_lsy} + 1, {_lsz} in {_w} to artifactRuinCarpetForKind({_pal}, {_kind})
    if {_doWalls} is true:
        set {_lz} to {_cz} - 8
        set {_lx} to {_cx} - 9
        while {_lx} <= {_cx} - 4:
            set {_wsy} to artifactRuinSurfaceY({_lx}, {_lz}, {_w})
            if {_wsy} > -90:
                chance of 62%:
                    set block at location at {_lx}, {_wsy} + 1, {_lz} in {_w} to artifactRuinPillarPieceForKind({_pal}, {_kind})
                chance of 48%:
                    set block at location at {_lx}, {_wsy} + 2, {_lz} in {_w} to artifactRuinPillarPieceForKind({_pal}, {_kind})
            add 1 to {_lx}
        set {_lx} to {_cx} + 5
        set {_lz} to {_cz} + 6
        while {_lz} <= {_cz} + 10:
            set {_wsy} to artifactRuinSurfaceY({_lx}, {_lz}, {_w})
            if {_wsy} > -90:
                chance of 58%:
                    set block at location at {_lx}, {_wsy} + 1, {_lz} in {_w} to artifactRuinPillarPieceForKind({_pal}, {_kind})
                chance of 40%:
                    set block at location at {_lx}, {_wsy} + 2, {_lz} in {_w} to artifactRuinPillarPieceForKind({_pal}, {_kind})
            add 1 to {_lz}
    if {_doStubs} is true:
        set {_txx} to {_cx} + 8
        set {_tzz} to {_cz} - 5
        set {_stub} to random integer between 2 and 4
        loop {_stub} times:
            set {_sty} to artifactRuinSurfaceY({_txx}, {_tzz}, {_w}) + loop-number
            chance of 85%:
                set block at location at {_txx}, {_sty}, {_tzz} in {_w} to artifactRuinPillarPieceForKind({_pal}, {_kind})
        set {_txx} to {_cx} - 7
        set {_tzz} to {_cz} + 7
        set {_stub} to random integer between 2 and 3
        loop {_stub} times:
            set {_sty} to artifactRuinSurfaceY({_txx}, {_tzz}, {_w}) + loop-number
            chance of 85%:
                set block at location at {_txx}, {_sty}, {_tzz} in {_w} to artifactRuinPillarPieceForKind({_pal}, {_kind})
    loop 22 times:
        set {_rx} to {_cx} + random integer between -10 and 10
        set {_rz} to {_cz} + random integer between -10 and 10
        set {_ox} to {_rx} - {_cx}
        set {_oz} to {_rz} - {_cz}
        set {_rubbleOk} to true
        if {_ox} >= {_nmPc}:
            if {_ox} <= {_pc}:
                if {_oz} >= {_nmPc}:
                    if {_oz} <= {_pc}:
                        set {_rubbleOk} to false
        if {_rubbleOk} is true:
            set {_rsy} to artifactRuinSurfaceY({_rx}, {_rz}, {_w})
            if {_rsy} > -90:
                set {_rr} to random integer between 1 and 100
                if {_rr} <= 35:
                    set block at location at {_rx}, {_rsy}, {_rz} in {_w} to gravel
                else if {_rr} <= 70:
                    set block at location at {_rx}, {_rsy}, {_rz} in {_w} to cobblestone
                else if {_rr} <= 88:
                    set block at location at {_rx}, {_rsy} + 1, {_rz} in {_w} to moss carpet
                else if {_rr} <= 100:
                    set block at location at {_rx}, {_rsy}, {_rz} in {_w} to dead bush
    chance of 55%:
        set {_wsy} to artifactRuinSurfaceY({_cx} - 4, {_cz} - 6, {_w})
        if {_wsy} > -90:
            set block at location at {_cx} - 4, {_wsy} + 3, {_cz} - 6 in {_w} to cobweb
    chance of 45%:
        set {_wsy} to artifactRuinSurfaceY({_cx} + 4, {_cz} + 6, {_w})
        if {_wsy} > -90:
            set block at location at {_cx} + 4, {_wsy} + 3, {_cz} + 6 in {_w} to cobweb
    set {_tdx} to 4
    while {_tdx} <= 6:
        set {_tdz} to -1
        while {_tdz} <= 1:
            set {_tlx} to {_cx} + {_tdx}
            set {_tlz} to {_cz} + {_tdz}
            set {_tsy} to artifactRuinSurfaceY({_tlx}, {_tlz}, {_w})
            if {_tsy} > -90:
                set block at location at {_tlx}, {_tsy}, {_tlz} in {_w} to artifactRuinTowerPadForKind({_kind})
            add 1 to {_tdz}
        add 1 to {_tdx}
    set {_twSy} to artifactRuinSurfaceY({_cx} + 5, {_cz}, {_w})
    if {_twSy} > -90:
        loop 7 times:
            if loop-number is 1:
                set {_wdx} to 4
                set {_wdz} to -1
            else if loop-number is 2:
                set {_wdx} to 5
                set {_wdz} to -1
            else if loop-number is 3:
                set {_wdx} to 6
                set {_wdz} to -1
            else if loop-number is 4:
                set {_wdx} to 4
                set {_wdz} to 1
            else if loop-number is 5:
                set {_wdx} to 5
                set {_wdz} to 1
            else if loop-number is 6:
                set {_wdx} to 6
                set {_wdz} to 1
            else:
                set {_wdx} to 6
                set {_wdz} to 0
            set {_wlx} to {_cx} + {_wdx}
            set {_wlz} to {_cz} + {_wdz}
            set {_wsy} to artifactRuinSurfaceY({_wlx}, {_wlz}, {_w})
            if {_wsy} > -90:
                chance of 72%:
                    set block at location at {_wlx}, {_wsy} + 1, {_wlz} in {_w} to artifactRuinPillarPieceForKind({_pal}, {_kind})
                chance of 58%:
                    set block at location at {_wlx}, {_wsy} + 2, {_wlz} in {_w} to artifactRuinPillarPieceForKind({_pal}, {_kind})
        set {_chestLoc} to location at {_cx} + 5, {_twSy} + 1, {_cz} in {_w}
        set block at {_chestLoc} to chest
        artifactRuinFillChestBoss({_chestLoc}, {_kind})
    set {_ci} to {_plazaR} - 1
    if {_satN} is 2:
        set {_pya} to artifactRuinSurfaceY({_cx} - {_ci}, {_cz} - {_ci}, {_w})
        if {_pya} > -90:
            set {_p1l} to location at {_cx} - {_ci}, {_pya} + 1, {_cz} - {_ci} in {_w}
            set block at {_p1l} to chest
            artifactRuinFillChest({_p1l}, {_satT})
        set {_pyd} to artifactRuinSurfaceY({_cx} + {_ci}, {_cz} + {_ci}, {_w})
        if {_pyd} > -90:
            set {_p4l} to location at {_cx} + {_ci}, {_pyd} + 1, {_cz} + {_ci} in {_w}
            set block at {_p4l} to chest
            artifactRuinFillChest({_p4l}, {_satT})
    else:
        set {_pya} to artifactRuinSurfaceY({_cx} - {_ci}, {_cz} - {_ci}, {_w})
        if {_pya} > -90:
            set {_p1l} to location at {_cx} - {_ci}, {_pya} + 1, {_cz} - {_ci} in {_w}
            set block at {_p1l} to chest
            artifactRuinFillChest({_p1l}, {_satT})
        if {_satN} >= 4:
            set {_pyb} to artifactRuinSurfaceY({_cx} - {_ci}, {_cz} + {_ci}, {_w})
            if {_pyb} > -90:
                set {_p2l} to location at {_cx} - {_ci}, {_pyb} + 1, {_cz} + {_ci} in {_w}
                set block at {_p2l} to chest
                artifactRuinFillChest({_p2l}, {_satT})
            set {_pyc} to artifactRuinSurfaceY({_cx} + {_ci}, {_cz} - {_ci}, {_w})
            if {_pyc} > -90:
                set {_p3l} to location at {_cx} + {_ci}, {_pyc} + 1, {_cz} - {_ci} in {_w}
                set block at {_p3l} to chest
                artifactRuinFillChest({_p3l}, {_satT})
            set {_pyd} to artifactRuinSurfaceY({_cx} + {_ci}, {_cz} + {_ci}, {_w})
            if {_pyd} > -90:
                set {_p4l} to location at {_cx} + {_ci}, {_pyd} + 1, {_cz} + {_ci} in {_w}
                set block at {_p4l} to chest
                artifactRuinFillChest({_p4l}, {_satT})
        if {_satN} >= 6:
            if {_doWalls} is true:
                set {_pye} to artifactRuinSurfaceY({_cx} - 6, {_cz} - 7, {_w})
                if {_pye} > -90:
                    set {_rwl} to location at {_cx} - 6, {_pye} + 1, {_cz} - 7 in {_w}
                    set block at {_rwl} to chest
                    artifactRuinFillChest({_rwl}, {_satT})
                set {_pyf} to artifactRuinSurfaceY({_cx} + 7, {_cz} + 7, {_w})
                if {_pyf} > -90:
                    set {_rw2} to location at {_cx} + 7, {_pyf} + 1, {_cz} + 7 in {_w}
                    set block at {_rw2} to chest
                    artifactRuinFillChest({_rw2}, {_satT})
    artifactRuinSpawnGuards({_cx}, {_cz}, {_w}, {_kind})
    return true

function artifactRuinAdminSpawnHereKind(p: player, kind: text) :: boolean:
    set {_w} to world of {_p}
    if environment of {_w} is not normal:
        return false
    set {_bx} to floor(x-coordinate of location of {_p})
    set {_bz} to floor(z-coordinate of location of {_p})
    set {_feet} to artifactRuinFeetAtColumn({_bx}, {_bz}, {_w})
    if artifactRuinFeetValid({_feet}) is false:
        return false
    return artifactRuinBuild({_feet}, {_kind})

function artifactRuinAdminSpawnHere(p: player) :: boolean:
    set {_rk} to artifactRuinRandomKind()
    return artifactRuinAdminSpawnHereKind({_p}, {_rk})

function artifactRuinGoodNeighborForNetherrack(nb: block) :: boolean:
    if {_nb} is not set:
        return false
    if {_nb} is air:
        return false
    if {_nb} is cave air:
        return false
    if {_nb} is void air:
        return false
    if {_nb} is water:
        return false
    if {_nb} is lava:
        return false
    if {_nb} is netherrack:
        return false
    if {_nb} is obsidian:
        return false
    if {_nb} is crying obsidian:
        return false
    if {_nb} is gold block:
        return false
    if {_nb} is gold ore:
        return false
    if {_nb} is nether gold ore:
        return false
    if {_nb} is magma block:
        return false
    if {_nb} is chest:
        return false
    if {_nb} is trapped chest:
        return false
    if {_nb} is iron bars:
        return false
    if "%type of {_nb}%" is "minecraft:chain":
        return false
    if {_nb} is stone bricks:
        return false
    if {_nb} is cracked stone bricks:
        return false
    if {_nb} is chiseled stone bricks:
        return false
    if {_nb} is mossy stone bricks:
        return false
    if {_nb} is stone brick slab:
        return false
    if {_nb} is stone brick stairs:
        return false
    if {_nb} is stone brick wall:
        return false
    set {_ty} to "%type of {_nb}%"
    if {_ty} contains "minecraft:blackstone":
        return false
    return true

function artifactRuinRemoveRuinedPortalScrap(center: location):
    set {_w} to world of {_center}
    loop blocks in radius 26 around {_center}:
        set {_ty} to "%type of loop-block%"
        if {_ty} contains "minecraft:blackstone":
            set loop-block to air
        else if loop-block is stone bricks:
            set loop-block to air
        else if loop-block is cracked stone bricks:
            set loop-block to air
        else if loop-block is chiseled stone bricks:
            set loop-block to air
        else if loop-block is mossy stone bricks:
            set loop-block to air
        else if loop-block is stone brick slab:
            set loop-block to air
        else if loop-block is stone brick stairs:
            set loop-block to air
        else if loop-block is stone brick wall:
            set loop-block to air
        else if loop-block is obsidian:
            set loop-block to air
        else if loop-block is crying obsidian:
            set loop-block to air
        else if loop-block is gold block:
            set loop-block to air
        else if loop-block is gold ore:
            set loop-block to air
        else if loop-block is nether gold ore:
            set loop-block to air
        else if loop-block is magma block:
            set loop-block to air
        else if loop-block is lava:
            set loop-block to air
        else if loop-block is iron bars:
            set loop-block to air
        else if loop-block is chest:
            set loop-block to air
        else if loop-block is trapped chest:
            set loop-block to air
        else if "%type of loop-block%" is "minecraft:chain":
            set loop-block to air

function artifactRuinHealNetherrackAround(center: location):
    set {_w} to world of {_center}
    loop blocks in radius 26 around {_center}:
        if loop-block is netherrack:
            set {_bx} to floor(x-coordinate of location of loop-block)
            set {_by} to floor(y-coordinate of location of loop-block)
            set {_bz} to floor(z-coordinate of location of loop-block)
            set {_nb} to block at location at {_bx} + 1, {_by}, {_bz} in {_w}
            if artifactRuinGoodNeighborForNetherrack({_nb}) is true:
                set loop-block to {_nb}
            else:
                set {_nb} to block at location at {_bx} - 1, {_by}, {_bz} in {_w}
                if artifactRuinGoodNeighborForNetherrack({_nb}) is true:
                    set loop-block to {_nb}
                else:
                    set {_nb} to block at location at {_bx}, {_by} + 1, {_bz} in {_w}
                    if artifactRuinGoodNeighborForNetherrack({_nb}) is true:
                        set loop-block to {_nb}
                    else:
                        set {_nb} to block at location at {_bx}, {_by} - 1, {_bz} in {_w}
                        if artifactRuinGoodNeighborForNetherrack({_nb}) is true:
                            set loop-block to {_nb}
                        else:
                            set {_nb} to block at location at {_bx}, {_by}, {_bz} + 1 in {_w}
                            if artifactRuinGoodNeighborForNetherrack({_nb}) is true:
                                set loop-block to {_nb}
                            else:
                                set {_nb} to block at location at {_bx}, {_by}, {_bz} - 1 in {_w}
                                if artifactRuinGoodNeighborForNetherrack({_nb}) is true:
                                    set loop-block to {_nb}
                                else:
                                    set loop-block to stone

function artifactRuinChunkLooksLikeRuinedPortal(mid: location) :: boolean:
    set {_cry} to 0
    set {_obs} to 0
    loop blocks in radius 20 around {_mid}:
        if loop-block is crying obsidian:
            add 1 to {_cry}
        else if loop-block is obsidian:
            add 1 to {_obs}
    if {_cry} < 1:
        return false
    if {_obs} < 2:
        return false
    if {_cry} + {_obs} < 6:
        return false
    return true

function artifactRuinTryReplaceRuinedPortalFromChunk(ch: chunk):
    set {_w} to world of {_ch}
    if environment of {_w} is not normal:
        stop
    set {_wcx} to x coordinate of {_ch}
    set {_wcz} to z coordinate of {_ch}
    set {_rc} to "{@artifact_ruin_region_chunks}" parsed as number
    if {_rc} is not set:
        set {_rc} to 6
    if {_rc} < 1:
        set {_rc} to 6
    set {_rx} to floor({_wcx} / {_rc})
    set {_rz} to floor({_wcz} / {_rc})
    set {_wn} to "%{_w}%"
    if {evo_ruin_reg::%{_wn}%::%{_rx}%::%{_rz}%} is true:
        stop
    set {_bx} to {_wcx} * 16 + 8
    set {_bz} to {_wcz} * 16 + 8
    set {_sy} to artifactRuinSurfaceY({_bx}, {_bz}, {_w})
    if {_sy} < -90:
        stop
    set {_mid} to location at {_bx}, {_sy} + 2, {_bz} in {_w}
    if artifactRuinChunkLooksLikeRuinedPortal({_mid}) is false:
        stop
    set {_legMax} to "{@artifact_ruin_portal_roll_legendary_max}" parsed as number
    set {_comMax} to "{@artifact_ruin_portal_roll_common_max}" parsed as number
    if {_legMax} is not set:
        set {_legMax} to 10
    if {_comMax} is not set:
        set {_comMax} to 60
    set {_spawnx} to {_bx}
    set {_spawnz} to {_bz}
    loop blocks in radius 24 around {_mid}:
        if loop-block is chest:
            set {_spawnx} to floor(x-coordinate of location of loop-block)
            set {_spawnz} to floor(z-coordinate of location of loop-block)
            exit loop
        if loop-block is trapped chest:
            set {_spawnx} to floor(x-coordinate of location of loop-block)
            set {_spawnz} to floor(z-coordinate of location of loop-block)
            exit loop
    set {_roll} to random integer between 1 and 100
    if {_roll} > {_comMax}:
        stop
    set {_kind} to "common"
    if {_roll} <= {_legMax}:
        set {_kind} to "legendary"
    set {_preFeet} to artifactRuinFeetAtColumn({_spawnx}, {_spawnz}, {_w})
    if artifactRuinFeetValid({_preFeet}) is false:
        stop
    if artifactRuinFarFromSpawn({_preFeet}, {_w}) is false:
        stop
    set {_cx} to floor(x-coordinate of {_preFeet})
    set {_cz} to floor(z-coordinate of {_preFeet})
    if artifactRuinTerrainTooSteep({_cx}, {_cz}, 9, {_w}) is true:
        stop
    artifactRuinRemoveRuinedPortalScrap({_mid})
    artifactRuinHealNetherrackAround({_mid})
    set {_feet} to artifactRuinFeetAtColumn({_spawnx}, {_spawnz}, {_w})
    if artifactRuinBuild({_feet}, {_kind}) is true:
        set {evo_ruin_reg::%{_wn}%::%{_rx}%::%{_rz}%} to true

function artifactRuinTrySpawnChunk(wcx: number, wcz: number, w: world):
    set {_rc} to "{@artifact_ruin_region_chunks}" parsed as number
    if {_rc} is not set:
        set {_rc} to 6
    if {_rc} < 1:
        set {_rc} to 6
    set {_rx} to floor({_wcx} / {_rc})
    set {_rz} to floor({_wcz} / {_rc})
    set {_wn} to "%{_w}%"
    if {evo_ruin_reg::%{_wn}%::%{_rx}%::%{_rz}%} is true:
        stop
    loop 6 times:
        set {_bx} to {_wcx} * 16 + random integer between 3 and 12
        set {_bz} to {_wcz} * 16 + random integer between 3 and 12
        set {_feet} to artifactRuinFeetAtColumn({_bx}, {_bz}, {_w})
        if artifactRuinFeetValid({_feet}) is true:
            if artifactRuinFarFromSpawn({_feet}, {_w}) is true:
                set {_rk} to artifactRuinRandomKind()
                if artifactRuinBuild({_feet}, {_rk}) is true:
                    set {evo_ruin_reg::%{_wn}%::%{_rx}%::%{_rz}%} to true
                    stop

# ----- Алтарь пробуждения (Незер): сундук → оболочка 3×3×3 + именная воронка в инвентарь → установка на центральный аметист -----
# Дыры по центру боковых граней среднего слоя (доступ); низ и верх центра не «дыры»: аметист и плачущий обсидиан.

function isAwakeningAltarFaceHoleMiddle(dx: number, dz: number) :: boolean:
    if {_dx} is -1:
        if {_dz} is 0:
            return true
    if {_dx} is 1:
        if {_dz} is 0:
            return true
    if {_dx} is 0:
        if {_dz} is -1:
            return true
        if {_dz} is 1:
            return true
    return false

function isAwakeningAltarTopButtonRel(dx: number, dz: number) :: boolean:
    if {_dx} is 0:
        if {_dz} is 1:
            return true
    return false

function awakeningHopperTokenItem() :: item:
    set {_h} to hopper
    set name of {_h} to "&5&lАлтарь Создания"
    set lore of {_h} to "&7Установи на центральный аметист алтаря", "&7(центр нижнего слоя куба)", "&8После установки откроется крафт воронки"
    return {_h}

function isAwakeningHopperToken(i: item) :: boolean:
    if {_i} is not hopper:
        return false
    set {_n} to name of {_i}
    if {_n} is not set:
        return false
    if {_n} contains "Алтарь Создания":
        return true
    return false

function altarAwakeningVoidKey(i: item) :: boolean:
    set {_n} to name of {_i}
    if {_n} is not set:
        return false
    if {_n} contains "Ключ Пустоты":
        return true
    if {_n} contains "Ключ пустоты":
        return true
    return false

function altarAwakeningReturnKey(i: item) :: boolean:
    set {_n} to name of {_i}
    if {_n} is not set:
        return false
    if {_n} contains "Ключ возврата":
        return true
    if {_n} contains "Ключ Возврата":
        return true
    if {_n} contains "Возврат":
        return true
    if {_n} contains "возврат":
        return true
    return false

function isAltarChestRecipeExact(inv: inventory) :: boolean:
    set {_voidN} to 0
    set {_cryN} to 0
    set {_obsN} to 0
    set {_amtN} to 0
    set {_bad} to false
    loop all items in {_inv}:
        if loop-value is air:
            stop
        if altarAwakeningVoidKey(loop-value) is true:
            add amount of loop-value to {_voidN}
        else if loop-value is crying obsidian:
            add amount of loop-value to {_cryN}
        else if loop-value is obsidian:
            add amount of loop-value to {_obsN}
        else if loop-value is amethyst shard:
            add amount of loop-value to {_amtN}
        else:
            set {_bad} to true
    if {_bad} is true:
        return false
    if {_voidN} is not 5:
        return false
    if {_cryN} is not 3:
        return false
    if {_obsN} is not 3:
        return false
    if {_amtN} is not 3:
        return false
    return true

function altarStructureShellOk(base: location, middleCenterMustBeHopper: boolean) :: boolean:
    set {_w} to world of {_base}
    set {_x} to floor(x-coordinate of {_base})
    set {_y} to floor(y-coordinate of {_base})
    set {_z} to floor(z-coordinate of {_base})
    set {_dx} to -1
    while {_dx} <= 1:
        set {_dz} to -1
        while {_dz} <= 1:
            set {_b0} to block at location at {_x} + {_dx}, {_y}, {_z} + {_dz} in {_w}
            if {_dx} is 0:
                if {_dz} is 0:
                    if {_b0} is not amethyst block:
                        return false
                else:
                    if {_b0} is not polished blackstone bricks:
                        return false
            else:
                if {_b0} is not polished blackstone bricks:
                    return false
            add 1 to {_dz}
        add 1 to {_dx}
    set {_dx} to -1
    while {_dx} <= 1:
        set {_dz} to -1
        while {_dz} <= 1:
            if {_dx} is 0:
                if {_dz} is 0:
                    set {_b1} to block at location at {_x}, {_y} + 1, {_z} in {_w}
                    if {_middleCenterMustBeHopper} is true:
                        if {_b1} is not hopper:
                            return false
                        if isAwakeningAltarHopperComplete({_b1}) is false:
                            return false
                    else:
                        if {_b1} is not air:
                            return false
                else:
                    set {_b1} to block at location at {_x} + {_dx}, {_y} + 1, {_z} + {_dz} in {_w}
                    if isAwakeningAltarFaceHoleMiddle({_dx}, {_dz}) is true:
                        if {_b1} is not air:
                            return false
                    else if {_b1} is not blackstone:
                        return false
            else:
                set {_b1} to block at location at {_x} + {_dx}, {_y} + 1, {_z} + {_dz} in {_w}
                if isAwakeningAltarFaceHoleMiddle({_dx}, {_dz}) is true:
                    if {_b1} is not air:
                        return false
                else if {_b1} is not blackstone:
                    return false
            add 1 to {_dz}
        add 1 to {_dx}
    set {_dx} to -1
    while {_dx} <= 1:
        set {_dz} to -1
        while {_dz} <= 1:
            set {_b2} to block at location at {_x} + {_dx}, {_y} + 2, {_z} + {_dz} in {_w}
            if {_dx} is 0:
                if {_dz} is 0:
                    if {_b2} is not crying obsidian:
                        return false
            add 1 to {_dz}
        add 1 to {_dx}
    set {_b3} to block at location at {_x}, {_y} + 2, {_z} - 1 in {_w}
    if {_b3} is not stone button:
        return false
    return true

function altarStructureCoreOk(base: location) :: boolean:
    return altarStructureShellOk({_base}, true)

function isAwakeningAltarHopperComplete(b: block) :: boolean:
    if {_b} is not hopper:
        return false
    # Не завязываемся на заголовок GUI: на некоторых сборках/клиентах
    # имя воронки может отображаться как Item Hopper.
    return true

function tryBuildAwakeningAltarAtChestBlock(cb: block, opener: player):
    set {_chestOk} to false
    if {_cb} is chest:
        set {_chestOk} to true
    else if {_cb} is trapped chest:
        set {_chestOk} to true
    if {_chestOk} is true:
        set {_cinv} to inventory of {_cb}
        if isAltarChestRecipeExact({_cinv}) is true:
            clear {_cinv}
            buildAwakeningAltarFromChest({_cb}, {_opener})

function tryBuildAwakeningAltarAtChestBlock(cb: block):
    set {_chestOk} to false
    if {_cb} is chest:
        set {_chestOk} to true
    else if {_cb} is trapped chest:
        set {_chestOk} to true
    if {_chestOk} is true:
        set {_cinv} to inventory of {_cb}
        if isAltarChestRecipeExact({_cinv}) is true:
            clear {_cinv}
            buildAwakeningAltarShellFromChest({_cb})

function tryBuildAwakeningAltarFromInventoryHolder(h: object, opener: player):
    if {_h} is chest:
        tryBuildAwakeningAltarAtChestBlock({_h}, {_opener})
    else if {_h} is trapped chest:
        tryBuildAwakeningAltarAtChestBlock({_h}, {_opener})

function tryBuildAwakeningAltarFromInventoryHolder(h: object):
    if {_h} is chest:
        tryBuildAwakeningAltarAtChestBlock({_h})
    else if {_h} is trapped chest:
        tryBuildAwakeningAltarAtChestBlock({_h})

function buildAwakeningAltarShellFromChest(ch: block):
    set {_w} to world of {_ch}
    set {_x} to floor(x-coordinate of {_ch})
    set {_y} to floor(y-coordinate of {_ch})
    set {_z} to floor(z-coordinate of {_ch})
    set block at {_ch} to air
    set {_dx} to -1
    while {_dx} <= 1:
        set {_dz} to -1
        while {_dz} <= 1:
            if {_dx} is 0:
                if {_dz} is 0:
                    set block at location at {_x}, {_y}, {_z} in {_w} to amethyst block
                else:
                    set block at location at {_x} + {_dx}, {_y}, {_z} + {_dz} in {_w} to polished blackstone bricks
            else:
                set block at location at {_x} + {_dx}, {_y}, {_z} + {_dz} in {_w} to polished blackstone bricks
            add 1 to {_dz}
        add 1 to {_dx}
    set {_dx} to -1
    while {_dx} <= 1:
        set {_dz} to -1
        while {_dz} <= 1:
            if {_dx} is 0:
                if {_dz} is 0:
                    set block at location at {_x}, {_y} + 1, {_z} in {_w} to air
                else:
                    set block at location at {_x} + {_dx}, {_y} + 1, {_z} + {_dz} in {_w} to blackstone
            else:
                set block at location at {_x} + {_dx}, {_y} + 1, {_z} + {_dz} in {_w} to blackstone
            add 1 to {_dz}
        add 1 to {_dx}
    set {_dx} to -1
    while {_dx} <= 1:
        set {_dz} to -1
        while {_dz} <= 1:
            set block at location at {_x} + {_dx}, {_y} + 2, {_z} + {_dz} in {_w} to air
            add 1 to {_dz}
        add 1 to {_dx}
    set block at location at {_x}, {_y} + 2, {_z} in {_w} to crying obsidian
    # Одна физическая кнопка: на центральном плачущем обсидиане (сбоку), с северной стороны (-Z).
    set block at location at {_x}, {_y} + 2, {_z} - 1 in {_w} to stone button
    set block at location at {_x} - 1, {_y} + 1, {_z} in {_w} to air
    set block at location at {_x} + 1, {_y} + 1, {_z} in {_w} to air
    set block at location at {_x}, {_y} + 1, {_z} - 1 in {_w} to air
    set block at location at {_x}, {_y} + 1, {_z} + 1 in {_w} to air
    set {_core} to location at {_x}, {_y}, {_z} in {_w}
    add {_core} to {awakening_altar_bases::*}
    set {_fx} to location at {_x}, {_y} + 1, {_z} in {_w}
    strike lightning effect at {_fx}
    play sound "block.beacon.activate" with volume 1 and pitch 0.8 at {_fx} for all players
    execute console command "execute positioned %x-coordinate of {_fx}% %y-coordinate of {_fx}% %z-coordinate of {_fx}% run particle minecraft:witch ~ ~ ~ 0.45 0.35 0.45 0.01 45 force"
    execute console command "execute positioned %x-coordinate of {_fx}% %y-coordinate of {_fx}% %z-coordinate of {_fx}% run particle minecraft:portal ~ ~0.4 ~ 0.55 0.35 0.55 0.01 60 force"

function buildAwakeningAltarFromChest(ch: block, opener: player):
    buildAwakeningAltarShellFromChest({_ch})
    set {_tok} to awakeningHopperTokenItem()
    if {_opener} has space for {_tok}:
        give {_tok} to {_opener}
        send "{@prefix} &dПолучена воронка &5Алтарь Создания&d — поставь её на центральный аметист." to {_opener}
    else:
        drop {_tok} at {_opener}
        send "{@prefix} &eИнвентарь полон: воронка &5Алтарь Создания &eвыпала рядом." to {_opener}

function tryCompleteAwakeningAltarHopper(placer: player, hb: block, placed: item):
    if {_hb} is not hopper:
        stop
    set {_tok} to false
    if isAwakeningHopperToken({_placed}) is true:
        set {_tok} to true
    if {_tok} is false:
        if isAwakeningHopperToken(tool of {_placer}) is true:
            set {_tok} to true
    if {_tok} is false:
        stop
    set {_w} to world of {_hb}
    set {_hx} to floor(x-coordinate of {_hb})
    set {_hy} to floor(y-coordinate of {_hb})
    set {_hz} to floor(z-coordinate of {_hb})
    set {_below} to block at location at {_hx}, {_hy} - 1, {_hz} in {_w}
    if {_below} is not amethyst block:
        stop
    set {_bx} to {_hx}
    set {_by} to {_hy} - 1
    set {_bz} to {_hz}
    set {_baseLoc} to location at {_bx}, {_by}, {_bz} in {_w}
    set {_listed} to false
    loop {awakening_altar_bases::*}:
        if loop-value is {_baseLoc}:
            set {_listed} to true
            exit loop
    if {_listed} is false:
        stop
    if altarStructureShellOk({_baseLoc}, false) is false:
        stop
    set {_already} to false
    loop {awakening_altars::*}:
        if loop-value is location of {_hb}:
            set {_already} to true
            exit loop
    if {_already} is true:
        stop
    set name of inventory of {_hb} to "&5&lАлтарь Создания"
    add location of {_hb} to {awakening_altars::*}
    play sound "block.beacon.activate" with volume 1 and pitch 1 at {_hb} for all players
    send "{@prefix} &dАлтарь создания завершён — можно крафтить в воронке." to {_placer}

function altarEtherPickaxeItem() :: item:
    set {_p} to diamond pickaxe
    set name of {_p} to "&dЭфирная Кирка"
    set lore of {_p} to "&8✦ Алтарная кирка", "&8ЭФИР_КИРКА", "&7ПКМ: &fшёлковое касание &7(целые блоки вкл/выкл)", "&7Shift+ПКМ: &fэфирный режим &7(пыль с мусора)", "&7Руды -> &aмгновенно в инвентарь", "&8∞ Неразрушимая"
    enchant {_p} with unbreaking 10
    return {_p}

function altarFlamePickaxeItem() :: item:
    set {_p} to diamond pickaxe
    set name of {_p} to "&cПламенная Кирка"
    set lore of {_p} to "&8✦ Алтарная кирка", "&8ПЛАМЯ_КИРКА", "&7Руды сразу плавятся в &6слитки", "&7Пылающая добыча + доп. опыт", "&8∞ Неразрушимая"
    enchant {_p} with unbreaking 10
    return {_p}

function altarVeinPickaxeItem() :: item:
    set {_p} to diamond pickaxe
    set name of {_p} to "&aЖильная Кирка"
    set lore of {_p} to "&8✦ Алтарная кирка", "&8ЖИЛА_КИРКА", "&7Ломает соседнюю жилу руды", "&7До &f27 &7блоков за один удар", "&8∞ Неразрушимая"
    enchant {_p} with unbreaking 10
    return {_p}

