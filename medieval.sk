    if {_pid} is "tank_B":
        return "&8&lB — Сейсмический удар"
    if {_pid} is "tank_C":
        return "&4&lC — Несокрушимый"
    if {_pid} is "tank_D":
        return "&6&lD — Защитник дуо"
    if {_pid} is "archer_A":
        return "&e&lA — Снайпер"
    if {_pid} is "archer_B":
