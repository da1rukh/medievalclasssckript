function isVoidHelmet(i: item) :: boolean:
    return altarGearHasTag({_i}, "АЛТАР_ПУСТОТА_ШЛЕМ")

function isVoidChestplate(i: item) :: boolean:
    return altarGearHasTag({_i}, "АЛТАР_ПУСТОТА_НАГРУД")

function isVoidLeggings(i: item) :: boolean:
    return altarGearHasTag({_i}, "АЛТАР_ПУСТОТА_ПОНОЖ")

function isVoidBoots(i: item) :: boolean:
    return altarGearHasTag({_i}, "АЛТАР_ПУСТОТА_САПОГ")

function isOmniHelmet(i: item) :: boolean:
    return altarGearHasTag({_i}, "АЛТАР_ОМНИ_ШЛЕМ")

function isOmniChestplate(i: item) :: boolean:
    return altarGearHasTag({_i}, "АЛТАР_ОМНИ_НАГРУД")

function isOmniLeggings(i: item) :: boolean:
    return altarGearHasTag({_i}, "АЛТАР_ОМНИ_ПОНОЖ")

function isOmniBoots(i: item) :: boolean:
    return altarGearHasTag({_i}, "АЛТАР_ОМНИ_САПОГ")

function isAltarArmorPiece(i: item) :: boolean:
    if altarGearHasTag({_i}, "_БРОНЯ") is true:
        return true
    if altarGearHasTag({_i}, "АЛТАР_ОМНИ_") is true:
        return true
    return false

function isAltarKeyToolRecipe(inv: inventory, tool: item, core: item, catalyst: item) :: boolean:
    set {_voidN} to 0
    set {_retN} to 0
    set {_toolN} to 0
    set {_coreN} to 0
    set {_catN} to 0
    set {_total} to 0
    set {_bad} to false
    loop 5 times:
        set {_it} to slot (loop-number - 1) of {_inv}
        if {_it} is air:
            set {_bad} to true
        else:
            add 1 to {_total}
            if altarAwakeningVoidKey({_it}) is true:
                add 1 to {_voidN}
            else if altarAwakeningReturnKey({_it}) is true:
                add 1 to {_retN}
            else if {_it} is {_tool}:
                add 1 to {_toolN}
            else if {_it} is {_core}:
                add 1 to {_coreN}
            else if {_it} is {_catalyst}:
                add 1 to {_catN}
            else:
                set {_bad} to true
    if {_bad} is true:
        return false
    if {_total} is not 5:
        return false
    if {_voidN} is not 1:
        return false
    if {_retN} is not 1:
        return false
    if {_toolN} is not 1:
        return false
    if {_coreN} is not 1:
        return false
    if {_catN} is not 1:
        return false
    return true

function isEtherAltarToolRecipeExact(inv: inventory, tool: item) :: boolean:
    set {_voidN} to 0
    set {_retN} to 0
    set {_toolN} to 0
    set {_blockN} to 0
    set {_amN} to 0
    set {_total} to 0
    set {_bad} to false
    loop 5 times:
        set {_it} to slot (loop-number - 1) of {_inv}
        if {_it} is air:
            set {_bad} to true
        else:
            add 1 to {_total}
            if altarAwakeningVoidKey({_it}) is true:
                add 1 to {_voidN}
            else if altarAwakeningReturnKey({_it}) is true:
                add 1 to {_retN}
            else if {_it} is {_tool}:
                add 1 to {_toolN}
            else if {_it} is diamond block:
                add 1 to {_blockN}
            else if {_it} is amethyst shard:
                add 1 to {_amN}
            else:
                set {_bad} to true
    if {_bad} is true:
        return false
    if {_total} is not 5:
        return false
    if {_voidN} is not 1:
        return false
    if {_retN} is not 1:
        return false
    if {_toolN} is not 1:
        return false
    if {_blockN} is not 1:
        return false
    if {_amN} is not 1:
        return false
    return true

