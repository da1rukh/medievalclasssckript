function evoAdminAltarItemByRecipeId(rid: text) :: item:
    set {_r} to {_rid} in lower case
    set {_parts::*} to {_r} split at "_"
    if size of {_parts::*} is not 2:
        return air
    set {_kind} to {_parts::1}
    set {_piece} to {_parts::2}
    if {_piece} is "pick":
        if {_kind} is "ether":
            return altarEtherPickaxeItem()
        if {_kind} is "flame":
            return altarFlamePickaxeItem()
        if {_kind} is "vein":
            return altarVeinPickaxeItem()
        if {_kind} is "fortune":
            return altarFortunePickaxeItem()
        if {_kind} is "void":
            return altarVoidPickaxeItem()
        if {_kind} is "omni":
            return altarOmniPickaxeItem()
    if {_piece} is "sword":
        if {_kind} is "ether":
            return altarEtherSwordItem()
        if {_kind} is "flame":
            return altarFlameSwordItem()
        if {_kind} is "vein":
            return altarVeinSwordItem()
        if {_kind} is "fortune":
            return altarFortuneSwordItem()
        if {_kind} is "void":
            return altarVoidSwordItem()
        if {_kind} is "omni":
            return altarOmniSwordItem()
    if {_piece} is "helm":
        if {_kind} is "ether":
            return altarEtherHelmetItem()
        if {_kind} is "flame":
            return altarFlameHelmetItem()
        if {_kind} is "vein":
            return altarVeinHelmetItem()
        if {_kind} is "fortune":
            return altarFortuneHelmetItem()
        if {_kind} is "void":
            return altarVoidHelmetItem()
        if {_kind} is "omni":
            return altarOmniHelmetItem()
    if {_piece} is "chest":
        if {_kind} is "ether":
            return altarEtherChestplateItem()
        if {_kind} is "flame":
            return altarFlameChestplateItem()
        if {_kind} is "vein":
            return altarVeinChestplateItem()
        if {_kind} is "fortune":
            return altarFortuneChestplateItem()
        if {_kind} is "void":
            return altarVoidChestplateItem()
        if {_kind} is "omni":
            return altarOmniChestplateItem()
    if {_piece} is "legs":
        if {_kind} is "ether":
            return altarEtherLeggingsItem()
        if {_kind} is "flame":
            return altarFlameLeggingsItem()
        if {_kind} is "vein":
            return altarVeinLeggingsItem()
        if {_kind} is "fortune":
            return altarFortuneLeggingsItem()
        if {_kind} is "void":
            return altarVoidLeggingsItem()
        if {_kind} is "omni":
            return altarOmniLeggingsItem()
    if {_piece} is "boots":
        if {_kind} is "ether":
            return altarEtherBootsItem()
        if {_kind} is "flame":
            return altarFlameBootsItem()
        if {_kind} is "vein":
            return altarVeinBootsItem()
        if {_kind} is "fortune":
            return altarFortuneBootsItem()
        if {_kind} is "void":
            return altarVoidBootsItem()
        if {_kind} is "omni":
            return altarOmniBootsItem()
    if {_piece} is "armor":
        if {_kind} is "ether":
            return altarEtherChestplateItem()
        if {_kind} is "flame":
            return altarFlameChestplateItem()
        if {_kind} is "vein":
            return altarVeinChestplateItem()
        if {_kind} is "fortune":
            return altarFortuneChestplateItem()
        if {_kind} is "void":
            return altarVoidChestplateItem()
        if {_kind} is "omni":
            return altarOmniChestplateItem()
    return air

function evoAdminItemById(id: text) :: item:
    set {_id} to {_id} in lower case

    # Базовые altar/ключевые предметы
    if {_id} is "void_key":
        set {_k} to disc fragment 5 named "&5Ключ пустоты"
        set lore of {_k} to "&7Найти в сундуке разрушенного портала" and "&7ПКМ по главному сундуку башни руины" and "&7в Оверворлде — открыть (расходуется)"
        return {_k}
    if {_id} is "key_void":
        set {_k} to disc fragment 5 named "&5Ключ пустоты"
        set lore of {_k} to "&7Найти в сундуке разрушенного портала" and "&7ПКМ по главному сундуку башни руины" and "&7в Оверворлде — открыть (расходуется)"
        return {_k}
    if {_id} is "return_key":
        set {_k} to echo shard named "&3Ключ возврата"
        set lore of {_k} to "&7ПКМ — телепорт на место последней смерти" and "&7Одноразовый" and "&7Точка обновляется при каждой смерти"
        return {_k}
    if {_id} is "key_return":
        set {_k} to echo shard named "&3Ключ возврата"
        set lore of {_k} to "&7ПКМ — телепорт на место последней смерти" and "&7Одноразовый" and "&7Точка обновляется при каждой смерти"
        return {_k}
    if {_id} is "altar_hopper":
        return awakeningHopperTokenItem()
    if {_id} is "awakening_hopper":
        return awakeningHopperTokenItem()
    if {_id} is "ruin_summon":
        return artifactRuinSummonObeliskItem()

    set {_altarItem} to evoAdminAltarItemByRecipeId({_id})
    if {_altarItem} is not air:
        return {_altarItem}

    # Новые крафтабельные артефакты вне ядра
    if {_id} is "heater":
        return portableHeaterItem()
    if {_id} is "dreamcatcher":
        return dreamCatcherItem()
    if {_id} is "desertheart":
        return desertHeartItem()
    if {_id} is "quantdup":
        return quantumDuplicatorItem()
    if {_id} is "facelessmask":
        return facelessMaskItem()
    if {_id} is "cursedgift":
        return cursedKingGiftItem()
    if {_id} is "lootmagnet":
        return lootMagnetItem()
    if {_id} is "nightlens":
        return nightLensItem()

    # Страницы дневника (алтарные рецепты)
    if {_id} starts with "diary_":
        set {_did} to {_id}
        replace all "diary_" in {_did} with ""
        return diaryPageItemForLocalRecipe({_did})

    # Древние свитки (для любого артефакта)
    if {_id} starts with "scroll_":
        set {_sid} to {_id}
        replace all "scroll_" in {_sid} with ""
        set {_sc} to ancientScrollItem({_sid})
        if {_sc} is not air:
            return {_sc}

    # Артефакты из основной системы по id
    set {_slot} to artifactSlotFromKey({_id})
    if {_slot} >= 0:
        return artifactFromSlot({_slot})

    return air

function evoAdminItemIdList() :: texts:
    delete {_ids::*}
    # Ключи / алтарь
    add "void_key" to {_ids::*}
    add "return_key" to {_ids::*}
    add "altar_hopper" to {_ids::*}
    add "ruin_summon" to {_ids::*}
    set {_altarIds::*} to altarLocalRecipeIds()
    loop {_altarIds::*}:
        add loop-value to {_ids::*}
    set {_coreIds::*} to artifactCoreIds()
    loop {_coreIds::*}:
        add loop-value to {_ids::*}
    # Свитки для всех артефактов
    loop "leg_warrior", "leg_scout", "leg_tank", "leg_archer", "leg_mage", "leg_necro", "hermes", "windring", "vampcharm", "etherdash", "mehrunes", "starfury", "icewalker", "frostheart", "ankhshield", "azura", "rottenapple", "voidcompass", "luckcoin", "cloudjump", "crownmind", "heater", "dreamcatcher", "desertheart", "quantdup", "facelessmask", "lootmagnet", "nightlens", "ruin_summon", "awakening_altar" and "cursedgift":
        add "scroll_%loop-value%" to {_ids::*}
    # Свитки и страницы дневника — алтарные кирки, мечи, броня
    loop {_altarIds::*}:
        add "scroll_%loop-value%" to {_ids::*}
        add "diary_%loop-value%" to {_ids::*}
    return {_ids::*}

function isArtifactRecipeByFive(inv: inventory, i1: item, i2: item, i3: item, i4: item, i5: item) :: boolean:
    set {_a} to 0
    set {_b} to 0
    set {_c} to 0
    set {_d} to 0
    set {_e} to 0
    set {_total} to 0
    set {_bad} to false
    loop 5 times:
        set {_it} to slot (loop-number - 1) of {_inv}
        if {_it} is air:
            set {_bad} to true
        else:
            add 1 to {_total}
            if {_it} is {_i1}:
                add 1 to {_a}
            else if {_it} is {_i2}:
                add 1 to {_b}
            else if {_it} is {_i3}:
                add 1 to {_c}
            else if {_it} is {_i4}:
                add 1 to {_d}
            else if {_it} is {_i5}:
                add 1 to {_e}
            else:
                set {_bad} to true
    if {_bad} is true:
        return false
    if {_total} is not 5:
        return false
    if {_a} is not 1:
        return false
    if {_b} is not 1:
        return false
    if {_c} is not 1:
        return false
    if {_d} is not 1:
        return false
    if {_e} is not 1:
        return false
    return true

function isCursedGiftAltarRecipe(inv: inventory) :: boolean:
    return isArtifactRecipeByFive({_inv}, crownHigherMindArtifactItem(), artifactFromSlot(8), enchanted golden apple, player head, netherite ingot)

function giveArtifactScaledExperience(p: player, amount: number):
    set {_xp} to round({_amount})
    if {_xp} < 1:
        set {_xp} to 1
    if hasArtifact({_p}, "crownmind") is true:
        set {_xp} to {_xp} * 3
    loop {_xp} times:
        give 1 experience to {_p}

function diaryRecipeTextByItem(it: item) :: text:
    if {_it} is air:
        return ""
    set {_nm} to name of {_it}
    if {_nm} is not set:
        set {_nm} to "%type of {_it}%"
    set {_nmLow} to lowercase "%{_nm}%"
    if {_nmLow} contains "эфирная кирка":
        return "recipe_local::ether_pick"
    if {_nmLow} contains "пламенная кирка":
        return "recipe_local::flame_pick"
    if {_nmLow} contains "жильная кирка":
        return "recipe_local::vein_pick"
    if {_nmLow} contains "кирка удачи":
        return "recipe_local::fortune_pick"
    if {_nmLow} contains "кирка пустоты":
        return "recipe_local::void_pick"
    if {_nmLow} contains "омни-кирка":
        return "recipe_local::omni_pick"
    if {_nmLow} contains "пульс эфира":
        return "recipe_local::ether_sword"
    if {_nmLow} contains "заря разлома":
        return "recipe_local::flame_sword"
    if {_nmLow} contains "сечение жилы":
        return "recipe_local::vein_sword"
    if {_nmLow} contains "клинок созвездия":
        return "recipe_local::fortune_sword"
    if {_nmLow} contains "разрез бездны":
        return "recipe_local::void_sword"
    if {_nmLow} contains "клинок шести искр":
        return "recipe_local::omni_sword"
    if {_nmLow} contains "эфирный венец":
        return "recipe_local::ether_helm"
    if {_nmLow} contains "пепельная корона":
        return "recipe_local::flame_helm"
    if {_nmLow} contains "шлем корней":
        return "recipe_local::vein_helm"
    if {_nmLow} contains "венец миража":
        return "recipe_local::fortune_helm"
    if {_nmLow} contains "маска бездны":
        return "recipe_local::void_helm"
    if {_nmLow} contains "омни-венец":
        return "recipe_local::omni_helm"
    if {_nmLow} contains "эфирная мантия":
        return "recipe_local::ether_chest"
    if {_nmLow} contains "кираса угольника":
        return "recipe_local::flame_chest"
    if {_nmLow} contains "кираса плети":
        return "recipe_local::vein_chest"
    if {_nmLow} contains "нагрудник охотника":
        return "recipe_local::fortune_chest"
    if {_nmLow} contains "грудь истощения":
        return "recipe_local::void_chest"
    if {_nmLow} contains "омни-мантия":
        return "recipe_local::omni_chest"
    if {_nmLow} contains "эфирные поножи":
        return "recipe_local::ether_legs"
    if {_nmLow} contains "поножи раскала":
        return "recipe_local::flame_legs"
    if {_nmLow} contains "поножи узора":
        return "recipe_local::vein_legs"
    if {_nmLow} contains "поножи добычи":
        return "recipe_local::fortune_legs"
    if {_nmLow} contains "поножи сгущения":
        return "recipe_local::void_legs"
    if {_nmLow} contains "омни-поножи":
        return "recipe_local::omni_legs"
    if {_nmLow} contains "эфирные сапоги":
        return "recipe_local::ether_boots"
    if {_nmLow} contains "сапоги пепла":
        return "recipe_local::flame_boots"
    if {_nmLow} contains "сапоги укоренения":
        return "recipe_local::vein_boots"
    if {_nmLow} contains "сапоги следопыта":
        return "recipe_local::fortune_boots"
    if {_nmLow} contains "сапоги фазового шага":
        return "recipe_local::void_boots"
    if {_nmLow} contains "омни-сапоги":
        return "recipe_local::omni_boots"
    set {_gearRid} to altarGearRecipeIdFromItem({_it})
    if {_gearRid} is not "":
        return {_gearRid}
    if {_nmLow} contains "голова игрока":
        return "recipe_local::player_head"
    return "%{_nm}%: рецепт изучен на Алтаре Создания"

function addDiaryPage(p: player, txt: text):
    set {_t} to "%{_txt}%"
    if {_t} is "":
        stop
    set {_u} to uuid of {_p}
    loop {adv_diary::%{_u}%::*}:
        if "%loop-value%" is {_t}:
            stop
    add {_t} to {adv_diary::%{_u}%::*}

function addDiaryRecipePage(p: player, rid: text):
    set {_r} to "%{_rid}%"
    if {_r} is "":
        stop
    set {_tag} to "recipe::%{_r}%"
    addDiaryPage({_p}, {_tag})

function ensureStarterAdventureDiaryPages(p: player):
    addDiaryRecipePage({_p}, "awakening_altar")
    addDiaryRecipePage({_p}, "ruin_summon")

function diaryRecipeEntryFromItem(it: item) :: text:
    set {_nm} to name of {_it}
    if {_nm} is not set:
        return ""
    loop "leg_warrior", "leg_scout", "leg_tank", "leg_archer", "leg_mage", "leg_necro", "hermes", "windring", "vampcharm", "etherdash", "mehrunes", "starfury", "icewalker", "frostheart", "ankhshield", "azura", "rottenapple", "voidcompass", "luckcoin", "cloudjump", "crownmind", "heater", "dreamcatcher", "desertheart", "quantdup", "facelessmask", "lootmagnet", "nightlens", "ruin_summon", "awakening_altar" and "cursedgift":
        set {_n} to {ancient_scroll_recipes::%loop-value%::name}
        if {_n} is set:
            if {_nm} contains {_n}:
                return loop-value
    set {_altarIds::*} to altarLocalRecipeIds()
    loop {_altarIds::*}:
        set {_n} to {ancient_scroll_recipes::%loop-value%::name}
        if {_n} is set:
            if {_nm} contains {_n}:
                return loop-value
    set {_txt} to diaryRecipeTextByItem({_it})
    if {_txt} starts with "recipe_local::":
        set {_rid} to {_txt}
        replace all "recipe_local::" in {_rid} with ""
        if {ancient_scroll_recipes::%{_rid}%::name} is set:
            return {_rid}
    return ""

function openAdventurerJournalPage(p: player, page: number):
    delete {_entries::*}
    loop {adv_diary::%uuid of {_p}%::*}:
        if "%loop-value%" is not "":
            add "%loop-value%" to {_entries::*}
    set {_total} to size of {_entries::*}
    if {_total} <= 0:
        open chest inventory with 3 rows named "Дневник приключенца" to {_p}
        wait 1 tick
        set slot 13 of current inventory of {_p} to writable book named "&6Дневник приключенца" with lore "&7Пока пусто." and "&8Крафтите на алтаре, чтобы" and "&8добавлять рецепты автоматически"
        stop
    set {_maxPage} to floor(({_total} - 1) / 5) + 1
    set {_pg} to {_page}
    if {_pg} < 1:
        set {_pg} to 1
    if {_pg} > {_maxPage}:
        set {_pg} to {_maxPage}
    set {adv_diary_open_page::%uuid of {_p}%} to {_pg}
    open chest inventory with 3 rows named "Дневник приключенца" to {_p}
    wait 1 tick
    set {_start} to ({_pg} - 1) * 5 + 1
    set {_slot} to 10
    loop 5 times:
        set {_idx} to {_start} + loop-number - 1
        if {_idx} <= {_total}:
            set {_txt} to {_entries::%{_idx}%}
            if {_txt} starts with "recipe::":
                set {_rid} to {_txt}
                replace all "recipe::" in {_rid} with ""
                set {_rn} to {ancient_scroll_recipes::%{_rid}%::name}
                if {_rn} is not set:
                    set {_rn} to {_rid}
                set {_i1} to {ancient_scroll_recipes::%{_rid}%::ing::1}
                set {_i2} to {ancient_scroll_recipes::%{_rid}%::ing::2}
                set {_i3} to {ancient_scroll_recipes::%{_rid}%::ing::3}
                set {_i4} to {ancient_scroll_recipes::%{_rid}%::ing::4}
                set {_i5} to {ancient_scroll_recipes::%{_rid}%::ing::5}
                if {_rid} is "ruin_summon":
                    set slot {_slot} of current inventory of {_p} to paper named "&fСтраница %{_idx}%" with lore "&6Рецепт: &f%{_rn}%" and "&8 • &f%{_i1}%" and "&8 • &f%{_i2}%" and "&8 • &f%{_i3}%" and "&8 • &f%{_i4}%" and "&8 • &f%{_i5}%" and "&7Сундук: только эти 5 предметов, слоты 0–4" and "&7— затем открыть сундук (Оверворлд)."
                else:
                    set slot {_slot} of current inventory of {_p} to paper named "&fСтраница %{_idx}%" with lore "&6Рецепт: &f%{_rn}%" and "&8 • &f%{_i1}%" and "&8 • &f%{_i2}%" and "&8 • &f%{_i3}%" and "&8 • &f%{_i4}%" and "&8 • &f%{_i5}%"
            else if {_txt} starts with "recipe_local::":
                set {_rid} to {_txt}
                replace all "recipe_local::" in {_rid} with ""
                if {_rid} is "player_head":
                    set slot {_slot} of current inventory of {_p} to paper named "&fСтраница %{_idx}%" with lore "&6Рецепт: &fГолова игрока" and "&8 • &fДёрн" and "&8 • &fЗолотое яблоко" and "&8 • &fАлмаз" and "&8 • &fНезерак" and "&8 • &fКамень Энда"
                else:
                    set {_lore::*} to altarLocalRecipePageLore({_rid})
                    set slot {_slot} of current inventory of {_p} to paper named "&fСтраница %{_idx}%" with lore {_lore::*}
            else:
                set slot {_slot} of current inventory of {_p} to paper named "&fСтраница %{_idx}%" with lore "&7%{_txt}%"
        add 1 to {_slot}
    set slot 4 of current inventory of {_p} to written book named "&6Дневник приключенца" with lore "&7Страница %{_pg}% из %{_maxPage}%" and "&8Нажмите стрелки для листания"
    if {_pg} > 1:
        set slot 18 of current inventory of {_p} to arrow named "&eНазад"
    if {_pg} < {_maxPage}:
        set slot 26 of current inventory of {_p} to arrow named "&eВперёд"

function openAdventurerJournal(p: player):
    openAdventurerJournalPage({_p}, 1)

command /diary:
    trigger:
        openAdventurerJournal(player)

function openLoreGuiPage(p: player, page: number):
    set {_pg} to {_page}
    if {_pg} < 1:
        set {_pg} to 1
    if {_pg} > 4:
        set {_pg} to 4
    set {evo_lore_page::%uuid of {_p}%} to {_pg}
    open chest inventory with 3 rows named "Хроники Расколотой Пустоты" to {_p}
    wait 1 tick
    set slot 4 of current inventory of {_p} to written book named "&5&lМегалор Эпохи" with lore "&7Страница %{_pg}% из 4" and "&8Подсказки спрятаны в тексте"
    if {_pg} is 1:
        set slot 11 of current inventory of {_p} to paper named "&8I. &dАлтарь Создания" with lore "&7Когда небо над миром почернело, под камнем" and "&7проснулся Шёпот. Он не убивает сразу —" and "&7он учит, оставляя знаки тем, кто слушает." and " " and "&7Сундук помнит ритуал лучше, чем рука." and "&7Ключи, обсидиан и аметист должны лечь" and "&7без лишнего груза — тогда камень сам" and "&7соберёт основу, а сердце попросит хоппер." and " " and "&8Намёк: у ритуала всегда 5 ингредиентов" and "&8там, где ждут 5 слотов."
        set slot 15 of current inventory of {_p} to hopper named "&5Сердце Алтаря" with lore "&7Поставь в центр завершённой конструкции"
    else if {_pg} is 2:
        set slot 11 of current inventory of {_p} to paper named "&8II. &6Зов Руин" with lore "&7Руины не любят спешку и не слышат" and "&7случайный клик. Только тот, кто пригнулся" and "&7и отметил блок, может разбудить их." and " " and "&7Сундук (слоты 0–4): плачущий обсидиан," and "&7обсидиан, аметистовый блок, эндер-жемчуг," and "&7незеритовый лом — только это, затем открыть." and " " and "&8Намёк: Зов отвечает в Оверворлде," and "&8на подходящей поверхности и подальше" and "&8от мирового спавна."
        set slot 15 of current inventory of {_p} to respawn anchor named "&6Зов Руин" with lore "&7Shift+ПКМ по блоку — возвести руину" and "&7Крафт: 5 слотов сундука, см. слева"
    else if {_pg} is 3:
        set slot 11 of current inventory of {_p} to paper named "&8III. &5Ключи Башни и Памяти" with lore "&7Ключ Пустоты открывает сердце башни." and "&7Ключ Возврата слышит только последнюю смерть" and "&7и сгорает вместе с пройденным путём." and " " and "&8Намёк: держи Возврат отдельно," and "&8чтобы не сжечь его не в тот момент."
        set slot 14 of current inventory of {_p} to evoAdminItemById("void_key")
        set slot 16 of current inventory of {_p} to evoAdminItemById("return_key")
    else:
        set slot 11 of current inventory of {_p} to paper named "&8IV. &eСвитки, Дневник, Ядра" with lore "&7Свитки — это не сила, а знание." and "&7Дневник хранит рецепты, но смерть" and "&7вырывает случайную страницу." and " " and "&7Обычное ядро любит порядок," and "&7Utility-ядро любит полезность." and " " and "&8Намёк: проверяй, что включено в ядрах," and "&8и подбирай потерянные страницы после боя."
        set slot 15 of current inventory of {_p} to written book named "&5&lФинальная запись" with lore "&7Кто читает знаки — выживает." and "&7Кто игнорирует — кормит руины."
    if {_pg} > 1:
        set slot 18 of current inventory of {_p} to arrow named "&eНазад"
    if {_pg} < 4:
        set slot 26 of current inventory of {_p} to arrow named "&eВперёд"

function openLoreGui(p: player):
    openLoreGuiPage({_p}, 1)

command /lore:
    trigger:
        openLoreGui(player)

on inventory click:
    if event-inventory is not set:
        stop
    if name of event-inventory is not "Хроники Расколотой Пустоты":
        stop
    cancel event
    set {_pg} to {evo_lore_page::%uuid of player%}
    if {_pg} is not set:
        set {_pg} to 1
    if clicked slot is 18:
        openLoreGuiPage(player, {_pg} - 1)
        stop
    if clicked slot is 26:
        openLoreGuiPage(player, {_pg} + 1)
        stop

on inventory close:
    if event-inventory is set:
        if name of event-inventory is "Хроники Расколотой Пустоты":
            delete {evo_lore_page::%uuid of player%}

on inventory click:
    if event-inventory is not set:
        stop
    if name of event-inventory is not "Дневник приключенца":
        stop
    cancel event
    set {_pg} to {adv_diary_open_page::%uuid of player%}
    if {_pg} is not set:
        set {_pg} to 1
    if clicked slot is 18:
        openAdventurerJournalPage(player, {_pg} - 1)
        stop
    if clicked slot is 26:
        openAdventurerJournalPage(player, {_pg} + 1)
        stop

on inventory close:
    if event-inventory is set:
        if name of event-inventory is "Дневник приключенца":
            delete {adv_diary_open_page::%uuid of player%}

on death of player:
    set {_u} to uuid of victim
    delete {_pages::*}
    loop {adv_diary::%{_u}%::*}:
        if "%loop-value%" is not "":
            add "%loop-value%" to {_pages::*}
    if size of {_pages::*} > 0:
        set {_pick} to random element out of {_pages::*}
        remove {_pick} from {adv_diary::%{_u}%::*}
        set {_page} to paper named "&6Страница дневника приключенца"
        set lore of {_page} to "&7%{_pick}%" and "&8ПКМ: изучить как свиток" and "&0EVODIARY:%{_pick}%"
        drop {_page} at location of victim

function debugEtherPickaxeRecipe(inv: inventory, p: player):
    if isEvoDebug({_p}) is false:
        stop
    set {_voidN} to 0
    set {_retN} to 0
    set {_pickN} to 0
    set {_blockN} to 0
    set {_amN} to 0
    set {_total} to 0
    set {_bad} to 0
    loop 5 times:
        set {_si} to loop-number - 1
        set {_it} to slot {_si} of {_inv}
        if {_it} is air:
            send "{@prefix} &8[debug] slot %{_si}%: &cпусто" to {_p}
        else:
            add 1 to {_total}
            set {_nm} to name of {_it}
            if {_nm} is not set:
                set {_nm} to "&7без имени"
            if altarAwakeningVoidKey({_it}) is true:
                add 1 to {_voidN}
                send "{@prefix} &8[debug] slot %{_si}%: &dключ пустоты &8(%{_nm}%)" to {_p}
            else if altarAwakeningReturnKey({_it}) is true:
                add 1 to {_retN}
                send "{@prefix} &8[debug] slot %{_si}%: &bключ возврата &8(%{_nm}%)" to {_p}
            else if {_it} is diamond pickaxe:
                add 1 to {_pickN}
                send "{@prefix} &8[debug] slot %{_si}%: &fалмазная кирка" to {_p}
            else if {_it} is diamond block:
                add 1 to {_blockN}
                send "{@prefix} &8[debug] slot %{_si}%: &bалмазный блок" to {_p}
            else if {_it} is amethyst shard:
                add 1 to {_amN}
                send "{@prefix} &8[debug] slot %{_si}%: &dаметистовый осколок" to {_p}
            else:
                add 1 to {_bad}
                send "{@prefix} &8[debug] slot %{_si}%: &cчужой предмет &8(%type of {_it}% | %{_nm}%)" to {_p}
    send "{@prefix} &8[debug] total=%{_total}% bad=%{_bad}% | void=%{_voidN}% ret=%{_retN}% pick=%{_pickN}% block=%{_blockN}% am=%{_amN}%" to {_p}

function isAwakeningCraftHopperReady(hb: block) :: boolean:
    if {_hb} is not hopper:
        return false
    set {_w} to world of {_hb}
    set {_x} to floor(x-coordinate of {_hb})
    set {_y} to floor(y-coordinate of {_hb})
    set {_z} to floor(z-coordinate of {_hb})
    set {_ped} to block at location at {_x}, {_y} - 1, {_z} in {_w}
    if {_ped} is not amethyst block:
        return false
    set {_top} to block at location at {_x}, {_y} + 1, {_z} in {_w}
    if {_top} is not crying obsidian:
        return false
    set {_btn} to block at location at {_x}, {_y} + 1, {_z} - 1 in {_w}
    if {_btn} is not stone button:
        return false
    return true

function tryCraftAwakeningAltarAt(hb: block, crafter: player) :: boolean:
    if {_hb} is not hopper:
        return false
    # Для крафта важна рабочая связка (кнопка/верх/воронка/пьедестал), а не идеальная оболочка.
    if isAwakeningCraftHopperReady({_hb}) is false:
        if {_crafter} is set:
            if isEvoDebug({_crafter}) is true:
                send "{@prefix} &8[debug] ready-check: FAIL (воронка/аметист/верх/кнопка)" to {_crafter}
        return false
    set {_inv} to inventory of {_hb}
    set {_outItem} to air
    if isEtherPickaxeAltarRecipeExact({_inv}) is true:
        set {_outItem} to altarEtherPickaxeItem()
    else if isPickaxeRecipeByCore({_inv}, gold block, blaze rod) is true:
        set {_outItem} to altarFlamePickaxeItem()
    else if isPickaxeRecipeByCore({_inv}, emerald block, slime ball) is true:
        set {_outItem} to altarVeinPickaxeItem()
    else if isPickaxeRecipeByCore({_inv}, gold block, lapis lazuli) is true:
        set {_outItem} to altarFortunePickaxeItem()
    else if isPickaxeRecipeByCore({_inv}, obsidian, ender pearl) is true:
        set {_outItem} to altarVoidPickaxeItem()
    else if isOmniPickaxeAltarRecipe({_inv}) is true:
        set {_outItem} to altarOmniPickaxeItem()
    else if isEtherAltarToolRecipeExact({_inv}, diamond sword) is true:
        set {_outItem} to altarEtherSwordItem()
    else if isAltarKeyToolRecipe({_inv}, diamond sword, gold block, blaze rod) is true:
        set {_outItem} to altarFlameSwordItem()
    else if isAltarKeyToolRecipe({_inv}, diamond sword, emerald block, slime ball) is true:
        set {_outItem} to altarVeinSwordItem()
    else if isAltarKeyToolRecipe({_inv}, diamond sword, gold block, lapis lazuli) is true:
        set {_outItem} to altarFortuneSwordItem()
    else if isAltarKeyToolRecipe({_inv}, diamond sword, obsidian, ender pearl) is true:
        set {_outItem} to altarVoidSwordItem()
    else if isOmniSwordAltarRecipe({_inv}) is true:
        set {_outItem} to altarOmniSwordItem()
    else if isEtherAltarToolRecipeExact({_inv}, diamond helmet) is true:
        set {_outItem} to altarEtherHelmetItem()
    else if isAltarKeyToolRecipe({_inv}, diamond helmet, gold block, blaze rod) is true:
        set {_outItem} to altarFlameHelmetItem()
    else if isAltarKeyToolRecipe({_inv}, diamond helmet, emerald block, slime ball) is true:
        set {_outItem} to altarVeinHelmetItem()
    else if isAltarKeyToolRecipe({_inv}, diamond helmet, gold block, lapis lazuli) is true:
        set {_outItem} to altarFortuneHelmetItem()
    else if isAltarKeyToolRecipe({_inv}, diamond helmet, obsidian, ender pearl) is true:
        set {_outItem} to altarVoidHelmetItem()
    else if isOmniAltarHelmetRecipe({_inv}) is true:
        set {_outItem} to altarOmniHelmetItem()
    else if isEtherAltarToolRecipeExact({_inv}, diamond chestplate) is true:
        set {_outItem} to altarEtherChestplateItem()
    else if isAltarKeyToolRecipe({_inv}, diamond chestplate, gold block, blaze rod) is true:
        set {_outItem} to altarFlameChestplateItem()
    else if isAltarKeyToolRecipe({_inv}, diamond chestplate, emerald block, slime ball) is true:
        set {_outItem} to altarVeinChestplateItem()
    else if isAltarKeyToolRecipe({_inv}, diamond chestplate, gold block, lapis lazuli) is true:
        set {_outItem} to altarFortuneChestplateItem()
    else if isAltarKeyToolRecipe({_inv}, diamond chestplate, obsidian, ender pearl) is true:
        set {_outItem} to altarVoidChestplateItem()
    else if isOmniAltarChestplateRecipe({_inv}) is true:
        set {_outItem} to altarOmniChestplateItem()
    else if isEtherAltarToolRecipeExact({_inv}, diamond leggings) is true:
        set {_outItem} to altarEtherLeggingsItem()
    else if isAltarKeyToolRecipe({_inv}, diamond leggings, gold block, blaze rod) is true:
        set {_outItem} to altarFlameLeggingsItem()
    else if isAltarKeyToolRecipe({_inv}, diamond leggings, emerald block, slime ball) is true:
        set {_outItem} to altarVeinLeggingsItem()
    else if isAltarKeyToolRecipe({_inv}, diamond leggings, gold block, lapis lazuli) is true:
        set {_outItem} to altarFortuneLeggingsItem()
    else if isAltarKeyToolRecipe({_inv}, diamond leggings, obsidian, ender pearl) is true:
        set {_outItem} to altarVoidLeggingsItem()
    else if isOmniAltarLeggingsRecipe({_inv}) is true:
        set {_outItem} to altarOmniLeggingsItem()
    else if isEtherAltarToolRecipeExact({_inv}, diamond boots) is true:
        set {_outItem} to altarEtherBootsItem()
    else if isAltarKeyToolRecipe({_inv}, diamond boots, gold block, blaze rod) is true:
        set {_outItem} to altarFlameBootsItem()
    else if isAltarKeyToolRecipe({_inv}, diamond boots, emerald block, slime ball) is true:
        set {_outItem} to altarVeinBootsItem()
    else if isAltarKeyToolRecipe({_inv}, diamond boots, gold block, lapis lazuli) is true:
        set {_outItem} to altarFortuneBootsItem()
    else if isAltarKeyToolRecipe({_inv}, diamond boots, obsidian, ender pearl) is true:
        set {_outItem} to altarVoidBootsItem()
    else if isOmniAltarBootsRecipe({_inv}) is true:
        set {_outItem} to altarOmniBootsItem()
    else if isArtifactRecipeByFive({_inv}, netherite sword, blaze rod, redstone block, ender pearl, diamond block) is true:
        set {_outItem} to artifactFromSlot(0)
    else if isArtifactRecipeByFive({_inv}, netherite boots, phantom membrane, echo shard, diamond block, ender pearl) is true:
        set {_outItem} to artifactFromSlot(1)
    else if isArtifactRecipeByFive({_inv}, netherite chestplate, obsidian, shield, iron block, golden apple) is true:
        set {_outItem} to artifactFromSlot(2)
    else if isArtifactRecipeByFive({_inv}, spectral arrow, bow, netherite ingot, ender eye, emerald block) is true:
        set {_outItem} to artifactFromSlot(6)
    else if isArtifactRecipeByFive({_inv}, amethyst block, blaze rod, enchanted book, ender eye, ghast tear) is true:
        set {_outItem} to artifactFromSlot(7)
    else if isArtifactRecipeByFive({_inv}, netherite chestplate, wither skeleton skull, soul sand, totem of undying, nether wart block) is true:
        set {_outItem} to artifactFromSlot(8)
    else if isArtifactRecipeByFive({_inv}, leather boots, rabbit foot, sugar, feather, gold ingot) is true:
        set {_outItem} to artifactFromSlot(10)
    else if isArtifactRecipeByFive({_inv}, gold nugget, sugar, emerald, feather, gold ingot) is true:
        set {_outItem} to artifactFromSlot(11)
    else if isArtifactRecipeByFive({_inv}, ghast tear, spider eye, fermented spider eye, redstone, gold ingot) is true:
        set {_outItem} to artifactFromSlot(12)
    else if isArtifactRecipeByFive({_inv}, ender pearl, chorus fruit, amethyst shard, phantom membrane, gold ingot) is true:
        set {_outItem} to artifactFromSlot(13)
    else if isArtifactRecipeByFive({_inv}, iron sword, blaze powder, nether wart, magma cream, gold ingot) is true:
        set {_outItem} to artifactFromSlot(14)
    else if isArtifactRecipeByFive({_inv}, diamond sword, nether star, glowstone dust, fire charge, gold ingot) is true:
        set {_outItem} to artifactFromSlot(15)
    else if isArtifactRecipeByFive({_inv}, packed ice, blue ice, snow block, prismarine crystals, gold ingot) is true:
        set {_outItem} to artifactFromSlot(16)
    else if isArtifactRecipeByFive({_inv}, heart of the sea, ice, snowball, prismarine shard, gold ingot) is true:
        set {_outItem} to artifactFromSlot(19)
    else if isArtifactRecipeByFive({_inv}, shield, golden apple, iron ingot, totem of undying, gold ingot) is true:
        set {_outItem} to artifactFromSlot(20)
    else if isArtifactRecipeByFive({_inv}, nether star, amethyst shard, experience bottle, lapis lazuli, gold ingot) is true:
        set {_outItem} to artifactFromSlot(21)
    else if isArtifactRecipeByFive({_inv}, poisonous potato, rotten flesh, spider eye, bone meal, gold ingot) is true:
        set {_outItem} to artifactFromSlot(22)
    else if isArtifactRecipeByFive({_inv}, compass, obsidian, ender pearl, amethyst shard, gold ingot) is true:
        set {_outItem} to artifactFromSlot(23)
    else if isArtifactRecipeByFive({_inv}, gold ingot, emerald, rabbit foot, wheat seeds, lapis lazuli) is true:
        set {_outItem} to artifactFromSlot(24)
    else if isArtifactRecipeByFive({_inv}, glass bottle, feather, phantom membrane, slime ball, gold ingot) is true:
        set {_outItem} to artifactFromSlot(25)
    else if isCrownHigherMindAltarRecipe({_inv}) is true:
        set {_outItem} to crownHigherMindArtifactItem()
    else if isArtifactRecipeByFive({_inv}, furnace, blaze powder, copper block, coal, iron ingot) is true:
        set {_outItem} to portableHeaterItem()
    else if isArtifactRecipeByFive({_inv}, string, cobweb, glowstone dust, feather, gold nugget) is true:
        set {_outItem} to dreamCatcherItem()
    else if isArtifactRecipeByFive({_inv}, cactus, soul sand, blaze powder, gold ingot, flint) is true:
        set {_outItem} to desertHeartItem()
    else if isArtifactRecipeByFive({_inv}, dispenser, amethyst shard, copper ingot, redstone block, glowstone dust) is true:
        set {_outItem} to quantumDuplicatorItem()
    else if isArtifactRecipeByFive({_inv}, leather, white wool, potion of invisibility, ink sac, gold ingot) is true:
        set {_outItem} to facelessMaskItem()
    else if isArtifactRecipeByFive({_inv}, hopper, redstone, iron ingot, ender pearl, gold nugget) is true:
        set {_outItem} to lootMagnetItem()
    else if isArtifactRecipeByFive({_inv}, glass, glowstone dust, amethyst shard, phantom membrane, spider eye) is true:
        set {_outItem} to nightLensItem()
    else if isArtifactRecipeByFive({_inv}, grass block, golden apple, diamond, netherrack, end stone) is true:
        set {_outItem} to player head
    else if isCursedGiftAltarRecipe({_inv}) is true:
        set {_outItem} to cursedKingGiftItem()
    else:
        if {_crafter} is set:
            if isEvoDebug({_crafter}) is true:
                send "{@prefix} &8[debug] recipe-check: FAIL" to {_crafter}
                debugEtherPickaxeRecipe({_inv}, {_crafter})
        return false
    clearAltarCraftSlots({_inv})
    set {_out} to location of {_hb}
    add 1 to y-coordinate of {_out}
    strike lightning effect at {_out}
    execute console command "execute positioned %x-coordinate of {_out}% %y-coordinate of {_out}% %z-coordinate of {_out}% run particle minecraft:witch ~ ~ ~ 0.35 0.35 0.35 0.01 30 force"
    execute console command "execute positioned %x-coordinate of {_out}% %y-coordinate of {_out}% %z-coordinate of {_out}% run particle minecraft:portal ~ ~0.4 ~ 0.45 0.35 0.45 0.01 40 force"
    if {_crafter} is set:
        giveOrDrop({_outItem}, {_crafter}, {_out})
    else:
        drop {_outItem} at {_out}
    play sound "block.enchantment_table.use" with volume 1 and pitch 0.8 at {_out} for all players
    if {_crafter} is set:
        set {_rid} to diaryRecipeEntryFromItem({_outItem})
        if {_rid} is not "":
            addDiaryRecipePage({_crafter}, {_rid})
            send action bar "&6+Рецепт добавлен в Дневник" to {_crafter}
        else:
            set {_j} to diaryRecipeTextByItem({_outItem})
            if {_j} is not "":
                addDiaryPage({_crafter}, {_j})
                send action bar "&6+Запись в Дневник приключенца" to {_crafter}
        send "{@prefix} &dКрафт подтверждён." to {_crafter}
    return true

function isAwakeningAltarStructurePart(loc: location) :: boolean:
    set {_lw} to world of {_loc}
    set {_lx} to floor(x-coordinate of {_loc})
    set {_ly} to floor(y-coordinate of {_loc})
    set {_lz} to floor(z-coordinate of {_loc})
    loop {awakening_altar_bases::*}:
        set {_base} to loop-value
        if world of {_base} is not {_lw}:
            continue
        set {_bx} to floor(x-coordinate of {_base})
        set {_by} to floor(y-coordinate of {_base})
        set {_bz} to floor(z-coordinate of {_base})
        if {_ly} < {_by}:
            continue
        if {_ly} > {_by} + 2:
            if {_ly} is not {_by} + 3:
                continue
        if {_lx} < {_bx} - 1:
            continue
        if {_lx} > {_bx} + 1:
            continue
        if {_lz} < {_bz} - 1:
            continue
        if {_lz} > {_bz} + 1:
            continue
        if {_ly} is {_by} + 3:
            if {_lx} is {_bx}:
                if {_lz} is {_bz}:
                    return true
            continue
        set {_rdx} to {_lx} - {_bx}
        set {_rdy} to {_ly} - {_by}
        set {_rdz} to {_lz} - {_bz}
        if {_rdy} is 1:
            if isAwakeningAltarFaceHoleMiddle({_rdx}, {_rdz}) is true:
                continue
        return true
    return false

on place of hopper:
    wait 1 tick
    set {_pit} to event-item
    tryCompleteAwakeningAltarHopper(player, event-block, {_pit})

# «Зов Руин» — якорь возрождения: без Shift легко поставить блок и потерять предмет; постройка руины только Shift+ПКМ.
on place of respawn anchor:
    if player is not set:
        stop
    set {_pit} to event-item
    if isArtifactRuinSummonItem({_pit}) is false:
        stop
    if player is not sneaking:
        cancel event
        send action bar "&7Зов Руин: зажми Shift и ПКМ по блоку в Оверворлде — вызвать руину." to player

# Алтарь из сундука: проверка при изменении инвентаря сундука.
on inventory click:
    set {_do} to false
    if event-inventory is set:
        set {_h1} to holder of event-inventory
        if {_h1} is chest:
            set {_do} to true
        else if {_h1} is trapped chest:
            set {_do} to true
    if clicked inventory is set:
        if clicked inventory is not event-inventory:
            set {_h2} to holder of clicked inventory
            if {_h2} is chest:
                set {_do} to true
            else if {_h2} is trapped chest:
                set {_do} to true
    if {_do} is false:
        stop
    wait 1 tick
    set {_pl} to player
    if event-inventory is set:
        tryBuildAwakeningAltarFromInventoryHolder(holder of event-inventory, {_pl})
    if clicked inventory is set:
        if clicked inventory is not event-inventory:
            tryBuildAwakeningAltarFromInventoryHolder(holder of clicked inventory, {_pl})

on inventory drag:
    if event-inventory is player's inventory:
        stop
    set {_hd} to holder of event-inventory
    if {_hd} is not chest:
        if {_hd} is not trapped chest:
            stop
    wait 1 tick
    tryBuildAwakeningAltarFromInventoryHolder({_hd}, player)

on inventory item move:
    set {_dest} to holder of event-inventory
    if {_dest} is not set:
        stop
    if {_dest} is not chest:
        if {_dest} is not trapped chest:
            stop
    if event-item is not disc fragment 5:
        if event-item is not crying obsidian:
            if event-item is not obsidian:
                if event-item is not amethyst shard:
                    stop
    wait 1 tick
    tryBuildAwakeningAltarAtChestBlock({_dest})

every 2 seconds:
    loop {awakening_altars::*}:
        set {_loc} to loop-value
        set {_b} to block at {_loc}
        if {_b} is not hopper:
            remove loop-value from {awakening_altars::*}
            continue
        # Автокрафт отключён: подтверждение теперь только кнопкой/ПКМ по алтарю.
        continue

on right click on stone button:
    set {_rb} to event-block
    if {_rb} is not set:
        stop
    set {_bw} to world of {_rb}
    set {_bx} to floor(x-coordinate of {_rb})
    set {_by} to floor(y-coordinate of {_rb})
    set {_bz} to floor(z-coordinate of {_rb})
    set {_top} to block at location at {_bx}, {_by}, {_bz} + 1 in {_bw}
    if {_top} is not crying obsidian:
        send "{@prefix} &7Крафт не подтверждён: это не кнопка алтаря." to player
        play sound "block.note_block.bass" with volume 0.8 and pitch 0.7 at player for player
        stop
    set {_hb} to block at location at {_bx}, {_by} - 1, {_bz} + 1 in {_bw}
    if {_hb} is not hopper:
        send "{@prefix} &cАлтарь не завершён: поставь воронку в центр." to player
        play sound "block.note_block.bass" with volume 0.8 and pitch 0.7 at player for player
        stop
    if tryCraftAwakeningAltarAt({_hb}, player) is false:
        send "{@prefix} &7Крафт не подтверждён: проверь 5 ингредиентов в слотах 0–4 воронки." to player
        if isEvoDebug(player) is true:
            if isAwakeningCraftHopperReady({_hb}) is false:
                send "{@prefix} &8[debug] не готово ядро: нужен аметист под воронкой, плачущий обсидиан сверху и кнопка на северной стороне." to player
            debugEtherPickaxeRecipe(inventory of {_hb}, player)
        play sound "block.note_block.bass" with volume 0.8 and pitch 0.7 at player for player
    else:
        cancel event

command /altar:
    permission: evo.admin
    permission message: {@prefix} &cУ вас нет прав!
    trigger:
        send "{@prefix} &7Алтарь: положи в сундук &fровно &7рецепт и больше ничего:"
        send "{@prefix} &f5× ключ пустоты&7, &f3× плачущий обсидиан&7, &f3× обсидиан&7, &f3× аметистовый осколок."
        send "{@prefix} &7Появится куб без воронки; именную воронку получишь в инвентарь — поставь её на центральный аметист."
        send "{@prefix} &7Крафт подтверждается нажатием &fодной каменной кнопки &7на плачущем обсидиане (сбоку)."
        send "{@prefix} &7Алтарная кирка: &fПКМ по воздуху &7— шёлковое касание (целые блоки руды/мусора); &fShift+ПКМ &7— эфирный режим (пыль с мусора)."
        send "{@prefix} &6Рецепты алтарных кирок (слоты 0–4, порядок любой):"
        send "{@prefix} &dЭфирная: &5Ключ пустоты + &bКлюч возврата + &fалмазная кирка + &bалмазный блок + &dаметистовый осколок"
        send "{@prefix} &cПламенная: &5Ключ пустоты + &bКлюч возврата + &fалмазная кирка + &bалмазный блок + &6blaze rod"
        send "{@prefix} &aЖильная: &5Ключ пустоты + &bКлюч возврата + &fалмазная кирка + &aизумрудный блок + &aslime ball"
        send "{@prefix} &eУдачи: &5Ключ пустоты + &bКлюч возврата + &fалмазная кирка + &eзолотой блок + &9лазурит"
        send "{@prefix} &5Пустоты: &5Ключ пустоты + &bКлюч возврата + &fалмазная кирка + &8обсидиан + &5эндер-жемчуг"
        send "{@prefix} &6Омни-слияние кирок: &7положи в 0–4 все 5 алтарных кирок (Эфирная, Пламенная, Жильная, Удачи, Пустоты)."
        send "{@prefix} &6Мечи и броня (шлем/нагрудник/поножи/сапоги) — как кирки:"
        send "{@prefix} &7Эфир: ключи + алм. предмет + алм. блок + аметист"
        send "{@prefix} &7Пламя: ключи + алм. предмет + зол. блок + blaze rod"
        send "{@prefix} &7Жила: ключи + алм. предмет + изумруд + слизь"
        send "{@prefix} &7Удача: ключи + алм. предмет + зол. блок + лазурит"
        send "{@prefix} &7Пустота: ключи + алм. предмет + обсидиан + эндер-жемчуг"
        send "{@prefix} &6Омни-слияние: &75 предметов &fодного слота &7(меч/шлем/...) разных тем."
        send "{@prefix} &7У каждой части брони своё имя и свой эффект — см. /diary после крафта."
        send "{@prefix} &7Бонус ❤: жила-нагрудник +2, пустота-нагрудник +1, удача-шлем +1, эфир-сапоги +1; омни-слоты суммируют."
        send "{@prefix} &7Пассивные зелья брони: Speed/Luck/Jump/NV — refresh каждые 4с (remove+15с). Slow falling не даётся."
        send "{@prefix} &7Все эффекты мечей и брони работают и в PvE, и в PvP."
        send "{@prefix} &fГолова игрока: &aдёрн + &6золотое яблоко + &bалмаз + &cnetherrack + &fкамень энда."
        send "{@prefix} &6Корона Высшего Разума: &6Эфирный Разум + &dЗвезда Азуры + &eзолотой шлем + &fenchanted book + &aпузырёк опыта."
        send "{@prefix} &6Портативный Нагреватель: &7печка + blaze powder + медный блок + уголь + железный слиток"
        send "{@prefix} &6Ловец Снов: &7нить + паутина + светокаменная пыль + перо + золотой самородок"
        send "{@prefix} &6Сердце Пустыни: &7кактус + песок душ + blaze powder + золотой слиток + кремень"
        send "{@prefix} &6Квантовый Дубликатор: &7раздатчик + аметист + медный слиток + блок редстоуна + светопыль"
        send "{@prefix} &6Маска Безликого: &7кожа + белая шерсть + зелье невидимости + чернильный мешок + золотой слиток"
        send "{@prefix} &6Магнит Добытчика: &7воронка + железный слиток + редстоун + эндер-жемчуг + золотой самородок"
        send "{@prefix} &6Линза Ночи: &7стекло + светокаменная пыль + аметистовый осколок + мембрана фантома + паучий глаз"
        send "{@prefix} &6Дар Проклятого Короля: &7посох некро-тирана + корона + зачар. золотое яблоко + голова + незерит"

function pullArtifactFromCore(p: player, key: text) :: boolean:
    set {_u} to uuid of {_p}
    if {art_found::%{_u}%::%{_key}%} is not true:
        return false
    set {_s} to artifactSlotFromKey({_key})
    if {_s} < 0:
        return false
    set {_it} to artifactFromSlot({_s})
    if {_it} is air:
        return false
    set {art_found::%{_u}%::%{_key}%} to false
    set {art_enabled::%{_u}%::%{_key}%} to false
    if {_key} is "cloudjump":
        resetBalloonState({_p})
    give {_it} to {_p}
    return true

function hasArtifact(p: player, key: text) :: boolean:
    set {_u} to uuid of {_p}
    if {ghost::%{_u}%} is true:
        return false
    if {art_found::%{_u}%::%{_key}%} is true:
        if {art_enabled::%{_u}%::%{_key}%} is true:
            return true
    return false

function artifactCoreCount(p: player) :: number:
    set {_u} to uuid of {_p}
    set {_n} to 0
    loop "hermes", "windring", "vampcharm", "etherdash", "mehrunes", "starfury", "icewalker", "frostheart", "ankhshield", "azura", "rottenapple", "voidcompass", "luckcoin", "cloudjump", "crownmind", "desertheart" and "cursedgift":
        if {art_found::%{_u}%::%loop-value%} is true:
            add 1 to {_n}
    return {_n}

function artifactCoreKeyByIndex(p: player, idx: number) :: text:
    set {_u} to uuid of {_p}
    set {_n} to 0
    loop "hermes", "windring", "vampcharm", "etherdash", "mehrunes", "starfury", "icewalker", "frostheart", "ankhshield", "azura", "rottenapple", "voidcompass", "luckcoin", "cloudjump", "crownmind", "desertheart" and "cursedgift":
        if {art_found::%{_u}%::%loop-value%} is true:
            add 1 to {_n}
            if {_n} is {_idx}:
                return loop-value
    return ""

function artifactCoreGuiIndexBySlot(s: number) :: number:
    if {_s} is 11:
        return 1
    else if {_s} is 12:
        return 2
    else if {_s} is 13:
        return 3
    else if {_s} is 14:
        return 4
    else if {_s} is 15:
        return 5
    return 0

function utilityCoreCount(p: player) :: number:
    set {_u} to uuid of {_p}
    set {_n} to 0
    loop "heater", "quantdup", "dreamcatcher", "facelessmask", "lootmagnet" and "nightlens":
        if {util_found::%{_u}%::%loop-value%} is true:
            add 1 to {_n}
    return {_n}

function utilityCoreKeyByIndex(p: player, idx: number) :: text:
    set {_u} to uuid of {_p}
    set {_n} to 0
    loop "heater", "quantdup", "dreamcatcher", "facelessmask", "lootmagnet" and "nightlens":
        if {util_found::%{_u}%::%loop-value%} is true:
            add 1 to {_n}
            if {_n} is {_idx}:
                return loop-value
    return ""

function utilityCoreGuiIndexBySlot(s: number) :: number:
    if {_s} is 11:
        return 1
    else if {_s} is 12:
        return 2
    else if {_s} is 13:
        return 3
    else if {_s} is 14:
        return 4
    else if {_s} is 15:
        return 5
    return 0

function pullUtilityFromCore(p: player, key: text) :: boolean:
    set {_u} to uuid of {_p}
    if {util_found::%{_u}%::%{_key}%} is not true:
        # Фоллбек для старых сохранений до разделения ядер.
        if {art_found::%{_u}%::%{_key}%} is true:
            set {util_found::%{_u}%::%{_key}%} to true
            if {art_enabled::%{_u}%::%{_key}%} is true:
                set {util_enabled::%{_u}%::%{_key}%} to true
            else:
                set {util_enabled::%{_u}%::%{_key}%} to false
            delete {art_found::%{_u}%::%{_key}%}
            delete {art_enabled::%{_u}%::%{_key}%}
        else:
            return false
    set {_s} to artifactSlotFromKey({_key})
    if {_s} < 0:
        return false
    set {_it} to artifactFromSlot({_s})
    if {_it} is air:
        return false
    set {util_found::%{_u}%::%{_key}%} to false
    set {util_enabled::%{_u}%::%{_key}%} to false
    give {_it} to {_p}
    return true

function isLegendaryArtifact(k: text) :: boolean:
    if {_k} is "leg_warrior":
        return true
    else if {_k} is "leg_scout":
        return true
    else if {_k} is "leg_tank":
        return true
    else if {_k} is "leg_archer":
        return true
    else if {_k} is "leg_mage":
        return true
    else if {_k} is "leg_necro":
        return true
    return false

function legendaryClass(k: text) :: text:
    if {_k} is "leg_warrior":
        return "Warrior"
    else if {_k} is "leg_scout":
        return "Scout"
    else if {_k} is "leg_tank":
        return "Tank"
    else if {_k} is "leg_archer":
        return "Archer"
    else if {_k} is "leg_mage":
        return "Mage"
    else if {_k} is "leg_necro":
        return "Necromancer"
    return ""

function classLegendaryKey(p: player) :: text:
    set {_u} to uuid of {_p}
    set {_c} to {class::%{_u}%} ? "None"
    if {_c} is "Warrior":
        return "leg_warrior"
    else if {_c} is "Scout":
        return "leg_scout"
    else if {_c} is "Tank":
        return "leg_tank"
    else if {_c} is "Archer":
        return "leg_archer"
    else if {_c} is "Mage":
        return "leg_mage"
    else if {_c} is "Necromancer":
        return "leg_necro"
    return ""

function hasBalloonArtifact(p: player) :: boolean:
    if hasArtifact({_p}, "cloudjump") is true:
        return true
    # Миграция старого ключа luckyhorseshoe -> cloudjump
    set {_u} to uuid of {_p}
    if {art_found::%{_u}%::luckyhorseshoe} is true:
        set {art_found::%{_u}%::cloudjump} to true
        if {art_enabled::%{_u}%::luckyhorseshoe} is true:
            set {art_enabled::%{_u}%::cloudjump} to true
        delete {art_found::%{_u}%::luckyhorseshoe}
        delete {art_enabled::%{_u}%::luckyhorseshoe}
        return true
    return false

function resetBalloonState(p: player):
    set {_u} to uuid of {_p}
    delete {art_cloud_used::%{_u}%}
    delete {art_cloud_fallimmune::%{_u}%}
    delete {art_cloud_fallimmune_until::%{_u}%}
    if {ghost::%{_u}%} is not true:
        if gamemode of {_p} is not creative:
            if gamemode of {_p} is not spectator:
                set flight mode of {_p} to false

# ---- Артефакты: пассивки, тики ----
every 10 ticks:
    loop all players:
        set {_u} to uuid of loop-player
        set {_loc} to location of loop-player
        set {_prev} to {art_hermes_prev::%{_u}%}
        set {_moved} to 0
        set {_speed_from_artifact} to false
        if {_prev} is set:
            set {_moved} to distance between {_loc} and {_prev}
        set {art_hermes_prev::%{_u}%} to {_loc}

        # Сапоги Гермеса: постоянный Speed II
        if hasArtifact(loop-player, "hermes") is true:
            apply speed 2 without particles to loop-player for 10 ticks
            set {_speed_from_artifact} to true
        else:
            delete {art_hermes_prev::%{_u}%}

        # Кольцо Ветра: мобильность + цена в голоде
        if hasArtifact(loop-player, "windring") is true:
            if {_speed_from_artifact} is false:
                apply speed 1 without particles to loop-player for 10 ticks
            if {_moved} > 0.25:
                chance of 20%:
                    if food level of loop-player > 1:
                        remove 1 from food level of loop-player

        # Щит Анх: иммун к ключевым дебаффам
        if hasArtifact(loop-player, "ankhshield") is true:
            set {_allowAnkhClean} to true
            if {class::%{_u}%} is "Mage":
                if hasArtifact(loop-player, "leg_mage") is true:
                    set {_allowAnkhClean} to false
            if {_allowAnkhClean} is true:
                remove poison from loop-player
                remove slowness from loop-player
                remove weakness from loop-player

        # Легендарка Mage: Эфирный Разум (инверсия дебаффов)
        if {class::%{_u}%} is "Mage":
            if hasArtifact(loop-player, "leg_mage") is true:
                if loop-player has potion effect wither:
                    remove wither from loop-player
                    apply regeneration 2 without particles to loop-player for 6 seconds
                if loop-player has potion effect poison:
                    remove poison from loop-player
                    apply regeneration 1 without particles to loop-player for 6 seconds
                if loop-player has potion effect slowness:
                    remove slowness from loop-player
                    apply speed 2 without particles to loop-player for 5 seconds
                if loop-player has potion effect weakness:
                    remove weakness from loop-player
                    apply strength 1 without particles to loop-player for 5 seconds
                if loop-player has potion effect mining fatigue:
                    remove mining fatigue from loop-player
                    apply haste 2 without particles to loop-player for 5 seconds

        # Легендарка Tank: Якорь Мироздания — пассивный урон отключён; эффект "стенка" ниже в every 2 ticks

        # Легендарка Necromancer: Амулет Гнилого Родства
        if {class::%{_u}%} is "Necromancer":
            if hasArtifact(loop-player, "leg_necro") is true:
                # Усиленная регенерация возле "смерти": мицелий/душ (дроп рядом — опущен из-за парсера Skript)
                set {_regenBoost} to false
                set {_under} to block below loop-player
                if {_under} is mycelium:
                    set {_regenBoost} to true
                else if {_under} is soul sand:
                    set {_regenBoost} to true
                else if {_under} is soul soil:
                    set {_regenBoost} to true
                if {_regenBoost} is true:
                    apply regeneration 2 without particles to loop-player for 15 ticks

                # Нежить следует фокусу некроманта (uuid цели)
                set {_fuuid} to {art_leg_necro_focus::%{_u}%}
                delete {_focus}
                if {_fuuid} is set:
                    for each {_le} in all living entities in radius 24 around loop-player:
                        if {_focus} is not set:
                            if "%uuid of {_le}%" is {_fuuid}:
                                set {_focus} to {_le}
                if {_focus} is set:
                    for each {_mob} in all living entities in radius 16 around loop-player:
                        if isLegNecroPacifiedUndead({_mob}) is true:
                            set target of {_mob} to {_focus}

        # Воздушный шарик: перезарядка на земле
        if hasBalloonArtifact(loop-player) is true:
            if gamemode of loop-player is not creative:
                if gamemode of loop-player is not spectator:
                    set {_b} to block below loop-player
                    if loop-player is on ground:
                        if {_b} is not air:
                            delete {art_cloud_used::%{_u}%}
                            set flight mode of loop-player to true
                    else:
                        if {art_cloud_used::%{_u}%} is true:
                            set flight mode of loop-player to false
                        else:
                            set flight mode of loop-player to true
        else:
            resetBalloonState(loop-player)

on right click with nether star:
    if hasArtifact(player, "azura") is true:
        cancel event
        set {_u} to player's uuid
        set {_c} to {art_azura_charge::%{_u}%} ? 0
        if {_c} < 25:
            send action bar "&cНедостаточно заряда: &e%{_c}%&7/&e25" to player
            stop
        remove 25 from {art_azura_charge::%{_u}%}
        give 8 experience bottle to player
        play sound "block.enchantment_table.use" with volume 1 and pitch 1.2 at player for player
        send "{@prefix} &dЗвезда Азуры высвободила энергию. &7(-25 заряда, +8 пузырьков опыта)" to player

on right click with compass:
    if hasArtifact(player, "voidcompass") is true:
        cancel event
        set {_u} to player's uuid
        if {art_voidcompass_pending::%{_u}%} is set:
            delete {art_voidcompass_pending::%{_u}%}
            send action bar "&cВозврат Компаса Пустоты отменён." to player
        else:
            send action bar "&7Компас Пустоты срабатывает автоматически после респавна." to player

command /voidcancel:
    aliases: /vccancel
    trigger:
        set {_u} to player's uuid
        if {art_voidcompass_pending::%{_u}%} is set:
            delete {art_voidcompass_pending::%{_u}%}
            send "{@prefix} &cВозврат Компаса Пустоты отменён." to player

# Ручная активация артефакта: только ПКМ предметом в руке
on right click:
    if player's tool is set:
        set {_n} to name of player's tool
        if {_n} does not contain "Артефакт:":
            if {_n} does not contain "Легендарный артефакт:":
                stop
        set {_key} to artifactKeyFromItemName({_n})
        if {_key} is "":
            dbgEvo(player, "artifact use: unknown key from item name %{_n}%")
            stop
        cancel event
        set {_u} to player's uuid
        if isUtilityArtifactKey({_key}) is true:
            if {util_found::%{_u}%::%{_key}%} is true:
                dbgEvo(player, "utility use: already in core key=%{_key}%")
                send action bar "&eЭтот utility-артефакт уже есть в Utility Core." to player
                stop
            remove 1 of player's tool from player
            set {util_found::%{_u}%::%{_key}%} to true
            set {util_enabled::%{_u}%::%{_key}%} to true
            send "{@prefix} &aUtility-артефакт поглощён: &f%{_n}%" to player
            send "{@prefix} &7Теперь его можно включать/выключать в &e/utilities" to player
            play sound "ui.toast.challenge_complete" with volume 1 and pitch 1 at player for player
            stop
        if {art_found::%{_u}%::%{_key}%} is true:
            dbgEvo(player, "artifact use: already in core key=%{_key}%")
            send action bar "&eЭтот артефакт уже есть в ядре." to player
            stop
        if isLegendaryArtifact({_key}) is not true:
            if artifactCoreCount(player) >= 5:
                send "{@prefix} &cВ ядре максимум 5 обычных артефактов." to player
                play sound "entity.villager.no" with volume 0.8 and pitch 1 at player for player
                stop
        remove 1 of player's tool from player
        set {art_found::%{_u}%::%{_key}%} to true
        set {art_enabled::%{_u}%::%{_key}%} to true
        dbgEvo(player, "artifact absorbed by use: key=%{_key}% found=true enabled=true")
        send "{@prefix} &aАртефакт поглощён ядром: &f%{_n}%" to player
        send "{@prefix} &7Теперь его можно включать/выключать в &e/artifacts" to player
        play sound "ui.toast.challenge_complete" with volume 1 and pitch 1 at player for player
        stop

# Ключ возврата: ПКМ — телепорт на место последней смерти (сохраняется при смерти)
on right click:
    if player's tool is not set:
        stop
    if altarAwakeningReturnKey(player's tool) is false:
        stop
    if event-block is set:
        stop
    set {_back} to {evo_death_return::%uuid of player%}
    if {_back} is not set:
        send action bar "&cНет сохранённого места смерти." to player
        stop
    cancel event
    remove 1 of player's tool from player
    teleport player to {_back}
    delete {evo_death_return::%uuid of player%}
    play sound "entity.enderman.teleport" with volume 1 and pitch 1 at player for player
    send "{@prefix} &bКлюч возврата: вы перенесены на место смерти." to player

# Зов Руин: Shift+ПКМ по блоку в Оверворлде (крафт на алтаре)
on right click:
    if player is not sneaking:
        stop
    if event-block is not set:
        stop
    if player's tool is not set:
        stop
    if isArtifactRuinSummonItem(player's tool) is false:
        stop
    set {_w} to world of event-block
    if environment of {_w} is not normal:
        send action bar "&cЗов Руин работает только в Оверворлде." to player
        stop
    cancel event
    set {_bx} to floor(x-coordinate of location of event-block)
    set {_bz} to floor(z-coordinate of location of event-block)
    set {_feet} to artifactRuinFeetAtColumn({_bx}, {_bz}, {_w})
    if artifactRuinFeetValid({_feet}) is false:
        send action bar "&cЗдесь нельзя поставить руину (колонка поверхности)." to player
        stop
    if artifactRuinFarFromSpawn({_feet}, {_w}) is false:
        send action bar "&cСлишком близко к спавну мира (нужно дальше)." to player
        stop
    set {_cx} to floor(x-coordinate of {_feet})
    set {_cz} to floor(z-coordinate of {_feet})
    if artifactRuinTerrainTooSteep({_cx}, {_cz}, 9, {_w}) is true:
        send action bar "&cРельеф слишком крутой для руины." to player
        stop
    set {_rc} to "{@artifact_ruin_region_chunks}" parsed as number
    if {_rc} is not set:
        set {_rc} to 6
    if {_rc} < 1:
        set {_rc} to 6
    set {_wcx} to floor({_bx} / 16)
    set {_wcz} to floor({_bz} / 16)
    set {_rx} to floor({_wcx} / {_rc})
    set {_rz} to floor({_wcz} / {_rc})
    set {_wn} to "%{_w}%"
    if {evo_ruin_reg::%{_wn}%::%{_rx}%::%{_rz}%} is true:
        send action bar "&cВ этом регионе уже отмечена руина (слот мира)." to player
        stop
    set {_kind} to artifactRuinRandomKind()
    if artifactRuinBuild({_feet}, {_kind}) is false:
        send action bar "&cНе удалось возвести руину (проверь место)." to player
        stop
    artifactRuinRegisterRegionForBlock({_w}, {_bx}, {_bz})
    remove 1 of player's tool from player
    play sound "block.beacon.activate" with volume 1 and pitch 1 at event-block for all players
    send "{@prefix} &6Руина возведена. &7Сундук башни открывается &5Ключом пустоты&7." to player

# Воздушный шарик: второй прыжок в воздухе
on toggle flight:
    if {ghost::%player's uuid%} is true:
        set flight mode of player to true
        stop
    if hasBalloonArtifact(player) is true:
        cancel event
        if gamemode of player is creative:
            stop
        if gamemode of player is spectator:
            stop
        set {_until} to {art_cloud_cd::%player's uuid%}
        if {_until} is set:
            if {_until} > now:
                send action bar "&7Воздушный шарик перезаряжается..." to player
                stop
        if {art_cloud_used::%player's uuid%} is true:
            stop
        set {art_cloud_used::%player's uuid%} to true
        set {art_cloud_fallimmune::%player's uuid%} to true
        set {art_cloud_fallimmune_until::%player's uuid%} to now + 4 seconds
        set {art_cloud_cd::%player's uuid%} to now + 1 second
        set flight mode of player to false
        set {_wloc} to location of player
        subtract 1 from y-coordinate of {_wloc}
        # Ветровой взрыв под носителем (визуал + импульс)
        play sound "entity.wind_charge.wind_burst" with volume 0.8 and pitch 1.1 at {_wloc} for all players
        push player upwards at speed 0.72
        send action bar "&f&lВОЗДУШНЫЙ ШАРИК!" to player
        stop

# Ледяной след: временный лёд под игроком
every 2 ticks:
    loop all players:
        # Легендарка Tank: "живая стена" — через танка нельзя пройти, но бить можно
        if classOf(loop-player) is "Tank":
            if hasArtifact(loop-player, "leg_tank") is true:
                for each {_tankWallEnt} in all living entities in radius 1.25 around loop-player:
                    if uuid of {_tankWallEnt} is not uuid of loop-player:
                        if {_tankWallEnt} is not an armor stand:
                            set {_dxWall} to x-coordinate of {_tankWallEnt} - x-coordinate of loop-player
                            set {_dzWall} to z-coordinate of {_tankWallEnt} - z-coordinate of loop-player
                            set {_lenWall} to sqrt((({_dxWall} * {_dxWall}) + ({_dzWall} * {_dzWall})))
                            if {_lenWall} <= 0.05:
                                set {_dxWall} to 0.1
                                set {_dzWall} to 0.1
                                set {_lenWall} to 0.141
                            set {_nlocWall} to location of {_tankWallEnt}
                            add ({_dxWall} / {_lenWall}) * 0.48 to x-coordinate of {_nlocWall}
                            add ({_dzWall} / {_lenWall}) * 0.48 to z-coordinate of {_nlocWall}
                            set {_feetWall} to block at {_nlocWall}
                            set {_headWall} to block above {_feetWall}
                            # Не только воздух: любой проходимый блок (трава, цветок, факел, знак…)
                            if {_feetWall} is passable:
                                if {_headWall} is passable:
                                    teleport {_tankWallEnt} to {_nlocWall}
        if hasArtifact(loop-player, "icewalker") is true:
            if gamemode of loop-player is not creative:
                if gamemode of loop-player is not spectator:
                    set {_b} to block below loop-player
                    set {_ok} to false
                    if {_b} is air:
                        set {_ok} to true
                    else if {_b} is water:
                        set {_ok} to true
                    else if "%type of {_b}%" is "minecraft:lava":
                        set {_ok} to true
                    if {_ok} is true:
                        set {_loc} to location of {_b}
                        set {_world} to name of world of {_loc}
                        set {_x} to floor(x-coordinate of {_loc})
                        set {_y} to floor(y-coordinate of {_loc})
                        set {_z} to floor(z-coordinate of {_loc})
                        set {_k} to "%{_world}%:%{_x}%:%{_y}%:%{_z}%"
                        if {art_ice_active::%{_k}%} is not true:
                            if {_b} is water:
                                set {art_ice_prev::%{_k}%} to "water"
                            else if "%type of {_b}%" is "minecraft:lava":
                                set {art_ice_prev::%{_k}%} to "lava"
                            else:
                                set {art_ice_prev::%{_k}%} to "air"
                            set {art_ice_active::%{_k}%} to true
                            execute console command "execute as %loop-player% at %loop-player% run setblock ~ ~-1 ~ packed_ice replace"
                            set {_k2} to {_k}
                            set {_world2} to {_world}
                            set {_x2} to {_x}
                            set {_y2} to {_y}
                            set {_z2} to {_z}
                            set {_owner} to loop-player
                            wait 35 ticks
                            if {art_ice_active::%{_k2}%} is true:
                                # Анти-rubberband: не убираем блок, пока кто-то стоит рядом
                                set {_occupied} to false
                                for each {_occP} in all players:
                                    if "%world of {_occP}%" is {_world2}:
                                        set {_px} to floor(x-coordinate of {_occP})
                                        set {_py} to floor(y-coordinate of {_occP})
                                        set {_pz} to floor(z-coordinate of {_occP})
                                        if {_px} is between {_x2} - 1 and {_x2} + 1:
                                            if {_py} is between {_y2} and {_y2} + 2:
                                                if {_pz} is between {_z2} - 1 and {_z2} + 1:
                                                    set {_occupied} to true
                                if {_occupied} is true:
                                    wait 15 ticks
                                set {_old} to {art_ice_prev::%{_k2}%}
                                if {_old} is set:
                                    execute console command "execute as %{_owner}% at %{_owner}% run setblock %{_x2}% %{_y2}% %{_z2}% %{_old}% replace"
                                else:
                                    execute console command "execute as %{_owner}% at %{_owner}% run setblock %{_x2}% %{_y2}% %{_z2}% air replace"
                                delete {art_ice_prev::%{_k2}%}
                                delete {art_ice_active::%{_k2}%}

