function syncAltarGearDurability(p: player):
    set {_tk} to {_p}'s tool
    if isAltarSwordTool({_tk}) is true:
        set durability of {_tk} to 99999
        set {_p}'s tool to {_tk}
    set {_helm} to helmet of {_p}
    if isAltarArmorPiece({_helm}) is true:
        set durability of {_helm} to 99999
        set helmet of {_p} to {_helm}
    set {_chest} to chestplate of {_p}
    if isAltarArmorPiece({_chest}) is true:
        set durability of {_chest} to 99999
        set chestplate of {_p} to {_chest}
    set {_legs} to leggings of {_p}
    if isAltarArmorPiece({_legs}) is true:
        set durability of {_legs} to 99999
        set leggings of {_p} to {_legs}
    set {_boots} to boots of {_p}
    if isAltarArmorPiece({_boots}) is true:
        set durability of {_boots} to 99999
        set boots of {_p} to {_boots}

function altarSwordIsUndead(v: living entity) :: boolean:
    loop zombie, skeleton, wither skeleton, stray, bogged, drowned, husk and phantom:
        if {_v} is a loop-value:
            return true
    return false

function applyAltarSwordOnHit(atk: player, vic: living entity, dmg: number):
    set {_tk} to {_atk}'s tool
    set {_omni} to false
    if isOmniSword({_tk}) is true:
        set {_omni} to true
    if isEtherSword({_tk}) is true:
        heal {_atk} by {_dmg} * 0.2
        apply slowness 1 without particles to {_vic} for 1 second
    if isFlameSword({_tk}) is true:
        ignite {_vic} for 3 seconds
        if altarSwordIsUndead({_vic}) is true:
            damage {_vic} by {_dmg} * 0.15
    if isVeinSword({_tk}) is true:
        set {_vloc} to location of {_vic}
        set {_hitN} to 0
        loop all living entities in radius 3 around {_vloc}:
            if loop-entity is not {_atk}:
                if loop-entity is not {_vic}:
                    if distance between loop-entity and {_vic} <= 2.75:
                        add 1 to {_hitN}
                        if {_hitN} <= 3:
                            damage loop-entity by {_dmg} * 0.35
    if isFortuneSword({_tk}) is true:
        giveArtifactScaledExperience({_atk}, 1)
    if isVoidSword({_tk}) is true:
        if random integer between 1 and 100 <= 25:
            push {_vic} away from {_atk} at speed 0.65
        apply weakness 1 without particles to {_vic} for 2 seconds
    if {_omni} is true:
        heal {_atk} by {_dmg} * 0.2
        apply slowness 1 without particles to {_vic} for 1 second
        ignite {_vic} for 3 seconds
        if altarSwordIsUndead({_vic}) is true:
            damage {_vic} by {_dmg} * 0.15
        set {_vloc} to location of {_vic}
        set {_hitN} to 0
        loop all living entities in radius 3 around {_vloc}:
            if loop-entity is not {_atk}:
                if loop-entity is not {_vic}:
                    if distance between loop-entity and {_vic} <= 2.75:
                        add 1 to {_hitN}
                        if {_hitN} <= 3:
                            damage loop-entity by {_dmg} * 0.35
        giveArtifactScaledExperience({_atk}, 1)
        if random integer between 1 and 100 <= 25:
            push {_vic} away from {_atk} at speed 0.65
        apply weakness 1 without particles to {_vic} for 2 seconds

function applyAltarSwordOnKill(atk: player):
    set {_tk} to {_atk}'s tool
    set {_fortune} to false
    set {_void} to false
    if isFortuneSword({_tk}) is true:
        set {_fortune} to true
    if isVoidSword({_tk}) is true:
        set {_void} to true
    if isOmniSword({_tk}) is true:
        set {_fortune} to true
        set {_void} to true
    if {_fortune} is true:
        if random integer between 1 and 100 <= 20:
            set {_bonus} to gold nugget
            if random integer between 1 and 100 <= 35:
                set {_bonus} to emerald
            giveOrDrop({_bonus}, {_atk}, location of {_atk})
        giveArtifactScaledExperience({_atk}, 2)
    if {_void} is true:
        apply speed 2 without particles to {_atk} for 2 seconds

function altarArmorPieceBlocksDamage(pl: player, piece: item, dc: text) :: boolean:
    if {_piece} is air:
        return false
    set {_d} to {_dc} in lower case
    if isFlameHelmet({_piece}) is true:
        if {_d} is "fire":
            return true
        if {_d} is "fire tick":
            return true
    if isOmniHelmet({_piece}) is true:
        if {_d} is "fire":
            return true
        if {_d} is "fire tick":
            return true
    if isFlameChestplate({_piece}) is true:
        if {_d} is "fire":
            return true
        if {_d} is "fire tick":
            return true
    if isOmniChestplate({_piece}) is true:
        if {_d} is "fire":
            return true
        if {_d} is "fire tick":
            return true
    if isFlameBoots({_piece}) is true:
        if {_d} is "lava":
            return true
        if {_d} is "hot floor":
            return true
    if isOmniBoots({_piece}) is true:
        if {_d} is "lava":
            return true
        if {_d} is "hot floor":
            return true
    return false

function altarArmorPieceDamageMult(pl: player, piece: item, dc: text) :: number:
    if {_piece} is air:
        return 1
    set {_d} to {_dc} in lower case
    if isEtherHelmet({_piece}) is true:
        return 0.97
    if isOmniHelmet({_piece}) is true:
        return 0.97
    if isEtherChestplate({_piece}) is true:
        return 0.95
    if isOmniChestplate({_piece}) is true:
        return 0.95
    if isFlameLeggings({_piece}) is true:
        if {_d} is "fire":
            return 0.5
        if {_d} is "fire tick":
            return 0.5
    if isOmniLeggings({_piece}) is true:
        if {_d} is "fire":
            return 0.5
        if {_d} is "fire tick":
            return 0.5
    return 1

function applyAltarArmorPieceEffects(pl: player, piece: item, atk: entity):
    if {_piece} is air:
        stop
    set {_vu} to uuid of {_pl}
    set {_now} to unix timestamp of now
    # Шлем
    if isVeinHelmet({_piece}) is true:
        set {_maxHp} to max health of {_pl}
        if health of {_pl} <= ({_maxHp} * 0.5):
            set {_last} to {altar_armor_veinhelm_cd::%{_vu}%} ? 0
            if {_now} - {_last} >= 8:
                set {altar_armor_veinhelm_cd::%{_vu}%} to {_now}
                apply regeneration 1 without particles to {_pl} for 2 seconds
    if isVoidHelmet({_piece}) is true:
        if {_atk} is a living entity:
            if {_atk} is not {_pl}:
                set {_last} to {altar_armor_voidhelm_cd::%{_vu}%} ? 0
                if {_now} - {_last} >= 6:
                    if random integer between 1 and 100 <= 15:
                        set {altar_armor_voidhelm_cd::%{_vu}%} to {_now}
                        apply blindness 1 without particles to {_atk} for 2 seconds
    if isOmniHelmet({_piece}) is true:
        set {_maxHp} to max health of {_pl}
        if health of {_pl} <= ({_maxHp} * 0.5):
            set {_last} to {altar_armor_veinhelm_cd::%{_vu}%} ? 0
            if {_now} - {_last} >= 8:
                set {altar_armor_veinhelm_cd::%{_vu}%} to {_now}
                apply regeneration 1 without particles to {_pl} for 2 seconds
        if {_atk} is a living entity:
            if {_atk} is not {_pl}:
                set {_last} to {altar_armor_voidhelm_cd::%{_vu}%} ? 0
                if {_now} - {_last} >= 6:
                    if random integer between 1 and 100 <= 15:
                        set {altar_armor_voidhelm_cd::%{_vu}%} to {_now}
                        apply blindness 1 without particles to {_atk} for 2 seconds
    # Нагрудник
    if isFlameChestplate({_piece}) is true:
        if {_atk} is a living entity:
            if {_atk} is not {_pl}:
                if distance between {_atk} and {_pl} <= 4:
                    ignite {_atk} for 2 seconds
    if isVeinChestplate({_piece}) is true:
        set {_last} to {altar_armor_regen_cd::%{_vu}%} ? 0
        if {_now} - {_last} >= 5:
            set {altar_armor_regen_cd::%{_vu}%} to {_now}
            apply regeneration 1 without particles to {_pl} for 2 seconds
    if isVoidChestplate({_piece}) is true:
        set {_maxHp} to max health of {_pl}
        if health of {_pl} <= ({_maxHp} * 0.3):
            apply resistance 1 without particles to {_pl} for 3 seconds
    if isOmniChestplate({_piece}) is true:
        if {_atk} is a living entity:
            if {_atk} is not {_pl}:
                if distance between {_atk} and {_pl} <= 4:
                    ignite {_atk} for 2 seconds
        set {_last} to {altar_armor_regen_cd::%{_vu}%} ? 0
        if {_now} - {_last} >= 5:
            set {altar_armor_regen_cd::%{_vu}%} to {_now}
            apply regeneration 1 without particles to {_pl} for 2 seconds
        set {_maxHp} to max health of {_pl}
        if health of {_pl} <= ({_maxHp} * 0.3):
            apply resistance 1 without particles to {_pl} for 3 seconds
    # Поножи
    if isVeinLeggings({_piece}) is true:
        if {_atk} is a living entity:
            if {_atk} is not {_pl}:
                if random integer between 1 and 100 <= 10:
                    apply slowness 1 without particles to {_atk} for 1 second
    if isVoidLeggings({_piece}) is true:
        if random integer between 1 and 100 <= 20:
            apply speed 1 without particles to {_pl} for 2 seconds
    if isOmniLeggings({_piece}) is true:
        if {_atk} is a living entity:
            if {_atk} is not {_pl}:
                if random integer between 1 and 100 <= 10:
                    apply slowness 1 without particles to {_atk} for 1 second
        if random integer between 1 and 100 <= 20:
            apply speed 1 without particles to {_pl} for 2 seconds

function applyAltarArmorHitEffects(pl: player, atk: entity):
    applyAltarArmorPieceEffects({_pl}, helmet of {_pl}, {_atk})
    applyAltarArmorPieceEffects({_pl}, chestplate of {_pl}, {_atk})
    applyAltarArmorPieceEffects({_pl}, leggings of {_pl}, {_atk})
    applyAltarArmorPieceEffects({_pl}, boots of {_pl}, {_atk})

function playerClassBaseMaxHp(p: player) :: number:
    if classOf({_p}) is "Tank":
        if levelOf({_p}) >= 25:
            return 20
    return 10

function altarArmorMaxHpBonus(p: player) :: number:
    set {_bonus} to 0
    set {_helm} to helmet of {_p}
    set {_chest} to chestplate of {_p}
    set {_boots} to boots of {_p}
    if isOmniHelmet({_helm}) is true:
        add 1 to {_bonus}
    else if isFortuneHelmet({_helm}) is true:
        add 1 to {_bonus}
    if isOmniChestplate({_chest}) is true:
        add 3 to {_bonus}
    else if isVeinChestplate({_chest}) is true:
        add 2 to {_bonus}
    else if isVoidChestplate({_chest}) is true:
        add 1 to {_bonus}
    if isOmniBoots({_boots}) is true:
        add 1 to {_bonus}
    else if isEtherBoots({_boots}) is true:
        add 1 to {_bonus}
    return {_bonus}

function syncPlayerMaxHealth(p: player):
    set {_u} to uuid of {_p}
    if {ghost::%{_u}%} is true:
        stop
    set {_target} to playerClassBaseMaxHp({_p}) + altarArmorMaxHpBonus({_p})
    remove health boost from {_p}
    set max health of {_p} to {_target}
    if health of {_p} > {_target}:
        set health of {_p} to {_target}

function refreshPassiveNightVision(p: player):
    remove night vision from {_p}
    apply night vision 1 without particles to {_p} for 15 seconds

function refreshAltarPassiveSpeed(p: player):
    remove speed from {_p}
    apply speed 1 without particles to {_p} for 15 seconds

function refreshAltarPassiveJump(p: player):
    remove jump boost from {_p}
    apply jump boost 1 without particles to {_p} for 15 seconds

function refreshAltarPassiveLuck(p: player):
    remove luck (potion effect type) from {_p}
    apply luck 1 without particles to {_p} for 15 seconds

function applyAltarArmorPassiveEffects(p: player):
    set {_helm} to helmet of {_p}
    syncPlayerMaxHealth({_p})
    if isEtherHelmet({_helm}) is true:
        set {_maxHp} to max health of {_p}
        if health of {_p} <= ({_maxHp} * 0.8):
            remove night vision from {_p}
    else if isOmniHelmet({_helm}) is true:
        set {_maxHp} to max health of {_p}
        if health of {_p} <= ({_maxHp} * 0.8):
            remove night vision from {_p}

function altarArmorFortuneXpBonus(p: player) :: number:
    set {_bonus} to 0
    if isFortuneHelmet(helmet of {_p}) is true:
        add 2 to {_bonus}
    else if isOmniHelmet(helmet of {_p}) is true:
        add 2 to {_bonus}
    if isFortuneChestplate(chestplate of {_p}) is true:
        add 3 to {_bonus}
    else if isOmniChestplate(chestplate of {_p}) is true:
        add 3 to {_bonus}
    return {_bonus}

function applyAltarArmorOnKill(atk: player):
    if isVoidBoots(boots of {_atk}) is true:
        apply speed 2 without particles to {_atk} for 2 seconds
    else if isOmniBoots(boots of {_atk}) is true:
        apply speed 2 without particles to {_atk} for 2 seconds
    if isFortuneLeggings(leggings of {_atk}) is true:
        if random integer between 1 and 100 <= 10:
            set {_bonus} to gold nugget
            giveOrDrop({_bonus}, {_atk}, location of {_atk})
    else if isOmniLeggings(leggings of {_atk}) is true:
        if random integer between 1 and 100 <= 10:
            set {_bonus} to gold nugget
            giveOrDrop({_bonus}, {_atk}, location of {_atk})

function altarTagToLocalRecipeId(tag: text) :: text:
    set {_t} to {_tag}
    if {_t} is "АЛТАР_МЕЧ_ЭФИР":
