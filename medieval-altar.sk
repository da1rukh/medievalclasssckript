function altarGearHasTag(i: item, tag: text) :: boolean:
    if {_i} is air:
        return false
    set {_l::*} to lore of {_i}
    loop {_l::*}:
        if loop-value contains {_tag}:
            return true
    return false

function isEtherSword(i: item) :: boolean:
    return altarGearHasTag({_i}, "АЛТАР_МЕЧ_ЭФИР")

function isFlameSword(i: item) :: boolean:
    return altarGearHasTag({_i}, "АЛТАР_МЕЧ_ПЛАМЯ")

function isVeinSword(i: item) :: boolean:
    return altarGearHasTag({_i}, "АЛТАР_МЕЧ_ЖИЛА")

function isFortuneSword(i: item) :: boolean:
    return altarGearHasTag({_i}, "АЛТАР_МЕЧ_УДАЧА")

function isVoidSword(i: item) :: boolean:
    return altarGearHasTag({_i}, "АЛТАР_МЕЧ_ПУСТОТА")

function isOmniSword(i: item) :: boolean:
    return altarGearHasTag({_i}, "АЛТАР_МЕЧ_ОМНИ")

function isAltarSwordTool(i: item) :: boolean:
    if isEtherSword({_i}) is true:
        return true
    if isFlameSword({_i}) is true:
        return true
    if isVeinSword({_i}) is true:
        return true
    if isFortuneSword({_i}) is true:
        return true
    if isVoidSword({_i}) is true:
        return true
    if isOmniSword({_i}) is true:
        return true
    return false

