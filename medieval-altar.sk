    if {_t} is "АЛТАР_ПУСТОТА_ШЛЕМ":
        return "void_helm"
    if {_t} is "АЛТАР_ОМНИ_ШЛЕМ":
        return "omni_helm"
    if {_t} is "АЛТАР_ЭФИР_НАГРУД":
        return "ether_chest"
    if {_t} is "АЛТАР_ПЛАМЯ_НАГРУД":
        return "flame_chest"
    if {_t} is "АЛТАР_ЖИЛА_НАГРУД":
        return "vein_chest"
    if {_t} is "АЛТАР_УДАЧА_НАГРУД":
        return "fortune_chest"
    if {_t} is "АЛТАР_ПУСТОТА_НАГРУД":
        return "void_chest"
    if {_t} is "АЛТАР_ОМНИ_НАГРУД":
        return "omni_chest"
    if {_t} is "АЛТАР_ЭФИР_ПОНОЖ":
        return "ether_legs"
    if {_t} is "АЛТАР_ПЛАМЯ_ПОНОЖ":
        return "flame_legs"
    if {_t} is "АЛТАР_ЖИЛА_ПОНОЖ":
        return "vein_legs"
    if {_t} is "АЛТАР_УДАЧА_ПОНОЖ":
        return "fortune_legs"
    if {_t} is "АЛТАР_ПУСТОТА_ПОНОЖ":
        return "void_legs"
    if {_t} is "АЛТАР_ОМНИ_ПОНОЖ":
        return "omni_legs"
    if {_t} is "АЛТАР_ЭФИР_САПОГ":
        return "ether_boots"
    if {_t} is "АЛТАР_ПЛАМЯ_САПОГ":
        return "flame_boots"
    if {_t} is "АЛТАР_ЖИЛА_САПОГ":
        return "vein_boots"
    if {_t} is "АЛТАР_УДАЧА_САПОГ":
        return "fortune_boots"
    if {_t} is "АЛТАР_ПУСТОТА_САПОГ":
        return "void_boots"
    if {_t} is "АЛТАР_ОМНИ_САПОГ":
        return "omni_boots"
    return ""

function altarGearRecipeIdFromItem(it: item) :: text:
    if {_it} is air:
        return ""
    set {_l::*} to lore of {_it}
    loop {_l::*}:
        set {_lv} to loop-value
        if {_lv} contains "АЛТАР_":
            set {_id} to {_lv}
            replace all "&8" in {_id} with ""
            set {_rid} to altarTagToLocalRecipeId({_id})
            if {_rid} is not "":
                return "recipe_local::%{_rid}%"
    return ""

function altarLocalRecipeIds() :: texts:
    delete {_ids::*}
    loop "ether_pick", "flame_pick", "vein_pick", "fortune_pick", "void_pick", "omni_pick", "ether_sword", "flame_sword", "vein_sword", "fortune_sword", "void_sword", "omni_sword", "ether_helm", "flame_helm", "vein_helm", "fortune_helm", "void_helm", "omni_helm", "ether_chest", "flame_chest", "vein_chest", "fortune_chest", "void_chest", "omni_chest", "ether_legs", "flame_legs", "vein_legs", "fortune_legs", "void_legs", "omni_legs", "ether_boots", "flame_boots", "vein_boots", "fortune_boots", "void_boots" and "omni_boots":
        add loop-value to {_ids::*}
    return {_ids::*}

