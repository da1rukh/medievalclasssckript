# medieval-altar.sk — алтарная экипировка, рецепты, пассивки (модуль EVO)
# Reload: /sk reload medieval-altar

using for loops

options:
    prefix: &8[&b&lEvo&8]&r
    max_level: 25
    kills_per_level: 2
    duotpa_warmup: 3
    duotpa_cooldown: 90
    duotpa_request_ttl: 60
    combat_log_duration: 15
    # Руины: 0 = не спавнить при загрузке чанков; 1 = включить случайный спавн (шанс 1/denominator в пустом регионе).
    artifact_ruin_auto_chunk_spawn: 0
    artifact_ruin_denominator: 20
    artifact_ruin_region_chunks: 6
    # Мин. расстояние от world spawn (блоки) — для игрока «Зов Руин» и автоспавна.
    artifact_ruin_min_spawn_blocks: 160
    artifact_ruin_legendary_chance_percent: 14
    # Замена разрушенного портала при генерации: common_max 0 = никогда не заменять (руины только вручную / админ).
    artifact_ruin_portal_roll_legendary_max: 10
    artifact_ruin_portal_roll_common_max: 0
    # Главный сундук башни: шанс что в центральном слоте свиток вместо артефакта (0–100).
    artifact_ruin_boss_chest_scroll_percent: 78
    # Обычные сундуки руины: при заполнении слота ресурсами — шанс страницы дневника с алтарным рецептом (0–100).
    artifact_ruin_side_chest_scroll_substitute_percent: 30
    # Обычные сундуки: шанс ключа возврата и (суммарно после него) ключа пустоты на один «лут-слот» (0–100).
    artifact_ruin_side_chest_return_key_percent: 11
    artifact_ruin_side_chest_void_key_percent: 3


# ===== Алтарные мечи и полная броня (5 тем × 4 слота + омни) =====

function altarEtherSwordItem() :: item:
    set {_s} to diamond sword
    set name of {_s} to "&dПульс Эфира"
    set lore of {_s} to "&8✦ Алтарный меч" and "&8АЛТАР_МЕЧ_ЭФИР" and "&7Вампиризм: 20%% урона в лечение" and "&7Замедляет цель на 1с" and "&8∞ Неразрушимый"
    enchant {_s} with unbreaking 10
    enchant {_s} with sharpness 4
    return {_s}

function altarFlameSwordItem() :: item:
    set {_s} to diamond sword
    set name of {_s} to "&cЗаря Разлома"
    set lore of {_s} to "&8✦ Алтарный меч" and "&8АЛТАР_МЕЧ_ПЛАМЯ" and "&7Поджигает на 4с" and "&7+15%% урона по нежити" and "&8∞ Неразрушимый"
