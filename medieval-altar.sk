function hasArtifactItemInInventory(p: player, mark: text) :: boolean:
    loop all items in {_p}'s inventory:
        set {_nm} to name of loop-value
        if {_nm} is set:
            if {_nm} contains {_mark}:
                return true
    return false

function hasArtifactCoreOrInventory(p: player, key: text, mark: text) :: boolean:
    if hasArtifact({_p}, {_key}) is true:
        return true
    if hasArtifactItemInInventory({_p}, {_mark}) is true:
        return true
    return false

function isUtilityArtifactKey(k: text) :: boolean:
    if {_k} is "heater":
        return true
    else if {_k} is "quantdup":
        return true
    else if {_k} is "dreamcatcher":
        return true
    else if {_k} is "facelessmask":
        return true
    else if {_k} is "lootmagnet":
        return true
    else if {_k} is "nightlens":
        return true
    return false

function hasUtilityArtifact(p: player, key: text) :: boolean:
    set {_u} to uuid of {_p}
    if {ghost::%{_u}%} is true:
        return false
    if {util_found::%{_u}%::%{_key}%} is true:
        if {util_enabled::%{_u}%::%{_key}%} is true:
            return true
    return false

function hasUtilityCoreOrInventory(p: player, key: text, mark: text) :: boolean:
    if hasUtilityArtifact({_p}, {_key}) is true:
        return true
    if hasArtifactItemInInventory({_p}, {_mark}) is true:
        return true
    return false

function migrateUtilityCoreVars(p: player):
    set {_u} to uuid of {_p}
    loop "heater", "dreamcatcher", "quantdup", "facelessmask", "lootmagnet" and "nightlens":
        if {art_found::%{_u}%::%loop-value%} is true:
            set {util_found::%{_u}%::%loop-value%} to true
            if {art_enabled::%{_u}%::%loop-value%} is true:
                set {util_enabled::%{_u}%::%loop-value%} to true
            else:
                set {util_enabled::%{_u}%::%loop-value%} to false
            delete {art_found::%{_u}%::%loop-value%}
            delete {art_enabled::%{_u}%::%loop-value%}

function isArtifactResultBlockedForQuantDup(it: item) :: boolean:
    set {_nm} to name of {_it}
    if {_nm} is set:
        if {_nm} contains "Алтар":
            return true
        if {_nm} contains "Артефакт:":
            return true
        if {_nm} contains "Легендарный артефакт:":
            return true
    return false

function isFiveItemRecipeExact(inv: inventory, a: item, b: item, c: item, d: item, e: item) :: boolean:
    set {_an} to 0
    set {_bn} to 0
    set {_cn} to 0
    set {_dn} to 0
    set {_en} to 0
    set {_total} to 0
    set {_bad} to false
    loop 5 times:
        set {_it} to slot (loop-number - 1) of {_inv}
        if {_it} is air:
            set {_bad} to true
        else:
            add 1 to {_total}
            if {_it} is {_a}:
                add 1 to {_an}
            else if {_it} is {_b}:
                add 1 to {_bn}
            else if {_it} is {_c}:
                add 1 to {_cn}
            else if {_it} is {_d}:
                add 1 to {_dn}
            else if {_it} is {_e}:
                add 1 to {_en}
            else:
                set {_bad} to true
    if {_bad} is true:
        return false
    if {_total} is not 5:
        return false
    if {_an} is not 1:
        return false
    if {_bn} is not 1:
        return false
    if {_cn} is not 1:
        return false
    if {_dn} is not 1:
        return false
    if {_en} is not 1:
        return false
    return true

function isCursedKingGiftRecipe(inv: inventory) :: boolean:
    return isFiveItemRecipeExact({_inv}, netherite ingot, enchanted golden apple, player head, crownHigherMindArtifactItem(), artifactFromSlot(8))

function isCrownHigherMindAltarRecipe(inv: inventory) :: boolean:
    set {_mindN} to 0
    set {_azuraN} to 0
    set {_helmN} to 0
    set {_bookN} to 0
    set {_xpBottleN} to 0
    set {_total} to 0
    set {_bad} to false
    loop 5 times:
        set {_it} to slot (loop-number - 1) of {_inv}
        if {_it} is air:
            set {_bad} to true
        else:
            add 1 to {_total}
            set {_nm} to name of {_it}
            if {_nm} is set:
                if {_nm} contains "Эфирный Разум":
                    add 1 to {_mindN}
                else if {_nm} contains "Звезда Азуры":
                    add 1 to {_azuraN}
                else:
                    if {_it} is golden helmet:
                        add 1 to {_helmN}
                    else if {_it} is enchanted book:
                        add 1 to {_bookN}
                    else if {_it} is experience bottle:
                        add 1 to {_xpBottleN}
                    else:
                        set {_bad} to true
            else:
                if {_it} is golden helmet:
                    add 1 to {_helmN}
                else if {_it} is enchanted book:
                    add 1 to {_bookN}
                else if {_it} is experience bottle:
                    add 1 to {_xpBottleN}
                else:
                    set {_bad} to true
    if {_bad} is true:
        return false
    if {_total} is not 5:
        return false
    if {_mindN} is not 1:
        return false
    if {_azuraN} is not 1:
        return false
    if {_helmN} is not 1:
        return false
    if {_bookN} is not 1:
        return false
    if {_xpBottleN} is not 1:
        return false
    return true

