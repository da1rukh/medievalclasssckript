function altarLocalRecipeSlotBaseName(slot: text) :: text:
    set {_s} to {_slot} in lower case
    if {_s} is "pick":
        return "Алмазная кирка"
    if {_s} is "sword":
        return "Алмазный меч"
    if {_s} is "helm":
        return "Алмазный шлем"
    if {_s} is "chest":
        return "Алмазный нагрудник"
    if {_s} is "legs":
        return "Алмазные поножи"
    if {_s} is "boots":
        return "Алмазные сапоги"
    return "Алмазный предмет"

function altarLocalRecipeOmniIngredients(slot: text) :: texts:
    delete {_out::*}
    set {_s} to {_slot} in lower case
    if {_s} is "pick":
        set {_out::*} to "Эфирная кирка", "Пламенная кирка", "Жильная кирка", "Кирка Удачи" and "Кирка Пустоты"
    else if {_s} is "sword":
        set {_out::*} to "Пульс Эфира", "Заря Разлома", "Сечение Жилы", "Клинок Созвездия" and "Разрез Бездны"
    else if {_s} is "helm":
        set {_out::*} to "Эфирный Венец", "Пепельная Корона", "Шлем Корней", "Венец Миража" and "Маска Бездны"
    else if {_s} is "chest":
        set {_out::*} to "Эфирная Мантия", "Кираса Угольника", "Кираса Плети", "Нагрудник Охотника" and "Грудь Истощения"
    else if {_s} is "legs":
        set {_out::*} to "Эфирные Поножи", "Поножи Раскала", "Поножи Узора", "Поножи Добычи" and "Поножи Сгущения"
    else if {_s} is "boots":
        set {_out::*} to "Эфирные Сапоги", "Сапоги Пепла", "Сапоги Укоренения", "Сапоги Следопыта" and "Сапоги Фазового Шага"
    return {_out::*}

function altarLocalRecipeIngredients(rid: text) :: texts:
    delete {_out::*}
    set {_r} to {_rid} in lower case
    if {_r} starts with "omni_":
        set {_slot} to {_r}
        replace all "omni_" in {_slot} with ""
        set {_out::*} to altarLocalRecipeOmniIngredients({_slot})
        return {_out::*}
    set {_theme} to ""
    set {_slot} to ""
    if {_r} starts with "ether_":
        set {_theme} to "ether"
        set {_slot} to {_r}
        replace all "ether_" in {_slot} with ""
    else if {_r} starts with "flame_":
        set {_theme} to "flame"
        set {_slot} to {_r}
        replace all "flame_" in {_slot} with ""
    else if {_r} starts with "vein_":
        set {_theme} to "vein"
        set {_slot} to {_r}
        replace all "vein_" in {_slot} with ""
    else if {_r} starts with "fortune_":
        set {_theme} to "fortune"
        set {_slot} to {_r}
        replace all "fortune_" in {_slot} with ""
    else if {_r} starts with "void_":
        set {_theme} to "void"
        set {_slot} to {_r}
        replace all "void_" in {_slot} with ""
    if {_theme} is "":
        return {_out::*}
    if {_slot} is "":
        return {_out::*}
    set {_base} to altarLocalRecipeSlotBaseName({_slot})
    add "Ключ Пустоты" to {_out::*}
    add "Ключ Возврата" to {_out::*}
    add {_base} to {_out::*}
    if {_theme} is "ether":
        add "Алмазный блок" to {_out::*}
        add "Аметистовый осколок" to {_out::*}
    else if {_theme} is "flame":
        add "Золотой блок" to {_out::*}
        add "Огненный стержень" to {_out::*}
    else if {_theme} is "vein":
        add "Изумрудный блок" to {_out::*}
        add "Слизь" to {_out::*}
    else if {_theme} is "fortune":
        add "Золотой блок" to {_out::*}
        add "Лазурит" to {_out::*}
    else if {_theme} is "void":
        add "Обсидиан" to {_out::*}
        add "Эндер-жемчуг" to {_out::*}
    return {_out::*}

function altarLocalRecipePageLore(rid: text) :: texts:
    delete {_lore::*}
    set {_name} to altarLocalRecipeName({_rid})
    add "&6Рецепт: &f%{_name}%" to {_lore::*}
    set {_ing::*} to altarLocalRecipeIngredients({_rid})
    loop {_ing::*}:
        add "&8 • &f%loop-value%" to {_lore::*}
    set {_r} to {_rid} in lower case
    if {_r} starts with "omni_":
        add "&7Слоты 0–4: все 5 предметов одного типа" to {_lore::*}
    else:
        add "&7Слоты 0–4 воронки, порядок любой" to {_lore::*}
    return {_lore::*}

function diaryPageItemForLocalRecipe(rid: text) :: item:
    set {_r} to {_rid} in lower case
    if {_r} is "":
        return air
    set {_name} to altarLocalRecipeName({_r})
    set {_page} to paper named "&6Страница дневника приключенца"
    set {_lore::*} to altarLocalRecipePageLore({_r})
    add "&8ПКМ: изучить как свиток" to {_lore::*}
    add "&0EVODIARY:recipe_local::%{_r}%" to {_lore::*}
    set lore of {_page} to {_lore::*}
    return {_page}

function artifactRuinRandomDiaryPageItem() :: item:
    set {_ids::*} to altarLocalRecipeIds()
    if size of {_ids::*} <= 0:
        return diaryPageItemForLocalRecipe("ether_pick")
    set {_pick} to random element out of {_ids::*}
    set {_pg} to diaryPageItemForLocalRecipe({_pick})
    if {_pg} is air:
        return diaryPageItemForLocalRecipe("ether_pick")
    return {_pg}

function isEtherTrashBlock(b: block) :: boolean:
    if {_b} is stone:
        return true
    if {_b} is cobblestone:
        return true
    if {_b} is dirt:
        return true
    if {_b} is gravel:
        return true
    if {_b} is deepslate:
        return true
    return false

function isEtherValuableOre(b: block) :: boolean:
    if {_b} is diamond ore:
        return true
    if {_b} is deepslate diamond ore:
        return true
    if {_b} is redstone ore:
        return true
    if {_b} is deepslate redstone ore:
        return true
    if {_b} is lapis ore:
        return true
    if {_b} is deepslate lapis ore:
        return true
    if {_b} is coal ore:
        return true
    if {_b} is deepslate coal ore:
        return true
    if {_b} is gold ore:
        return true
    if {_b} is deepslate gold ore:
        return true
    if {_b} is nether gold ore:
        return true
    if {_b} is iron ore:
        return true
    if {_b} is deepslate iron ore:
        return true
    if {_b} is ancient debris:
        return true
    return false

# Целый блок как при шёлковом касании (без консольной команды, как обычный дроп через giveOrDrop).
function giveAltarSilkBlockItemById(p: player, id: text, loc: location):
    set {_t} to {_id} in lower case
    set {_it} to air
    if {_t} is "stone":
        set {_it} to stone
    else if {_t} is "cobblestone":
        set {_it} to cobblestone
    else if {_t} is "dirt":
        set {_it} to dirt
    else if {_t} is "gravel":
        set {_it} to gravel
    else if {_t} is "deepslate":
        set {_it} to deepslate
    else if {_t} is "diamond_ore":
        set {_it} to diamond ore
    else if {_t} is "deepslate_diamond_ore":
        set {_it} to deepslate diamond ore
    else if {_t} is "gold_ore":
        set {_it} to gold ore
    else if {_t} is "deepslate_gold_ore":
        set {_it} to deepslate gold ore
    else if {_t} is "nether_gold_ore":
        set {_it} to nether gold ore
    else if {_t} is "iron_ore":
        set {_it} to iron ore
    else if {_t} is "deepslate_iron_ore":
        set {_it} to deepslate iron ore
    else if {_t} is "coal_ore":
        set {_it} to coal ore
    else if {_t} is "deepslate_coal_ore":
        set {_it} to deepslate coal ore
    else if {_t} is "lapis_ore":
        set {_it} to lapis ore
    else if {_t} is "deepslate_lapis_ore":
        set {_it} to deepslate lapis ore
    else if {_t} is "redstone_ore":
        set {_it} to redstone ore
    else if {_t} is "deepslate_redstone_ore":
        set {_it} to deepslate redstone ore
    else if {_t} is "ancient_debris":
        set {_it} to ancient debris
    if {_it} is not air:
        giveOrDrop({_it}, {_p}, {_loc})

function giveAltarSilkBlockItem(p: player, b: block, loc: location):
    giveAltarSilkBlockItemById({_p}, "%type of {_b}%", {_loc})

# Опыт как у обычной добычи руды (под шёлк).
function giveAltarSilkOreXp(p: player, b: block):
    if {_b} is diamond ore:
        give 3 experience to {_p}
    else if {_b} is deepslate diamond ore:
        give 3 experience to {_p}
    else if {_b} is gold ore:
        give 2 experience to {_p}
    else if {_b} is deepslate gold ore:
        give 2 experience to {_p}
    else if {_b} is nether gold ore:
        give 2 experience to {_p}
    else if {_b} is iron ore:
        give 2 experience to {_p}
    else if {_b} is deepslate iron ore:
        give 2 experience to {_p}
    else if {_b} is coal ore:
        give 2 experience to {_p}
    else if {_b} is deepslate coal ore:
        give 2 experience to {_p}
    else if {_b} is lapis ore:
        give 3 experience to {_p}
    else if {_b} is deepslate lapis ore:
        give 3 experience to {_p}
    else if {_b} is redstone ore:
        give 3 experience to {_p}
    else if {_b} is deepslate redstone ore:
        give 3 experience to {_p}
    else if {_b} is ancient debris:
        give 5 experience to {_p}

function giveOrDrop(it: item, p: player, loc: location):
    if {_p} has space for {_it}:
        give {_it} to {_p}
    else:
        drop {_it} at {_loc}

function clearAltarCraftSlots(inv: inventory):
    set slot 0 of {_inv} to air
    set slot 1 of {_inv} to air
    set slot 2 of {_inv} to air
    set slot 3 of {_inv} to air
    set slot 4 of {_inv} to air

function isPickaxeRecipeByCore(inv: inventory, core: item, catalyst: item) :: boolean:
    set {_voidN} to 0
    set {_retN} to 0
    set {_pickN} to 0
    set {_coreN} to 0
    set {_catN} to 0
    set {_total} to 0
    set {_bad} to false
    loop 5 times:
        set {_it} to slot (loop-number - 1) of {_inv}
        if {_it} is air:
            set {_bad} to true
        else:
            add 1 to {_total}
            if altarAwakeningVoidKey({_it}) is true:
                add 1 to {_voidN}
            else if altarAwakeningReturnKey({_it}) is true:
                add 1 to {_retN}
            else if {_it} is diamond pickaxe:
                add 1 to {_pickN}
            else if {_it} is {_core}:
                add 1 to {_coreN}
            else if {_it} is {_catalyst}:
                add 1 to {_catN}
            else:
                set {_bad} to true
    if {_bad} is true:
        return false
    if {_total} is not 5:
        return false
    if {_voidN} is not 1:
        return false
    if {_retN} is not 1:
        return false
    if {_pickN} is not 1:
        return false
    if {_coreN} is not 1:
        return false
    if {_catN} is not 1:
        return false
    return true

function isOmniPickaxeAltarRecipe(inv: inventory) :: boolean:
    set {_ether} to 0
    set {_flame} to 0
    set {_vein} to 0
    set {_fortune} to 0
    set {_voidp} to 0
    set {_total} to 0
    set {_bad} to false
    loop 5 times:
        set {_it} to slot (loop-number - 1) of {_inv}
        if {_it} is air:
            set {_bad} to true
        else:
            add 1 to {_total}
            if isEtherPickaxe({_it}) is true:
                add 1 to {_ether}
            else if isFlamePickaxe({_it}) is true:
                add 1 to {_flame}
            else if isVeinPickaxe({_it}) is true:
                add 1 to {_vein}
            else if isFortunePickaxe({_it}) is true:
                add 1 to {_fortune}
            else if isVoidPickaxe({_it}) is true:
                add 1 to {_voidp}
            else:
                set {_bad} to true
    if {_bad} is true:
        return false
    if {_total} is not 5:
        return false
    if {_ether} is not 1:
        return false
    if {_flame} is not 1:
        return false
    if {_vein} is not 1:
        return false
    if {_fortune} is not 1:
        return false
    if {_voidp} is not 1:
        return false
    return true

function isEtherPickaxeAltarRecipeExact(inv: inventory) :: boolean:
    set {_voidN} to 0
    set {_retN} to 0
    set {_pickN} to 0
    set {_blockN} to 0
    set {_amN} to 0
    set {_total} to 0
    set {_bad} to false
    loop 5 times:
        set {_si} to loop-number - 1
        set {_it} to slot {_si} of {_inv}
        if {_it} is air:
            set {_bad} to true
        else:
            add 1 to {_total}
            if altarAwakeningVoidKey({_it}) is true:
                add 1 to {_voidN}
            else if altarAwakeningReturnKey({_it}) is true:
                add 1 to {_retN}
            else if {_it} is diamond pickaxe:
                add 1 to {_pickN}
            else if {_it} is diamond block:
                add 1 to {_blockN}
            else if {_it} is amethyst shard:
                add 1 to {_amN}
            else:
                set {_bad} to true
    if {_bad} is true:
        return false
    if {_total} is not 5:
        return false
    if {_voidN} is not 1:
        return false
    if {_retN} is not 1:
        return false
    if {_pickN} is not 1:
        return false
    if {_blockN} is not 1:
        return false
    if {_amN} is not 1:
        return false
    return true

