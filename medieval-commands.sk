    initAltarGearAncientScrollRecipes()

function initAltarGearAncientScrollRecipes():
    set {_altarIds::*} to altarLocalRecipeIds()
    loop {_altarIds::*}:
        set {_id} to loop-value
        set {_r} to {_id} in lower case
        set {_tier} to "medium"
        if {_r} starts with "omni_":
            set {_tier} to "absolute"
        set {ancient_scroll_recipes::%{_id}%::name} to altarLocalRecipeName({_id})
        set {ancient_scroll_recipes::%{_id}%::tier} to {_tier}
        delete {ancient_scroll_recipes::%{_id}%::ing::*}
        set {_ing::*} to altarLocalRecipeIngredients({_id})
        loop {_ing::*}:
            add loop-value-2 to {ancient_scroll_recipes::%{_id}%::ing::*}

function ancientScrollItem(id: text) :: item:
    set {_n} to {ancient_scroll_recipes::%{_id}%::name}
    if {_n} is not set:
        return air
    set {_it} to paper named "&6Древний Свиток: %{_n}%"
    set lore of {_it} to "&7Нажмите ПКМ, чтобы изучить рецепт." and "&8Только знание, без свойств предмета" and "&0EVOSCROLL:%{_id}%"
    return {_it}

function ancientScrollIdFromItem(i: item) :: text:
    set {_ls::*} to lore of {_i}
    loop {_ls::*}:
        set {_lv} to "%loop-value%"
        if {_lv} starts with "&0EVOSCROLL:":
            replace all "&0EVOSCROLL:" in {_lv} with ""
            return {_lv}
    return ""

function diaryPageEntryFromItem(i: item) :: text:
    set {_ls::*} to lore of {_i}
    loop {_ls::*}:
        set {_lv} to "%loop-value%"
        if {_lv} starts with "&0EVODIARY:":
            replace all "&0EVODIARY:" in {_lv} with ""
            return {_lv}
    return ""

function ancientScrollDiaryEntry(id: text) :: text:
    set {_n} to {ancient_scroll_recipes::%{_id}%::name}
    if {_n} is not set:
        return ""
    set {_line} to ""
    loop {ancient_scroll_recipes::%{_id}%::ing::*}:
        if {_line} is "":
            set {_line} to "%loop-value%"
        else:
            set {_line} to "%{_line}% + %loop-value%"
    return "Рецепт %{_n}%: %{_line}%"

function isRuinDimension(w: world) :: boolean:
    set {_wn} to "%{_w}%" in lower case
    if {_wn} contains "руин":
        return true
    if {_wn} contains "ruin":
        return true
    return false

on load:
    initAncientScrollRecipes()

on right click:
    if player's tool is paper:
        set {_entry} to diaryPageEntryFromItem(player's tool)
        if {_entry} is not "":
            cancel event
            if {_entry} starts with "recipe::":
                set {_rid} to {_entry}
                replace all "recipe::" in {_rid} with ""
                addDiaryRecipePage(player, {_rid})
                set {_name} to {ancient_scroll_recipes::%{_rid}%::name}
                if {_name} is not set:
                    set {_name} to {_rid}
                send title "&6Страница дневника" with subtitle "&f%{_name}%" to player for 2 seconds
                send "{@prefix} &aРецепт со страницы добавлен в Дневник: &f%{_name}%" to player
            else if {_entry} starts with "recipe_local::":
                addDiaryPage(player, {_entry})
                set {_rid} to {_entry}
                replace all "recipe_local::" in {_rid} with ""
                set {_name} to altarLocalRecipeName({_rid})
                send title "&6Страница дневника" with subtitle "&f%{_name}%" to player for 2 seconds
                send "{@prefix} &aРецепт со страницы добавлен в Дневник: &f%{_name}%" to player
            else:
                addDiaryPage(player, {_entry})
                send title "&6Страница дневника" with subtitle "&fЗапись изучена" to player for 2 seconds
                send "{@prefix} &aЗапись со страницы добавлена в ваш дневник." to player
            play sound "block.enchantment_table.use" with volume 1 and pitch 1 at player for player
            remove 1 of player's tool from player
            stop
        set {_sid} to ancientScrollIdFromItem(player's tool)
        if {_sid} is not "":
            cancel event
            set {_name} to {ancient_scroll_recipes::%{_sid}%::name}
            addDiaryRecipePage(player, {_sid})
            send title "&6Древний Свиток" with subtitle "&f%{_name}%" to player for 2 seconds
            send "{@prefix} &aРецепт добавлен в Дневник приключенца: &f%{_name}%" to player
            execute console command "particle minecraft:spell %x-coordinate of player% %y-coordinate of player% %z-coordinate of player% 0.4 0.6 0.4 0.03 25 force"
            play sound "block.enchantment_table.use" with volume 1 and pitch 1 at player for player
            remove 1 of player's tool from player
            stop

on death:
    if victim is not a player:
        if isRuinDimension(world of victim) is true:
            chance of 0.5%:
                set {_abs::*} to "leg_warrior", "leg_scout", "leg_tank", "leg_archer", "leg_mage", "leg_necro", "crownmind" and "cursedgift"
                set {_aid} to random element out of {_abs::*}
                set {_as} to ancientScrollItem({_aid})
                if {_as} is not air:
                    drop {_as} at location of victim
            else:
                chance of 2%:
                    set {_mid::*} to "hermes", "windring", "vampcharm", "etherdash", "mehrunes", "starfury", "icewalker", "frostheart", "ankhshield", "azura", "rottenapple", "voidcompass", "luckcoin", "cloudjump", "heater", "dreamcatcher", "desertheart", "quantdup", "facelessmask", "lootmagnet", "nightlens" and "ruin_summon"
                    set {_pick} to random element out of {_mid::*}
                    set {_ms} to ancientScrollItem({_pick})
                    if {_ms} is not air:
                        drop {_ms} at location of victim
