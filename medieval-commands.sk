# medieval-commands.sk — команды, админка, косметика, init (модуль EVO)
# Reload: /sk reload medieval-commands

using for loops

options:
    prefix: &8[&b&lEvo&8]&r
    max_level: 25
    kills_per_level: 2
    duotpa_warmup: 3
    duotpa_cooldown: 90
    duotpa_request_ttl: 60
    combat_log_duration: 15
    # Руины: 0 = не спавнить при загрузке чанков; 1 = включить случайный спавн (шанс 1/denominator в пустом регионе).
    artifact_ruin_auto_chunk_spawn: 0
    artifact_ruin_denominator: 20
    artifact_ruin_region_chunks: 6
    # Мин. расстояние от world spawn (блоки) — для игрока «Зов Руин» и автоспавна.
    artifact_ruin_min_spawn_blocks: 160
    artifact_ruin_legendary_chance_percent: 14
    # Замена разрушенного портала при генерации: common_max 0 = никогда не заменять (руины только вручную / админ).
    artifact_ruin_portal_roll_legendary_max: 10
    artifact_ruin_portal_roll_common_max: 0
    # Главный сундук башни: шанс что в центральном слоте свиток вместо артефакта (0–100).
    artifact_ruin_boss_chest_scroll_percent: 78
    # Обычные сундуки руины: при заполнении слота ресурсами — шанс страницы дневника с алтарным рецептом (0–100).
    artifact_ruin_side_chest_scroll_substitute_percent: 30
    # Обычные сундуки: шанс ключа возврата и (суммарно после него) ключа пустоты на один «лут-слот» (0–100).
    artifact_ruin_side_chest_return_key_percent: 11
    artifact_ruin_side_chest_void_key_percent: 3


# ==========================================
# АДМИН GUI АРТЕФАКТОВ
# ==========================================
command /artifacts:
    trigger:
        migrateUtilityCoreVars(player)
        open chest inventory with 3 rows named "&8Artifacts Core" to player
        dbgEvo(player, "opened /artifacts GUI")
        loop 27 times:
            set slot (loop-number - 1) of player's current inventory to gray stained glass pane named " "

        set slot 4 of player's current inventory to nether star named "&6&lАРТЕФАКТЫ: ЯДРО"
        set lore of slot 4 of player's current inventory to "&75 слотов ядра (обычные артефакты)" and "&7ПКМ: включить/выключить" and "&7ЛКМ: извлечь в предмет" and "&7Utility-ядро: &e/utilities" and "&7Легендарные: &e/legendary"

        loop 5 times:
            set {_idx} to loop-number
            set {_slot} to 10 + loop-number
            set {_key} to artifactCoreKeyByIndex(player, {_idx})
            if {_key} is "":
                set slot {_slot} of player's current inventory to black stained glass pane named "&8Пустой слот ядра"
            else:
                set {_s} to artifactSlotFromKey({_key})
                if {_s} >= 0:
                    set {_art} to artifactMenuItem(player, {_s})
                    if {_art} is not air:
                        set slot {_slot} of player's current inventory to {_art}

on inventory click:
    if name of event-inventory contains "Artifacts Core":
        cancel event
        set {_slot} to index of event-slot
        if {_slot} is not between 0 and 26:
            stop
        set {_i} to artifactCoreGuiIndexBySlot({_slot})
        if {_i} is 0:
            stop
        set {_key} to artifactCoreKeyByIndex(player, {_i})
        if {_key} is "":
            stop
        set {_u} to uuid of player
        set {_enabled_now} to {art_enabled::%{_u}%::%{_key}%} ? false
        set {_click} to "%click type%"
        set {_isLeft} to false
        set {_isRight} to false
        if {_click} contains "left mouse button":
            set {_isLeft} to true
        if {_click} contains "right mouse button":
            set {_isRight} to true
        if {_isLeft} is true:
            if pullArtifactFromCore(player, {_key}) is true:
                send "{@prefix} &eАртефакт извлечён в предмет."
                play sound "item.bundle.remove_one" with volume 0.9 and pitch 1 at player for player
        else if {_isRight} is true:
            if {_enabled_now} is true:
                set {art_enabled::%{_u}%::%{_key}%} to false
            else:
                set {art_enabled::%{_u}%::%{_key}%} to true
            set {_enabled_after} to {art_enabled::%{_u}%::%{_key}%} ? false
            if {_key} is "cloudjump":
                if {_enabled_after} is false:
                    resetBalloonState(player)
            if {_enabled_after} is true:
                send "{@prefix} &aЭффект артефакта включён."
                play sound "entity.experience_orb.pickup" with volume 1 and pitch 1.2 at player for player
            else:
                send "{@prefix} &cЭффект артефакта выключен."
                play sound "block.note_block.bass" with volume 1 and pitch 0.8 at player for player
        else:
            stop
        # Перерисовываем 5 слотов после любого изменения.
        wait 1 tick
        loop 5 times:
            set {_idx} to loop-number
            set {_rslot} to 10 + loop-number
            set {_rkey} to artifactCoreKeyByIndex(player, {_idx})
            if {_rkey} is "":
                set slot {_rslot} of player's current inventory to black stained glass pane named "&8Пустой слот ядра"
            else:
                set {_rs} to artifactSlotFromKey({_rkey})
                if {_rs} >= 0:
                    set {_rit} to artifactMenuItem(player, {_rs})
                    if {_rit} is not air:
                        set slot {_rslot} of player's current inventory to {_rit}

command /utilities:
    aliases: /utility
    trigger:
        migrateUtilityCoreVars(player)
        open chest inventory with 3 rows named "&8Utility Core" to player
        loop 27 times:
            set slot (loop-number - 1) of player's current inventory to light blue stained glass pane named " "
        set slot 4 of player's current inventory to clock named "&b&lUTILITY: ЯДРО"
        set lore of slot 4 of player's current inventory to "&7Utility-ядро без лимита слотов" and "&7ПКМ: включить/выключить" and "&7ЛКМ: извлечь в предмет" and "&7Обычные артефакты: &e/artifacts"
        loop 5 times:
            set {_idx} to loop-number
            set {_slot} to 10 + loop-number
            set {_key} to utilityCoreKeyByIndex(player, {_idx})
            if {_key} is "":
                set slot {_slot} of player's current inventory to black stained glass pane named "&8Пустой utility-слот"
            else:
                set {_s} to artifactSlotFromKey({_key})
                if {_s} >= 0:
                    set {_art} to utilityMenuItem(player, {_s})
                    if {_art} is not air:
                        set slot {_slot} of player's current inventory to {_art}

on inventory click:
    if name of event-inventory contains "Utility Core":
        cancel event
        set {_slot} to index of event-slot
        if {_slot} is not between 0 and 26:
            stop
        set {_i} to utilityCoreGuiIndexBySlot({_slot})
        if {_i} is 0:
            stop
        set {_key} to utilityCoreKeyByIndex(player, {_i})
        if {_key} is "":
            stop
        set {_u} to uuid of player
        set {_enabled_now} to {util_enabled::%{_u}%::%{_key}%} ? false
        set {_click} to "%click type%"
        if {_click} contains "left mouse button":
            if pullUtilityFromCore(player, {_key}) is true:
                send "{@prefix} &eUtility-артефакт извлечён в предмет."
                play sound "item.bundle.remove_one" with volume 0.9 and pitch 1 at player for player
        else if {_click} contains "right mouse button":
            if {_enabled_now} is true:
                set {util_enabled::%{_u}%::%{_key}%} to false
            else:
                set {util_enabled::%{_u}%::%{_key}%} to true
            if {util_enabled::%{_u}%::%{_key}%} is true:
                send "{@prefix} &aUtility-эффект включён."
                play sound "entity.experience_orb.pickup" with volume 1 and pitch 1.2 at player for player
            else:
                send "{@prefix} &cUtility-эффект выключен."
                play sound "block.note_block.bass" with volume 1 and pitch 0.8 at player for player
        else:
            stop
        wait 1 tick
        loop 5 times:
            set {_idx} to loop-number
            set {_rslot} to 10 + loop-number
            set {_rkey} to utilityCoreKeyByIndex(player, {_idx})
            if {_rkey} is "":
                set slot {_rslot} of player's current inventory to black stained glass pane named "&8Пустой utility-слот"
            else:
                set {_rs} to artifactSlotFromKey({_rkey})
                if {_rs} >= 0:
                    set {_rit} to utilityMenuItem(player, {_rs})
                    if {_rit} is not air:
                        set slot {_rslot} of player's current inventory to {_rit}

command /legendary:
    trigger:
        open chest inventory with 3 rows named "&8Legendary Core" to player
        loop 27 times:
            set slot (loop-number - 1) of player's current inventory to black stained glass pane named " "
        loop 0, 1, 2, 6, 8, 9, 11, 15, 17, 18, 19, 20, 24, 25 and 26:
            set slot loop-value of player's current inventory to orange stained glass pane named " "
        set slot 4 of player's current inventory to nether star named "&6&l✦ ЛЕГЕНДАРНЫЙ АРТЕФАКТ ✦"
        set lore of slot 4 of player's current inventory to "&7Твой активный легендарный слот" and "&7по текущему классу." and " " and "&aПКМ: включить/выключить" and "&eЛКМ: извлечь в предмет"
        set slot 22 of player's current inventory to barrier named "&c&lЗакрыть"
        set lore of slot 22 of player's current inventory to "&7Нажми, чтобы закрыть меню"
        set {_k} to classLegendaryKey(player)
        if {_k} is "":
            set slot 13 of player's current inventory to barrier named "&cЛегендарка недоступна" with lore "&7Сначала выбери класс через &e/class" and "&7Затем вернись в это меню"
            stop
        set {_s} to artifactSlotFromKey({_k})
        if {_s} < 0:
            set slot 13 of player's current inventory to barrier named "&cОшибка легендарки класса"
            stop
        set {_it} to artifactMenuItem(player, {_s})
        if {_it} is air:
            set slot 13 of player's current inventory to barrier named "&cЛегендарный артефакт недоступен"
        else:
            set slot 13 of player's current inventory to {_it}

on inventory click:
    if name of event-inventory contains "Legendary Core":
        cancel event
        if clicked inventory is not player's current inventory:
            stop
        set {_slot} to index of event-slot
        if {_slot} is 22:
            close player's inventory
            stop
        if {_slot} is not 13:
            stop
        set {_k} to classLegendaryKey(player)
        if {_k} is "":
            send "{@prefix} &cВыбери класс, чтобы использовать легендарный артефакт."
            stop
        set {_u} to player's uuid
        set {_owned} to {art_found::%{_u}%::%{_k}%} ? false
        if {_owned} is false:
            send "{@prefix} &cЭтот легендарный артефакт ещё не найден."
            send "{@prefix} &7Выдача: &e/evo <ник> artifactgive %{_k}%"
            play sound "entity.villager.no" with volume 0.7 and pitch 1 at player for player
            stop
        set {_click} to "%click type%"
        if {_click} contains "left mouse button":
            if pullArtifactFromCore(player, {_k}) is true:
                send "{@prefix} &eЛегендарный артефакт извлечён в предмет."
                play sound "item.bundle.remove_one" with volume 0.9 and pitch 1 at player for player
        else if {_click} contains "right mouse button":
            set {_now} to {art_enabled::%{_u}%::%{_k}%} ? false
            if {_now} is true:
                set {art_enabled::%{_u}%::%{_k}%} to false
                send "{@prefix} &cЛегендарный эффект выключен."
            else:
                loop "leg_warrior", "leg_scout", "leg_tank", "leg_archer", "leg_mage" and "leg_necro":
                    if loop-value is not {_k}:
                        set {art_enabled::%{_u}%::%loop-value%} to false
                set {art_enabled::%{_u}%::%{_k}%} to true
                send "{@prefix} &aЛегендарный эффект включён."
            play sound "entity.experience_orb.pickup" with volume 1 and pitch 1.2 at player for player
        set {_s} to artifactSlotFromKey({_k})
        set {_it} to artifactMenuItem(player, {_s})
        if {_it} is not air:
            set slot 13 of player's current inventory to {_it}

command /artifactpull <text>:
    trigger:
        set {_id} to arg-1 in lower case
        if {_id} is "all":
            set {_c} to 0
            set {_coreIds::*} to artifactCoreIds()
            loop {_coreIds::*}:
                if pullArtifactFromCore(player, loop-value) is true:
                    add 1 to {_c}
            if {_c} > 0:
                send "{@prefix} &aИз ядра извлечено артефактов: &e%{_c}%"
                play sound "item.bundle.remove_one" with volume 0.9 and pitch 1 at player for player
            else:
                send "{@prefix} &7В ядре нет артефактов для извлечения."
            stop
        if isKnownArtifactId({_id}) is false:
            send "{@prefix} &cНеизвестный id артефакта."
            send "&7ID: &f%artifactCoreIdsHint()%"
            stop
        if pullArtifactFromCore(player, {_id}) is true:
            send "{@prefix} &aАртефакт &e%{_id}% &aизвлечён из ядра в предмет."
            play sound "item.bundle.remove_one" with volume 0.9 and pitch 1 at player for player
        else:
            send "{@prefix} &7Этот артефакт не найден в твоём ядре."

function evoBlockLocKey(bl: block) :: text:
    set {_loc} to location of {_bl}
    set {_w} to world of {_bl}
    set {_x} to floor(x-coordinate of {_loc})
    set {_y} to floor(y-coordinate of {_loc})
    set {_z} to floor(z-coordinate of {_loc})
    return "%{_w}%:%{_x}%:%{_y}%:%{_z}%"

function isRuinedPortalChestLike(b: block) :: boolean:
    if {_b} is not chest:
        if {_b} is not trapped chest:
            return false
    set {_w} to world of {_b}
    if environment of {_w} is not normal:
        return false
    set {_loc} to location of {_b}
    set {_obs} to 0
    set {_cry} to 0
    set {_nether} to 0
    set {_magma} to 0
    set {_gold} to 0
    loop blocks in radius 4 around {_loc}:
        if loop-block is obsidian:
            add 1 to {_obs}
        else if loop-block is crying obsidian:
            add 1 to {_cry}
        else if loop-block is netherrack:
            add 1 to {_nether}
        else if loop-block is magma block:
            add 1 to {_magma}
        else if loop-block is gold block:
            add 1 to {_gold}
    # Защита от абуза: обычный сундук рядом с 1 обсидианом не считается "порталом".
    # Нужна более полная сигнатура руин-портала.
    set {_portalStone} to {_obs} + {_cry}
    if {_portalStone} < 6:
        return false
    if {_nether} < 4:
        return false
    if {_magma} < 1:
        return false
    if {_gold} < 1:
        return false
    return true

# Ключ пустоты: не чаще одного в радиусе 2 чанков; не с сундуков, поставленных игроком.
function evoTryGiveVoidKeyFromRuinedPortal(p: player, cb: block) :: boolean:
    if isRuinedPortalChestLike({_cb}) is false:
        return false
    set {_bk} to evoBlockLocKey({_cb})
    if {evo_chest_player_placed::%{_bk}%} is true:
        send action bar "&cКлюч пустоты нельзя получить с установленного сундука." to {_p}
        return false
    if {evo_voidkey_taken::%{_bk}%} is true:
        return false
    set {_loc} to location of {_cb}
    set {_w} to world of {_cb}
    set {_wn} to "%{_w}%"
    set {_x} to floor(x-coordinate of {_loc})
    set {_z} to floor(z-coordinate of {_loc})
    set {_ccx} to floor({_x} / 16)
    set {_ccz} to floor({_z} / 16)
    if {evo_voidkey_chunk_used::%{_wn}%::%{_ccx}%::%{_ccz}%} is true:
        send action bar "&cВ радиусе 2 чанков уже забирали ключ пустоты." to {_p}
        return false
    set {_k} to evoAdminItemById("void_key")
    if {_k} is air:
        return false
    set {evo_voidkey_taken::%{_bk}%} to true
    set {_dx} to -2
    while {_dx} <= 2:
        set {_dz} to -2
        while {_dz} <= 2:
            set {_tx} to {_ccx} + {_dx}
            set {_tz} to {_ccz} + {_dz}
            set {evo_voidkey_chunk_used::%{_wn}%::%{_tx}%::%{_tz}%} to true
            add 1 to {_dz}
        add 1 to {_dx}
    giveOrDrop({_k}, {_p}, location of {_cb})
    send "{@prefix} &5Вы нашли Ключ пустоты в руинах портала." to {_p}
    play sound "entity.experience_orb.pickup" with volume 0.9 and pitch 1 at {_p} for {_p}
    return true

on place of chest:
    set {evo_chest_player_placed::%evoBlockLocKey(event-block)%} to true

on place of trapped chest:
    set {evo_chest_player_placed::%evoBlockLocKey(event-block)%} to true

on break of chest:
    delete {evo_chest_player_placed::%evoBlockLocKey(event-block)%}

on break of trapped chest:
    delete {evo_chest_player_placed::%evoBlockLocKey(event-block)%}

on right click on chest:
    set {_ck} to evoBlockLocKey(event-block)
    if {evo_ruin_tower_locked::%{_ck}%} is true:
        if {evo_ruin_tower_unlocked::%{_ck}%} is true:
            stop
        cancel event
        if altarAwakeningVoidKey(player's tool) is false:
            send action bar "&cСундук башни заперт: нужен Ключ пустоты в руке." to player
            play sound "block.chest.locked" with volume 1 and pitch 0.8 at player for player
            stop
        remove 1 of player's tool from player
        set {evo_ruin_tower_unlocked::%{_ck}%} to true
        play sound "block.chest.open" with volume 1 and pitch 1.1 at event-block for player
        send "{@prefix} &5Сундук башни открыт ключом пустоты." to player
        set {_tinv} to inventory of event-block
        open {_tinv} to player
        stop
    evoTryGiveVoidKeyFromRuinedPortal(player, event-block)
    stop

on right click on trapped chest:
    evoTryGiveVoidKeyFromRuinedPortal(player, event-block)
    stop

function evoRuinFirstNormalWorld() :: world:
    loop all worlds:
        if environment of loop-world is normal:
            return loop-world
    return world("world")

# ==========================================
# АДМИН-КОМАНДЫ
# ==========================================
command /evoruinspawn [<number>] [<number>] [<text>]:
    executable by: players and console
    permission: evo.admin
    permission message: {@prefix} &cУ вас нет прав!
    trigger:
        if arg-1 is set:
            if arg-2 is not set:
                send "{@prefix} &cИспользование: /evoruinspawn <x> <z> [мир]"
                stop
            set {_x} to floor(arg-1)
            set {_z} to floor(arg-2)
            delete {_w}
            if arg-3 is set:
                set {_wn} to arg-3
                set {_w} to world({_wn})
                if {_w} is not set:
                    send "{@prefix} &cМир &f%{_wn}% &cне найден."
                    stop
            else:
                if sender is a player:
                    set {_w} to world of player
                else:
                    set {_w} to evoRuinFirstNormalWorld()
            if environment of {_w} is not normal:
                send "{@prefix} &cНужен мир с типом Оверворлд (normal)."
                stop
            set {_feet} to artifactRuinFeetAtColumn({_x}, {_z}, {_w})
            if artifactRuinFeetValid({_feet}) is false:
                send "{@prefix} &cНет подходящей поверхности у колонки X=%{_x}% Z=%{_z}% в &f%{_w}%&c."
                stop
            if artifactRuinBuild({_feet}, "common") is true:
                send "{@prefix} &aПостроена руина в &f%{_w}%&a: центр пола &f%{_x}% %{_z}%"
                stop
            send "{@prefix} &cНе удалось построить руину по этим координатам."
            stop
        if sender is not a player:
            send "{@prefix} &cС консоли: &f/evoruinspawn <x> <z> [мир]"
            send "{@prefix} &7Без [мир] используется первый оверворлд из списка миров сервера."
            stop
        if artifactRuinAdminSpawnHere(player) is true:
            send "{@prefix} &aПостроена руина: &7чёрный камень = легендарный артефакт, &fцветной пол = обычный&a. Сундук в башне."
            play sound "block.beacon.activate" with volume 1 and pitch 1.2 at player for player
        else:
            send "{@prefix} &cНе удалось: нужен Оверворлд и твёрдая поверхность под колонкой X/Z."

command /evoruinlegspawn [<number>] [<number>] [<text>]:
    executable by: players and console
    permission: evo.admin
    permission message: {@prefix} &cУ вас нет прав!
    trigger:
        if arg-1 is set:
            if arg-2 is not set:
                send "{@prefix} &cИспользование: /evoruinlegspawn <x> <z> [мир]"
                stop
            set {_x} to floor(arg-1)
            set {_z} to floor(arg-2)
            delete {_w}
            if arg-3 is set:
                set {_wn} to arg-3
                set {_w} to world({_wn})
                if {_w} is not set:
                    send "{@prefix} &cМир &f%{_wn}% &cне найден."
                    stop
            else:
                if sender is a player:
                    set {_w} to world of player
                else:
                    set {_w} to evoRuinFirstNormalWorld()
            if environment of {_w} is not normal:
                send "{@prefix} &cНужен мир с типом Оверворлд (normal)."
                stop
            set {_feet} to artifactRuinFeetAtColumn({_x}, {_z}, {_w})
            if artifactRuinFeetValid({_feet}) is false:
                send "{@prefix} &cНет подходящей поверхности у колонки X=%{_x}% Z=%{_z}% в &f%{_w}%&c."
                stop
            if artifactRuinBuild({_feet}, "legendary") is true:
                send "{@prefix} &6Построена легендарная руина в &f%{_w}%&6: центр пола &f%{_x}% %{_z}%"
                stop
            send "{@prefix} &cНе удалось построить легендарную руину по этим координатам."
            stop
        if sender is not a player:
            send "{@prefix} &cС консоли: &f/evoruinlegspawn <x> <z> [мир]"
            send "{@prefix} &7Без [мир] используется первый оверворлд из списка миров сервера."
            stop
        if artifactRuinAdminSpawnHereKind(player, "legendary") is true:
            send "{@prefix} &6Построена &lлегендарная&6 руина: &7чернокаменный стиль, в сундуке башни — &6легендарный&7 артефакт."
            play sound "block.respawn_anchor.set_spawn" with volume 1 and pitch 1.15 at player for player
        else:
            send "{@prefix} &cНе удалось: нужен Оверворлд и твёрдая поверхность под колонкой X/Z."

function openEvoGivePage(v: player, target: player, page: number):
    set {_ids::*} to evoAdminItemIdList()
    set {_total} to size of {_ids::*}
    set {_pages} to floor(({_total} - 1) / 45) + 1
    if {_pages} < 1:
        set {_pages} to 1
    set {_pg} to {_page}
    if {_pg} < 1:
        set {_pg} to 1
    if {_pg} > {_pages}:
        set {_pg} to {_pages}
    set {evo_give_page::%uuid of {_v}%} to {_pg}
    delete {evo_give_slot_id::%uuid of {_v}%::*}
    open chest inventory with 6 rows named "&0EVO GIVE" to {_v}
    set {_start} to ({_pg} - 1) * 45 + 1
    set {_slot} to 0
    loop 45 times:
        set {_idx} to {_start} + loop-number - 1
        set {_id} to {_ids::%{_idx}%}
        if {_id} is set:
            set {_it} to evoAdminItemById({_id})
            if {_it} is not air:
                set {_l::*} to lore of {_it}
                add " " to {_l::*}
                add "&8ID: %{_id}%" to {_l::*}
                add "&7ЛКМ: выдать x1" to {_l::*}
                add "&7ПКМ: выдать x64" to {_l::*}
                set lore of {_it} to {_l::*}
                set slot {_slot} of {_v}'s current inventory to {_it}
                set {evo_give_slot_id::%uuid of {_v}%::%{_slot}%} to {_id}
        add 1 to {_slot}
    if {_pg} > 1:
        set slot 45 of {_v}'s current inventory to arrow named "&e← Назад" with lore "&7Страница %{_pg}%/%{_pages}%"
    set slot 49 of {_v}'s current inventory to paper named "&6Страница %{_pg}%/%{_pages}%" with lore "&7Цель: &e%{_target}%"
    if {_pg} < {_pages}:
        set slot 52 of {_v}'s current inventory to arrow named "&eВперёд →" with lore "&7Страница %{_pg}%/%{_pages}%"
    set slot 53 of {_v}'s current inventory to barrier named "&cЗакрыть" with lore "&7Цель выдачи: &e%{_target}%"

command /evogive [<player>]:
    permission: evo.admin
    permission message: {@prefix} &cУ вас нет прав!
    trigger:
        set {_target} to player
        if arg-1 is set:
            set {_target} to arg-1
        if {_target} is not set:
            send "{@prefix} &cЦелевой игрок не найден."
            stop
        set {evo_give_target::%uuid of player%} to uuid of {_target}
        openEvoGivePage(player, {_target}, 1)
        send "{@prefix} &7GUI выдачи открыт. Цель: &e%{_target}%&7."

on inventory click:
    if name of event-inventory is "&0EVO ADMIN":
        cancel event
        if clicked inventory is not event-inventory:
            stop
        set {_slot} to index of event-slot
        if {_slot} is not set:
            set {_slot} to clicked slot
        set {_act} to {evo_admin_slot::%uuid of player%::%{_slot}%}
        if {_act} is not set:
            stop
        if {_act} is "nav:close":
            close player's inventory
            stop
        set {_pg} to {evo_admin_page::%uuid of player%} ? 0
        if {_act} is "nav:back":
            if {_pg} is 1:
                set {evo_admin_reopen::%uuid of player%} to true
                openEvoAdminPage(player, 0)
            else if {_pg} is 4:
                set {evo_admin_reopen::%uuid of player%} to true
                openEvoAdminPage(player, 3)
            else:
                set {evo_admin_reopen::%uuid of player%} to true
                openEvoAdminPage(player, {_pg} - 1)
            stop
        if {_act} is "nav:next":
            set {evo_admin_reopen::%uuid of player%} to true
            openEvoAdminPage(player, {_pg} + 1)
            stop
        if {_act} starts with "nav:":
            set {_nav} to {_act}
            replace all "nav:" in {_nav} with ""
            set {_npg} to {_nav} parsed as number
            if {_npg} is set:
                set {evo_admin_reopen::%uuid of player%} to true
                openEvoAdminPage(player, {_npg})
            stop
        if {_act} starts with "cd:":
            set {_k} to {_act}
            replace all "cd:" in {_k} with ""
            evoAdminToggleCd({_k})
            set {evo_admin_reopen::%uuid of player%} to true
            openEvoAdminPage(player, {_pg})
            play sound "ui.button.click" with volume 0.8 and pitch 1.2 at player for player
            stop
        if {_act} starts with "class:":
            set {_k} to {_act}
            replace all "class:" in {_k} with ""
            evoAdminToggleClass({_k})
            set {evo_admin_reopen::%uuid of player%} to true
            openEvoAdminPage(player, {_pg})
            play sound "ui.button.click" with volume 0.8 and pitch 1.2 at player for player
            stop
        if {_act} starts with "ability:":
            set {_k} to {_act}
            replace all "ability:" in {_k} with ""
            evoAdminToggleAbility({_k})
            set {evo_admin_reopen::%uuid of player%} to true
            openEvoAdminPage(player, {_pg})
            play sound "ui.button.click" with volume 0.8 and pitch 1.2 at player for player
            stop

on inventory click:
    if name of event-inventory is "&0EVO GIVE":
        cancel event
        if clicked inventory is not event-inventory:
            stop
        set {_slot} to index of event-slot
        if {_slot} is not set:
            set {_slot} to clicked slot
        if {_slot} is 53:
            close player's inventory
            stop
        set {_tu} to {evo_give_target::%uuid of player%}
        set {_target} to player from {_tu}
        if {_target} is not online:
            send "{@prefix} &cЦелевой игрок офлайн. Открой GUI заново."
            close player's inventory
            stop
        set {_pg} to {evo_give_page::%uuid of player%} ? 1
        if {_slot} is 45:
            set {evo_give_reopen::%uuid of player%} to true
            openEvoGivePage(player, {_target}, {_pg} - 1)
            stop
        if {_slot} is 52:
            set {evo_give_reopen::%uuid of player%} to true
            openEvoGivePage(player, {_target}, {_pg} + 1)
            stop
        set {_id} to {evo_give_slot_id::%uuid of player%::%{_slot}%}
        if {_id} is not set:
            stop
        set {_it} to evoAdminItemById({_id})
        if {_it} is air:
            send "{@prefix} &cПредмет с этим id недоступен."
            stop
        set {_amount} to 1
        set {_click} to "%click type%" in lower case
        if {_click} contains "right":
            set {_amount} to 64
        set amount of {_it} to {_amount}
        giveOrDrop({_it}, {_target}, location of {_target})
        send "{@prefix} &aВыдано: &e%{_id}% &7x%{_amount}% &aигроку &e%{_target}%&a."
        if {_target} is not player:
            send "{@prefix} &aАдмин выдал вам: &e%{_id}% &7x%{_amount}%" to {_target}

on inventory close:
    if name of event-inventory is "&0EVO ADMIN":
        if {evo_admin_reopen::%uuid of player%} is true:
            delete {evo_admin_reopen::%uuid of player%}
            stop
        delete {evo_admin_slot::%uuid of player%::*}
        delete {evo_admin_page::%uuid of player%}

on inventory close:
    if name of event-inventory is "&0EVO GIVE":
        if {evo_give_reopen::%uuid of player%} is true:
            delete {evo_give_reopen::%uuid of player%}
            stop
        delete {evo_give_slot_id::%uuid of player%::*}
        delete {evo_give_target::%uuid of player%}
        delete {evo_give_page::%uuid of player%}

command /evo [<offline player>] [<text>] [<text>]:
    permission: evo.admin
    permission message: {@prefix} &cУ вас нет прав!
    trigger:
        if arg-1 is not set:
            send "&8&l--- {@prefix} &6ADMIN HELP &8&l---"
            send "&e/evogive [игрок] &7— GUI выдачи предметов"
            send "&e/evoadmin &7— GUI настроек (КД, классы, способности)"
            send "&e/evo <player> setlevel <num>"
            send "&e/evo <player> setkills <num>"
            send "&e/evo <player> setclass <Warrior|Scout|Tank|Archer|Mage|None>"
            send "&e/evo <player> setperk <id|clear>"
            send "&e/evo <player> givehead [amount]"
            send "&e/evo <player> artifactgive <id|all>"
            send "&e/evo <player> cooldown <on|off>"
            send "&e/evo <player> sync"
            send "&e/evo <player> debug"
            send "&e/evo <player> reset"
            send "&e/evoruinspawn [x z [мир]] &7— руина; консоль: &f/evoruinspawn x z [мир]"
            send "&e/evoruinlegspawn [x z [мир]] &7— легендарная; консоль: &f/evoruinlegspawn x z [мир]"
            send "&8&l----------------------------"
            stop

        set {_u} to uuid of arg-1

        if arg-2 is "setlevel":
            set {_val} to arg-3 parsed as number
            if {_val} is set:
                set {_fixed} to clampLevel({_val})
                set {level::%{_u}%} to {_fixed}
                set {kills::%{_u}%} to ({_fixed} - 1) * {@kills_per_level}
                send "{@prefix} &fУровень &e%arg-1%&f → &a%{_fixed}% &7(kill-опыт синхронизирован)"
            else:
                send "{@prefix} &cИспользование: /evo <player> setlevel <число>"

        else if arg-2 is "setkills":
            set {_val} to arg-3 parsed as number
            if {_val} is set:
                set {_val} to clampKills({_val})
                set {kills::%{_u}%} to {_val}
                set {level::%{_u}%} to calcLevel({_val})
                send "{@prefix} &fКиллы &e%arg-1%&f → &a%{_val}% &7(уровневые, макс 49)"
            else:
                send "{@prefix} &cИспользование: /evo <player> setkills <число>"

        else if arg-2 is "setclass":
            if arg-3 is "Warrior" or "Scout" or "Tank" or "Archer" or "Mage" or "Necromancer" or "None":
                set {class::%{_u}%} to arg-3
                if arg-3 is "None":
                    delete {perk::%{_u}%}
                    delete {perk_notified::%{_u}%}
                send "{@prefix} &fКласс &e%arg-1%&f → &a%arg-3%"
                if arg-1 is online:
                    giveClassKit(arg-1)
            else:
                send "{@prefix} &cКлассы: Warrior, Scout, Tank, Archer, Mage, Necromancer, None"

        else if arg-2 is "setperk":
            if arg-3 is not set:
                send "{@prefix} &cИспользование: /evo <player> setperk <id|clear>"
                stop
            if arg-3 is "clear":
                delete {perk::%{_u}%}
                delete {perk_notified::%{_u}%}
                send "{@prefix} &fПерк &e%arg-1%&f → &aочищен"
                stop
            if arg-3 is "warrior_A" or "warrior_B" or "warrior_C" or "warrior_D" or "scout_A" or "scout_B" or "scout_C" or "scout_D" or "tank_A" or "tank_B" or "tank_C" or "tank_D" or "archer_A" or "archer_B" or "archer_C" or "archer_D" or "mage_A" or "mage_B" or "mage_C" or "mage_D" or "necro_A" or "necro_B" or "necro_C" or "necro_D":
                set {perk::%{_u}%} to arg-3
                set {perk_notified::%{_u}%} to true
                send "{@prefix} &fПерк &e%arg-1%&f → &a%arg-3%"
                if arg-1 is online:
                    send "{@prefix} &aАдмин выдал вам перк: &e%arg-3%" to arg-1
            else:
                send "{@prefix} &cНеверный id перка. Пример: warrior_A или necro_D"

        else if arg-2 is "givehead":
            if arg-1 is not online:
                send "{@prefix} &cИгрок должен быть онлайн для выдачи головы."
                stop
            set {_n} to arg-3 parsed as number
            if {_n} is not set:
                set {_n} to 1
            if {_n} < 1:
                set {_n} to 1
            if {_n} > 64:
                set {_n} to 64
            set {_h} to player head
            set amount of {_h} to {_n}
            set name of {_h} to "&eГолова игрока"
            set lore of {_h} to "&7ПКМ — поглотить и получить &a+1 опыта"
            set {_t} to arg-1
            if {_t} is set:
                give {_h} to {_t}
            send "{@prefix} &aВыдано &e%{_n}% &aголов игроку &e%arg-1%&a."

        else if arg-2 is "artifactgive":
            if arg-3 is not set:
                send "{@prefix} &eИспользование: /evo <player> artifactgive <id|all>"
                send "&7ID: &f%artifactCoreIdsHint()%"
                stop
            if arg-1 is not online:
                send "{@prefix} &cИгрок должен быть онлайн для выдачи предмета артефакта."
                stop
            set {_t} to arg-1
            set {_id} to arg-3 in lower case
            if {_id} is "all":
                set {_coreIds::*} to artifactCoreIds()
                loop {_coreIds::*}:
                    set {_s} to artifactSlotFromKey(loop-value)
                    if {_s} >= 0:
                        set {_it} to artifactFromSlot({_s})
                        if {_it} is not air:
                            give {_it} to {_t}
                send "{@prefix} &aИгроку &e%arg-1% &aвыданы все артефакты предметами в инвентарь."
                send "{@prefix} &aТебе выданы предметы артефактов. Поглощение: возьми в руку и нажми &eПКМ&a." to {_t}
                stop
            if isKnownArtifactId({_id}) is false:
                send "{@prefix} &cНеизвестный id артефакта."
                send "&7ID: &f%artifactCoreIdsHint()%"
                stop
            set {_s} to artifactSlotFromKey({_id})
            if {_s} < 0:
                send "{@prefix} &cНе удалось определить слот артефакта (%{_id}%)."
                stop
            set {_it} to artifactFromSlot({_s})
            if {_it} is air:
                send "{@prefix} &cНе удалось создать предмет артефакта (%{_id}%)."
                stop
            give {_it} to {_t}
            send "{@prefix} &aАртефакт &e%{_id}% &aвыдан игроку &e%arg-1% &aпредметом в инвентарь."
            send "{@prefix} &aТебе выдан артефакт-предмет: &e%{_id}%&a. Поглощение: возьми в руку и нажми &eПКМ&a." to {_t}

        else if arg-2 is "artifactpull":
            if arg-3 is not set:
                send "{@prefix} &eИспользование: /evo <player> artifactpull <id|all>"
                send "&7ID: &f%artifactCoreIdsHint()%"
                stop
            set {_id} to arg-3 in lower case
            if {_id} is "all":
                set {_coreIds::*} to artifactCoreIds()
                loop {_coreIds::*}:
                    if {art_found::%{_u}%::%loop-value%} is true:
                        set {_s} to artifactSlotFromKey(loop-value)
                        set {_it} to artifactFromSlot({_s})
                        if {_it} is not air:
                            set {art_found::%{_u}%::%loop-value%} to false
                            set {art_enabled::%{_u}%::%loop-value%} to false
                            if arg-1 is online:
                                set {_t} to arg-1
                                if {_t} is set:
                                    give {_it} to {_t}
                send "{@prefix} &aВсе найденные артефакты извлечены из ядра игрока &e%arg-1%&a."
                if arg-1 is online:
                    send "{@prefix} &eВсе артефакты извлечены из ядра в предметы." to arg-1
                stop
            if isKnownArtifactId({_id}) is false:
                send "{@prefix} &cНеизвестный id артефакта."
                send "&7ID: &f%artifactCoreIdsHint()%"
                stop
            if {art_found::%{_u}%::%{_id}%} is not true:
                send "{@prefix} &cУ игрока нет этого артефакта в ядре."
                stop
            set {_s} to artifactSlotFromKey({_id})
            set {_it} to artifactFromSlot({_s})
            if {_it} is air:
                send "{@prefix} &cНе удалось создать предмет артефакта (%{_id}%)."
                stop
            set {art_found::%{_u}%::%{_id}%} to false
            set {art_enabled::%{_u}%::%{_id}%} to false
            if arg-1 is online:
                set {_t} to arg-1
                if {_t} is set:
                    give {_it} to {_t}
            send "{@prefix} &aАртефакт &e%{_id}% &aизвлечён из ядра игрока &e%arg-1%&a."
            if arg-1 is online:
                send "{@prefix} &eАртефакт &f%{_id}% &eизвлечён из ядра в предмет." to arg-1

        else if arg-2 is "cooldown":
            if arg-3 is not set:
                send "{@prefix} &cИспользование: /evo <player> cooldown <on|off>"
                stop
            if arg-3 is "off":
                if {admin_nocd::%{_u}%} is true:
                    send "{@prefix} &eКулдауны уже отключены для &e%arg-1%&e."
                    stop

                # Снапшот оставшихся кулдаунов: чтобы при включении обратно они восстановились
                set {admin_nocd_save_archer_eye_cd::%{_u}%} to {archer_eye_cd::%{_u}%} ? 0
                set {admin_nocd_save_warrior_secondwind_cd::%{_u}%} to {warrior_secondwind_cd::%{_u}%} ? 0
                set {admin_nocd_save_scout_bloodrush_cd::%{_u}%} to {scout_bloodrush_cd::%{_u}%} ? 0
                set {admin_nocd_save_scout_parachute_cd::%{_u}%} to {scout_parachute_cd::%{_u}%} ? 0
                set {admin_nocd_save_archer_triple_cd::%{_u}%} to {archer_triple_cd::%{_u}%} ? 0
                set {admin_nocd_save_mage_overload_cd::%{_u}%} to {mage_overload_cd::%{_u}%} ? 0
                set {admin_nocd_save_necro_grip_cd::%{_u}%} to {necro_grip_cd::%{_u}%} ? 0
                set {admin_nocd_save_tank_laststand_cd::%{_u}%} to {tank_laststand_cd::%{_u}%} ? 0
                set {admin_nocd_save_necro_lifesteal_until::%{_u}%} to {necro_lifesteal_until::%{_u}%} ? 0
                set {admin_nocd_save_scout_dash_window::%{_u}%} to {scout_dash_window::%{_u}%} ? 0

                if arg-1 is online:
                    set {admin_nocd_save_feather_cd::%{_u}%} to cooldown of feather for arg-1
                    set {admin_nocd_save_bone_cd::%{_u}%} to cooldown of bone for arg-1
                    set {admin_nocd_save_blaze_rod_cd::%{_u}%} to cooldown of blaze rod for arg-1
                    set {admin_nocd_save_splash_potion_cd::%{_u}%} to cooldown of splash potion for arg-1
                    set {admin_nocd_save_golden_apple_cd::%{_u}%} to cooldown of golden apple for arg-1
                    set {admin_nocd_save_mace_cd::%{_u}%} to cooldown of mace for arg-1
                    # Parry на мече использует vanilla cooldown оружия (cooldown of {_tool} for player),
                    # поэтому тоже делаем снапшот и восстановление.
                    set {admin_nocd_save_netherite_sword_cd::%{_u}%} to cooldown of netherite sword for arg-1
                    set {admin_nocd_save_diamond_sword_cd::%{_u}%} to cooldown of diamond sword for arg-1
                    set {admin_nocd_save_iron_sword_cd::%{_u}%} to cooldown of iron sword for arg-1
                    set {admin_nocd_save_golden_sword_cd::%{_u}%} to cooldown of golden sword for arg-1
                    set {admin_nocd_save_stone_sword_cd::%{_u}%} to cooldown of stone sword for arg-1
                    set {admin_nocd_save_wooden_sword_cd::%{_u}%} to cooldown of wooden sword for arg-1
                else:
                    delete {admin_nocd_save_feather_cd::%{_u}%}
                    delete {admin_nocd_save_bone_cd::%{_u}%}
                    delete {admin_nocd_save_blaze_rod_cd::%{_u}%}
                    delete {admin_nocd_save_splash_potion_cd::%{_u}%}
                    delete {admin_nocd_save_golden_apple_cd::%{_u}%}
                    delete {admin_nocd_save_mace_cd::%{_u}%}
                    delete {admin_nocd_save_netherite_sword_cd::%{_u}%}
                    delete {admin_nocd_save_diamond_sword_cd::%{_u}%}
                    delete {admin_nocd_save_iron_sword_cd::%{_u}%}
                    delete {admin_nocd_save_golden_sword_cd::%{_u}%}
                    delete {admin_nocd_save_stone_sword_cd::%{_u}%}
                    delete {admin_nocd_save_wooden_sword_cd::%{_u}%}

                set {admin_nocd::%{_u}%} to true
                send "{@prefix} &aКулдауны способностей для &e%arg-1% &aотключены."
                if arg-1 is online:
                    send "{@prefix} &6Тест-режим: &aкулдауны отключены." to arg-1
            else if arg-3 is "on":
                if {admin_nocd::%{_u}%} is not set:
                    send "{@prefix} &eКулдауны уже включены для &e%arg-1%&e."
                    stop

                delete {admin_nocd::%{_u}%}

                # Восстановить внутренние КД (таймеры/окна), которые очищались в noCooldownMode
                if {admin_nocd_save_archer_eye_cd::%{_u}%} > 0:
                    set {archer_eye_cd::%{_u}%} to {admin_nocd_save_archer_eye_cd::%{_u}%}
                else:
                    delete {archer_eye_cd::%{_u}%}
                if {admin_nocd_save_warrior_secondwind_cd::%{_u}%} > 0:
                    set {warrior_secondwind_cd::%{_u}%} to {admin_nocd_save_warrior_secondwind_cd::%{_u}%}
                else:
                    delete {warrior_secondwind_cd::%{_u}%}
                if {admin_nocd_save_scout_bloodrush_cd::%{_u}%} > 0:
                    set {scout_bloodrush_cd::%{_u}%} to {admin_nocd_save_scout_bloodrush_cd::%{_u}%}
                else:
                    delete {scout_bloodrush_cd::%{_u}%}
                if {admin_nocd_save_scout_parachute_cd::%{_u}%} > 0:
                    set {scout_parachute_cd::%{_u}%} to {admin_nocd_save_scout_parachute_cd::%{_u}%}
                else:
                    delete {scout_parachute_cd::%{_u}%}
                if {admin_nocd_save_archer_triple_cd::%{_u}%} > 0:
                    set {archer_triple_cd::%{_u}%} to {admin_nocd_save_archer_triple_cd::%{_u}%}
                else:
                    delete {archer_triple_cd::%{_u}%}
                if {admin_nocd_save_mage_overload_cd::%{_u}%} > 0:
                    set {mage_overload_cd::%{_u}%} to {admin_nocd_save_mage_overload_cd::%{_u}%}
                else:
                    delete {mage_overload_cd::%{_u}%}
                if {admin_nocd_save_necro_grip_cd::%{_u}%} > 0:
                    set {necro_grip_cd::%{_u}%} to {admin_nocd_save_necro_grip_cd::%{_u}%}
                else:
                    delete {necro_grip_cd::%{_u}%}
                if {admin_nocd_save_tank_laststand_cd::%{_u}%} > 0:
                    set {tank_laststand_cd::%{_u}%} to {admin_nocd_save_tank_laststand_cd::%{_u}%}
                else:
                    delete {tank_laststand_cd::%{_u}%}
                if {admin_nocd_save_necro_lifesteal_until::%{_u}%} > 0:
                    set {necro_lifesteal_until::%{_u}%} to {admin_nocd_save_necro_lifesteal_until::%{_u}%}
                else:
                    delete {necro_lifesteal_until::%{_u}%}
                if {admin_nocd_save_scout_dash_window::%{_u}%} > 0:
                    set {scout_dash_window::%{_u}%} to {admin_nocd_save_scout_dash_window::%{_u}%}
                else:
                    delete {scout_dash_window::%{_u}%}

                # Восстановить предметные КД (если игрок онлайн)
                if arg-1 is online:
                    set {_feather_cd} to {admin_nocd_save_feather_cd::%{_u}%} ? 0
                    set {_bone_cd} to {admin_nocd_save_bone_cd::%{_u}%} ? 0
                    set {_blaze_rod_cd} to {admin_nocd_save_blaze_rod_cd::%{_u}%} ? 0
                    set {_splash_potion_cd} to {admin_nocd_save_splash_potion_cd::%{_u}%} ? 0
                    set {_golden_apple_cd} to {admin_nocd_save_golden_apple_cd::%{_u}%} ? 0
                    set {_mace_cd} to {admin_nocd_save_mace_cd::%{_u}%} ? 0
                    set {_netherite_sword_cd} to {admin_nocd_save_netherite_sword_cd::%{_u}%} ? 0
                    set {_diamond_sword_cd} to {admin_nocd_save_diamond_sword_cd::%{_u}%} ? 0
                    set {_iron_sword_cd} to {admin_nocd_save_iron_sword_cd::%{_u}%} ? 0
                    set {_golden_sword_cd} to {admin_nocd_save_golden_sword_cd::%{_u}%} ? 0
                    set {_stone_sword_cd} to {admin_nocd_save_stone_sword_cd::%{_u}%} ? 0
                    set {_wooden_sword_cd} to {admin_nocd_save_wooden_sword_cd::%{_u}%} ? 0
                    set cooldown of feather for arg-1 to {_feather_cd} * 1 second
                    set cooldown of bone for arg-1 to {_bone_cd} * 1 second
                    set cooldown of blaze rod for arg-1 to {_blaze_rod_cd} * 1 second
                    set cooldown of splash potion for arg-1 to {_splash_potion_cd} * 1 second
                    set cooldown of golden apple for arg-1 to {_golden_apple_cd} * 1 second
                    set cooldown of mace for arg-1 to {_mace_cd} * 1 second
                    set cooldown of netherite sword for arg-1 to {_netherite_sword_cd} * 1 second
                    set cooldown of diamond sword for arg-1 to {_diamond_sword_cd} * 1 second
                    set cooldown of iron sword for arg-1 to {_iron_sword_cd} * 1 second
                    set cooldown of golden sword for arg-1 to {_golden_sword_cd} * 1 second
                    set cooldown of stone sword for arg-1 to {_stone_sword_cd} * 1 second
                    set cooldown of wooden sword for arg-1 to {_wooden_sword_cd} * 1 second

                delete {admin_nocd_save_archer_eye_cd::%{_u}%}
                delete {admin_nocd_save_warrior_secondwind_cd::%{_u}%}
                delete {admin_nocd_save_scout_bloodrush_cd::%{_u}%}
                delete {admin_nocd_save_scout_parachute_cd::%{_u}%}
                delete {admin_nocd_save_archer_triple_cd::%{_u}%}
                delete {admin_nocd_save_mage_overload_cd::%{_u}%}
                delete {admin_nocd_save_necro_grip_cd::%{_u}%}
                delete {admin_nocd_save_tank_laststand_cd::%{_u}%}
                delete {admin_nocd_save_necro_lifesteal_until::%{_u}%}
                delete {admin_nocd_save_scout_dash_window::%{_u}%}
                delete {admin_nocd_save_feather_cd::%{_u}%}
                delete {admin_nocd_save_bone_cd::%{_u}%}
                delete {admin_nocd_save_blaze_rod_cd::%{_u}%}
                delete {admin_nocd_save_splash_potion_cd::%{_u}%}
                delete {admin_nocd_save_golden_apple_cd::%{_u}%}
                delete {admin_nocd_save_mace_cd::%{_u}%}
                delete {admin_nocd_save_netherite_sword_cd::%{_u}%}
                delete {admin_nocd_save_diamond_sword_cd::%{_u}%}
                delete {admin_nocd_save_iron_sword_cd::%{_u}%}
                delete {admin_nocd_save_golden_sword_cd::%{_u}%}
                delete {admin_nocd_save_stone_sword_cd::%{_u}%}
                delete {admin_nocd_save_wooden_sword_cd::%{_u}%}

                send "{@prefix} &aКулдауны способностей для &e%arg-1% &aвключены."
                if arg-1 is online:
                    send "{@prefix} &6Тест-режим: &cкулдауны включены." to arg-1
            else:
                send "{@prefix} &cИспользование: /evo <player> cooldown <on|off>"

        else if arg-2 is "sync":
            if arg-1 is online:
                syncProgress(arg-1)
                send "{@prefix} &aСинхронизация завершена для &e%arg-1%&a."
            else:
                set {_k} to clampKills({kills::%{_u}%} ? 0)
                set {kills::%{_u}%} to {_k}
                set {level::%{_u}%} to calcLevel({_k})
                send "{@prefix} &aСинхронизация завершена для &e%arg-1% &7(offline)."

        else if arg-2 is "debug":
            if arg-3 is "on":
                set {evo_debug::%{_u}%} to true
            else if arg-3 is "off":
                delete {evo_debug::%{_u}%}
            else:
                if {evo_debug::%{_u}%} is true:
                    delete {evo_debug::%{_u}%}
                else:
                    set {evo_debug::%{_u}%} to true
            set {_dbg} to {evo_debug::%{_u}%} ? false
            if {_dbg} is true:
                send "{@prefix} &eDebug-режим для &f%arg-1%&e: &aON"
            else:
                send "{@prefix} &eDebug-режим для &f%arg-1%&e: &cOFF"
            send "{@prefix} &7Использование: &f/evo <player> debug <on|off>"
            if arg-1 is online:
                if {_dbg} is true:
                    send "{@prefix} &eDebug включен. Теперь будут видны тех-сообщения [DBG]." to arg-1
                else:
                    send "{@prefix} &7Debug выключен." to arg-1
            set {_foundCount} to 0
            set {_enabledCount} to 0
            send "{@prefix} &8[DBG] --- ARTIFACT CORE STATE: %arg-1% ---"
            set {_coreIds::*} to artifactCoreIds()
            loop {_coreIds::*}:
                set {_f} to {art_found::%{_u}%::%loop-value%} ? false
                set {_e} to {art_enabled::%{_u}%::%loop-value%} ? false
                if {_f} is true:
                    add 1 to {_foundCount}
                if {_e} is true:
                    add 1 to {_enabledCount}
                send "{@prefix} &8[DBG] %loop-value% -> found=%{_f}% enabled=%{_e}%"
            send "{@prefix} &8[DBG] totals: found=%{_foundCount}% enabled=%{_enabledCount}%"

        else if arg-2 is "reset":
            set {kills::%{_u}%} to 0
            set {total_kills::%{_u}%} to 0
            set {level::%{_u}%} to 1
            set {class::%{_u}%} to "None"
            set {class_lock::%{_u}%} to false
            delete {wlvl::%{_u}%::*}
            delete {wxp::%{_u}%::*}
            delete {perk::%{_u}%}
            delete {perk_notified::%{_u}%}
            delete {admin_nocd::%{_u}%}
            delete {admin_nocd_save_archer_eye_cd::%{_u}%}
            delete {admin_nocd_save_warrior_secondwind_cd::%{_u}%}
            delete {admin_nocd_save_scout_bloodrush_cd::%{_u}%}
            delete {admin_nocd_save_scout_parachute_cd::%{_u}%}
            delete {admin_nocd_save_archer_triple_cd::%{_u}%}
            delete {admin_nocd_save_mage_overload_cd::%{_u}%}
            delete {admin_nocd_save_necro_grip_cd::%{_u}%}
            delete {admin_nocd_save_tank_laststand_cd::%{_u}%}
            delete {admin_nocd_save_necro_lifesteal_until::%{_u}%}
            delete {admin_nocd_save_scout_dash_window::%{_u}%}
            delete {admin_nocd_save_feather_cd::%{_u}%}
            delete {admin_nocd_save_bone_cd::%{_u}%}
            delete {admin_nocd_save_blaze_rod_cd::%{_u}%}
            delete {admin_nocd_save_splash_potion_cd::%{_u}%}
            delete {admin_nocd_save_golden_apple_cd::%{_u}%}
            delete {admin_nocd_save_mace_cd::%{_u}%}
            delete {admin_nocd_save_netherite_sword_cd::%{_u}%}
            delete {admin_nocd_save_diamond_sword_cd::%{_u}%}
            delete {admin_nocd_save_iron_sword_cd::%{_u}%}
            delete {admin_nocd_save_golden_sword_cd::%{_u}%}
            delete {admin_nocd_save_stone_sword_cd::%{_u}%}
            delete {admin_nocd_save_wooden_sword_cd::%{_u}%}
            # Полная очистка ядра артефактов и связанных состояний
            delete {art_found::%{_u}%::*}
            delete {art_enabled::%{_u}%::*}
            delete {util_found::%{_u}%::*}
            delete {util_enabled::%{_u}%::*}
            # Полная очистка дневника приключенца
            delete {adv_diary::%{_u}%::*}
            delete {adv_diary_open_page::%{_u}%}
            if arg-1 is online:
                ensureStarterAdventureDiaryPages(arg-1)
            delete {evo_death_return::%{_u}%}
            delete {art_hermes_prev::%{_u}%}
            delete {art_azura_charge::%{_u}%}
            delete {art_last_death::%{_u}%}
            delete {art_voidcompass_nonce::%{_u}%}
            delete {art_voidcompass_pending::%{_u}%}
            delete {art_etherdash_cd::%{_u}%}
            delete {art_etherdash_immune_until::%{_u}%}
            delete {art_cloud_used::%{_u}%}
            delete {art_cloud_fallimmune::%{_u}%}
            delete {art_cloud_fallimmune_until::%{_u}%}
            delete {art_cloud_cd::%{_u}%}
            delete {art_icewalker_cd::%{_u}%}
            delete {art_leg_scout_cd::%{_u}%}
            delete {art_leg_tank_cd::%{_u}%}
            delete {art_leg_mage_cd::%{_u}%}
            delete {art_leg_necro_souls::%{_u}%}
            if arg-1 is online:
                resetBalloonState(arg-1)
            send "{@prefix} &4WIPED &fигрок &e%arg-1% &7(включая все артефакты)"
            if arg-1 is online:
                send "{@prefix} &cВаши данные и все артефакты ядра сброшены админом!" to arg-1

        else:
            send "{@prefix} &cНеизвестное действие."

# Таб-комплит отключён: текущая версия Skript не поддерживает on tab complete

# ==========================================
# СИСТЕМА ДУО (ПАРЫ)
# ==========================================
# Хранение:
#   {duo::%uuid%}            = uuid напарника
#   {duo_invite::%uuid%}     = uuid пригласившего (ожидает accept)
#   {duo_invite_time::%uuid%} = время приглашения

function duoPartner(p: player) :: offline player:
    set {_id} to {duo::%uuid of {_p}%}
    if {_id} is not set:
        return {_p}  # сам себе, чтоб не было null
    return offline player from {_id}

function inDuo(p: player) :: boolean:
    if {duo::%uuid of {_p}%} is set:
        return true
    return false

function areDuo(a: player, b: player) :: boolean:
    if {duo::%uuid of {_a}%} is uuid of {_b}:
        return true
    return false

command /duo [<text>] [<offline player>]:
    aliases: /pair, /team
    trigger:
        set {_u} to player's uuid
        if arg-1 is not set:
            send "&8&l------ {@prefix} &6ДУО &8&l------"
            if inDuo(player) is true:
                set {_p} to duoPartner(player)
                send "&7Ваш напарник: &a%{_p}%"
                send "&e/duo leave &7— покинуть дуо"
            else:
                send "&7Вы не в дуо."
                send "&e/duo invite <игрок> &7— пригласить"
                send "&e/duo accept &7— принять"
                send "&e/duo deny &7— отклонить"
            send "&8&l-----------------------------"
            stop

        # ----- INVITE -----
        if arg-1 is "invite":
            if arg-2 is not set:
                send "{@prefix} &cУкажите игрока: /duo invite <ник>"
                stop
            if arg-2 is offline:
                send "{@prefix} &cИгрок не онлайн."
                stop
            if arg-2 is player:
                send "{@prefix} &cНельзя пригласить себя."
                stop
            if inDuo(player) is true:
                send "{@prefix} &cВы уже в дуо. /duo leave"
                stop
            if inDuo(arg-2) is true:
                send "{@prefix} &c%arg-2% уже в дуо."
                stop
            set {duo_invite::%uuid of arg-2%} to {_u}
            set {duo_invite_time::%uuid of arg-2%} to now
            send "{@prefix} &aПриглашение отправлено &e%arg-2%&a."
            send "{@prefix} &e%player% &aпригласил вас в дуо! &7/duo accept &8| &7/duo deny" to arg-2
            play sound "entity.experience_orb.pickup" at arg-2 for arg-2
            stop

        # ----- ACCEPT -----
        if arg-1 is "accept":
            if {duo_invite::%{_u}%} is not set:
                send "{@prefix} &cНет активных приглашений."
                stop
            set {_inv} to {duo_invite::%{_u}%}
            set {_t} to {duo_invite_time::%{_u}%}
            if difference between {_t} and now > 60 seconds:
                delete {duo_invite::%{_u}%}
                delete {duo_invite_time::%{_u}%}
                send "{@prefix} &cПриглашение истекло."
                stop
            set {_invP} to offline player from {_inv}
            if {_invP} is offline:
                send "{@prefix} &cПригласивший не онлайн."
                stop
            set {_inDuo1} to inDuo(player)
            set {_inDuo2} to inDuo({_invP})
            if {_inDuo1} is true:
                send "{@prefix} &cКто-то из вас уже в дуо."
                stop
            if {_inDuo2} is true:
                send "{@prefix} &cКто-то из вас уже в дуо."
                stop
            set {duo::%{_u}%} to {_inv}
            set {duo::%{_inv}%} to {_u}
            delete {duo_invite::%{_u}%}
            delete {duo_invite_time::%{_u}%}
            send "{@prefix} &aВы в дуо с &e%{_invP}%&a!"
            send "{@prefix} &aВы в дуо с &e%player%&a!" to {_invP}
            play sound "ui.toast.challenge_complete" at player for player
            play sound "ui.toast.challenge_complete" at {_invP} for {_invP}
            stop

        # ----- DENY -----
        if arg-1 is "deny":
            if {duo_invite::%{_u}%} is not set:
                send "{@prefix} &cНет активных приглашений."
                stop
            set {_inv} to {duo_invite::%{_u}%}
            delete {duo_invite::%{_u}%}
            delete {duo_invite_time::%{_u}%}
            set {_invP} to offline player from {_inv}
            send "{@prefix} &cПриглашение отклонено."
            if {_invP} is online:
                send "{@prefix} &c%player% отклонил ваше приглашение." to {_invP}
            stop

        # ----- LEAVE -----
        if arg-1 is "leave":
            if inDuo(player) is not true:
                send "{@prefix} &cВы не в дуо."
                stop
            set {_p} to duoPartner(player)
            delete {duo::%{_u}%}
            delete {duo::%uuid of {_p}%}
            send "{@prefix} &7Вы покинули дуо."
            if {_p} is online:
                send "{@prefix} &c%player% покинул ваше дуо." to {_p}
            stop

        # ----- INFO -----
        if arg-1 is "info":
            if inDuo(player) is true:
                set {_p} to duoPartner(player)
                send "{@prefix} &7Напарник: &a%{_p}%"
            else:
                send "{@prefix} &cВы не в дуо."
            stop

        send "{@prefix} &cНеизвестная команда. Используйте /duo"

# ----- Запрет фрэндли-фаер между напарниками (тихо) -----
on damage:
    if attacker is a player:
        if victim is a player:
            if areDuo(attacker, victim) is true:
                cancel event

# ----- Уведомление о приближении напарника при логине -----
on join:
    set {_u} to player's uuid
    if inDuo(player) is true:
        set {_p} to duoPartner(player)
        if {_p} is online:
            send "{@prefix} &aВаш напарник &e%{_p}% &aонлайн." to player
            send "{@prefix} &a%player% &aзашёл на сервер." to {_p}
# ==========================================
# СИСТЕМА ВЫБОРА ПЕРКА (L15+) — меню как у класса
# ==========================================
command /perk:
    trigger:
        set {_u} to player's uuid
        set {_cls} to {class::%{_u}%} ? "None"
        set {_lvl} to {level::%{_u}%} ? 1
        if {_cls} is "None":
            send "{@prefix} &cСначала выбери класс: &e/class"
            stop
        if {_lvl} < 15:
            send "{@prefix} &cПерк доступен только с 15 уровня."
            stop
        if {perk::%{_u}%} is set:
            send "{@prefix} &eТекущий перк: &6%{perk::%{_u}%}%"
            if {_lvl} > 15:
                set {_after} to {_lvl} - 5
                send "{@prefix} &c&lВНИМАНИЕ: &cсмена перка стоит &f-5 уровней&c!"
                send "{@prefix} &7Будет: &fL%{_lvl}% &7→ &cL%{_after}%"
            else:
                set {_need} to 16 - {_lvl}
                send "{@prefix} &cСмена перка доступна только с &f16 уровня&c."
                send "{@prefix} &7Тебе нужно ещё &e%{_need}% &7уровней."
                stop
            send "{@prefix} &7Кликай на новый перк, чтобы заменить."

        open chest inventory with 1 rows named "&8Choose your Perk" to player
        # Заполнение фоновыми панелями
        set slot 0 of player's current inventory to gray stained glass pane named " "
        set slot 2 of player's current inventory to gray stained glass pane named " "
        set slot 6 of player's current inventory to gray stained glass pane named " "
        set slot 8 of player's current inventory to gray stained glass pane named " "

        if {_cls} is "Warrior":
            set slot 1 of player's current inventory to iron sword named "&6&lA — Палач"
            set lore of slot 1 of player's current inventory to "&7Удар по цели с ❤≤4 наносит" and "&c+75%% урона &7+ &cStrength I &7на 3с" and "" and "&8» Добивай раненых одним ударом"
            set slot 3 of player's current inventory to redstone named "&4&lB — Кровавая клятва"
            set lore of slot 3 of player's current inventory to "&7При ❤<6 — постоянно &cStr II + Speed I" and "&7Но получаешь &c+15%% входящего урона" and "" and "&8» Отчаянный режим выживания"
            set slot 5 of player's current inventory to shield named "&e&lC — Идеальное парирование"
            set lore of slot 5 of player's current inventory to "&7Парирование возвращает &cx1.5 урона" and "&7+ Slowness II &7+ &8Blindness на 4с" and "&7КД парирования &c-50%%" and "&8(броня атакующего поглощает урон)" and "" and "&8» Мастер боя 1-в-1"
            set slot 7 of player's current inventory to totem of undying named "&a&lD — Второй ветер"
            set lore of slot 7 of player's current inventory to "&7Раз в 3 минуты при смертельном ударе:" and "&aспасение на 6❤ + Resistance II + Regen II" and "&7на 6с" and "" and "&8» Ангел-хранитель"

        else if {_cls} is "Scout":
            set slot 1 of player's current inventory to sugar named "&b&lA — Двойной рывок"
            set lore of slot 1 of player's current inventory to "&7Можно сделать &fдва рывка &7подряд" and "&7(КД 1-го: 4с, 2-й сразу за 1-м)" and "" and "&8» Молниеносная мобильность"
            set slot 3 of player's current inventory to iron sword named "&5&lB — Невидимый клинок"
            set lore of slot 3 of player's current inventory to "&7Удар в невидимости даёт &c+100%% урона" and "&7+ невидимость &fне снимается &7ещё 2с" and "&8(макс. цепочка инвиза — &f30с&8)" and "" and "&8» Атака из тени"
            set slot 5 of player's current inventory to phantom membrane named "&f&lC — Парашют"
            set lore of slot 5 of player's current inventory to "&7Shift в воздухе при падении >5 блоков" and "&7= &fSlow Falling 5с &7(КД 30с)" and "" and "&8» Никогда не разобьёшься"
            set slot 7 of player's current inventory to ghast tear named "&c&lD — Кровопийца"
            set lore of slot 7 of player's current inventory to "&7Каждый &f4-й удар &7лечит &c+½❤" and "&7При ❤<6 даёт &fSpeed III &7на 5с (КД 20с)" and "" and "&8» Вампирский темп"

        else if {_cls} is "Tank":
            set slot 1 of player's current inventory to magma cream named "&c&lA — Магма-броня"
            set lore of slot 1 of player's current inventory to "&7Атакующий поджигается на &c4с" and "&7+ получает &c2❤ огнём" and "" and "&8» Враги горят рядом с тобой"
            set slot 3 of player's current inventory to anvil named "&8&lB — Сейсмический удар"
            set lore of slot 3 of player's current inventory to "&7Каждый &f4-й удар &7по тебе автоматически" and "&7вызывает толчок: всех врагов в радиусе 4" and "&7отталкивает + &fSlowness II &7на 3с" and "" and "&8» Реактивная защита — нажимать ничего не надо"
            set slot 5 of player's current inventory to netherite ingot named "&4&lC — Несокрушимый"
            set lore of slot 5 of player's current inventory to "&7При ≤40%% макс. ❤ — &cResistance III &7+ &c-30%% урона" and "&7сверху" and "" and "&8» Чем меньше ❤, тем мощнее броня"
            set slot 7 of player's current inventory to golden apple named "&6&lD — Защитник дуо"
            set lore of slot 7 of player's current inventory to "&7Союзник дуо в радиусе 8 получает" and "&aResistance II + Regen I &7пассивно" and "&7Ты получаешь &c50%% его урона" and "" and "&8» Истинный танк-бабсилитер"

        else if {_cls} is "Archer":
            set slot 1 of player's current inventory to spectral arrow named "&e&lA — Снайпер"
            set lore of slot 1 of player's current inventory to "&7Стрелы наносят &c+50%% урона" and "&7если цель дальше &f20 блоков" and "" and "&8» Дальнобойная резня"
            set slot 3 of player's current inventory to packed ice named "&b&lB — Морозная стрела"
            set lore of slot 3 of player's current inventory to "&7Стрела даёт цели:" and "&fSlowness III + Mining Fatigue II + Weakness I" and "&7на 5с" and "" and "&8» Полная парализация"
            set slot 5 of player's current inventory to bow named "&6&lC — Тройной выстрел"
            set lore of slot 5 of player's current inventory to "&7Shift+ПКМ луком — &fвыпустить 3 стрелы" and "&7веером сразу (КД 12с)" and "" and "&8» Пулемёт"
            set slot 7 of player's current inventory to ender pearl named "&d&lD — Рикошет"
            set lore of slot 7 of player's current inventory to "&7Стрела наносит &c75%% урона" and "&7ближайшему врагу в радиусе 6" and "&7от первой цели" and "" and "&8» Цепная стрельба"

        else if {_cls} is "Mage":
            set slot 1 of player's current inventory to fire charge named "&c&lA — Метеор"
            set lore of slot 1 of player's current inventory to "&7Большой фаербол &fдоступен с L1" and "&7через Shift+ПКМ блейз-родом (КД 20с)" and "" and "&8» Досрочный ульт"
            set slot 3 of player's current inventory to packed ice named "&b&lB — Ледяной взрыв"
            set lore of slot 3 of player's current inventory to "&7Фаербол при попадании замораживает" and "&7врагов в радиусе 4: &fSlowness III &7на 6с" and "" and "&8» AoE контроль"
            set slot 5 of player's current inventory to glistering melon slice named "&a&lC — Аура регена"
            set lore of slot 5 of player's current inventory to "&7Союзники в радиусе 10 пассивно" and "&7получают &aRegeneration I" and "" and "&8» Группа всегда живёт"
            set slot 7 of player's current inventory to amethyst shard named "&d&lD — Арканная перегрузка"
            set lore of slot 7 of player's current inventory to "&7При получении удара (КД 20с):" and "&7враг получает &fSlow II + Weakness I 4с" and "&7а ты — &fSpeed II 3с" and "" and "&8» Контроль дистанции и кайт"

        else if {_cls} is "Necromancer":
            set slot 1 of player's current inventory to soul lantern named "&2&lA — Армия мёртвых"
            set lore of slot 1 of player's current inventory to "&7Призыв даёт &f+1 миньон сверху" and "&7Время жизни — &f75с &7(вместо 45с)" and "" and "&8» Маленькая армия"
            set slot 3 of player's current inventory to fermented spider eye named "&5&lB — Чумной взрыв"
            set lore of slot 3 of player's current inventory to "&7Миньон при смерти взрывается:" and "&fPoison II 8с + Wither II 5с" and "&7в радиусе 4" and "" and "&8» Каждая смерть — оружие"
            set slot 5 of player's current inventory to fishing rod named "&8&lC — Мёртвая хватка"
            set lore of slot 5 of player's current inventory to "&7Shift+ПКМ костью — &fвытянуть врага" and "&7к себе + Slowness III на 4с (КД 20с)" and "" and "&8» Безотказный гангк"
            set slot 7 of player's current inventory to wither skeleton skull named "&4&lD — Могильный лорд"
            set lore of slot 7 of player's current inventory to "&7Миньоны: &fx2 ❤ + 30%% урона" and "&7+ накладывают &fWither I &7при ударе" and "" and "&8» Босс-армия"

        set slot 4 of player's current inventory to book named "&eВыбор перка" with lore "&7Выбор &cокончательный&7." and "&8Класс: &f%{_cls}%" and "" and "&7Кликай на любой из четырёх перков"

on inventory click:
    if name of event-inventory is "&8Choose your Perk":
        cancel event
        set {_u} to player's uuid
        set {_cls} to {class::%{_u}%} ? "None"
        set {_letter} to ""
        if index of event-slot is 1:
            set {_letter} to "A"
        else if index of event-slot is 3:
            set {_letter} to "B"
        else if index of event-slot is 5:
            set {_letter} to "C"
        else if index of event-slot is 7:
            set {_letter} to "D"
        if {_letter} is not "":
            set {_oldPerk} to {perk::%{_u}%}
            set {_newPerk} to ""
            if {_cls} is "Warrior":
                set {_newPerk} to "warrior_%{_letter}%"
            else if {_cls} is "Scout":
                set {_newPerk} to "scout_%{_letter}%"
            else if {_cls} is "Tank":
                set {_newPerk} to "tank_%{_letter}%"
            else if {_cls} is "Archer":
                set {_newPerk} to "archer_%{_letter}%"
            else if {_cls} is "Mage":
                set {_newPerk} to "mage_%{_letter}%"
            else if {_cls} is "Necromancer":
                set {_newPerk} to "necro_%{_letter}%"
            # Если игрок просто пере-выбирает тот же перк — ничего не делаем
            if {_oldPerk} is {_newPerk}:
                close player's inventory
                send "{@prefix} &7Этот перк уже выбран — ничего не изменилось."
                stop
            # Проверка минимального уровня для смены перка (L16 / выше 15)
            if {_oldPerk} is set:
                set {_curLvl} to {level::%{_u}%} ? 1
                if {_curLvl} < 16:
                    set {_need2} to 16 - {_curLvl}
                    close player's inventory
                    send "{@prefix} &cСмена перка доступна только с &f16 уровня&c."
                    send "{@prefix} &7Тебе нужно ещё &e%{_need2}% &7уровней."
                    play sound "entity.villager.no" with volume 0.7 and pitch 1.0 at player for player
                    stop
            set {perk::%{_u}%} to {_newPerk}
            close player's inventory
            # Списываем 5 уровней при смене перка (был ≥20)
            if {_oldPerk} is set:
                set {_curLvl} to {level::%{_u}%} ? 1
                set {_newLvl} to {_curLvl} - 5
                set {kills::%{_u}%} to ({_newLvl} - 1) * {@kills_per_level}
                set {level::%{_u}%} to {_newLvl}
                send "{@prefix} &cУровень: &fL%{_curLvl}% &c→ &fL%{_newLvl}% &7(-5 за смену перка)"
                play sound "entity.wither.hurt" with volume 0.7 and pitch 1.4 at player for player
                send "{@prefix} &eПерк изменён: &7%{_oldPerk}% &8→ &6%{_newPerk}%"
            else:
                send "{@prefix} &aПерк выбран: &e%{_newPerk}%"
            play sound "ui.toast.challenge_complete" at player for player

# ==========================================
# ДУАЛ ВИЛД: HASTE III ПРИ ДВУХ ОДИНАКОВЫХ ПРЕДМЕТАХ В РУКАХ
# ==========================================
every 3 seconds:
    loop all players:
        set {_main} to loop-player's tool
        set {_off} to loop-player's off hand tool
        if {_main} is set:
            if {_off} is set:
                if {_main} is not air:
                    if {_off} is not air:
                        if type of {_main} is type of {_off}:
                            apply haste 3 without particles to loop-player for 60 ticks

# ==========================================
# /duotpa — ТЕЛЕПОРТ К НАПАРНИКУ ПО ДУО (L5+)
# Полноценный /tpa-стиль: запрос → accept → мгновенный телепорт.
# Никаких эндер-перлов.
#
# Хранение:
#   {duotpa_req::%uuid%}      = uuid игрока, который просит ТП К адресату (адресат = ключ)
#   {duotpa_req_time::%uuid%} = unix timestamp выдачи запроса (TTL 60с)
#   {duotpa_cd::%uuid%}       = unix timestamp, до которого инициатору нельзя слать новый запрос
# ==========================================
command /duotpa [<text>]:
    aliases: /dtpa, /duotp
    trigger:
        set {_u} to player's uuid
        set {_l} to {level::%{_u}%} ? 1
        set {_now} to unix timestamp of now

        # ----- accept / deny не требуют дуо/уровня -----
        if arg-1 is "accept":
            if {duotpa_req::%{_u}%} is not set:
                send "{@prefix} &cНет активных запросов."
                stop
            set {_inv} to {duotpa_req::%{_u}%}
            set {_t} to {duotpa_req_time::%{_u}%} ? 0
            if {_now} - {_t} > {@duotpa_request_ttl}:
                delete {duotpa_req::%{_u}%}
                delete {duotpa_req_time::%{_u}%}
                send "{@prefix} &cЗапрос истёк."
                stop
            set {_invP} to player from {_inv}
            if {_invP} is not online:
                delete {duotpa_req::%{_u}%}
                delete {duotpa_req_time::%{_u}%}
                send "{@prefix} &cЗапросивший игрок не онлайн."
                stop
            # Combat-log: запретить ТП в бою
            if inCombat(player) is true:
                send "{@prefix} &cТы в бою — нельзя принимать ТП ещё &e%combatLeft(player)%с&c."
                stop
            if inCombat({_invP}) is true:
                send "{@prefix} &c%{_invP}% в бою — ТП недоступен ещё &e%combatLeft({_invP})%с&c."
                send "{@prefix} &cТы в бою — телепорт отменён." to {_invP}
                stop
            delete {duotpa_req::%{_u}%}
            delete {duotpa_req_time::%{_u}%}
            # Подтверждение обоим
            send "{@prefix} &aЗапрос принят. &e%{_invP}% &aтелепортируется через &f{@duotpa_warmup}с&a..." to player
            send "{@prefix} &a%player% &aпринял твой запрос! Телепорт через &f{@duotpa_warmup}с&a..." to {_invP}
            play sound "entity.experience_orb.pickup" at {_invP} for {_invP}
            # Запоминаем стартовую точку для отмены при движении
            set {duotpa_warm_loc::%{_inv}%} to location of {_invP}
            set {duotpa_warm_target::%{_inv}%} to {_u}
            set {duotpa_warm_until::%{_inv}%} to {_now} + {@duotpa_warmup}
            stop

        if arg-1 is "deny":
            if {duotpa_req::%{_u}%} is not set:
                send "{@prefix} &cНет активных запросов."
                stop
            set {_inv} to {duotpa_req::%{_u}%}
            delete {duotpa_req::%{_u}%}
            delete {duotpa_req_time::%{_u}%}
            set {_invP} to player from {_inv}
            send "{@prefix} &cЗапрос отклонён."
            if {_invP} is online:
                send "{@prefix} &c%player% отклонил твой запрос телепорта." to {_invP}
            stop

        if arg-1 is "cancel":
            # Отменить свой исходящий запрос (если ещё висит)
            set {_found} to false
            loop all players:
                set {_pid} to uuid of loop-player
                if {duotpa_req::%{_pid}%} is {_u}:
                    delete {duotpa_req::%{_pid}%}
                    delete {duotpa_req_time::%{_pid}%}
                    send "{@prefix} &7Запрос телепорта отменён." to player
                    send "{@prefix} &7%player% отменил запрос телепорта." to loop-player
                    set {_found} to true
            # Также отменить активный warmup
            if {duotpa_warm_until::%{_u}%} is set:
                delete {duotpa_warm_until::%{_u}%}
                delete {duotpa_warm_loc::%{_u}%}
                delete {duotpa_warm_target::%{_u}%}
                send "{@prefix} &7Телепортация отменена." to player
                set {_found} to true
            if {_found} is false:
                send "{@prefix} &cНечего отменять."
            stop

        # ----- запрос требует дуо и уровень -----
        if {_l} < 5:
            send "{@prefix} &cТелепорт к напарнику открывается с 5 уровня."
            stop
        if inDuo(player) is not true:
            send "{@prefix} &cУ тебя нет дуо. Создай дуо: &e/duo invite <ник>"
            stop
        set {_partner} to duoPartner(player)
        if {_partner} is offline:
            send "{@prefix} &cНапарник не онлайн."
            stop

        if arg-1 is not set:
            # Combat-log: запретить запрос ТП в бою
            if inCombat(player) is true:
                send "{@prefix} &cТы в бою — ТП недоступен ещё &e%combatLeft(player)%с&c."
                stop
            if inCombat({_partner}) is true:
                send "{@prefix} &cНапарник в бою — ТП недоступен ещё &e%combatLeft({_partner})%с&c."
                stop
            # Кулдаун инициатора
            set {_cd} to {duotpa_cd::%{_u}%} ? 0
            if {_now} < {_cd}:
                set {_left} to {_cd} - {_now}
                send action bar "&cТелепорт на КД ещё &e%{_left}%с" to player
                stop
            # Уже идёт warmup?
            if {duotpa_warm_until::%{_u}%} is set:
                send "{@prefix} &cТы уже телепортируешься. &e/duotpa cancel"
                stop
            # Уже есть исходящий запрос?
            if {duotpa_req::%uuid of {_partner}%} is {_u}:
                send "{@prefix} &cУ тебя уже есть активный запрос к этому игроку."
                stop
            set {duotpa_req::%uuid of {_partner}%} to {_u}
            set {duotpa_req_time::%uuid of {_partner}%} to {_now}
            send "{@prefix} &aЗапрос телепорта отправлен &e%{_partner}%&a. &7(истечёт через {@duotpa_request_ttl}с)"
            send "{@prefix} &7Отменить: &e/duotpa cancel"
            send "{@prefix} &e%player% &aпросит телепорт к тебе! &a/duotpa accept &8| &c/duotpa deny" to {_partner}
            play sound "entity.experience_orb.pickup" at {_partner} for {_partner}
            stop

        send "{@prefix} &cИспользование: &e/duotpa &7| &aaccept &7| &cdeny &7| &7cancel"

# ==========================================
# DUOTPA: WARMUP — каждую секунду тикает; телепорт срабатывает,
# когда warmup истекает. Отменяется при движении или получении урона.
# ==========================================
every 1 second:
    loop all players:
        set {_uu} to uuid of loop-player
        if {duotpa_warm_until::%{_uu}%} is set:
            set {_now} to unix timestamp of now
            set {_until} to {duotpa_warm_until::%{_uu}%}
            set {_left} to {_until} - {_now}
            # Проверка движения (более 0.5 блока от стартовой точки)
            set {_start} to {duotpa_warm_loc::%{_uu}%}
            if {_start} is set:
                if distance between location of loop-player and {_start} > 0.5:
                    delete {duotpa_warm_until::%{_uu}%}
                    delete {duotpa_warm_loc::%{_uu}%}
                    delete {duotpa_warm_target::%{_uu}%}
                    send "{@prefix} &cТелепорт прерван — ты сдвинулся!" to loop-player
                    play sound "block.note_block.bass" at loop-player for loop-player
                    stop
            # Время вышло — телепортируем
            if {_left} <= 0:
                set {_tid} to {duotpa_warm_target::%{_uu}%}
                delete {duotpa_warm_until::%{_uu}%}
                delete {duotpa_warm_loc::%{_uu}%}
                delete {duotpa_warm_target::%{_uu}%}
                set {_tgt} to player from {_tid}
                if {_tgt} is online:
                    teleport loop-player to {_tgt}
                    play sound "entity.enderman.teleport" at loop-player for all players
                    play sound "entity.enderman.teleport" at {_tgt} for all players
                    send action bar "&d&lТЕЛЕПОРТ К НАПАРНИКУ!" to loop-player
                    set {duotpa_cd::%{_uu}%} to {_now} + {@duotpa_cooldown}
                else:
                    send "{@prefix} &cНапарник вышел — телепорт отменён." to loop-player
            else:
                send action bar "&dТелепорт через &f%{_left}%с &7(не двигайся)" to loop-player

# Прервать warmup при получении урона
on damage:
    if victim is a player:
        set {_vid} to victim's uuid
        if {duotpa_warm_until::%{_vid}%} is set:
            delete {duotpa_warm_until::%{_vid}%}
            delete {duotpa_warm_loc::%{_vid}%}
            delete {duotpa_warm_target::%{_vid}%}
            send "{@prefix} &cТелепорт прерван — тебя ударили!" to victim
            play sound "block.note_block.bass" at victim for victim

# ===== COMBAT-LOG: тегировать обоих участников PvP =====
on damage:
    if attacker is a player:
        if victim is a player:
            if attacker is not victim:
                if areDuo(attacker, victim) is not true:
                    tagCombat(attacker)
                    tagCombat(victim)

# ===== COMBAT-LOG: смерть при выходе в бою =====
on quit:
    set {_qid} to player's uuid
    if inCombat(player) is true:
        kill player
        broadcast "{@prefix} &c&l%player% &cсбежал из боя и был убит!"
    delete {combat_until::%{_qid}%}
    delete {leg_warrior_air_last::%{_qid}%}
    delete {leg_warrior_slashing::%{_qid}%}
    delete {duotpa_warm_until::%{_qid}%}
    delete {duotpa_warm_loc::%{_qid}%}
    delete {duotpa_warm_target::%{_qid}%}
    delete {duotpa_req::%{_qid}%}
    delete {duotpa_req_time::%{_qid}%}
    # И снять входящие запросы от вышедшего игрока
    loop all players:
        set {_pid} to uuid of loop-player
        if {duotpa_req::%{_pid}%} is {_qid}:
            delete {duotpa_req::%{_pid}%}
            delete {duotpa_req_time::%{_pid}%}

# Снять combat-метку при смерти и при заходе
on death of player:
    delete {combat_until::%uuid of victim%}

on join:
    delete {combat_until::%player's uuid%}

# Оповещение об окончании combat-log
every 1 second:
    set {_now} to unix timestamp of now
    loop all players:
        set {_uid} to uuid of loop-player
        if {combat_until::%{_uid}%} is set:
            if {combat_until::%{_uid}%} <= {_now}:
                delete {combat_until::%{_uid}%}
                send action bar "&a&lБОЙ ОКОНЧЕН! &7Можно выходить и юзать ТП" to loop-player
                play sound "block.note_block.bell" with volume 0.6 and pitch 1.5 at loop-player for loop-player


# ==========================================
# СПОНСОРСКИЕ ПЛЮШКИ (Supporter)
# Один ранг для всех, кто поддержал проект.
# НИКАКИХ боевых преимуществ — только косметика и мелкое удобство.
#
# Управление (только OP):
#   /sponsor add <player>     — выдать
#   /sponsor remove <player>  — снять
#   /sponsor list             — список
#
# Плюшки игроку:
#   • Префикс ★ перед ником в чате
#   • /workbench (/wb)        — переносной верстак
#   • /hat                    — надеть предмет с руки на голову
#   • /trail [type|off]       — частицы под ногами при ходьбе
#   • /sponsorkit             — космет.набор: знамя, фейерверки, пластинка (КД 24ч)
# ==========================================

function isSponsor(p: player) :: boolean:
    if {sponsor::%uuid of {_p}%} is set:
        return true
    return false

function spCdLeft(p: player, key: text) :: number:
    set {_v} to {sponsor_cd::%uuid of {_p}%::%{_key}%} ? 0
    set {_now} to unix timestamp of now
    if {_v} > {_now}:
        return {_v} - {_now}
    return 0

function spSetCd(p: player, key: text, secs: number):
    set {sponsor_cd::%uuid of {_p}%::%{_key}%} to (unix timestamp of now) + {_secs}

function spFmtTime(s: number) :: text:
    if {_s} >= 3600:
        return "%floor({_s} / 3600)%ч %floor((mod({_s}, 3600)) / 60)%м"
    if {_s} >= 60:
        return "%floor({_s} / 60)%м %mod({_s}, 60)%с"
    return "%{_s}%с"

# ===== Префикс ★ в чате =====
on chat:
    set {_u} to player's uuid
    set {_cls} to classDisplayName(classOf(player))
    set {_lvl} to calcLevel(clampKills({kills::%{_u}%} ? 0))
    set {level::%{_u}%} to {_lvl}
    set {_title} to classTitle(classOf(player), {_lvl})
    if classOf(player) is "None":
        set {_chatPrefix} to "&8[&7Без класса&8] "
    else:
        set {_chatPrefix} to "&8[%{_title}%&8] "
    if isSponsor(player) is true:
        set {_chatPrefix} to "&6★ %{_chatPrefix}%"
    set chat format to "%{_chatPrefix}%&r<%player's display name%&r> %message%"

# ===== /sponsor (управление + просмотр) =====
command /sponsor [<text>] [<offline player>]:
    trigger:
        # Без аргументов — показать свой статус
        if arg-1 is not set:
            send "&8&l▬▬▬▬▬▬ &6&l★ СПОНСОР &8&l▬▬▬▬▬▬"
            if isSponsor(player) is true:
                send "&7Ты — &6&l★ Спонсор&7. Спасибо за поддержку!"
                send ""
                send "&7Доступные команды:"
                send "&e/workbench &8(или /wb) — мобильный верстак"
                send "&e/hat &8— предмет с руки на голову"
                send "&e/trail [type|off] &8— частицы под ногами"
                send "&e/sponsorkit &8— космет.набор &7(КД 24ч)"
                send ""
                send "&8Все плюшки чисто косметические — без боевого преимущества."
            else:
                send "&7Ты пока не спонсор."
                send "&8Поддержи проект, чтобы получить ★"
            stop

        # ===== Управление — только OP =====
        if player is not op:
            send "{@prefix} &cНет прав"
            stop

        if arg-1 is "add":
            if arg-2 is not set:
                send "{@prefix} &cИспользование: /sponsor add <player>"
                stop
            set {_target} to arg-2
            set {_uid} to "%uuid of {_target}%"
            if {_uid} is "<none>":
                send "{@prefix} &cИгрок &e%arg-2% &cне найден (никогда не заходил на сервер)"
                stop
            if {_uid} is "":
                send "{@prefix} &cНе удалось получить UUID игрока &e%arg-2%"
                stop
            set {sponsor::%{_uid}%} to true
            send "{@prefix} &a%arg-2% &7теперь &6★ Спонсор &8(uuid: %{_uid}%)"
            if {_target} is online:
                send "" to {_target}
                send "&8&l▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬" to {_target}
                send "&6&l★ ТЕБЕ ВЫДАН РАНГ СПОНСОРА!" to {_target}
                send "&7Спасибо за поддержку проекта" to {_target}
                send "&8Команды: &f/sponsor" to {_target}
                send "&8&l▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬" to {_target}
                play sound "ui.toast.challenge_complete" at {_target} for {_target}
                play sound "entity.player.levelup" with volume 1 and pitch 1.2 at {_target} for {_target}
            stop

        if arg-1 is "remove":
            if arg-2 is not set:
                send "{@prefix} &cИспользование: /sponsor remove <player>"
                stop
            set {_target} to arg-2
            set {_uid} to "%uuid of {_target}%"
            if {_uid} is "<none>":
                send "{@prefix} &cИгрок не найден"
                stop
            delete {sponsor::%{_uid}%}
            delete {sponsor_cd::%{_uid}%::*}
            delete {sponsor_trail::%{_uid}%}
            send "{@prefix} &cРанг снят с %arg-2%"
            if {_target} is online:
                send "&cТвой спонсорский ранг был снят" to {_target}
            stop

        if arg-1 is "list":
            send "&8&l▬▬▬▬ &6&l★ Спонсоры &8&l▬▬▬▬"
            set {_n} to 0
            loop {sponsor::*}:
                set {_pname} to loop-index parsed as offline player
                send "&7• %{_pname}%"
                add 1 to {_n}
            if {_n} is 0:
                send "&8(пусто)"
            stop

        # Подсказка
        send "{@prefix} &eИспользование:"
        send "&7/sponsor &8— твой статус"
        send "&c/sponsor add <player> &8(OP)"
        send "&c/sponsor remove <player> &8(OP)"
        send "&c/sponsor list &8(OP)"

# ===== /workbench — переносной верстак =====
command /workbench:
    aliases: /wb
    trigger:
        if isSponsor(player) is not true:
            send "{@prefix} &cТолько для спонсоров"
            stop
        open workbench inventory to player

# ===== /hat — предмет с руки на голову =====
command /hat:
    trigger:
        if isSponsor(player) is not true:
            send "{@prefix} &cТолько для спонсоров"
            stop
        if player's tool is air:
            send "{@prefix} &cВ руке ничего нет"
            stop
        set {_old} to player's helmet
        set player's helmet to player's tool
        if {_old} is set:
            set player's tool to {_old}
        else:
            set player's tool to air
        send "{@prefix} &eГотово — стиляга!"

# ===== /trail — космет.частицы под ногами =====
command /trail [<text>]:
    trigger:
        if isSponsor(player) is not true:
            send "{@prefix} &cТолько для спонсоров"
            stop
        if arg-1 is not set:
            send "&8&l▬▬ &6Частицы &8&l▬▬"
            send "&7Текущий: &e%{sponsor_trail::%player's uuid%} ? "off"%"
            send ""
            send "&7Доступные:"
            send "&8• &fheart &8• &fflame &8• &fnote &8• &fcrit"
            send "&8• &fend_rod &8• &fhappy &8• &fcloud &8• &fsoul"
            send "&8• &foff &7(выключить)"
            send "&8/trail <type>"
            stop
        set {_trailArg} to arg-1 in lower case
        if {_trailArg} is "off":
            delete {sponsor_trail::%player's uuid%}
            send "{@prefix} &7Частицы выключены"
            stop
        if {_trailArg} is not "heart":
            if {_trailArg} is not "flame":
                if {_trailArg} is not "note":
                    if {_trailArg} is not "crit":
                        if {_trailArg} is not "end_rod":
                            if {_trailArg} is not "happy":
                                if {_trailArg} is not "cloud":
                                    if {_trailArg} is not "soul":
                                        send "{@prefix} &cНеизвестный тип. /trail для списка"
                                        stop
        set {sponsor_trail::%player's uuid%} to {_trailArg}
        send "{@prefix} &eЧастицы: &f%{_trailArg}%"

# Рендер частиц — раз в 5 тиков (1/4 сек)
every 5 ticks:
    loop all players:
        set {_u} to loop-player's uuid
        if {sponsor_trail::%{_u}%} is set:
            set {_type} to {sponsor_trail::%{_u}%}
            set {_loc} to location of loop-player
            if {_type} is "heart":
                execute console command "particle minecraft:heart %x-coordinate of {_loc}% %y-coordinate of {_loc}% %z-coordinate of {_loc}% 0.2 0.3 0.2 0 1 force"
            else if {_type} is "flame":
                execute console command "particle minecraft:flame %x-coordinate of {_loc}% %y-coordinate of {_loc}% %z-coordinate of {_loc}% 0.15 0.05 0.15 0 3 force"
            else if {_type} is "note":
                execute console command "particle minecraft:note %x-coordinate of {_loc}% %y-coordinate of {_loc}% %z-coordinate of {_loc}% 0.3 0.1 0.3 0 1 force"
            else if {_type} is "crit":
                execute console command "particle minecraft:crit %x-coordinate of {_loc}% %y-coordinate of {_loc}% %z-coordinate of {_loc}% 0.2 0.2 0.2 0 4 force"
            else if {_type} is "end_rod":
                execute console command "particle minecraft:end_rod %x-coordinate of {_loc}% %y-coordinate of {_loc}% %z-coordinate of {_loc}% 0.12 0.12 0.12 0 2 force"
            else if {_type} is "happy":
                execute console command "particle minecraft:happy_villager %x-coordinate of {_loc}% %y-coordinate of {_loc}% %z-coordinate of {_loc}% 0.25 0.25 0.25 0 3 force"
            else if {_type} is "cloud":
                execute console command "particle minecraft:cloud %x-coordinate of {_loc}% %y-coordinate of {_loc}% %z-coordinate of {_loc}% 0.2 0.05 0.2 0 3 force"
            else if {_type} is "soul":
                execute console command "particle minecraft:soul %x-coordinate of {_loc}% %y-coordinate of {_loc}% %z-coordinate of {_loc}% 0.1 0.1 0.1 0 2 force"

# ===== /sponsorkit — чисто космет.набор (КД 24ч) =====
command /sponsorkit:
    aliases: /spkit
    trigger:
        if isSponsor(player) is not true:
            send "{@prefix} &cТолько для спонсоров"
            stop
        set {_left} to spCdLeft(player, "kit")
        if {_left} > 0:
            send "{@prefix} &cКД: &e%spFmtTime({_left})%"
            stop
        # Косметика — никакого боевого/прочного снаряжения
        give 4 firework rocket to player
        give 1 yellow banner to player
        give 1 red banner to player
        give 1 name tag to player
        give 1 music disc 13 to player
        give 1 painting to player
        give 4 cake to player
        spSetCd(player, "kit", 86400)
        send "{@prefix} &eПолучен спонсорский космет.набор!"
        play sound "ui.toast.challenge_complete" at player for player


# ---- Новые крафтабельные артефакты (инвентарь) ----
every 5 seconds:
    if {evo_faceless_team_ready} is not true:
        execute console command "team add evo_faceless"
        execute console command "team modify evo_faceless nametagVisibility never"
        set {evo_faceless_team_ready} to true
    loop all players:
        if hasUtilityCoreOrInventory(loop-player, "heater", "Портативный Нагреватель") is true:
            set {_t} to loop-player's tool
            if {_t} is beef:
                remove 1 beef from loop-player
                give 1 cooked beef to loop-player
            else if {_t} is porkchop:
                remove 1 porkchop from loop-player
                give 1 cooked porkchop to loop-player
            else if {_t} is chicken:
                remove 1 chicken from loop-player
                give 1 cooked chicken to loop-player
            else if {_t} is mutton:
                remove 1 mutton from loop-player
                give 1 cooked mutton to loop-player
            else if {_t} is rabbit:
                remove 1 rabbit from loop-player
                give 1 cooked rabbit to loop-player
            else if {_t} is cod:
                remove 1 cod from loop-player
                give 1 cooked cod to loop-player
            else if {_t} is salmon:
                remove 1 salmon from loop-player
                give 1 cooked salmon to loop-player

        set {_pu} to uuid of loop-player
        if hasUtilityCoreOrInventory(loop-player, "facelessmask", "Маска Безликого") is true:
            if {evo_faceless_applied::%{_pu}%} is not true:
                execute console command "team join evo_faceless %loop-player%"
                set {evo_faceless_applied::%{_pu}%} to true
        else:
            if {evo_faceless_applied::%{_pu}%} is true:
                execute console command "team leave %loop-player%"
                delete {evo_faceless_applied::%{_pu}%}

on bed enter:
    if hasUtilityCoreOrInventory(player, "dreamcatcher", "Ловец Снов") is true:
        set time in world of player to 6:00
        clear weather in world of player
        apply luck 1 without particles to player for 1200 seconds
        send action bar "&d&lЛОВЕЦ СНОВ: ночь мгновенно рассеялась" to player

on craft:
    if hasUtilityCoreOrInventory(player, "quantdup", "Квантовый Дубликатор") is true:
        set {_res} to event-item
        set {_blocked} to false
        set {_nm} to name of {_res}
        if {_nm} is set:
            if {_nm} contains "Алтар":
                set {_blocked} to true
            if {_nm} contains "Артефакт:":
                set {_blocked} to true
            if {_nm} contains "Легендарный артефакт:":
                set {_blocked} to true
        if {_blocked} is false:
            chance of 10%:
                wait 1 tick
                if {_res} is set:
                    give {_res} to player
                    send action bar "&b&lКВАНТОВЫЙ ДУБЛИКАТОР: +1 копия!" to player

# Сердце Пустыни и Дар Проклятого Короля
on death of player:
    set {_vu} to victim's uuid
    loop all players:
        if hasArtifactCoreOrInventory(loop-player, "cursedgift", "Дар Проклятого Короля") is true:
            if loop-player is not victim:
                if distance between loop-player and victim <= 10:
                    if areDuo(loop-player, victim) is true:
                        set {_ou} to uuid of loop-player
                        set {_cd} to {cursedgift_cd::%{_ou}%::%{_vu}%} ? 0
                        if {_cd} <= unix timestamp of now:
                            set {_lv} to {level::%{_ou}%} ? 1
                            if {_lv} > 10:
                                set {cursedgift_cd::%{_ou}%::%{_vu}%} to (unix timestamp of now) + 300
                                set {cursedgift_pending::%{_vu}%} to {_ou}
                                set {level::%{_ou}%} to {_lv} - 10
                                set {kills::%{_ou}%} to ({level::%{_ou}%} - 1) * {@kills_per_level}
                                send action bar "&4Дар Проклятого Короля: -10 уровней" to loop-player
                                exit loop

on respawn:
    set {_vu} to player's uuid
    if {cursedgift_pending::%{_vu}%} is set:
        set {_ou} to {cursedgift_pending::%{_vu}%}
        delete {cursedgift_pending::%{_vu}%}
        set {_owner} to player from {_ou}
        if {_owner} is online:
            teleport player to {_owner}
            set health of player to 2
            send title "&4&lВОСКРЕШЕНИЕ" with subtitle "&7Дар Проклятого Короля" to player for 2 seconds
            send action bar "&cСоюзник воскрешён рядом" to {_owner}

every 2 ticks:
    loop all players:
        if hasArtifactCoreOrInventory(loop-player, "desertheart", "Сердце Пустыни") is true:
            loop blocks in radius 5 around loop-player:
                if loop-block is water:
                    set loop-block to air
            loop all living entities in radius 3 around loop-player:
                set {_target} to loop-entity-1
                if {_target} is a player:
                    if uuid of {_target} is uuid of loop-player:
                        continue
                    if areDuo(loop-player, {_target}) is true:
                        continue
                apply hunger 1 without particles to {_target} for 3 seconds
                apply wither 1 without particles to {_target} for 2 seconds

every 2 seconds:
    loop all players:
        if hasUtilityCoreOrInventory(loop-player, "lootmagnet", "Магнит Добытчика") is true:
            loop all dropped items in radius 6 around loop-player:
                teleport loop-entity-1 to loop-player

every 4 seconds:
    loop all players:
        if hasUtilityCoreOrInventory(loop-player, "nightlens", "Ночная Линза") is true:
            refreshPassiveNightVision(loop-player)
        set {_altarNvHelm} to helmet of loop-player
        if isEtherHelmet({_altarNvHelm}) is true:
            set {_altarNv} to true
        else if isOmniHelmet({_altarNvHelm}) is true:
            set {_altarNv} to true
        else:
            set {_altarNv} to false
        if {_altarNv} is true:
            set {_altarMaxHp} to max health of loop-player
            if health of loop-player > ({_altarMaxHp} * 0.8):
                refreshPassiveNightVision(loop-player)
        set {_altarLegs} to leggings of loop-player
        if isEtherLeggings({_altarLegs}) is true:
            refreshAltarPassiveSpeed(loop-player)
        else if isOmniLeggings({_altarLegs}) is true:
            refreshAltarPassiveSpeed(loop-player)
        set {_altarBoots} to boots of loop-player
        if isVeinBoots({_altarBoots}) is true:
            refreshAltarPassiveJump(loop-player)
        else if isOmniBoots({_altarBoots}) is true:
            refreshAltarPassiveJump(loop-player)
            refreshAltarPassiveLuck(loop-player)
        else if isFortuneBoots({_altarBoots}) is true:
            refreshAltarPassiveLuck(loop-player)

# ---- Древние свитки ----
function initAncientScrollRecipes():
    delete {ancient_scroll_recipes::*}
    # Легендарные
    set {ancient_scroll_recipes::leg_warrior::name} to "Печать Пространственного Разреза"
    set {ancient_scroll_recipes::leg_warrior::tier} to "absolute"
    set {ancient_scroll_recipes::leg_warrior::ing::*} to "Незеритовый меч" and "Огненный стержень" and "Редстоун блок" and "Эндер-жемчуг" and "Алмазный блок"
